<!--
  SettingsWindow-Redesign.xaml
  ═══════════════════════════════════════════════════════════════════════════
  This is the NEW layout skeleton for SettingsWindow.xaml.

  STRATEGY: Keep ALL existing Window.Resources (styles, converters, templates)
  from the current SettingsWindow.xaml. Replace only the content structure
  (Grid layout, TitleBar, nav bar, filter bar, main area).

  DataContext: SettingsViewModel (unchanged).

  Key structural change:
    OLD → single scrollable list of profile cards + settings expanded inline
    NEW → TitleBar / TopNav / FilterBar / ScrollViewer(card grid)
          Settings/About/FAQ panels slide in and replace the card grid
          Profile detail opens as an overlay modal on top of everything

  Window sizing: no fixed Width/Height — let user resize freely.
  MinWidth=680 MinHeight=480 is a comfortable minimum.
  ═══════════════════════════════════════════════════════════════════════════
-->
<Window x:Class="VibeSwitcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VibeSwitcher.ViewModels"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBg}"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" GlassFrameThickness="0"
                      ResizeBorderThickness="4" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- ════════════════════════════════════════════════════════════
         RESOURCES
         Keep all existing resources from the current SettingsWindow.
         Add these new ones below.
         ════════════════════════════════════════════════════════════ -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Filter chip: ghost → orange fill when checked -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="Height"   Value="26"/>
            <Setter Property="Padding"  Value="10,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="13" BorderThickness="1"
                                BorderBrush="{DynamicResource InputBorder}"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"  Value="{DynamicResource VSAccentDim}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource VSAccentBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked"   Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background"  Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource InputHoverBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav icon button (Settings/About/FAQ) -->
        <Style x:Key="NavIconBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"   Value="34"/>
            <Setter Property="Height"  Value="34"/>
            <Setter Property="Cursor"  Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Width="34" Height="34" CornerRadius="8"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Active" variant of NavIconBtn — orange tint when panel is open -->
        <Style x:Key="NavIconBtnActive" TargetType="Button"
               BasedOn="{StaticResource NavIconBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Width="34" Height="34" CornerRadius="8"
                                Background="{DynamicResource VSAccentGlow}"
                                BorderBrush="{DynamicResource VSAccentBorder}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title bar window control buttons -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"    Value="44"/>
            <Setter Property="Height"  Value="30"/>
            <Setter Property="Cursor"  Value="Hand"/>
            <Setter Property="Foreground" Value="#555570"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0DFFFFFF"/>
                                <Setter Property="Foreground" Value="#AAAACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBtnClose" TargetType="Button"
               BasedOn="{StaticResource TitleBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ════════════════════════════════════════════════════════════
         ROOT LAYOUT: 4 rows — TitleBar / TopNav / FilterBar / Content
         ════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>    <!-- Title bar -->
            <RowDefinition Height="54"/>    <!-- Top nav -->
            <RowDefinition Height="Auto"/>  <!-- Filter bar (animated, starts at 0) -->
            <RowDefinition Height="*"/>     <!-- Main content -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             ROW 0 — CUSTOM TITLE BAR
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource VSTitleBarBg}"
                BorderBrush="#16162A" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Left: logo mark + app name -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="14,0,0,0" Spacing="8">
                    <!-- VS icon at 14px: use <Image Source="pack://...Resources/Icons/..." Width="14"/> -->
                    <Canvas Width="14" Height="14">
                        <Path Data="M 4,5 L 7,10 L 10,5"
                              Stroke="#F5820A" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent"/>
                    </Canvas>
                    <TextBlock Text="VibeSwitcher"
                               FontFamily="Segoe UI" FontSize="11.5" FontWeight="Medium"
                               Foreground="#44445A"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: window controls (not in WindowChrome caption area) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBtn}"
                            Content="─"
                            Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource TitleBtn}"
                            Content="□"
                            Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource TitleBtnClose}"
                            Content="✕"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             ROW 1 — TOP NAVIGATION BAR
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource VSNavBg}"
                BorderBrush="{DynamicResource VSNavBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- logo -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1"/>      <!-- divider -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"        MaxWidth="260"/>  <!-- search -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>   <!-- filters btn -->
                    <ColumnDefinition Width="*"/>      <!-- spacer -->
                    <ColumnDefinition Width="Auto"/>   <!-- FAQ -->
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>   <!-- About -->
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>   <!-- Settings -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1"/>      <!-- divider -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>   <!-- + New Profile -->
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="8">
                    <!-- Small VS icon — same Canvas as TitleBar or use Image -->
                    <Canvas Width="26" Height="26">
                        <Rectangle Width="26" Height="26" RadiusX="6" RadiusY="6" Fill="#13131E"/>
                        <Path Data="M 5,7 L 13,18 L 21,7"
                              Stroke="#F5820A" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent"/>
                    </Canvas>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Vibe"
                                   FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Switcher"
                                   FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Column="2" Width="1" Height="22"
                        Background="{DynamicResource InputBorder}"
                        VerticalAlignment="Center"/>

                <!-- Search box -->
                <Border Grid.Column="4"
                        Background="{DynamicResource InputBg}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="32">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource VSAccentBorder}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="11,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Search icon -->
                        <Path Grid.Column="0" Margin="0,0,7,0"
                              Data="M7,7 A5,5 0 0 0 7,2 A5,5 0 0 0 7,12 A5,5 0 0 0 12,7 A5,5 0 0 0 7,2 M11,11 L14,14"
                              Stroke="{DynamicResource MutedText}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round"
                              Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <!--
                          BINDING: Search filter.
                          SettingsViewModel does not have a SearchText property yet —
                          add one and wire it to filter Profiles by Name.Contains(SearchText).
                        -->
                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Height="30"
                                 FontSize="13"
                                 Foreground="{DynamicResource PrimaryText}"
                                 VerticalContentAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Filters button -->
                <Button Grid.Column="6"
                        x:Name="FiltersToggleBtn"
                        Style="{StaticResource ActionButton}"
                        Height="32" Padding="11,0"
                        FontSize="12.5"
                        Click="FiltersToggle_Click">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Path Data="M1.5,3.5 L14.5,3.5 M4,8 L12,8 M7,12.5 L9,12.5"
                              Stroke="CurrentColor" StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Filters" VerticalAlignment="Center"/>
                        <!-- Filter count badge — show only when IsAnyFilterActive -->
                        <Border Background="{DynamicResource Accent}"
                                CornerRadius="8" Padding="4,0" MinWidth="16" Height="16"
                                Visibility="{Binding IsAnyFilterActive, Converter={StaticResource BoolToVis}}">
                            <!-- NOTE: Add FilterCount int property to SettingsViewModel,
                                 or use a converter to count active filters -->
                            <TextBlock x:Name="FilterCountBadge"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#0D0D12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Spacer -->
                <!-- (Grid column 7 is the * spacer — no element needed) -->

                <!-- FAQ button -->
                <Button Grid.Column="8" x:Name="FaqBtn"
                        Style="{StaticResource NavIconBtn}"
                        Click="ShowFaq_Click"
                        ToolTip="FAQ">
                    <Path Data="M8,2 A6,6 0 0 1 8,14 A6,6 0 0 1 8,2 Z M6,6.5 A2,2 0 1 1 8,8 L8,9.2 M8,11.5 A0.75,0.75 0 1 0 8,13 A0.75,0.75 0 1 0 8,11.5"
                          Stroke="{DynamicResource MutedText}" StrokeThickness="1.75"
                          Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="15" Height="15" Stretch="Uniform"/>
                </Button>

                <!-- About button -->
                <Button Grid.Column="10" x:Name="AboutBtn"
                        Style="{StaticResource NavIconBtn}"
                        Click="ShowAbout_Click"
                        ToolTip="About">
                    <Path Data="M8,2 A6,6 0 0 1 8,14 A6,6 0 0 1 8,2 Z M8,7.5 L8,11.2 M8,5.5 A0.75,0.75 0 1 0 8,7 A0.75,0.75 0 1 0 8,5.5"
                          Stroke="{DynamicResource MutedText}" StrokeThickness="1.75"
                          Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="15" Height="15" Stretch="Uniform"/>
                </Button>

                <!-- Settings button -->
                <Button Grid.Column="12" x:Name="SettingsBtn"
                        Style="{StaticResource NavIconBtn}"
                        Click="ShowSettings_Click"
                        ToolTip="Settings">
                    <Path Data="M8,6 A2.4,2.4 0 0 0 8,10.8 A2.4,2.4 0 0 0 8,6 Z M8,1.5 L8,2.8 M8,13.2 L8,14.5 M1.5,8 L2.8,8 M13.2,8 L14.5,8 M3.2,3.2 L4.1,4.1 M11.9,11.9 L12.8,12.8 M3.2,12.8 L4.1,11.9 M11.9,4.1 L12.8,3.2"
                          Stroke="{DynamicResource MutedText}" StrokeThickness="1.75"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="15" Height="15" Stretch="Uniform"/>
                </Button>

                <!-- Divider -->
                <Border Grid.Column="14" Width="1" Height="22"
                        Background="{DynamicResource InputBorder}"
                        VerticalAlignment="Center"/>

                <!-- + New Profile button -->
                <Button Grid.Column="16"
                        Style="{StaticResource PrimaryButton}"
                        Height="34" Padding="15,0"
                        Command="{Binding AddProfileCommand}"
                        ToolTip="Add new profile">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Data="M6.5,1.5 L6.5,11.5 M1.5,6.5 L11.5,6.5"
                              Stroke="#0D0D12" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="New Profile" VerticalAlignment="Center"
                                   FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             ROW 2 — FILTER BAR (animated collapse/expand)
             ══════════════════════════════════════════════════════ -->
        <!--
          Use a Border with Height animated between 0 and Auto.
          In code-behind, toggle via Storyboard on FiltersToggle_Click:

              var open = FilterBarBorder.Height > 0;
              var target = open ? 0 : double.NaN; // NaN = Auto
              // Use DoubleAnimation to/from ActualHeight for collapse,
              // or just toggle a MaxHeight from 0 to 52.

          Simpler approach: animate MaxHeight 0 → 52.
        -->
        <Border Grid.Row="2"
                x:Name="FilterBarBorder"
                Background="{DynamicResource AppBg}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1"
                MaxHeight="0"
                ClipToBounds="True">
            <WrapPanel x:Name="FilterBar"
                       Margin="18,9"
                       Orientation="Horizontal">

                <!-- Mode chips (mutually exclusive — bind IsChecked to ModePlayback, ModeRecording, ModeBoth) -->
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Playback only"
                              IsChecked="{Binding ModePlayback}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Recording only"
                              IsChecked="{Binding ModeRecording}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Both devices"
                              IsChecked="{Binding ModeBoth}"/>

                <!-- Separator -->
                <Separator Width="1" Height="18" Margin="2,0,8,4" VerticalAlignment="Center"/>

                <!-- Attribute chips -->
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="★ Pinned"   IsChecked="{Binding PinnedFilter}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="✓ Active"   IsChecked="{Binding ActiveFilter}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Silent"     IsChecked="{Binding SilentFilter}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Has hotkey" IsChecked="{Binding HotkeyFilter}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Scheduled"  IsChecked="{Binding ScheduledFilter}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Has trigger" IsChecked="{Binding HotkeyFilter}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Has sound"  IsChecked="{Binding SoundFilter}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="⚠ Warning"  IsChecked="{Binding WarningFilter}"/>

                <!-- Clear all -->
                <Button Margin="6,0,0,4"
                        Style="{StaticResource ActionButton}"
                        Height="26" Padding="10,0" FontSize="11.5"
                        Content="✕ Clear"
                        Command="{Binding ClearFiltersCommand}"
                        Foreground="{DynamicResource ErrorText}"
                        Visibility="{Binding IsAnyFilterActive, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             ROW 3 — MAIN CONTENT AREA
             Three views share this space; only one is visible at a time.
             Toggle Visibility via code-behind (or a ContentControl + DataTemplates).
             ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">

            <!-- ── A. Profile Card Grid ── -->
            <ScrollViewer x:Name="ProfileGridView"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{DynamicResource AppBg}">
                <Grid Margin="18,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- grid header label -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>  <!-- card grid -->
                        <RowDefinition Height="Auto"/>  <!-- empty-state -->
                    </Grid.RowDefinitions>

                    <!-- Grid header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="PROFILES"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedText}"
                                   CharacterSpacing="100"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource InputBg}"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="7,1">
                            <!-- Bind to profile count -->
                            <TextBlock FontFamily="Segoe UI" FontSize="10.5"
                                       Foreground="{DynamicResource MutedText}">
                                <TextBlock.Text>
                                    <Binding Path="Profiles.Count"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Card grid — CenteredWrapPanel already in the project -->
                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProfileCardViewModel}">
                                <views:ProfileCardView
                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                    MouseLeftButtonUp="ProfileCard_Clicked"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!--
                                  CenteredWrapPanel is already in Views/CenteredWrapPanel.cs.
                                  Set ItemWidth to card width (192) + gap (13) = 205.
                                  The panel centres incomplete last rows automatically.
                                -->
                                <views:CenteredWrapPanel ItemWidth="205"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Empty-state: no profiles at all -->
                    <Border Grid.Row="3"
                            Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVis}}"
                            Margin="0,40">
                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <TextBlock Text="No profiles yet"
                                       FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedText}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Click + New Profile to get started"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="{DynamicResource SubtleText}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty-state: filters returned no results -->
                    <Border Grid.Row="3"
                            Visibility="{Binding HasNoFilterResults, Converter={StaticResource BoolToVis}}"
                            Margin="0,40">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="No profiles match the active filters"
                                       FontFamily="Segoe UI" FontSize="13"
                                       Foreground="{DynamicResource MutedText}"
                                       HorizontalAlignment="Center"/>
                            <Button Content="Clear filters"
                                    Style="{StaticResource ActionButton}"
                                    Command="{Binding ClearFiltersCommand}"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- ── B. Settings Panel (slides in from right, replaces card grid) ── -->
            <!--
              The existing SettingsWindow.xaml settings content goes here.
              Move all existing settings StackPanels/Expander content into this ScrollViewer.
              Show/Hide via code-behind on ShowSettings_Click.
              Full existing settings content (startup, tray, devices, hotkeys, etc.)
              is kept intact — just move it inside this ScrollViewer.
            -->
            <ScrollViewer x:Name="SettingsPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource AppBg}">
                <StackPanel Margin="24,26" MaxWidth="620"
                            HorizontalAlignment="Left">

                    <!-- Panel header -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,24">
                        <Button Style="{StaticResource ActionButton}"
                                Width="34" Height="34" Padding="0"
                                Click="ShowSettings_Click"
                                ToolTip="Back to profiles">
                            <Path Data="M10,3 L5,8 L10,13"
                                  Stroke="CurrentColor" StrokeThickness="2"
                                  Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <TextBlock Text="Settings"
                                   FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!--
                      INSERT ALL EXISTING SETTINGS CONTENT HERE.
                      Copy the sections from current SettingsWindow.xaml:
                      Startup, Tray, Notifications, Devices, Theme,
                      Schedules, Hotkeys, Device Aliases, Import/Export.

                      Each section uses this container pattern:
                    -->
                    <TextBlock Text="APPEARANCE" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedText}" CharacterSpacing="120"
                               Margin="2,0,0,7"/>
                    <Border Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Margin="0,0,0,22" ClipToBounds="True">
                        <!-- rows go here — see existing SettingsWindow content -->
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── C. About / FAQ Panel (same structure as Settings) ── -->
            <ScrollViewer x:Name="AboutPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource AppBg}">
                <!-- Move AboutWindow content here, restyled with section containers -->
            </ScrollViewer>

            <!-- ── D. Profile Detail Modal Overlay ── -->
            <!--
              Sits on top of all content at ZIndex=10.
              Collapsed by default; shown when a profile card is clicked.
              DataContext: the clicked ProfileCardViewModel.

              Semi-transparent backdrop + animated modal card.
              ALL EXISTING dialog content (name, devices, hotkey, icon,
              notes, schedules, sound override) moves into this panel.
              The existing code-behind for each sub-dialog (HotkeyCaptureDialog,
              IconGalleryDialog, etc.) stays EXACTLY as-is — only the trigger
              changes from a separate Window to buttons inside this modal.
            -->
            <Grid x:Name="ProfileDetailOverlay"
                  Visibility="Collapsed"
                  Panel.ZIndex="10">

                <!-- Backdrop -->
                <Border Background="#D50D0D12"
                        MouseLeftButtonDown="ProfileDetail_BackdropClick"/>

                <!-- Modal card -->
                <Border x:Name="ProfileDetailCard"
                        Background="{DynamicResource VSModalBg}"
                        BorderBrush="{DynamicResource VSModalBorder}"
                        BorderThickness="1"
                        CornerRadius="18"
                        MaxWidth="480"
                        MaxHeight="600"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="100"
                                          ShadowDepth="0" Opacity="0.78"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ModalScale" ScaleX="1" ScaleY="1"
                                            CenterX="240" CenterY="300"/>
                            <TranslateTransform x:Name="ModalTranslate" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- header -->
                            <RowDefinition Height="*"/>     <!-- body (scrollable) -->
                            <RowDefinition Height="Auto"/>  <!-- footer -->
                        </Grid.RowDefinitions>

                        <!-- Modal header: icon + editable name + mode pills + close -->
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource SeparatorBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="22,22,22,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>  <!-- icon -->
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>   <!-- name + pills -->
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="30"/>  <!-- close -->
                                </Grid.ColumnDefinitions>

                                <!-- Profile icon -->
                                <Border Grid.Column="0"
                                        Width="54" Height="54" CornerRadius="13"
                                        Background="{DynamicResource IconPreviewBg}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <Image Source="{Binding IconPreview}"
                                           Width="36" Height="36"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Name + mode pills -->
                                <StackPanel Grid.Column="2" Spacing="10">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0,0,0,1"
                                             BorderBrush="Transparent"
                                             FontFamily="Segoe UI"
                                             FontSize="16" FontWeight="Bold"
                                             Foreground="{DynamicResource PrimaryText}"
                                             VerticalContentAlignment="Center"/>

                                    <!-- Mode pills: use RadioButton or ToggleButton group -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <!-- Use ToggleButton style "FilterChip" or define mode-specific pill style -->
                                    </StackPanel>
                                </StackPanel>

                                <!-- Close button -->
                                <Button Grid.Column="4"
                                        Style="{StaticResource NavIconBtn}"
                                        Width="30" Height="30"
                                        Click="ProfileDetail_Close"
                                        ToolTip="Close">
                                    <Path Data="M2,2 L12,12 M12,2 L2,12"
                                          Stroke="{DynamicResource MutedText}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Modal body: Notes / Playback / Recording / Hotkey / Icon -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="400">
                            <StackPanel Margin="22,18" Spacing="14">
                                <!--
                                  Move existing profile editing fields here:
                                  Notes TextBox, Playback ComboBox, Recording ComboBox,
                                  HotkeyDisplay + CaptureHotkeyCommand button,
                                  Icon gallery row (PickIconCommand).

                                  All bindings stay identical to the current SettingsWindow markup.
                                  Only layout changes (was in an Expander, now in this modal).
                                -->
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Modal footer: Cancel + Save -->
                        <Border Grid.Row="2"
                                BorderBrush="{DynamicResource SeparatorBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="22,14,22,20">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="8">
                                <Button Content="Cancel"
                                        Style="{StaticResource ActionButton}"
                                        Height="34"
                                        Click="ProfileDetail_Close"/>
                                <!-- Save is auto-handled via live bindings; button triggers SaveFlash -->
                                <Button Content="Save Changes"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="34"
                                        Click="ProfileDetail_Save"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

    </Grid>
</Window>

<!--
═══════════════════════════════════════════════════════════════════════════════
  SettingsWindow.xaml.cs — additions needed
═══════════════════════════════════════════════════════════════════════════════

  PANEL NAVIGATION
  ─────────────────
  private enum ActivePanel { Profiles, Settings, About, Faq }
  private ActivePanel _activePanel = ActivePanel.Profiles;

  private void ShowPanel(ActivePanel panel)
  {
      ProfileGridView.Visibility     = panel == ActivePanel.Profiles ? Visibility.Visible : Visibility.Collapsed;
      SettingsPanel.Visibility       = panel == ActivePanel.Settings  ? Visibility.Visible : Visibility.Collapsed;
      AboutPanel.Visibility          = panel == ActivePanel.About     ? Visibility.Visible : Visibility.Collapsed;
      // FAQ reuses AboutPanel or has its own ScrollViewer
      _activePanel = panel;
  }

  private void ShowSettings_Click(object s, RoutedEventArgs e)
      => ShowPanel(_activePanel == ActivePanel.Settings ? ActivePanel.Profiles : ActivePanel.Settings);

  private void ShowAbout_Click(object s, RoutedEventArgs e)
      => ShowPanel(_activePanel == ActivePanel.About ? ActivePanel.Profiles : ActivePanel.About);

  private void ShowFaq_Click(object s, RoutedEventArgs e) { ... }


  FILTER BAR ANIMATION
  ─────────────────────
  private bool _filtersOpen;
  private void FiltersToggle_Click(object s, RoutedEventArgs e)
  {
      _filtersOpen = !_filtersOpen;
      var anim = new DoubleAnimation(
          _filtersOpen ? 52 : 0,
          TimeSpan.FromMilliseconds(300));
      anim.EasingFunction = new CubicEase { EasingMode = EasingMode.EaseInOut };
      FilterBarBorder.BeginAnimation(MaxHeightProperty, anim);
  }


  PROFILE DETAIL MODAL
  ─────────────────────
  private ProfileCardViewModel? _detailVm;

  private void ProfileCard_Clicked(object s, MouseButtonEventArgs e)
  {
      if (s is not FrameworkElement el) return;
      _detailVm = el.DataContext as ProfileCardViewModel;
      ProfileDetailCard.DataContext = _detailVm;
      ProfileDetailOverlay.Visibility = Visibility.Visible;

      // Open animation: scale 0.88→1, opacity 0→1, translateY 16→0
      var scaleAnim = new DoubleAnimation(0.88, 1.0, TimeSpan.FromMilliseconds(320));
      scaleAnim.EasingFunction = new BackEase { EasingMode = EasingMode.EaseOut, Amplitude = 0.3 };
      ModalScale.BeginAnimation(ScaleTransform.ScaleXProperty, scaleAnim);
      ModalScale.BeginAnimation(ScaleTransform.ScaleYProperty, scaleAnim);
      var translateAnim = new DoubleAnimation(16, 0, TimeSpan.FromMilliseconds(320));
      ModalTranslate.BeginAnimation(TranslateTransform.YProperty, translateAnim);
      var opacityAnim = new DoubleAnimation(0, 1, TimeSpan.FromMilliseconds(200));
      ProfileDetailCard.BeginAnimation(OpacityProperty, opacityAnim);
  }

  private void ProfileDetail_Close(object s, RoutedEventArgs e)
      => ProfileDetailOverlay.Visibility = Visibility.Collapsed;

  private void ProfileDetail_BackdropClick(object s, MouseButtonEventArgs e)
      => ProfileDetailOverlay.Visibility = Visibility.Collapsed;

  private void ProfileDetail_Save(object s, RoutedEventArgs e)
  {
      // Bindings are live (UpdateSourceTrigger=PropertyChanged) so no manual copy needed.
      // Just flash and close.
      _detailVm?.TriggerSaveFlash();
      ProfileDetailOverlay.Visibility = Visibility.Collapsed;
  }


  WINDOW CONTROLS
  ─────────────────
  private void MinimizeButton_Click(object s, RoutedEventArgs e)  => WindowState = WindowState.Minimized;
  private void MaximizeButton_Click(object s, RoutedEventArgs e)
      => WindowState = WindowState == WindowState.Maximized ? WindowState.Normal : WindowState.Maximized;
  private void CloseButton_Click(object s, RoutedEventArgs e)     => Close();
═══════════════════════════════════════════════════════════════════════════════
-->
