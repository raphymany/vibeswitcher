<!--
  SplashWindow.xaml
  ═══════════════════════════════════════════════════════════════════
  Add this file to VibeSwitcher/Views/SplashWindow.xaml

  In App.xaml.cs OnStartup(), show this BEFORE opening SettingsWindow.
  The window closes itself after 2200ms. Pattern:

      var splash = new SplashWindow();
      splash.Show();
      await Task.Delay(2200);
      splash.Close();
      OpenSettingsWindow();

  Or wire Closed event to open main window. The Storyboard fires
  automatically on Window.Loaded.
  ═══════════════════════════════════════════════════════════════════
-->
<Window x:Class="VibeSwitcher.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeSwitcher"
        Width="360" Height="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <!-- ── Splash entry + animation storyboard ── -->
        <Storyboard x:Key="SplashStoryboard" x:Name="SplashStoryboard">

            <!-- 1. Fade whole window in (0–300ms) -->
            <DoubleAnimation
                Storyboard.TargetName="RootPanel"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 2a. Icon rises up (380–720ms) -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="IconTranslate"
                Storyboard.TargetProperty="Y"
                BeginTime="0:0:0.38">
                <LinearDoubleKeyFrame Value="0"   KeyTime="0:0:0"/>
                <EasingDoubleKeyFrame Value="-26" KeyTime="0:0:0.34">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- 2b. Icon slams down + squish (720–1000ms) -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="IconTranslate"
                Storyboard.TargetProperty="Y"
                BeginTime="0:0:0.72">
                <LinearDoubleKeyFrame Value="-23" KeyTime="0:0:0"/>
                <EasingDoubleKeyFrame Value="11"  KeyTime="0:0:0.18">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <!-- bounce up -->
                <EasingDoubleKeyFrame Value="-10" KeyTime="0:0:0.38">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <!-- settle -->
                <EasingDoubleKeyFrame Value="3"   KeyTime="0:0:0.52">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame Value="0"   KeyTime="0:0:0.66">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- ScaleY squish on slam -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="IconScale"
                Storyboard.TargetProperty="ScaleY"
                BeginTime="0:0:0.72">
                <LinearDoubleKeyFrame Value="1"    KeyTime="0:0:0"/>
                <EasingDoubleKeyFrame Value="0.87" KeyTime="0:0:0.18">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame Value="1.06" KeyTime="0:0:0.38">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame Value="1"    KeyTime="0:0:0.66">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- ScaleX slight expand on slam (opposite of ScaleY) -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="IconScale"
                Storyboard.TargetProperty="ScaleX"
                BeginTime="0:0:0.72">
                <LinearDoubleKeyFrame Value="1"    KeyTime="0:0:0"/>
                <EasingDoubleKeyFrame Value="1.06" KeyTime="0:0:0.18"/>
                <EasingDoubleKeyFrame Value="0.97" KeyTime="0:0:0.38"/>
                <EasingDoubleKeyFrame Value="1"    KeyTime="0:0:0.66"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 3. Text fades in after icon lands (900ms–1100ms) -->
            <DoubleAnimation
                Storyboard.TargetName="TextGroup"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                BeginTime="0:0:0.9"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="TextTranslate"
                Storyboard.TargetProperty="Y"
                From="6" To="0"
                BeginTime="0:0:0.9"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 4. Window fades + scales out at 1860ms -->
            <DoubleAnimation
                Storyboard.TargetName="RootPanel"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0"
                BeginTime="0:0:1.86"
                Duration="0:0:0.34">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource SplashStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <!-- Drop shadow container -->
    <Border Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>

        <Border Background="#0D0D12" CornerRadius="20">

            <StackPanel x:Name="RootPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Opacity="0">

                <!-- ── VS Icon with transform group ── -->
                <Border HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="IconScale"
                                            ScaleX="1" ScaleY="1"
                                            CenterX="48" CenterY="48"/>
                            <TranslateTransform x:Name="IconTranslate" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>

                    <!--
                      VS Icon — 96×96 rounded square.
                      The V chevron + 5 equalizer bars are drawn as WPF Paths.
                      Replace this Canvas with an <Image> pointing to your .ico
                      if you prefer (96px render size).
                    -->
                    <Border Width="96" Height="96" CornerRadius="22"
                            Background="#13131E">
                        <Border.Effect>
                            <DropShadowEffect Color="#F5820A" BlurRadius="32"
                                              ShadowDepth="0" Opacity="0.08"/>
                        </Border.Effect>
                        <Border BorderBrush="#3D2908" BorderThickness="1" CornerRadius="22">
                            <Canvas Width="80" Height="80" Margin="8">

                                <!-- V chevron -->
                                <Path Canvas.Left="0" Canvas.Top="0"
                                      Data="M 19,22 L 40,54 L 61,22"
                                      Stroke="#F5820A" StrokeThickness="4"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"/>

                                <!-- Equalizer bars (left → right, varying opacity) -->
                                <Rectangle Canvas.Left="22"   Canvas.Top="61" Width="4.5" Height="7"  RadiusX="2.25" RadiusY="2.25" Fill="#F5820A" Opacity="0.38"/>
                                <Rectangle Canvas.Left="29.5" Canvas.Top="56" Width="4.5" Height="12" RadiusX="2.25" RadiusY="2.25" Fill="#F5820A" Opacity="0.62"/>
                                <Rectangle Canvas.Left="37.75" Canvas.Top="58.5" Width="4.5" Height="9.5"  RadiusX="2.25" RadiusY="2.25" Fill="#F5820A"/>
                                <Rectangle Canvas.Left="46"   Canvas.Top="56" Width="4.5" Height="12" RadiusX="2.25" RadiusY="2.25" Fill="#F5820A" Opacity="0.62"/>
                                <Rectangle Canvas.Left="53.5" Canvas.Top="61" Width="4.5" Height="7"  RadiusX="2.25" RadiusY="2.25" Fill="#F5820A" Opacity="0.38"/>

                            </Canvas>
                        </Border>
                    </Border>
                </Border>

                <!-- ── Text group ── -->
                <StackPanel x:Name="TextGroup" Opacity="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="TextTranslate">
                        <!-- NOTE: apply TranslateTransform on this TextBlock, not the StackPanel,
                             if you want the translate to only affect vertical position -->
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TextTranslate" Y="6"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <TextBlock Text="VibeSwitcher"
                               FontFamily="Segoe UI"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#E4E4EF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TextTranslate" Y="6"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <TextBlock Text="Manage your device profiles and hotkeys"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#38384E"
                               HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Border>
</Window>
