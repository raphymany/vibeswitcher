<!--
  ProfileCardView.xaml
  ═══════════════════════════════════════════════════════════════════
  Add as VibeSwitcher/Views/ProfileCardView.xaml (UserControl).

  DataContext: ProfileCardViewModel (one instance per profile card).

  This replaces the existing DataTemplate-based inline card markup
  inside SettingsWindow.xaml. Wire it up in SettingsWindow.xaml as:

      <ItemsControl ItemsSource="{Binding Profiles}"
                    ItemTemplate="{StaticResource ProfileCardTemplate}">
          <ItemsControl.Resources>
              <DataTemplate x:Key="ProfileCardTemplate">
                  <views:ProfileCardView/>
              </DataTemplate>
          </ItemsControl.Resources>
          <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                  <views:CenteredWrapPanel ItemWidth="206" .../>
              </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
      </ItemsControl>

  Or use an implicit DataTemplate with DataType:
      <DataTemplate DataType="{x:Type vm:ProfileCardViewModel}">
          <views:ProfileCardView/>
      </DataTemplate>
  ═══════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="VibeSwitcher.Views.ProfileCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VibeSwitcher.ViewModels"
             Width="192" MinHeight="244"
             Cursor="Hand">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ─── Mode badge style (applied per instance with colour override) ─── -->
        <Style x:Key="ModeBadge" TargetType="Border">
            <Setter Property="CornerRadius"      Value="10"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="8,2.5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- ─── Action icon button ─── -->
        <Style x:Key="ActBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Width="28" Height="28" CornerRadius="6"
                                Background="{DynamicResource VSActBg}"
                                BorderBrush="{DynamicResource VSActBorder}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource VSActHoverBg}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource VSActHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Dot (status indicator) ─── -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width"  Value="6"/>
            <Setter Property="Height" Value="6"/>
        </Style>

    </UserControl.Resources>

    <!--
      Outer border = the card. Use a Grid so the hover action strip
      can overlay the bottom of the card at ZIndex=1.
    -->
    <Border x:Name="CardBorder"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14,20,14,14"
            Margin="6.5"
            ClipToBounds="True">

        <Border.Effect>
            <!-- Subtle default shadow; becomes more prominent on hover via trigger below -->
            <DropShadowEffect x:Name="CardShadow"
                              Color="#000000" BlurRadius="8"
                              ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>

        <!-- ── Active-profile top accent bar ── -->
        <!-- Sits outside normal flow at the very top; clipped by card border -->
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- Hover: lighten border + deepen shadow -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource InnerCardBorderBrush}"/>
                        <Setter Property="Background"  Value="{DynamicResource InnerCardBg}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- accent bar row (zero height unless active) -->
                <RowDefinition Height="76"/>    <!-- icon -->
                <RowDefinition Height="8"/>     <!-- gap -->
                <RowDefinition Height="Auto"/>  <!-- name -->
                <RowDefinition Height="7"/>
                <RowDefinition Height="Auto"/>  <!-- mode badge -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>  <!-- device rows -->
                <RowDefinition Height="*"/>     <!-- spacer -->
                <RowDefinition Height="Auto"/>  <!-- footer: dots + hotkey -->
                <RowDefinition Height="0"/>     <!-- hover action bar (overlaid, Height=0) -->
            </Grid.RowDefinitions>

            <!-- ── Active-profile accent gradient bar (Row 0) ── -->
            <Border Grid.Row="0" Height="2"
                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                    Margin="-14,-20,-14,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#F5820A"     Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ── Profile icon (Row 1) ── -->
            <Border Grid.Row="1"
                    Width="76" Height="76"
                    CornerRadius="17"
                    Background="{DynamicResource IconPreviewBg}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource VSAccentBorder}"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#F5820A" BlurRadius="18"
                                                          ShadowDepth="0" Opacity="0.1"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- Profile icon image — bound to IconPreview (ImageSource) -->
                <Image Source="{Binding IconPreview}"
                       Width="46" Height="46"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- ── Profile name (Row 3) ── -->
            <TextBlock Grid.Row="3"
                       Text="{Binding Name}"
                       FontFamily="Segoe UI"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"
                       MaxWidth="164"/>

            <!-- ── Mode badge (Row 5) ── -->
            <!--
              Use a ContentControl + DataTriggers to swap the badge colour
              based on ModeLabel. All three DataTriggers share one template.
            -->
            <ContentControl Grid.Row="5" HorizontalAlignment="Center">
                <Border x:Name="ModeBadgeBorder" Style="{StaticResource ModeBadge}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ModeBadge}">
                            <!-- Default = Both (orange) -->
                            <Setter Property="Background"   Value="{DynamicResource VSAccentDim}"/>
                            <Setter Property="BorderBrush"  Value="{DynamicResource VSAccentBorder}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModeLabel}" Value="Playback Only">
                                    <Setter Property="Background"  Value="#0F1828"/>
                                    <Setter Property="BorderBrush" Value="#1A3050"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ModeLabel}" Value="Recording Only">
                                    <Setter Property="Background"  Value="#0A2018"/>
                                    <Setter Property="BorderBrush" Value="#143828"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="ModeBadgeText"
                               Text="{Binding ModeLabel}"
                               FontFamily="Segoe UI"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               CharacterSpacing="70"
                               TextOptions.TextFormattingMode="Ideal">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <!-- Default = Both (orange text) -->
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModeLabel}" Value="Playback Only">
                                        <Setter Property="Foreground" Value="{DynamicResource VSBlue}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ModeLabel}" Value="Recording Only">
                                        <Setter Property="Foreground" Value="{DynamicResource VSMint}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </ContentControl>

            <!-- ── Device rows (Row 7) ── -->
            <StackPanel Grid.Row="7" Spacing="3">

                <!-- Playback device -->
                <StackPanel Orientation="Horizontal" Spacing="5"
                            Visibility="{Binding PlaybackVisible}">
                    <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource VSBlue}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedPlaybackDevice.FriendlyName}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryText}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="150"/>
                </StackPanel>

                <!-- Recording device -->
                <StackPanel Orientation="Horizontal" Spacing="5"
                            Visibility="{Binding RecordingVisible}">
                    <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource VSMint}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedRecordingDevice.FriendlyName}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryText}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="150"/>
                </StackPanel>

            </StackPanel>

            <!-- ── Footer: status dots + hotkey chip (Row 9) ── -->
            <StackPanel Grid.Row="9" Orientation="Horizontal" Spacing="5"
                        HorizontalAlignment="Center" Margin="0,6,0,0">

                <!-- Active dot (green glow) -->
                <Ellipse Style="{StaticResource StatusDot}"
                         Fill="{DynamicResource VSGreen}"
                         Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                         VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#2DCA72" BlurRadius="6"
                                          ShadowDepth="0" Opacity="0.5"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Pinned dot (orange) -->
                <Ellipse Style="{StaticResource StatusDot}"
                         Fill="{DynamicResource Accent}"
                         Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"
                         VerticalAlignment="Center"/>

                <!-- Scheduled dot (blue) -->
                <Ellipse Style="{StaticResource StatusDot}"
                         Fill="{DynamicResource VSBlue}"
                         Visibility="{Binding HasSchedules, Converter={StaticResource BoolToVis}}"
                         VerticalAlignment="Center"/>

                <!-- Hotkey chip -->
                <Border Background="{DynamicResource HotkeyBg}"
                        BorderBrush="{DynamicResource HotkeyBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="5,1"
                        Visibility="{Binding IsHotkeySet, Converter={StaticResource BoolToVis}}">
                    <!-- NOTE: Add IsHotkeySet bool property to ProfileCardViewModel:
                         public bool IsHotkeySet => !_model.Hotkey.IsEmpty; -->
                    <TextBlock Text="{Binding HotkeyDisplay}"
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="{DynamicResource MutedText}"/>
                </Border>

            </StackPanel>

            <!--
              ── Hover action strip (Row 10 / overlaid at bottom) ──
              Opacity is animated by EventSetters in code-behind or
              by VisualStateManager. The strip sits at the bottom of
              the card with a gradient fade upward.

              Wire MouseEnter/MouseLeave in the UserControl's code-behind:

                  private void OnMouseEnter(object s, MouseEventArgs e) {
                      var sb = (Storyboard)Resources["ShowActions"];
                      sb.Begin();
                  }
                  private void OnMouseLeave(object s, MouseEventArgs e) {
                      var sb = (Storyboard)Resources["HideActions"];
                      sb.Begin();
                  }
            -->
            <Border Grid.Row="0" Grid.RowSpan="11"
                    x:Name="ActionStrip"
                    VerticalAlignment="Bottom"
                    Margin="-14,0,-14,-14"
                    Opacity="0"
                    IsHitTestVisible="False">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent"  Offset="0"/>
                        <GradientStop Color="#FA0C0C12"    Offset="0.35"/>
                        <GradientStop Color="#FC0C0C12"    Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <!-- 9 action buttons in a WrapPanel -->
                <WrapPanel HorizontalAlignment="Center"
                           Margin="8,8,8,8"
                           Orientation="Horizontal">

                    <!-- No Notification — toggles Silent -->
                    <Button Style="{StaticResource ActBtn}"
                            Margin="1.5"
                            Command="{Binding ToggleSilentCommand}"
                            ToolTip="No Notification Banner">
                        <!-- Bell-slash icon path — replace with your icon Path Data -->
                        <Path Data="M8,2 A5,5 0 0 0 3,7 L3,10 L2,12 L14,12 L13,10 L13,7 A5,5 0 0 0 8,2 Z M6.5,13.5 A1.5,1.5 0 0 0 9.5,13.5 M1,1 L15,15"
                              Stroke="#484868" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <!-- App Trigger — opens AppTriggerDialog -->
                    <Button Style="{StaticResource ActBtn}"
                            Margin="1.5"
                            Command="{Binding OpenAppTriggersCommand}"
                            ToolTip="App Trigger">
                        <Path Data="M7,3 L4,3 A1,1 0 0 0 3,4 L3,12 A1,1 0 0 0 4,13 L12,13 A1,1 0 0 0 13,12 L13,9 M10,2 L14,2 L14,6 M9.5,6.5 L14,2"
                              Stroke="#484868" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <!-- Auto-Switch — toggles TriggerOnConnect -->
                    <Button Style="{StaticResource ActBtn}"
                            Margin="1.5"
                            Command="{Binding ToggleTriggerOnConnectCommand}"
                            ToolTip="Auto-Switch on Connect"
                            Visibility="{Binding TriggerOnConnectVisible}">
                        <Path Data="M14,8 A6,6 0 0 1 3,11.2 M2,8 A6,6 0 0 1 13,4.8 M2,11.5 L2,8 L5,8 M14,4.5 L14,8 L11,8"
                              Stroke="#484868" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <!-- Favorite — toggles IsPinned -->
                    <Button Style="{StaticResource ActBtn}"
                            Margin="1.5"
                            Command="{Binding TogglePinnedCommand}"
                            ToolTip="Favorite">
                        <Path Data="M8,1.5 L10.2,5.8 L15,6.4 L11.5,9.8 L12.4,14.5 L8,12.1 L3.6,14.5 L4.5,9.8 L1,6.4 L5.8,5.8 Z"
                              Fill="#484868" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <!-- Activate — calls ActivateCommand -->
                    <Button Style="{StaticResource ActBtn}"
                            Margin="1.5"
                            Command="{Binding ActivateCommand}"
                            ToolTip="Activate Profile">
                        <Path Data="M8,2.5 A5.5,5.5 0 0 1 8,13.5 A5.5,5.5 0 0 1 8,2.5 Z M5.5,8 L7.5,10.2 L11,6"
                              Stroke="#484868" StrokeThickness="1.5"
                              Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <!-- Clone — calls CloneCommand -->
                    <Button Style="{StaticResource ActBtn}"
                            Margin="1.5"
                            Command="{Binding CloneCommand}"
                            ToolTip="Clone Profile">
                        <Path Data="M5.5,5.5 L13.5,5.5 L13.5,13.5 L5.5,13.5 Z M3.5,10.5 L3.5,3.5 A1,1 0 0 1 4.5,2.5 L11.5,2.5"
                              Stroke="#484868" StrokeThickness="1.5"
                              Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <!-- Scheduler — opens ScheduleWizardDialog via AddScheduleCommand -->
                    <Button Style="{StaticResource ActBtn}"
                            Margin="1.5"
                            Command="{Binding AddScheduleCommand}"
                            ToolTip="Scheduler">
                        <Path Data="M8,2.5 A5.5,5.5 0 0 1 8,13.5 A5.5,5.5 0 0 1 8,2.5 Z M8,5 L8,8.5 L10.5,10.2"
                              Stroke="#484868" StrokeThickness="1.5"
                              Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <!-- Sound Switch — opens ConfigureSoundCommand dialog -->
                    <Button Style="{StaticResource ActBtn}"
                            Margin="1.5"
                            Command="{Binding ConfigureSoundCommand}"
                            ToolTip="Switch Sound">
                        <Path Data="M5,5.5 L7,5.5 L11,2 L11,14 L7,10.5 L5,10.5 Z M11,6.8 A2,2 0 0 1 11,9.2"
                              Stroke="#484868" StrokeThickness="1.5"
                              Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <!-- Delete — calls DeleteCommand (already shows confirm dialog) -->
                    <Button Style="{StaticResource ActBtn}"
                            Margin="1.5"
                            Command="{Binding DeleteCommand}"
                            ToolTip="Delete Profile">
                        <Path Data="M2,4 L14,4 M5.5,4 L5.5,2.5 L10.5,2.5 L10.5,4 M3.5,4 L4.3,13.5 L11.7,13.5 L12.5,4"
                              Stroke="#E05555" StrokeThickness="1.5"
                              Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                </WrapPanel>
            </Border>

            <!-- Validation warning overlay (top-right corner badge) -->
            <Border Grid.Row="0" Grid.RowSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="18" Height="18" CornerRadius="9"
                    Background="{DynamicResource WarningBadgeBg}"
                    Margin="0,-6,-6,0"
                    Visibility="{Binding HasValidationWarning, Converter={StaticResource BoolToVis}}"
                    ToolTip="{Binding ValidationWarning}">
                <TextBlock Text="!" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource WarningBadgeText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

        </Grid>
    </Border>

</UserControl>

<!--
══════════════════════════════════════════════════════════════════════
  ProfileCardView.xaml.cs — code-behind additions
══════════════════════════════════════════════════════════════════════

  1. Add hover animations for ActionStrip:

    public ProfileCardView()
    {
        InitializeComponent();
        MouseEnter += (_, _) => AnimateActions(1);
        MouseLeave += (_, _) => AnimateActions(0);
        MouseLeftButtonUp += OnCardClicked;
    }

    private void AnimateActions(double to)
    {
        var anim = new DoubleAnimation(to, TimeSpan.FromMilliseconds(150));
        anim.EasingFunction = new CubicEase { EasingMode = EasingMode.EaseOut };
        ActionStrip.BeginAnimation(OpacityProperty, anim);
        ActionStrip.IsHitTestVisible = to > 0;
    }

  2. Handle card click (opens ProfileDetailModal — see SettingsWindow notes):

    private void OnCardClicked(object sender, MouseButtonEventArgs e)
    {
        // Press animation
        var scaleAnim = new DoubleAnimationUsingKeyFrames();
        scaleAnim.KeyFrames.Add(new EasingDoubleKeyFrame(1.0,   KeyTime.FromTimeSpan(TimeSpan.Zero)));
        scaleAnim.KeyFrames.Add(new EasingDoubleKeyFrame(0.93,  KeyTime.FromTimeSpan(TimeSpan.FromMilliseconds(80))));
        scaleAnim.KeyFrames.Add(new EasingDoubleKeyFrame(1.0,   KeyTime.FromTimeSpan(TimeSpan.FromMilliseconds(220))));
        var st = new ScaleTransform(1, 1);
        CardBorder.RenderTransformOrigin = new Point(0.5, 0.5);
        CardBorder.RenderTransform = st;
        st.BeginAnimation(ScaleTransform.ScaleXProperty, scaleAnim);
        st.BeginAnimation(ScaleTransform.ScaleYProperty, scaleAnim);

        // Expand profile (open detail modal) after brief delay
        Dispatcher.InvokeAsync(() => {
            // raise an event or call a method on SettingsWindow to open the modal
            RaiseEvent(new RoutedEventArgs(CardExpandedEvent));
        }, System.Windows.Threading.DispatcherPriority.Background);
    }

    public static readonly RoutedEvent CardExpandedEvent =
        EventManager.RegisterRoutedEvent("CardExpanded", RoutingStrategy.Bubble,
            typeof(RoutedEventHandler), typeof(ProfileCardView));

    public event RoutedEventHandler CardExpanded
    {
        add { AddHandler(CardExpandedEvent, value); }
        remove { RemoveHandler(CardExpandedEvent, value); }
    }

  3. Add ToggleSilentCommand, TogglePinnedCommand, ToggleTriggerOnConnectCommand,
     IsHotkeySet to ProfileCardViewModel:

    public ICommand ToggleSilentCommand         => new RelayCommand(() => Silent = !Silent);
    public ICommand TogglePinnedCommand         => new RelayCommand(() => IsPinned = !IsPinned);
    public ICommand ToggleTriggerOnConnectCommand => new RelayCommand(() => TriggerOnConnect = !TriggerOnConnect);
    public bool IsHotkeySet => !_model.Hotkey.IsEmpty;
══════════════════════════════════════════════════════════════════════
