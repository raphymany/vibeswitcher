<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBg"              Color="#F3F3F3"/>
    <SolidColorBrush x:Key="CardBg"             Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InnerCardBg"        Color="#F8F9FA"/>
    <SolidColorBrush x:Key="InnerCardBorderBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="CardBorderBrush"    Color="#C0C0C0"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryText"        Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SecondaryText"      Color="#555555"/>
    <SolidColorBrush x:Key="TertiaryText"       Color="#777777"/>
    <SolidColorBrush x:Key="MutedText"          Color="#888888"/>
    <SolidColorBrush x:Key="SubtleText"         Color="#999999"/>
    <SolidColorBrush x:Key="DisabledText"       Color="#AAAAAA"/>
    <SolidColorBrush x:Key="ReadOnlyText"       Color="#666666"/>
    <SolidColorBrush x:Key="SectionLabelText"   Color="#444444"/>

    <!-- Accent (Papaya Orange) -->
    <SolidColorBrush x:Key="Accent"             Color="#FF8000"/>
    <SolidColorBrush x:Key="AccentHover"        Color="#E07200"/>
    <SolidColorBrush x:Key="AccentPressed"      Color="#CC6600"/>
    <Color           x:Key="AccentColor"               >#FF8000</Color>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBg"            Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorder"        Color="#BBBBBB"/>
    <SolidColorBrush x:Key="InputHoverBorder"   Color="#888888"/>

    <!-- Hover / Selection -->
    <SolidColorBrush x:Key="HoverBg"            Color="#FFF4E8"/>
    <SolidColorBrush x:Key="SelectedBg"         Color="#FFE8CC"/>
    <SolidColorBrush x:Key="PressedBg"          Color="#FFD9AA"/>
    <SolidColorBrush x:Key="ReadOnlyBg"         Color="#F7F7F7"/>

    <!-- Info badge (ⓘ) -->
    <SolidColorBrush x:Key="InfoBadgeBg"        Color="#FFF0E0"/>
    <SolidColorBrush x:Key="InfoBadgeText"      Color="#FF8000"/>

    <!-- Name suggestion chips -->
    <SolidColorBrush x:Key="ChipBg"             Color="#FFF4E8"/>
    <SolidColorBrush x:Key="ChipBorder"         Color="#FFB366"/>
    <SolidColorBrush x:Key="ChipText"           Color="#CC6600"/>
    <SolidColorBrush x:Key="ChipHoverBg"        Color="#FFE8CC"/>

    <!-- Separators -->
    <SolidColorBrush x:Key="SeparatorBrush"     Color="#AAAAAA"/>
    <SolidColorBrush x:Key="CardSeparator"      Color="#D4D4D4"/>

    <!-- Error / Danger -->
    <SolidColorBrush x:Key="ErrorText"          Color="#C00000"/>
    <SolidColorBrush x:Key="ErrorBg"            Color="#FFF0F0"/>
    <SolidColorBrush x:Key="ErrorBorder"        Color="#FFBBBB"/>
    <SolidColorBrush x:Key="ErrorIconBg"        Color="#FFE8E8"/>
    <SolidColorBrush x:Key="DangerBtnBg"        Color="#C00020"/>
    <SolidColorBrush x:Key="DangerBtnBorder"    Color="#A00018"/>
    <SolidColorBrush x:Key="DangerBtnHover"     Color="#A80018"/>
    <SolidColorBrush x:Key="DangerBtnPressed"   Color="#900015"/>

    <!-- Status dots -->
    <SolidColorBrush x:Key="SuccessDot"         Color="#2DB55D"/>
    <SolidColorBrush x:Key="ErrorDot"           Color="#CC3333"/>

    <!-- Success badge -->
    <SolidColorBrush x:Key="SuccessBadgeBg"     Color="#E8F5E9"/>
    <SolidColorBrush x:Key="SuccessBadgeText"   Color="#2E7D32"/>

    <!-- Primary (blue) badge -->
    <SolidColorBrush x:Key="PrimaryBadgeBg"     Color="#E3F2FD"/>
    <SolidColorBrush x:Key="PrimaryBadgeText"   Color="#1565C0"/>

    <!-- Warning (amber) badge -->
    <SolidColorBrush x:Key="WarningBadgeBg"     Color="#FFF8E1"/>
    <SolidColorBrush x:Key="WarningBadgeText"   Color="#E65C00"/>

    <!-- Warning -->
    <SolidColorBrush x:Key="WarningBg"          Color="#FFF8E0"/>
    <SolidColorBrush x:Key="WarningBorder"       Color="#FFE082"/>
    <SolidColorBrush x:Key="WarningText"         Color="#7A5800"/>

    <!-- Toggle switch (Color resource for animation) -->
    <Color           x:Key="ToggleOffColor"            >#CCCCCC</Color>

    <!-- Icon preview background -->
    <SolidColorBrush x:Key="IconPreviewBg"      Color="#4A4A4A"/>

    <!-- Tray context menu -->
    <SolidColorBrush x:Key="MenuBg"             Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuBorder"         Color="#BBBBBB"/>
    <SolidColorBrush x:Key="MenuItemHoverBg"    Color="#FFF4E8"/>
    <SolidColorBrush x:Key="MenuItemSelHoverBg" Color="#FFE8CC"/>

    <!-- Tooltip -->
    <SolidColorBrush x:Key="TooltipBg"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TooltipBorder"      Color="#BBBBBB"/>

    <!-- HelpDialog footer -->
    <SolidColorBrush x:Key="FooterBg"           Color="#EBEBEB"/>
    <SolidColorBrush x:Key="FooterBorder"       Color="#BBBBBB"/>

    <!-- Hotkey display box -->
    <SolidColorBrush x:Key="HotkeyBg"           Color="#F5F5F5"/>
    <SolidColorBrush x:Key="HotkeyBorder"       Color="#AAAAAA"/>

    <!-- About window section cards -->
    <SolidColorBrush x:Key="AboutSectionBg"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AboutSectionBorder" Color="#C8C8C8"/>

    <!-- Session log -->
    <SolidColorBrush x:Key="SessionListBg"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SessionListBorder"  Color="#BBBBBB"/>
    <SolidColorBrush x:Key="SessionItemHoverBg" Color="#F8F8F8"/>
    <SolidColorBrush x:Key="SessionSeparator"   Color="#D4D4D4"/>
    <SolidColorBrush x:Key="ErrorCodeText"      Color="#C00000"/>
    <SolidColorBrush x:Key="SessionMsgText"     Color="#333333"/>

    <!-- Save flash overlay -->
    <SolidColorBrush x:Key="SaveFlashBg"        Color="#E8F5E9"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollBarTrack"         Color="#EBEBEB"/>
    <SolidColorBrush x:Key="ScrollBarThumb"         Color="#C8C8C8"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover"    Color="#A0A0A0"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressed"  Color="#808080"/>

    <!-- Icon gallery -->
    <SolidColorBrush x:Key="GalleryItemBg"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GalleryItemBorder"  Color="#C0C0C0"/>
    <SolidColorBrush x:Key="ColorPillBg"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorPillBorder"    Color="#BBBBBB"/>
    <SolidColorBrush x:Key="ColorPillText"      Color="#333333"/>

    <!-- NEW VS keys — light equivalents -->
    <SolidColorBrush x:Key="VSTitleBarBg"       Color="#E8E8E8"/>
    <SolidColorBrush x:Key="VSNavBg"            Color="#F0F0F0"/>
    <SolidColorBrush x:Key="VSNavBorder"        Color="#D0D0D0"/>
    <SolidColorBrush x:Key="VSSurface2"         Color="#F5F5F5"/>
    <SolidColorBrush x:Key="VSSurface3"         Color="#EBEBEB"/>
    <SolidColorBrush x:Key="VSModalBg"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="VSModalBorder"      Color="#FFD0A0"/>
    <SolidColorBrush x:Key="VSAccentDim"        Color="#FFF0E0"/>
    <SolidColorBrush x:Key="VSAccentBorder"     Color="#FFB366"/>
    <SolidColorBrush x:Key="VSAccentGlow"       Color="#FFF8F0"/>
    <SolidColorBrush x:Key="VSGreen"            Color="#2DB55D"/>
    <SolidColorBrush x:Key="VSBlue"             Color="#1565C0"/>
    <SolidColorBrush x:Key="VSMint"             Color="#2E7D32"/>
    <SolidColorBrush x:Key="VSPurple"           Color="#6A1B9A"/>
    <SolidColorBrush x:Key="VSActBg"            Color="#F5F5F5"/>
    <SolidColorBrush x:Key="VSActBorder"        Color="#D0D0D0"/>
    <SolidColorBrush x:Key="VSActIcon"          Color="#888888"/>
    <SolidColorBrush x:Key="VSActHoverBg"       Color="#EBEBEB"/>
    <SolidColorBrush x:Key="VSActHoverBorder"   Color="#BBBBBB"/>
    <SolidColorBrush x:Key="VSActHoverIcon"     Color="#444444"/>

</ResourceDictionary>
