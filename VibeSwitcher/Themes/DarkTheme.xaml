<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Backgrounds ─────────────────────────────────────────── -->
    <SolidColorBrush x:Key="AppBg"                Color="#0D0D12"/>
    <SolidColorBrush x:Key="CardBg"               Color="#16161E"/>
    <SolidColorBrush x:Key="InnerCardBg"          Color="#1E1E28"/>
    <SolidColorBrush x:Key="InnerCardBorderBrush" Color="#363650"/>
    <SolidColorBrush x:Key="CardBorderBrush"      Color="#222234"/>

    <!-- NEW — for title bar, nav bar, modal -->
    <SolidColorBrush x:Key="VSTitleBarBg"         Color="#09090E"/>
    <SolidColorBrush x:Key="VSNavBg"              Color="#10101A"/>
    <SolidColorBrush x:Key="VSNavBorder"          Color="#1C1C2C"/>
    <SolidColorBrush x:Key="VSModalBg"            Color="#17171F"/>

    <!-- ── Redesign content surfaces / text / borders ───────────── -->
    <SolidColorBrush x:Key="VSLabel"              Color="#A0A0C0"/>
    <SolidColorBrush x:Key="VSSurface"            Color="#1A1A28"/>
    <SolidColorBrush x:Key="VSSurfaceHover"       Color="#222236"/>
    <SolidColorBrush x:Key="VSInsetBg"            Color="#0D0E1A"/>
    <SolidColorBrush x:Key="VSBorder"             Color="#2C2C42"/>
    <SolidColorBrush x:Key="VSBorderStrong"       Color="#484860"/>
    <SolidColorBrush x:Key="VSStripOverlay"       Color="#47000000"/>

    <!-- Glass action buttons (translucent fill that must invert for light) -->
    <SolidColorBrush x:Key="VSGlassFill"          Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="VSGlassBorder"        Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="VSHairline"           Color="#0EFFFFFF"/>

    <!-- Schedule chip (blue) -->
    <SolidColorBrush x:Key="VSScheduleBg"          Color="#0D122A"/>
    <SolidColorBrush x:Key="VSScheduleBorder"      Color="#1E2844"/>
    <SolidColorBrush x:Key="VSScheduleHoverBg"     Color="#152040"/>
    <SolidColorBrush x:Key="VSScheduleHoverBorder" Color="#2E4A78"/>

    <!-- Sound chip (green) -->
    <SolidColorBrush x:Key="VSSoundBg"             Color="#0B1E14"/>
    <SolidColorBrush x:Key="VSSoundBorder"         Color="#1B3325"/>
    <SolidColorBrush x:Key="VSSoundHoverBg"        Color="#0F2A1E"/>
    <SolidColorBrush x:Key="VSSoundHoverBorder"    Color="#2A5040"/>

    <!-- Modal scrim + active-card gradient stops -->
    <SolidColorBrush x:Key="VSScrim"               Color="#D405050A"/>
    <Color           x:Key="VSActiveGradTop"              >#1C1610</Color>
    <Color           x:Key="VSActiveGradBot"              >#16161E</Color>

    <!-- ── Text ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="PrimaryText"          Color="#E4E4EF"/>
    <SolidColorBrush x:Key="SecondaryText"        Color="#7878A0"/>
    <SolidColorBrush x:Key="TertiaryText"         Color="#7878A0"/>
    <SolidColorBrush x:Key="DisabledText"         Color="#38384E"/>
    <SolidColorBrush x:Key="ReadOnlyText"         Color="#7878A0"/>
    <SolidColorBrush x:Key="SectionLabelText"     Color="#38384E"/>

    <!-- ── Accent — orange ─────────────────────────────────────── -->
    <SolidColorBrush x:Key="Accent"               Color="#F5820A"/>
    <SolidColorBrush x:Key="AccentHover"          Color="#E07409"/>
    <SolidColorBrush x:Key="AccentPressed"        Color="#C96500"/>
    <Color           x:Key="AccentColor"                  >#F5820A</Color>

    <!-- ── Status colors ───────────────────────────────────────── -->
    <SolidColorBrush x:Key="VSGreen"              Color="#2DCA72"/>
    <SolidColorBrush x:Key="VSBlue"               Color="#4AA8FF"/>
    <SolidColorBrush x:Key="VSMint"               Color="#30D278"/>

    <!-- ── Inputs ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="InputBg"              Color="#101018"/>
    <SolidColorBrush x:Key="InputBorder"          Color="#1E1E30"/>
    <SolidColorBrush x:Key="InputHoverBorder"     Color="#363650"/>

    <!-- ── Hover / Selection ───────────────────────────────────── -->
    <SolidColorBrush x:Key="HoverBg"              Color="#1C1C2A"/>
    <SolidColorBrush x:Key="SelectedBg"           Color="#231808"/>
    <SolidColorBrush x:Key="PressedBg"            Color="#181208"/>
    <SolidColorBrush x:Key="ReadOnlyBg"           Color="#101018"/>

    <!-- ── Info / chip ─────────────────────────────────────────── -->
    <SolidColorBrush x:Key="InfoBadgeBg"          Color="#1F1308"/>
    <SolidColorBrush x:Key="InfoBadgeText"        Color="#F5820A"/>
    <SolidColorBrush x:Key="ChipBg"               Color="#1F1308"/>
    <SolidColorBrush x:Key="ChipBorder"           Color="#3D2908"/>
    <SolidColorBrush x:Key="ChipText"             Color="#F5820A"/>
    <SolidColorBrush x:Key="ChipHoverBg"          Color="#261A08"/>

    <!-- ── Separators ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SeparatorBrush"       Color="#1E1E2C"/>
    <SolidColorBrush x:Key="CardSeparator"        Color="#1A1A28"/>

    <!-- ── Error / Danger ──────────────────────────────────────── -->
    <SolidColorBrush x:Key="ErrorText"            Color="#E05555"/>
    <SolidColorBrush x:Key="ErrorBg"              Color="#1C0E0E"/>
    <SolidColorBrush x:Key="ErrorBorder"          Color="#3A1818"/>
    <SolidColorBrush x:Key="ErrorIconBg"          Color="#221212"/>
    <SolidColorBrush x:Key="DangerBtnBg"          Color="#1C0E0E"/>
    <SolidColorBrush x:Key="DangerBtnBorder"      Color="#3A1818"/>
    <SolidColorBrush x:Key="DangerBtnHover"       Color="#2A1212"/>
    <SolidColorBrush x:Key="DangerBtnPressed"     Color="#3A1818"/>

    <!-- ── Status dots ─────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SuccessDot"           Color="#2DCA72"/>
    <SolidColorBrush x:Key="ErrorDot"             Color="#E05555"/>

    <!-- ── Badges ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SuccessBadgeBg"       Color="#0C2018"/>
    <SolidColorBrush x:Key="SuccessBadgeText"     Color="#2DCA72"/>
    <SolidColorBrush x:Key="WarningBadgeBg"       Color="#1F1308"/>
    <SolidColorBrush x:Key="WarningBadgeText"     Color="#F5820A"/>

    <!-- ── Warning ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="WarningBg"            Color="#1A1408"/>
    <SolidColorBrush x:Key="WarningBorder"        Color="#3D2908"/>
    <SolidColorBrush x:Key="WarningText"          Color="#F5820A"/>

    <!-- ── Toggle switch ───────────────────────────────────────── -->
    <Color           x:Key="ToggleOffColor"               >#252540</Color>

    <!-- ── Icon preview ────────────────────────────────────────── -->

    <!-- ── Tray / Menu ─────────────────────────────────────────── -->
    <SolidColorBrush x:Key="MenuBg"               Color="#17171F"/>
    <SolidColorBrush x:Key="MenuBorder"           Color="#282840"/>
    <SolidColorBrush x:Key="MenuItemHoverBg"      Color="#1C1C2A"/>
    <SolidColorBrush x:Key="MenuItemSelHoverBg"   Color="#231808"/>

    <!-- ── Tooltip ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TooltipBg"            Color="#22223A"/>
    <SolidColorBrush x:Key="TooltipBorder"        Color="#363650"/>


    <!-- ── Hotkey chip ─────────────────────────────────────────── -->
    <SolidColorBrush x:Key="HotkeyBg"             Color="#131320"/>

    <!-- ── About window ────────────────────────────────────────── -->

    <!-- ── Session log ─────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SessionListBg"        Color="#101018"/>
    <SolidColorBrush x:Key="SessionListBorder"    Color="#1E1E30"/>
    <SolidColorBrush x:Key="SessionItemHoverBg"   Color="#16161E"/>
    <SolidColorBrush x:Key="SessionSeparator"     Color="#1A1A28"/>
    <SolidColorBrush x:Key="ErrorCodeText"        Color="#E05555"/>
    <SolidColorBrush x:Key="SessionMsgText"       Color="#7878A0"/>

    <!-- ── Save flash ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SaveFlashBg"          Color="#0C2018"/>

    <!-- ── Scrollbar ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ScrollBarTrack"       Color="#0D0D12"/>
    <SolidColorBrush x:Key="ScrollBarThumb"       Color="#1E1E30"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover"  Color="#363650"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressed" Color="#484868"/>

    <!-- ── Icon gallery ────────────────────────────────────────── -->
    <SolidColorBrush x:Key="GalleryItemBg"        Color="#1C1C2A"/>
    <SolidColorBrush x:Key="GalleryItemBorder"    Color="#282838"/>
    <SolidColorBrush x:Key="ColorPillBg"          Color="#16161E"/>
    <SolidColorBrush x:Key="ColorPillBorder"      Color="#282840"/>
    <SolidColorBrush x:Key="ColorPillText"        Color="#7878A0"/>

</ResourceDictionary>
