<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBg"              Color="#1E1E1E"/>
    <SolidColorBrush x:Key="CardBg"             Color="#2D2D2D"/>
    <SolidColorBrush x:Key="InnerCardBg"        Color="#252525"/>
    <SolidColorBrush x:Key="InnerCardBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="CardBorderBrush"    Color="#3D3D3D"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryText"        Color="#F0F0F0"/>
    <SolidColorBrush x:Key="SecondaryText"      Color="#C8C8C8"/>
    <SolidColorBrush x:Key="TertiaryText"       Color="#AAAAAA"/>
    <SolidColorBrush x:Key="MutedText"          Color="#888888"/>
    <SolidColorBrush x:Key="SubtleText"         Color="#666666"/>
    <SolidColorBrush x:Key="DisabledText"       Color="#606060"/>
    <SolidColorBrush x:Key="ReadOnlyText"       Color="#888888"/>
    <SolidColorBrush x:Key="SectionLabelText"   Color="#BBBBBB"/>

    <!-- Accent (Papaya Orange — same in both themes) -->
    <SolidColorBrush x:Key="Accent"             Color="#FF8000"/>
    <SolidColorBrush x:Key="AccentHover"        Color="#FF9520"/>
    <SolidColorBrush x:Key="AccentPressed"      Color="#E07200"/>
    <Color           x:Key="AccentColor"               >#FF8000</Color>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBg"            Color="#383838"/>
    <SolidColorBrush x:Key="InputBorder"        Color="#4A4A4A"/>
    <SolidColorBrush x:Key="InputHoverBorder"   Color="#666666"/>

    <!-- Hover / Selection -->
    <SolidColorBrush x:Key="HoverBg"            Color="#3D2200"/>
    <SolidColorBrush x:Key="SelectedBg"         Color="#4A2A00"/>
    <SolidColorBrush x:Key="PressedBg"          Color="#2D1800"/>
    <SolidColorBrush x:Key="ReadOnlyBg"         Color="#2A2A2A"/>

    <!-- Info badge (ⓘ) -->
    <SolidColorBrush x:Key="InfoBadgeBg"        Color="#3D2000"/>
    <SolidColorBrush x:Key="InfoBadgeText"      Color="#FFA040"/>

    <!-- Name suggestion chips -->
    <SolidColorBrush x:Key="ChipBg"             Color="#3D2800"/>
    <SolidColorBrush x:Key="ChipBorder"         Color="#7A4800"/>
    <SolidColorBrush x:Key="ChipText"           Color="#FFA040"/>
    <SolidColorBrush x:Key="ChipHoverBg"        Color="#4A3000"/>

    <!-- Separators -->
    <SolidColorBrush x:Key="SeparatorBrush"     Color="#505050"/>
    <SolidColorBrush x:Key="CardSeparator"      Color="#3A3A3A"/>

    <!-- Error / Danger -->
    <SolidColorBrush x:Key="ErrorText"          Color="#FF6B6B"/>
    <SolidColorBrush x:Key="ErrorBg"            Color="#3D1A1A"/>
    <SolidColorBrush x:Key="ErrorBorder"        Color="#6B2020"/>
    <SolidColorBrush x:Key="ErrorIconBg"        Color="#4A1A1A"/>
    <SolidColorBrush x:Key="DangerBtnBg"        Color="#CC2233"/>
    <SolidColorBrush x:Key="DangerBtnBorder"    Color="#AA1122"/>
    <SolidColorBrush x:Key="DangerBtnHover"     Color="#DD3344"/>
    <SolidColorBrush x:Key="DangerBtnPressed"   Color="#BB2233"/>

    <!-- Status dots -->
    <SolidColorBrush x:Key="SuccessDot"         Color="#4CAF50"/>
    <SolidColorBrush x:Key="ErrorDot"           Color="#FF6B6B"/>

    <!-- Warning -->
    <SolidColorBrush x:Key="WarningBg"          Color="#3D3520"/>

    <!-- Toggle switch (Color resource for animation) -->
    <SolidColorBrush x:Key="ToggleInactiveBg"   Color="#555555"/>
    <Color           x:Key="ToggleOffColor"            >#555555</Color>

    <!-- Icon preview background -->
    <SolidColorBrush x:Key="IconPreviewBg"      Color="#3D3D3D"/>

    <!-- Tray context menu -->
    <SolidColorBrush x:Key="MenuBg"             Color="#2D2D2D"/>
    <SolidColorBrush x:Key="MenuBorder"         Color="#4A4A4A"/>
    <SolidColorBrush x:Key="MenuItemHoverBg"    Color="#3D2200"/>
    <SolidColorBrush x:Key="MenuItemSelHoverBg" Color="#4A2A00"/>

    <!-- Tooltip -->
    <SolidColorBrush x:Key="TooltipBg"          Color="#2D2D2D"/>
    <SolidColorBrush x:Key="TooltipBorder"      Color="#4A4A4A"/>

    <!-- HelpDialog footer -->
    <SolidColorBrush x:Key="FooterBg"           Color="#252525"/>
    <SolidColorBrush x:Key="FooterBorder"       Color="#3A3A3A"/>

    <!-- Hotkey display box -->
    <SolidColorBrush x:Key="HotkeyBg"           Color="#333333"/>
    <SolidColorBrush x:Key="HotkeyBorder"       Color="#505050"/>

    <!-- About window section cards -->
    <SolidColorBrush x:Key="AboutSectionBg"     Color="#383838"/>
    <SolidColorBrush x:Key="AboutSectionBorder" Color="#4A4A4A"/>

    <!-- Session log -->
    <SolidColorBrush x:Key="SessionListBg"      Color="#383838"/>
    <SolidColorBrush x:Key="SessionListBorder"  Color="#4A4A4A"/>
    <SolidColorBrush x:Key="SessionItemHoverBg" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="SessionSeparator"   Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ErrorCodeText"      Color="#FF6B6B"/>
    <SolidColorBrush x:Key="SessionMsgText"     Color="#CCCCCC"/>

    <!-- Save flash overlay -->
    <SolidColorBrush x:Key="SaveFlashBg"        Color="#1A3D2A"/>

    <!-- Icon gallery -->
    <SolidColorBrush x:Key="GalleryItemBg"      Color="#383838"/>
    <SolidColorBrush x:Key="GalleryItemBorder"  Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ColorPillBg"        Color="#383838"/>
    <SolidColorBrush x:Key="ColorPillBorder"    Color="#555555"/>
    <SolidColorBrush x:Key="ColorPillText"      Color="#CCCCCC"/>

</ResourceDictionary>
