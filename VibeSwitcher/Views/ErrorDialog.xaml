<Window x:Class="VibeSwitcher.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        ShowInTaskbar="False">

    <Window.Resources>
        <ControlTemplate x:Key="RoundedBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Template"        Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="24,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#0078D4"/>
            <Setter Property="BorderBrush"     Value="#0060AA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#0060AA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Template"        Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#F0F0F0"/>
                    <Setter Property="BorderBrush" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,24">

        <!-- Icon + title row -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="36" Height="36" CornerRadius="18"
                    Background="#FFE8E8" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="✕" FontSize="16" FontWeight="Bold"
                           Foreground="#C00000"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                           Foreground="#1A1A1A"/>
                <TextBlock x:Name="CodeText" FontSize="10" Foreground="#888888"
                           Margin="0,1,0,0" FontFamily="Consolas"/>
            </StackPanel>
        </StackPanel>

        <!-- Selectable message -->
        <TextBox x:Name="MessageText"
                 IsReadOnly="True" TextWrapping="Wrap"
                 Background="Transparent" BorderThickness="0"
                 FontSize="12" Foreground="#444444"
                 Margin="0,0,0,20" MaxHeight="200"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Open Log File" Style="{StaticResource SecondaryBtn}"
                    Margin="0,0,10,0" Click="OpenLog_Click"/>
            <Button Content="OK" Style="{StaticResource PrimaryBtn}"
                    IsDefault="True" IsCancel="True" Click="OK_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
