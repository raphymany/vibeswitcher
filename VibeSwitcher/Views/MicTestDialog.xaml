<Window x:Class="VibeSwitcher.Views.MicTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microphone Test"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <StackPanel Margin="24,20,24,24">

        <TextBlock x:Name="DeviceNameText"
                   FontSize="12" Foreground="#777777"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBlock Text="Speak into your microphone"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="#1A1A1A" Margin="0,0,0,12"/>

        <ProgressBar x:Name="LevelBar"
                     Minimum="0" Maximum="1" Value="0"
                     Height="14" Margin="0,0,0,8"/>

        <Grid Margin="0,0,0,16">
            <TextBlock x:Name="LevelText"
                       Text="0%" FontSize="12" Foreground="#555555"
                       HorizontalAlignment="Left"/>
            <TextBlock x:Name="PeakText"
                       Text="Peak: 0%" FontSize="12" Foreground="#777777"
                       HorizontalAlignment="Right"/>
        </Grid>

        <Grid>
            <TextBlock x:Name="CountdownText"
                       Text="Closing in 5 s" FontSize="11" Foreground="#AAAAAA"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button Content="Close"
                    Style="{StaticResource ActionButton}"
                    Width="90" HorizontalAlignment="Right"
                    Click="Close_Click"/>
        </Grid>

    </StackPanel>
</Window>
