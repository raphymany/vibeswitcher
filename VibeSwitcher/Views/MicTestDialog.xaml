<Window x:Class="VibeSwitcher.Views.MicTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="Microphone Test"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <TextBlock x:Name="DeviceNameText"
                       FontSize="12" Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,0,0,14"/>

            <TextBlock Text="Speak into your microphone"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,12"/>

            <ProgressBar x:Name="LevelBar"
                         Minimum="0" Maximum="1" Value="0"
                         Height="14" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,16">
                <TextBlock x:Name="LevelText"
                           Text="0%" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="PeakText"
                           Text="Peak: 0%" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <Grid>
                <TextBlock x:Name="CountdownText"
                           Text="Closing in 5 s" FontSize="11" Foreground="{DynamicResource DisabledText}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Button Content="Close"
                        Style="{StaticResource ActionButton}"
                        Width="90" HorizontalAlignment="Right"
                        Click="Close_Click"/>
            </Grid>

        </StackPanel>
    </Grid>
</Window>
