<Window x:Class="VibeSwitcher.Views.MicTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        BorderBrush="{DynamicResource Accent}" BorderThickness="1"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Accent}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IcoMic}" Width="18" Height="18" Stretch="Uniform"
                          Fill="Transparent" Stroke="White" StrokeThickness="1.5"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Microphone Test" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock x:Name="DeviceNameText" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap" MaxWidth="280" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="SpeakPrompt"
                       Text="Speak into your microphone"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,12"/>

            <TextBlock x:Name="CaptureError"
                       Text="Could not open the microphone. Check that it is not in use by another app."
                       FontSize="12" Foreground="{DynamicResource ErrorText}"
                       TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="Collapsed"/>

            <ProgressBar x:Name="LevelBar"
                         Minimum="0" Maximum="1" Value="0"
                         Height="14" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,16">
                <TextBlock x:Name="LevelText"
                           Text="0%" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="PeakText"
                           Text="Peak: 0%" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <Grid>
                <TextBlock x:Name="CountdownText"
                           Text="Closing in 5 s" FontSize="11" Foreground="{DynamicResource DisabledText}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Button Content="Close"
                        Style="{StaticResource ActionButton}"
                        Width="90" HorizontalAlignment="Right"
                        Click="Close_Click"/>
            </Grid>

        </StackPanel>
    </Grid>
</Window>
