<Window x:Class="VibeSwitcher.Views.AppTriggerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="500" SizeToContent="Height" MaxHeight="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="{DynamicResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Viewbox Width="11" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0">
                        <Polygon Points="0,0 11,6.5 0,13" Fill="Black"/>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="App Launch Triggers"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="Switch to this profile automatically when a linked app opens"
                               FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Description -->
            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource PrimaryText}" LineHeight="18"
                       Margin="0,0,0,6">
                When a linked app launches, VibeSwitcher switches to this profile — but only if you're not already on it. Switching back manually at any time is fine; closing the app does nothing.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="11" LineHeight="17"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,16">
                ⚠ Apps that keep a background process after closing (e.g. Spotify, Discord) must be fully ended in Task Manager and relaunched to trigger a switch.
            </TextBlock>

            <!-- Linked apps section -->
            <TextBlock Text="LINKED APPS" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/>

            <Border x:Name="LinkedBorder"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,0,16" Padding="0,4">
                <StackPanel>
                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyLabel"
                               Text="No apps linked yet. Add one from the list below."
                               FontSize="12" Foreground="{DynamicResource SecondaryText}"
                               Margin="12,8" HorizontalAlignment="Center"/>
                    <!-- Populated rows — built in code-behind -->
                    <StackPanel x:Name="LinkedPanel"/>
                </StackPanel>
            </Border>

            <!-- Apps section label -->
            <TextBlock Text="APPS" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/>

            <!-- Search box -->
            <Border BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,0,6" Padding="8,6">
                <Grid>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Search apps..."
                               FontSize="12" Foreground="{DynamicResource SecondaryText}"
                               IsHitTestVisible="False" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox"
                             FontSize="12" Background="Transparent" BorderThickness="0"
                             Padding="0"
                             Foreground="{DynamicResource PrimaryText}"
                             VerticalAlignment="Center"
                             GotFocus="SearchBox_GotFocus"
                             LostFocus="SearchBox_LostFocus"
                             TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Border>

            <!-- Filter chips -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border x:Name="ChipAll" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0"
                        Cursor="Hand" BorderBrush="{DynamicResource CardBorderBrush}"
                        MouseLeftButtonUp="FilterChip_Click" Tag="All">
                    <TextBlock Text="All" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}"/>
                </Border>
                <Border x:Name="ChipRunning" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0"
                        Cursor="Hand" BorderBrush="{DynamicResource CardBorderBrush}"
                        MouseLeftButtonUp="FilterChip_Click" Tag="Running">
                    <TextBlock Text="Running" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}"/>
                </Border>
                <Border x:Name="ChipInstalled" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0"
                        Cursor="Hand" BorderBrush="{DynamicResource CardBorderBrush}"
                        MouseLeftButtonUp="FilterChip_Click" Tag="Installed">
                    <TextBlock Text="Installed" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}"/>
                </Border>
                <Border x:Name="ChipInUse" BorderThickness="1" CornerRadius="4" Padding="8,3"
                        Cursor="Hand" BorderBrush="{DynamicResource CardBorderBrush}"
                        MouseLeftButtonUp="FilterChip_Click" Tag="InUse">
                    <TextBlock Text="In use" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}"/>
                </Border>
            </StackPanel>

            <!-- App list -->
            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,0,8">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RunningPanel" Margin="0,4,0,4"/>
                </ScrollViewer>
            </Border>

            <!-- Browse button -->
            <Button x:Name="BrowseButton"
                    Content="Browse for .exe file..."
                    Click="Browse_Click"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,20"
                    Style="{StaticResource ActionButton}"/>

            <!-- Action buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Done"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="Done_Click"/>

                <Button Grid.Column="2"
                        Content="Cancel"
                        Style="{StaticResource ActionButton}"
                        Click="Cancel_Click"/>
            </Grid>

        </StackPanel>
    </Grid>
</Window>
