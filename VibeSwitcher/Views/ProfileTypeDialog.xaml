<Window x:Class="VibeSwitcher.Views.ProfileTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Profile"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="TypeButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F6FF"/>
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DDEEFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Height"         Value="32"/>
            <Setter Property="Padding"        Value="20,0"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Background"     Value="White"/>
            <Setter Property="BorderBrush"    Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#F0F6FF"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DDEEFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="What kind of profile?"
                   FontSize="15" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Text="Choose what this profile will control when activated."
                   FontSize="12" Foreground="#666666"
                   Margin="0,0,0,16"/>

        <!-- Playback Only -->
        <Button Style="{StaticResource TypeButton}" Click="Playback_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔊" FontSize="22" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Playback Only" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="Switch your speaker or headphone output"
                               Foreground="#666666" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Button>

        <!-- Recording Only -->
        <Button Style="{StaticResource TypeButton}" Click="Recording_Click" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🎤" FontSize="22" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Recording Only" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="Switch your microphone or audio input"
                               Foreground="#666666" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Button>

        <!-- Both -->
        <Button Style="{StaticResource TypeButton}" Click="Both_Click" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔗" FontSize="22" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Both Devices" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="Switch speaker and microphone together"
                               Foreground="#666666" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Button>

        <Button Content="Cancel" Click="Cancel_Click"
                Style="{StaticResource CancelBtn}"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"/>
    </StackPanel>
</Window>
