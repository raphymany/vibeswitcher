<Window x:Class="VibeSwitcher.Views.ProfileTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TypeButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Height"         Value="32"/>
            <Setter Property="Padding"        Value="20,0"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Foreground"     Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background"     Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource HoverBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PressedBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="20,14,20,20">
            <TextBlock Text="What kind of profile?"
                       FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Choose what this profile will control when activated."
                       FontSize="12" Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,16"/>

            <Button Style="{StaticResource TypeButton}" Click="Playback_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                            Background="{DynamicResource Accent}" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <TextBlock Text="🔊" FontSize="17" LineHeight="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Playback Only" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="Switch your speaker or headphone output"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Style="{StaticResource TypeButton}" Click="Recording_Click" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                            Background="{DynamicResource Accent}" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <TextBlock Text="🎤" FontSize="17" LineHeight="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Recording Only" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="Switch your microphone or audio input"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Style="{StaticResource TypeButton}" Click="Both_Click" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                            Background="{DynamicResource Accent}" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <TextBlock Text="🔗" FontSize="17" LineHeight="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Both Devices" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="Switch speaker and microphone together"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Content="Cancel" Click="Cancel_Click"
                    Style="{StaticResource CancelBtn}"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</Window>
