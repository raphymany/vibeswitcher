<Window x:Class="VibeSwitcher.Views.CustomReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,12,24,24">

            <!-- Title -->
            <TextBlock Text="Custom Reminder"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="How many minutes before the switch should the reminder fire?"
                       FontSize="12" Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap" LineHeight="18"
                       Margin="0,0,0,20"/>

            <!-- Input card -->
            <Border Background="{DynamicResource InnerCardBg}"
                    BorderBrush="{DynamicResource InnerCardBorderBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="24,18" Margin="0,0,0,8">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBox x:Name="MinutesBox"
                                 FontSize="26" FontWeight="SemiBold"
                                 Width="90" Height="50"
                                 Padding="0"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 MaxLength="4"
                                 TextChanged="MinutesBox_TextChanged"
                                 KeyDown="MinutesBox_KeyDown"/>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="minutes"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}"/>
                            <TextBlock Text="before the switch"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="RangeHint"
                               Text="1 – 1440 minutes"
                               FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Validation error -->
            <TextBlock x:Name="ErrorText"
                       Text="Please enter a number between 1 and 1440"
                       FontSize="11" Foreground="#CC3300"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"
                       Visibility="Collapsed"/>

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource ActionButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button x:Name="OkButton"
                        Content="Set Reminder"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="Ok_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
