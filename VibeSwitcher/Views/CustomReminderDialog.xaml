<Window x:Class="VibeSwitcher.Views.CustomReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,12,24,24">

            <!-- Title -->
            <TextBlock Text="Custom Reminder"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="How long before the switch should the reminder fire?"
                       FontSize="12" Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap" LineHeight="18"
                       Margin="0,0,0,20"/>

            <!-- Input card -->
            <Border Background="{DynamicResource InnerCardBg}"
                    BorderBrush="{DynamicResource InnerCardBorderBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="24,18" Margin="0,0,0,8">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Hours -->
                        <StackPanel HorizontalAlignment="Center">
                            <ComboBox x:Name="HourCombo"
                                      FontSize="22" FontWeight="SemiBold"
                                      Width="76" Height="46"
                                      HorizontalContentAlignment="Center"
                                      SelectionChanged="Dropdowns_Changed"/>
                            <TextBlock Text="hours"
                                       FontSize="10" Foreground="{DynamicResource SecondaryText}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Colon -->
                        <TextBlock Text=":" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   VerticalAlignment="Top" Margin="8,6,8,0"/>

                        <!-- Minutes -->
                        <StackPanel HorizontalAlignment="Center">
                            <ComboBox x:Name="MinuteCombo"
                                      FontSize="22" FontWeight="SemiBold"
                                      Width="76" Height="46"
                                      HorizontalContentAlignment="Center"
                                      SelectionChanged="Dropdowns_Changed"/>
                            <TextBlock Text="minutes"
                                       FontSize="10" Foreground="{DynamicResource SecondaryText}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Dynamic total hint -->
                    <TextBlock x:Name="TotalHint"
                               FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Validation error -->
            <TextBlock x:Name="ErrorText"
                       Text="Total must be at least 1 minute"
                       FontSize="11" Foreground="{DynamicResource ErrorText}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"
                       Visibility="Collapsed"/>

            <!-- Centered buttons -->
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Cancel"
                        Style="{StaticResource ActionButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button x:Name="OkButton"
                        Content="Set Reminder"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="Ok_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
