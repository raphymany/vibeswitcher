<Window x:Class="VibeSwitcher.Views.CustomReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Width="340" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <!-- Header -->
            <TextBlock Text="Custom Reminder" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,6"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="18">
                How many minutes before the scheduled switch should the reminder fire?
            </TextBlock>

            <!-- Input row -->
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right" Text="min before"
                           FontSize="12" Foreground="{DynamicResource SecondaryText}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox x:Name="MinutesBox"
                         Text="{Binding ElementName=MinutesBox, Path=Tag, Mode=OneWay}"
                         FontSize="13" Height="32"
                         TextChanged="MinutesBox_TextChanged"
                         KeyDown="MinutesBox_KeyDown"/>
            </DockPanel>

            <!-- Validation error -->
            <TextBlock x:Name="ErrorText"
                       FontSize="11" Foreground="#CC3300"
                       Margin="0,0,0,16" Visibility="Collapsed"
                       Text="Enter a number between 1 and 1440"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource ActionButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button x:Name="OkButton"
                        Content="Set Reminder"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="Ok_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
