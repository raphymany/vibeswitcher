<Window x:Class="VibeSwitcher.Views.UninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="20,14,20,20">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource ErrorDot}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IcoTrash}" Width="15" Height="15" Stretch="Uniform"
                          Fill="Transparent" Stroke="White" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Uninstall VibeSwitcher?"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="The app will close and Windows will remove it."
                               FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap" MaxWidth="280" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="VibeSwitcher will be removed from this PC, along with its Start Menu and desktop shortcuts and the start-with-Windows entry. No admin prompt is needed."
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource PrimaryText}" LineHeight="18"
                       Margin="0,0,0,14"/>

            <!-- Data choice (defaults to KEEP) -->
            <Border Background="{DynamicResource VSInsetBg}" BorderBrush="{DynamicResource InputBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                    <StackPanel Margin="0,0,52,0">
                        <TextBlock Text="Also delete my profiles and settings" FontSize="12.5"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="Deletes the app's data folder (%APPDATA%\VibeSwitcher). Leave this off to keep your profiles for a future reinstall."
                                   FontSize="10.5" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="DeleteDataToggle" Style="{StaticResource ToggleSwitchStyle}"
                              HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Footer -->
            <Grid Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource ActionButton}" IsCancel="True"
                        HorizontalAlignment="Left" MinWidth="90" Click="Cancel_Click"/>
                <Button Content="Uninstall" Style="{StaticResource DeleteButton}"
                        HorizontalAlignment="Right" MinWidth="90" Click="Uninstall_Click"/>
            </Grid>
        </StackPanel>
    
        <!-- Accent window frame: a rounded overlay (not a Window border) so it follows
             Windows 11's rounded window corners instead of being clipped at them. -->
        <Border Grid.RowSpan="99" Grid.ColumnSpan="99" CornerRadius="8"
                BorderBrush="#66F5820A" BorderThickness="1"
                IsHitTestVisible="False" Panel.ZIndex="9999"/>
    </Grid>
</Window>
