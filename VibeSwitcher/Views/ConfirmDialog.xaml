<Window x:Class="VibeSwitcher.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        ShowInTaskbar="False">

    <Window.Resources>
        <ControlTemplate x:Key="RoundedBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Template"        Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#F0F6FF"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfirmBtn" TargetType="Button">
            <Setter Property="Template"        Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#0078D4"/>
            <Setter Property="BorderBrush"     Value="#0060AA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#0060AA"/>
                    <Setter Property="BorderBrush" Value="#004E8C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#004E8C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,24">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="36" Height="36" Background="#FFF8E0" CornerRadius="18"
                    Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="⚠" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="#444444" LineHeight="18"
                   Margin="0,0,0,20"/>

        <!-- Cancel is IsDefault so Enter safely dismisses -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="CancelBtn"
                    Content="Cancel"
                    Style="{StaticResource CancelBtn}"
                    IsDefault="True"
                    IsCancel="True"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button x:Name="ActionBtn"
                    Style="{StaticResource ConfirmBtn}"
                    Click="Confirm_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
