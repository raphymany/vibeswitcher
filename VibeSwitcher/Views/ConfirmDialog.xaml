<Window x:Class="VibeSwitcher.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ControlTemplate x:Key="RoundedBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Template"        Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background"      Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource HoverBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfirmBtn" TargetType="Button">
            <Setter Property="Template"        Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource AccentHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border x:Name="IconBadge" Width="36" Height="36" Background="{DynamicResource WarningBg}" CornerRadius="18"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <ContentControl x:Name="IconContent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Focusable="False"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource PrimaryText}" LineHeight="18"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="CancelBtn"
                        Content="Cancel"
                        Style="{StaticResource CancelBtn}"
                        IsDefault="True"
                        IsCancel="True"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button x:Name="ActionBtn"
                        Style="{StaticResource ConfirmBtn}"
                        Click="Confirm_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
