<Window x:Class="VibeSwitcher.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border x:Name="IconBadge" Width="36" Height="36" Background="{DynamicResource WarningBg}" CornerRadius="18"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <ContentControl x:Name="IconContent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Focusable="False"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"
                               TextWrapping="Wrap" MaxWidth="280" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource PrimaryText}" LineHeight="18"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="CancelBtn"
                        Content="Cancel"
                        Style="{StaticResource ActionButton}"
                        IsDefault="True"
                        IsCancel="True"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button x:Name="ActionBtn"
                        Style="{StaticResource PrimaryButton}"
                        Click="Confirm_Click"/>
            </StackPanel>

        </StackPanel>
    
        <!-- Accent window frame: a rounded overlay (not a Window border) so it follows
             Windows 11's rounded window corners instead of being clipped at them. -->
        <Border Grid.RowSpan="99" Grid.ColumnSpan="99" CornerRadius="8"
                BorderBrush="#66F5820A" BorderThickness="1"
                IsHitTestVisible="False" Panel.ZIndex="9999"/>
    </Grid>
</Window>
