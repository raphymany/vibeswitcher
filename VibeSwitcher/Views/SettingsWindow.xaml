                                <TextBlock Grid.Column="0" Text="WPF / .NET 8" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock Grid.Column="1" Text="Windows Presentation Foundation" FontSize="12"
                                           Foreground="{DynamicResource SecondaryText}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
