            </ScrollViewer>

            <!-- ── PANEL D: FAQ ───────────────────────────────────── -->
            <ScrollViewer x:Name="FaqPanel"
                          Visibility="Collapsed"
                          Focusable="True"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720" HorizontalAlignment="Center" Margin="22,18,22,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Button Style="{StaticResource BackButton}" Content="←" FontSize="14" Click="NavProfiles_Click"/>
                        <TextBlock Text="Help &amp; FAQ" Style="{StaticResource PanelTitle}"/>
                    </StackPanel>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="WHAT IS VIBESWITCHER?" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                VibeSwitcher is a Windows system tray app that lets you save audio device configurations as profiles and switch between them instantly — using hotkeys, schedules, or a single click.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="SETTING UP PROFILES" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Click <Hyperlink Tag="newProfile" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">+ New Profile</Hyperlink> to create a profile. Choose a mode (Playback, Recording, or Both), pick your devices, then give it a name. You can assign a global hotkey to activate it from anywhere.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="CUSTOM PROFILE ICONS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,6">
                                Open <Hyperlink Tag="profiles" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">a profile</Hyperlink>, click its icon, and choose "Browse from disk" to use your own <Run FontFamily="Consolas">.ico</Run> file. To make one from any picture:
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" LineHeight="21">
                                1.&#160; Save the picture you want to use.<LineBreak/>
                                2.&#160; (Optional) Remove its background with <Hyperlink NavigateUri="https://www.pixelcut.ai/background-remover/png" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource Accent}">Pixelcut Background Remover</Hyperlink>.<LineBreak/>
                                3.&#160; Convert the image to <Run FontFamily="Consolas">.ico</Run> with <Hyperlink NavigateUri="https://image.online-convert.com/convert-to-ico" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource Accent}">Online&#8209;Convert</Hyperlink>. If your file is a PNG, JPEG, or other format, just pick the matching conversion (e.g. PNG&#160;&#8594;&#160;ICO).
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="FILTERING PROFILES" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Use the <Hyperlink Tag="filters" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">search box and filter chips</Hyperlink> to narrow down your profile list. Filters stack (AND logic). Clear all filters with the ✕ Clear button.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="USING HOTKEYS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Click <Hyperlink Tag="profiles" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">a profile card</Hyperlink> to open profile details, then click "Set Hotkey". Press your desired key combination. Hotkeys work globally — even when VibeSwitcher is minimized to the tray. App-wide shortcuts (open/close the window, mute) live in <Hyperlink Tag="shortcuts" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">Settings → Shortcuts</Hyperlink>.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="SCHEDULED SWITCHING" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Click the schedule button (&#x231A;) on <Hyperlink Tag="profiles" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">a profile card</Hyperlink> to add a schedule. Choose a time and days of the week. Multiple schedules per profile are supported. The schedule button lights up orange when at least one schedule is set, and the card shows a schedule chip you can click to edit it.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="AUTO-SWITCH ON CONNECT" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Click the auto-switch button (&#x26A1;) on <Hyperlink Tag="profiles" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">a profile card</Hyperlink> to enable auto-switch. VibeSwitcher will activate this profile whenever its playback device connects. Best for wireless headsets and USB audio interfaces.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="MINI MODE" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Shrink VibeSwitcher into a small profile switcher that sits in a corner of your screen — perfect over games. Enter it with the shrink button in the title bar, the tray menu, or a hotkey; the expand button brings the full window back. In <Hyperlink Tag="miniSettings" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">Settings → Mini Window</Hyperlink> you can pick the layout (rows or icon grid), choose which profiles appear, set the toggle shortcut, keep it always on top, and make it fade when inactive. Or just <Hyperlink Tag="miniTry" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">try Mini Mode now</Hyperlink>.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="PANIC / MUTE HOTKEYS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Set global hotkeys to instantly mute your microphone, speakers, or both — from inside any app. Each toggle plays a distinct sound and shows a brief "muted / unmuted" notification (you can silence the banner per shortcut with its bell toggle). Press the hotkey again to unmute. Set them up in <Hyperlink Tag="shortcuts" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">Settings → Shortcuts</Hyperlink>.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="APP LAUNCH TRIGGERS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Link one or more programs to a profile with the trigger button (&#x25B6;) on <Hyperlink Tag="profiles" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">a profile card</Hyperlink> — VibeSwitcher switches to that profile automatically within seconds of any linked app launching, and stays there until you switch yourself.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="SWITCH SOUNDS &amp; SILENT PROFILES" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Each profile can play a tone when it activates — choose from 7 built-in tones or your own WAV via the sound button on <Hyperlink Tag="profiles" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">a profile card</Hyperlink>. Prefer quiet? The silent toggle on a card skips the Windows notification banner for that profile, and app-wide notification options live in <Hyperlink Tag="notifications" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">Settings → Notifications</Hyperlink>.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="BACKUP &amp; RESTORE" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Go to <Hyperlink Tag="backup" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">Settings → Backup &amp; Restore</Hyperlink> to export your config to a JSON file. Import that file on a new machine to restore all your profiles. Config is stored at %APPDATA%\VibeSwitcher\config.json.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="TRAY ICON BASICS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                VibeSwitcher lives in the system tray. Left-click the icon to cycle to the next profile (or open the window instead — choose in <Hyperlink Tag="traySettings" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">Settings → Tray</Hyperlink>), and right-click for the full menu with all profiles and quick actions. Hover the icon to see the active profile and your hotkey cheat sheet.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="STARTING WITH WINDOWS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                In <Hyperlink Tag="startupSettings" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">Settings → Startup</Hyperlink> you can have VibeSwitcher launch when Windows starts, begin minimized to the tray, and keep running in the tray when the window is closed — so your hotkeys, schedules, and auto-switching are always active.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="RENAMING DEVICES" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Windows device names can be a mouthful ("Headphones (3- Logitech PRO X Wireless Gaming Headset)"). Give devices short friendly names like "GoXLR" or "Desk Speakers" in <Hyperlink Tag="deviceAliases" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">Settings → Devices</Hyperlink> — aliases are shown everywhere in the app instead of the raw names.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="INSTALL, UPDATES &amp; UNINSTALL" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                <Hyperlink Tag="installSettings" Click="FaqAction_Click" Foreground="{DynamicResource Accent}">Settings → Install &amp; Updates</Hyperlink> shows your version, where the app and its data live (with folder sizes), and lets you uninstall from inside the app. Uninstalling keeps your profiles and settings unless you explicitly choose to delete them — so a reinstall picks up right where you left off.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════════════════
                 PROFILE DETAIL OVERLAY  (Panel.ZIndex = 10)
                 ══════════════════════════════════════════════════════ -->
            <Grid x:Name="ProfileDetailOverlay"
                  Visibility="Collapsed"
                  Panel.ZIndex="10">

                <!-- Backdrop -->
                <Border Background="{DynamicResource VSScrim}"
                        MouseLeftButtonDown="OverlayBackdrop_MouseDown"/>

                <!-- Modal card -->
                <Border x:Name="ProfileDetailCard"
                        MaxWidth="500" MinWidth="400"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="20"
                        Background="{DynamicResource VSModalBg}"
                        CornerRadius="18"
                        BorderBrush="#66F5820A" BorderThickness="1">
                    <Grid x:Name="ProfileDetailContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- header -->
                            <RowDefinition Height="*"/>     <!-- body -->
                            <RowDefinition Height="Auto"/>  <!-- footer -->
                        </Grid.RowDefinitions>

                        <!-- ── Modal Header ── -->
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1"
                                Padding="22,18,22,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon preview -->
                                <Border Grid.Column="0" Width="54" Height="54" CornerRadius="13"
                                        Background="{DynamicResource VSInsetBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1"
                                        Margin="0,0,14,0">
                                    <Grid>
                                        <controls:NavLogoIcon Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <controls:NavLogoIcon.Style>
                                                <Style TargetType="controls:NavLogoIcon">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCustomIcon}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:NavLogoIcon.Style>
                                        </controls:NavLogoIcon>
                                        <Image Source="{Binding IconPreview}" Width="52" Height="52" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCustomIcon}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>

                                <!-- Name + mode badge -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="20"
                                             FontSize="16" FontWeight="Bold"
                                             Foreground="{DynamicResource PrimaryText}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             Margin="0,0,0,6"/>
                                    <!-- Mode chip — brand orange for all modes, matching the card chips -->
                                    <Border CornerRadius="6" Padding="8,3"
                                            HorizontalAlignment="Left"
                                            Background="#1FF5820A" BorderBrush="#40F5820A" BorderThickness="1">
                                        <TextBlock Text="{Binding ModeLabel}"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Close button -->
                                <Button Grid.Column="2" Width="30" Height="30"
                                        Content="✕" FontSize="13"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource BackButton}"
                                        Click="OverlayClose_Click"/>
                            </Grid>
                        </Border>

                        <!-- ── Modal Body (scrollable) ── -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="440">
                            <StackPanel Margin="22,14,22,14">

                                <!-- Name suggestions -->
                                <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,10"
                                           Visibility="{Binding SuggestionsVisibility}">
                                    <Button Content="Gaming"    Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Gaming"/>
                                    <Button Content="Work"      Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Work"/>
                                    <Button Content="Music"     Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Music"/>
                                    <Button Content="Headset"   Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Headset"/>
                                    <Button Content="Streaming" Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Streaming"/>
                                    <Button Content="Calls"     Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Calls"/>
                                    <Button Content="Mic"       Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Mic"/>
                                    <Button Content="Home"      Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Home"/>
                                    <Button Content="Speakers"  Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Speakers"/>
                                </WrapPanel>

                                <!-- Notes -->
                                <TextBlock Text="NOTES" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,14">
                                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="61"/>
                                    <TextBlock Text="Add a note about this profile..."
                                               IsHitTestVisible="False"
                                               Foreground="{DynamicResource TertiaryText}" FontStyle="Italic"
                                               VerticalAlignment="Center" Margin="9,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Notes}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Playback device -->
                                <StackPanel Visibility="{Binding PlaybackVisible}" Margin="0,0,0,14">
                                    <TextBlock Text="PLAYBACK DEVICE" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding PlaybackDevices}"
                                                  SelectedItem="{Binding SelectedPlaybackDevice}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Visibility="{Binding ShowDot, Converter={StaticResource BoolToVis}}">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource SuccessDot}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                            <Setter Property="Fill" Value="{DynamicResource ErrorDot}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1" Content="Test" Margin="8,0,0,0"
                                                Style="{StaticResource ActionButton}"
                                                Command="{Binding TestSoundCommand}"
                                                IsEnabled="{Binding IsPlaybackDeviceSet}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Recording device -->
                                <StackPanel Visibility="{Binding RecordingVisible}" Margin="0,0,0,14">
                                    <TextBlock Text="RECORDING DEVICE" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding RecordingDevices}"
                                                  SelectedItem="{Binding SelectedRecordingDevice}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Visibility="{Binding ShowDot, Converter={StaticResource BoolToVis}}">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource SuccessDot}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                            <Setter Property="Fill" Value="{DynamicResource ErrorDot}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1" Content="Test" Margin="8,0,0,0"
                                                Style="{StaticResource ActionButton}"
                                                Command="{Binding TestMicCommand}"
                                                IsEnabled="{Binding IsRecordingDeviceSet}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Hotkey -->
                                <TextBlock Text="HOTKEY" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBox Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                             IsReadOnly="True" IsTabStop="False" Width="120" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource ActionButton}" Content="Set Hotkey"
                                            Command="{Binding CaptureHotkeyCommand}"/>
                                </StackPanel>

                                <!-- Icon -->
                                <TextBlock Text="ICON" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBox Text="{Binding IconPath, Mode=OneWay, FallbackValue='(default)'}"
                                             IsReadOnly="True" IsTabStop="False" Width="160" Margin="0,0,8,0"/>
                                    <Button Content="Pick Icon" Style="{StaticResource ActionButton}"
                                            Command="{Binding PickIconCommand}"/>
                                </StackPanel>

                                <!-- Validation warning -->
                                <Border Padding="10,7" CornerRadius="5"
                                        Background="{DynamicResource WarningBg}"
                                        BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
                                        Margin="0,0,0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValidationWarning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠" FontSize="12" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource WarningText}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ValidationWarning}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ── Modal Footer ── -->
                        <Border Grid.Row="2"
                                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0"
                                Padding="22,14,22,18">
                            <Grid>
                                <!-- Quick action buttons (left) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionButton}" Content="Clone"
                                            Command="{Binding CloneCommand}" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource DangerButton}" Content="Delete"
                                            Command="{Binding DeleteCommand}"/>
                                </StackPanel>
                                <!-- Done button (right) -->
                                <Button Content="Done"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        Click="OverlayClose_Click"/>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

        </Grid><!-- /MainGrid -->
    
        <!-- Accent window frame: a rounded overlay (not a Window border) so it follows
             Windows 11's rounded window corners instead of being clipped at them. -->
        <Border Grid.RowSpan="99" Grid.ColumnSpan="99" CornerRadius="8"
                BorderBrush="#66F5820A" BorderThickness="1"
                IsHitTestVisible="False" Panel.ZIndex="9999"/>
    </Grid><!-- /outer Grid -->
</Window>

