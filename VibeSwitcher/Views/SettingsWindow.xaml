<Window x:Class="VibeSwitcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VibeSwitcher.ViewModels"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBg}"
        WindowStyle="None"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" GlassFrameThickness="0"
                      ResizeBorderThickness="4" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Filter chip — ghost outline, orange fill when checked -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="Height"   Value="26"/>
            <Setter Property="Padding"  Value="10,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="13" BorderThickness="1"
                                BorderBrush="{DynamicResource InputBorder}"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"  Value="{DynamicResource VSAccentDim}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource VSAccentBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked"   Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background"  Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource InputHoverBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav icon button -->
        <Style x:Key="NavIconBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"  Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Width="34" Height="34" CornerRadius="8"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active nav icon button — orange tint -->
        <Style x:Key="NavIconBtnActive" TargetType="Button" BasedOn="{StaticResource NavIconBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Width="34" Height="34" CornerRadius="8"
                                Background="{DynamicResource VSAccentGlow}"
                                BorderBrush="{DynamicResource VSAccentBorder}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title bar window control buttons -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"    Value="44"/>
            <Setter Property="Height"   Value="30"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="Foreground" Value="#555570"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0DFFFFFF"/>
                                <Setter Property="Foreground" Value="#AAAACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBtnClose" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings section card -->
        <Style x:Key="InnerCardBorder" TargetType="Border">
            <Setter Property="Background"       Value="{DynamicResource InnerCardBg}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource InnerCardBorderBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="10"/>
            <Setter Property="Padding"          Value="14,12"/>
            <Setter Property="Margin"           Value="0,0,0,10"/>
        </Style>

        <!-- Label in modal edit rows -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{DynamicResource SecondaryText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Name suggestion chips -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="Margin"   Value="0,0,6,4"/>
            <Setter Property="Padding"  Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{DynamicResource ChipBg}"
                                BorderBrush="{DynamicResource ChipBorder}"
                                BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToolTip override — needed by existing tooltips that use ToolTip as content -->
        <Style TargetType="ToolTip">
            <Setter Property="Background"   Value="{DynamicResource TooltipBg}"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource TooltipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="10,7"/>
            <Setter Property="HasDropShadow" Value="False"/>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT LAYOUT: 4 rows — TitleBar / TopNav / FilterBar / Content
         ═══════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════
             ROW 0 — CUSTOM TITLE BAR
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource VSTitleBarBg}"
                BorderBrush="#16162A" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <Canvas Width="14" Height="14" Margin="0,0,8,0">
                        <Path Data="M 4,5 L 7,10 L 10,5"
                              Stroke="#F5820A" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent"/>
                    </Canvas>
                    <TextBlock Text="VibeSwitcher"
                               FontFamily="Segoe UI" FontSize="11.5" FontWeight="Medium"
                               Foreground="#44445A"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBtn}" Content="─"
                            Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource TitleBtn}" Content="□"
                            Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource TitleBtnClose}" Content="✕"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════
             ROW 1 — TOP NAVIGATION BAR
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource VSNavBg}"
                BorderBrush="{DynamicResource VSNavBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- logo -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1"/>      <!-- divider -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MaxWidth="240"/>  <!-- search -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>   <!-- filters btn -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>   <!-- logs btn -->
                    <ColumnDefinition Width="*"/>      <!-- spacer -->
                    <ColumnDefinition Width="Auto"/>   <!-- About -->
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>   <!-- Settings -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1"/>      <!-- divider -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>   <!-- + New Profile -->
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Canvas Width="26" Height="26" Margin="0,0,8,0">
                        <Rectangle Width="26" Height="26" RadiusX="6" RadiusY="6" Fill="#13131E"/>
                        <Path Data="M 5,7 L 13,18 L 21,7"
                              Stroke="#F5820A" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent"/>
                    </Canvas>
                    <TextBlock Text="Vibe"
                               FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Switcher"
                               FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Column="2" Width="1" Height="22"
                        Background="{DynamicResource InputBorder}"
                        VerticalAlignment="Center"/>

                <!-- Search box -->
                <Border Grid.Column="4"
                        Background="{DynamicResource InputBg}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1" CornerRadius="8" Height="32">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource VSAccentBorder}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="11,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⌕"
                                   FontSize="14" Foreground="{DynamicResource MutedText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Height="30"
                                 FontSize="13"
                                 Foreground="{DynamicResource PrimaryText}"
                                 VerticalContentAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Filters button -->
                <Button Grid.Column="6"
                        x:Name="FiltersToggleBtn"
                        Style="{StaticResource ActionButton}"
                        Height="32" Padding="11,0"
                        FontSize="12.5"
                        Click="FiltersToggle_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⊟" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Filters" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Accent}"
                                CornerRadius="8" Padding="4,0" MinWidth="16" Height="16"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsAnyFilterActive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="●"
                                       FontSize="8" FontWeight="Bold"
                                       Foreground="#0D0D12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Logs button — only visible when errors exist -->
                <Button Grid.Column="8"
                        x:Name="LogsButton"
                        Style="{StaticResource ActionButton}"
                        Height="32" Padding="10,0"
                        Visibility="Collapsed"
                        Click="LogsButton_Click">
                    <TextBlock x:Name="LogsButtonText" FontSize="11" Foreground="{DynamicResource WarningText}"/>
                </Button>

                <!-- Divider at col 14 -->
                <Border Grid.Column="14" Width="1" Height="22"
                        Background="{DynamicResource InputBorder}"
                        VerticalAlignment="Center"/>

                <!-- About button -->
                <Button Grid.Column="10"
                        x:Name="AboutBtn"
                        Style="{StaticResource NavIconBtn}"
                        Click="ShowAbout_Click"
                        ToolTip="About">
                    <Path Data="M8,2 A6,6 0 0 1 8,14 A6,6 0 0 1 8,2 Z M8,7.5 L8,11.2 M8,5.5 A0.75,0.75 0 1 0 8,7 A0.75,0.75 0 1 0 8,5.5"
                          Stroke="{DynamicResource MutedText}" StrokeThickness="1.75"
                          Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="15" Height="15" Stretch="Uniform"/>
                </Button>

                <!-- Settings button -->
                <Button Grid.Column="12"
                        x:Name="SettingsBtn"
                        Style="{StaticResource NavIconBtn}"
                        Click="ShowSettings_Click"
                        ToolTip="Settings">
                    <Path Data="M8,6 A2.4,2.4 0 0 0 8,10.8 A2.4,2.4 0 0 0 8,6 Z M8,1.5 L8,2.8 M8,13.2 L8,14.5 M1.5,8 L2.8,8 M13.2,8 L14.5,8 M3.2,3.2 L4.1,4.1 M11.9,11.9 L12.8,12.8 M3.2,12.8 L4.1,11.9 M11.9,4.1 L12.8,3.2"
                          Stroke="{DynamicResource MutedText}" StrokeThickness="1.75"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="15" Height="15" Stretch="Uniform"/>
                </Button>

                <!-- + New Profile button -->
                <Button Grid.Column="16"
                        Style="{StaticResource PrimaryButton}"
                        Height="34" Padding="15,0"
                        Command="{Binding AddProfileCommand}"
                        ToolTip="Add new profile">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="#0D0D12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="New Profile" VerticalAlignment="Center"
                                   FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════
             ROW 2 — FILTER BAR (animated collapse/expand via MaxHeight)
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                x:Name="FilterBarBorder"
                Background="{DynamicResource AppBg}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1"
                MaxHeight="0"
                ClipToBounds="True">
            <WrapPanel x:Name="FilterBar"
                       Margin="18,9"
                       Orientation="Horizontal">

                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Playback only"
                              IsChecked="{Binding ModePlayback}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Recording only"
                              IsChecked="{Binding ModeRecording}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Both devices"
                              IsChecked="{Binding ModeBoth}"/>

                <Separator Width="1" Height="18" Margin="2,0,8,4" VerticalAlignment="Center"/>

                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="★ Pinned"   IsChecked="{Binding PinnedFilter}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="✓ Active"   IsChecked="{Binding ActiveFilter}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Silent"     IsChecked="{Binding SilentFilter}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Has hotkey" IsChecked="{Binding HotkeyFilter}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Scheduled"  IsChecked="{Binding ScheduledFilter}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="Has sound"  IsChecked="{Binding SoundFilter}"/>
                <ToggleButton Style="{StaticResource FilterChip}" Margin="0,0,6,4"
                              Content="⚠ Warning"  IsChecked="{Binding WarningFilter}"/>

                <Button Margin="6,0,0,4"
                        Style="{StaticResource ActionButton}"
                        Height="26" Padding="10,0" FontSize="11.5"
                        Content="✕ Clear"
                        Command="{Binding ClearFiltersCommand}"
                        Foreground="{DynamicResource ErrorText}"
                        Visibility="{Binding IsAnyFilterActive, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════
             ROW 3 — MAIN CONTENT
             Only one panel visible at a time.
             ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">

            <!-- ── A. Profile Card Grid ── -->
            <ScrollViewer x:Name="ProfileGridView"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{DynamicResource AppBg}">
                <Grid Margin="18,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="PROFILES"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Border Background="{DynamicResource InputBg}"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="7,1">
                            <TextBlock FontFamily="Segoe UI" FontSize="10.5"
                                       Foreground="{DynamicResource MutedText}"
                                       Text="{Binding Profiles.Count}"/>
                        </Border>
                    </StackPanel>

                    <!-- Card grid -->
                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProfileCardViewModel}">
                                <views:ProfileCardView
                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                    CardExpanded="ProfileCard_Clicked"
                                    Margin="0,0,13,13"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:CenteredWrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Empty state — no profiles at all -->
                    <Border Grid.Row="3"
                            Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVis}}"
                            Margin="0,40">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No profiles yet"
                                       FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Click + New Profile to get started"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="{DynamicResource SubtleText}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty state — filters returned no results -->
                    <Border Grid.Row="3"
                            Visibility="{Binding HasNoFilterResults, Converter={StaticResource BoolToVis}}"
                            Margin="0,40">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No profiles match the active filters"
                                       FontFamily="Segoe UI" FontSize="13"
                                       Foreground="{DynamicResource MutedText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <Button Content="Clear filters"
                                    Style="{StaticResource ActionButton}"
                                    Command="{Binding ClearFiltersCommand}"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- ── B. Settings Panel ── -->
            <ScrollViewer x:Name="SettingsPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource AppBg}">
                <StackPanel Margin="28,26" MaxWidth="640" HorizontalAlignment="Left">

                    <!-- Panel header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                        <Button Style="{StaticResource ActionButton}"
                                Width="34" Height="34" Padding="0"
                                Click="ShowProfiles_Click"
                                ToolTip="Back to profiles">
                            <TextBlock Text="←" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <TextBlock Text="Settings"
                                   FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                        <Button x:Name="HelpButton"
                                Width="28" Height="28" Padding="0"
                                Margin="12,0,0,0"
                                Style="{StaticResource ActionButton}"
                                Click="HelpButton_Click"
                                ToolTip="Getting started &amp; help">
                            <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- APPEARANCE -->
                    <TextBlock Text="APPEARANCE" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedText}"
                               Margin="2,0,0,7"/>
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Theme" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Height="30">
                                <StackPanel.Resources>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="GroupName"              Value="ThemeGroup"/>
                                        <Setter Property="Cursor"                 Value="Hand"/>
                                        <Setter Property="FontSize"               Value="12"/>
                                        <Setter Property="Padding"                Value="14,0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment"   Value="Center"/>
                                        <Setter Property="Foreground"             Value="{DynamicResource SecondaryText}"/>
                                        <Setter Property="Background"             Value="Transparent"/>
                                        <Setter Property="BorderBrush"            Value="{DynamicResource InputBorder}"/>
                                        <Setter Property="BorderThickness"        Value="1"/>
                                        <Setter Property="FocusVisualStyle"       Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="Bg"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background"  Value="{DynamicResource Accent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
