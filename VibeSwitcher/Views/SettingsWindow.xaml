<Window x:Class="VibeSwitcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VibeSwitcher.ViewModels"
        Title="VibeSwitcher"
        Width="540" Height="680"
        MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F3F3F3"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Card ── -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="Padding"         Value="16,14"/>
        </Style>

        <!-- ── Inner card (nested within General Settings) ── -->
        <Style x:Key="InnerCardBorder" TargetType="Border">
            <Setter Property="Background"      Value="#F8F9FA"/>
            <Setter Property="BorderBrush"     Value="#EBEBEB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="#555555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,10,0"/>
        </Style>

        <!-- ── TextBox: rounded, blue focus ring ── -->
        <Style TargetType="TextBox">
            <Setter Property="Height"                  Value="30"/>
            <Setter Property="FontSize"                Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                 Value="8,0"/>
            <Setter Property="Background"              Value="White"/>
            <Setter Property="Foreground"              Value="#1A1A1A"/>
            <Setter Property="BorderBrush"             Value="#DDDDDD"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F7F7F7"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox: rounded, same hover feel ── -->
        <Style TargetType="ComboBox">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#1A1A1A"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,0,28,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="root">
                            <Border x:Name="bg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,0,28,0">
                                <ContentPresenter x:Name="contentPresenter"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False"/>
                            </Border>
                            <Path x:Name="arrow"
                                  Data="M0,0 L3.5,4 L7,0"
                                  Stroke="#777777" StrokeThickness="1.5"
                                  Fill="Transparent"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  IsHitTestVisible="False"/>
                            <ToggleButton x:Name="toggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   VerticalOffset="2">
                                <Border Background="White"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, ElementName=root}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.10"
                                                          BlurRadius="10" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <ScrollViewer Padding="4,4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="toggleButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F0F6FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="#0078D4"/>
                            </Trigger>
                            <Trigger SourceName="toggleButton" Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F0F6FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox dropdown items ── -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"   Value="10,6"/>
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="Cursor"    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bg"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F0F6FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E3F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Name suggestion chip pills ── -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background"      Value="#EEF4FF"/>
            <Setter Property="BorderBrush"     Value="#AACCFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="#3366CC"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="#D4E6FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Styled tooltip ── -->
        <Style TargetType="ToolTip">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                                  Opacity="0.13" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="MainGrid" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <StackPanel x:Name="HeaderPanel" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Image x:Name="HeaderIcon" Width="40" Height="40"
                   VerticalAlignment="Center" Margin="0,0,12,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="VibeSwitcher"
                           FontSize="20" FontWeight="Bold" Foreground="#1A1A1A"/>
                <TextBlock Text="Manage your device profiles and hotkeys"
                           FontSize="12" Foreground="#777777" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Profile cards ── -->
        <ScrollViewer x:Name="ProfilesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>

                <ItemsControl ItemsSource="{Binding Profiles}"
                              KeyboardNavigation.DirectionalNavigation="Contained">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileCardViewModel}">

                            <!-- F18: save-flash animation on Background.Color -->
                            <Border AllowDrop="True"
                                    DragEnter="Card_DragEnter"
                                    DragLeave="Card_DragLeave"
                                    DragOver="Card_DragOver"
                                    Drop="Card_Drop">
                                <Border.Background>
                                    <SolidColorBrush Color="White"/>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SaveFlash}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#E8F5E9" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="White" Duration="0:0:0.6"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>  <!-- drag grip -->
                                        <ColumnDefinition Width="95"/>  <!-- labels -->
                                        <ColumnDefinition Width="*"/>   <!-- inputs -->
                                        <ColumnDefinition Width="Auto"/> <!-- actions -->
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Drag grip -->
                                    <TextBlock Grid.Column="0" Grid.Row="3"
                                               Text="⠿" FontSize="20" Foreground="#CCCCCC"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Cursor="Hand" Margin="-4,0,4,0"
                                               ToolTipService.InitialShowDelay="400"
                                               ToolTipService.ShowDuration="10000"
                                               PreviewMouseLeftButtonDown="DragGrip_MouseDown"
                                               PreviewMouseLeftButtonUp="DragGrip_MouseUp"
                                               MouseMove="DragGrip_MouseMove">
                                        <TextBlock.ToolTip>
                                            <ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="Drag to reorder"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#1A1A1A" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Hold and drag up or down to change the order profiles appear in the tray menu."
                                                               FontSize="11" Foreground="#555555"
                                                               TextWrapping="Wrap" MaxWidth="220"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>

                                    <!-- Name -->
                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                                Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Name" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                        <Border Width="15" Height="15" Background="#E8F0FF" CornerRadius="8"
                                                VerticalAlignment="Center" Cursor="Help"
                                                ToolTipService.InitialShowDelay="400"
                                                ToolTipService.ShowDuration="12000">
                                            <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                       Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="240">
                                                        A short display name for this profile. It appears in the tray menu and at the top of the settings card.
                                                    </TextBlock>
                                                </ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                    </StackPanel>
                                    <TextBox Grid.Row="0" Grid.Column="2"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="20"
                                             Margin="0,0,0,10"/>
                                    <Border Grid.Row="0" Grid.Column="3"
                                            Margin="8,0,0,10" VerticalAlignment="Center"
                                            Background="#EEF4FF" BorderBrush="#AACCFF"
                                            BorderThickness="1" CornerRadius="5"
                                            Padding="10,4">
                                        <TextBlock Text="{Binding ModeLabel}"
                                                   FontSize="11" Foreground="#3366CC"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name suggestions -->
                                    <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                               HorizontalAlignment="Center"
                                               Orientation="Horizontal" Margin="0,0,0,8">
                                        <WrapPanel.Style>
                                            <Style TargetType="WrapPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowNameSuggestions}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </WrapPanel.Style>
                                        <Button Content="Gaming"    Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Gaming"/>
                                        <Button Content="Work"      Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Work"/>
                                        <Button Content="Music"     Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Music"/>
                                        <Button Content="Headset"   Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Headset"/>
                                        <Button Content="Streaming" Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Streaming"/>
                                        <Button Content="Calls"     Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Calls"/>
                                        <Button Content="Mic"       Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Mic"/>
                                        <Button Content="Home"      Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Home"/>
                                        <Button Content="Speakers"  Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Speakers"/>
                                    </WrapPanel>

                                    <!-- Playback -->
                                    <StackPanel Grid.Row="2" Grid.Column="1"
                                                Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding PlaybackVisible}">
                                        <TextBlock Text="Playback" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                        <Border Width="15" Height="15" Background="#E8F0FF" CornerRadius="8"
                                                VerticalAlignment="Center" Cursor="Help"
                                                ToolTipService.InitialShowDelay="400"
                                                ToolTipService.ShowDuration="12000">
                                            <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                       Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="240">
                                                        The output audio device (speakers or headphones) that will become the default when this profile is activated.
                                                    </TextBlock>
                                                </ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox Grid.Row="2" Grid.Column="2"
                                              ItemsSource="{Binding PlaybackDevices}"
                                              SelectedItem="{Binding SelectedPlaybackDevice}"
                                              Visibility="{Binding PlaybackVisible}"
                                              Margin="0,0,0,8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                             Visibility="{Binding ShowDot, Converter={StaticResource BoolToVis}}">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#2DB55D"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                        <Setter Property="Fill" Value="#CC3333"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Row="2" Grid.Column="3"
                                            Content="Test"
                                            Margin="8,0,0,8" VerticalAlignment="Center"
                                            Style="{StaticResource ActionButton}"
                                            Command="{Binding TestSoundCommand}"
                                            IsEnabled="{Binding IsPlaybackDeviceSet}"
                                            Visibility="{Binding PlaybackVisible}"/>

                                    <!-- Recording -->
                                    <StackPanel Grid.Row="3" Grid.Column="1"
                                                Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding RecordingVisible}">
                                        <TextBlock Text="Recording" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                        <Border Width="15" Height="15" Background="#E8F0FF" CornerRadius="8"
                                                VerticalAlignment="Center" Cursor="Help"
                                                ToolTipService.InitialShowDelay="400"
                                                ToolTipService.ShowDuration="12000">
                                            <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                       Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="240">
                                                        The microphone or audio input that will become the default when this profile is activated.
                                                    </TextBlock>
                                                </ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox Grid.Row="3" Grid.Column="2"
                                              ItemsSource="{Binding RecordingDevices}"
                                              SelectedItem="{Binding SelectedRecordingDevice}"
                                              Visibility="{Binding RecordingVisible}"
                                              Margin="0,0,0,8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                             Visibility="{Binding ShowDot, Converter={StaticResource BoolToVis}}">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#2DB55D"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                        <Setter Property="Fill" Value="#CC3333"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Row="3" Grid.Column="3"
                                            Content="Test"
                                            Margin="8,0,0,8" VerticalAlignment="Center"
                                            Style="{StaticResource ActionButton}"
                                            Command="{Binding TestMicCommand}"
                                            IsEnabled="{Binding IsRecordingDeviceSet}"
                                            Visibility="{Binding RecordingVisible}"/>

                                    <!-- Hotkey -->
                                    <StackPanel Grid.Row="4" Grid.Column="1"
                                                Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Hotkey" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                        <Border Width="15" Height="15" Background="#E8F0FF" CornerRadius="8"
                                                VerticalAlignment="Center" Cursor="Help"
                                                ToolTipService.InitialShowDelay="400"
                                                ToolTipService.ShowDuration="12000">
                                            <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                       Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="240">
                                                        A global keyboard shortcut that switches to this profile instantly from anywhere, even when the app is minimized. Supports combinations like Ctrl+Shift+F1.
                                                    </TextBlock>
                                                </ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                    </StackPanel>
                                    <TextBox Grid.Row="4" Grid.Column="2"
                                             Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                             IsReadOnly="True"
                                             IsTabStop="False"
                                             Margin="0,0,0,8"/>
                                    <Button Grid.Row="4" Grid.Column="3"
                                            Content="Set Hotkey"
                                            Margin="8,0,0,8" VerticalAlignment="Center"
                                            Style="{StaticResource ActionButton}"
                                            Command="{Binding CaptureHotkeyCommand}"/>

                                    <!-- Icon -->
                                    <StackPanel Grid.Row="5" Grid.Column="1"
                                                Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Icon" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                        <ToggleButton x:Name="IconInfoToggle"
                                                      Width="15" Height="15"
                                                      VerticalAlignment="Center"
                                                      Cursor="Hand" Focusable="False"
                                                      OverridesDefaultStyle="True">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="#E8F0FF" CornerRadius="8">
                                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                                   Foreground="#0078D4"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=IconInfoToggle}"
                                               PlacementTarget="{Binding ElementName=IconInfoToggle}"
                                               Placement="Bottom" VerticalOffset="4"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Background="White"
                                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                                    CornerRadius="8" Padding="14,12" MaxWidth="280">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                                                      Direction="270" Opacity="0.13" Color="#000000"/>
                                                </Border.Effect>
                                                <StackPanel>
                                                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10">
                                                        Custom tray icon shown when this profile is active.
                                                        Must be <Run FontWeight="SemiBold">.ico format</Run> only.
                                                    </TextBlock>
                                                    <TextBlock Text="💡 How to create a custom icon:"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="#444444"
                                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2">
                                                        1. Remove the background from your image:
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Margin="0,0,0,10">
                                                        <Hyperlink NavigateUri="https://www.pixelcut.ai/t/background-remover"
                                                                   RequestNavigate="Hyperlink_RequestNavigate">
                                                            pixelcut.ai/t/background-remover
                                                        </Hyperlink>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2">
                                                        2. Convert the image to .ico:
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Margin="0,0,0,10">
                                                        <Hyperlink NavigateUri="https://image.online-convert.com/convert-to-ico"
                                                                   RequestNavigate="Hyperlink_RequestNavigate">
                                                            image.online-convert.com/convert-to-ico
                                                        </Hyperlink>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#888888" TextWrapping="Wrap">
                                                        Tip: export with multiple sizes (16, 32, 48, 256 px) for a sharper icon at all screen DPI settings.
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                    <TextBox Grid.Row="5" Grid.Column="2"
                                             Text="{Binding IconPath, Mode=OneWay, FallbackValue='(default)'}"
                                             IsReadOnly="True"
                                             IsTabStop="False"
                                             Margin="0,0,0,12"/>
                                    <StackPanel Grid.Row="5" Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,12">
                                        <Button Content="Pick Icon"
                                                Style="{StaticResource ActionButton}"
                                                Command="{Binding PickIconCommand}"/>
                                        <Border Background="#4A4A4A" CornerRadius="4" Padding="3"
                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconPreview}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image Source="{Binding IconPreview}" Width="18" Height="18"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Separator -->
                                    <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4"
                                            Height="1" Background="#F0F0F0" Margin="0,0,0,12"/>

                                    <!-- Bottom row: Silent toggle (left) + Clone + Delete (right) -->
                                    <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4">
                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding Silent}"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center">
                                                <TextBlock Text="Silent switch" FontSize="12" Foreground="#555555"/>
                                            </CheckBox>
                                            <Border Width="15" Height="15" Background="#E8F0FF" CornerRadius="8"
                                                    VerticalAlignment="Center" Cursor="Help" Margin="6,0,0,0"
                                                    ToolTipService.InitialShowDelay="400"
                                                    ToolTipService.ShowDuration="12000">
                                                <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                           Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock TextWrapping="Wrap" MaxWidth="240">
                                                            When enabled, switching to this profile skips the Windows notification banner. Device-unavailable warnings still appear regardless of this setting.
                                                        </TextBlock>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button Content="Clone"
                                                    Style="{StaticResource ActionButton}"
                                                    Command="{Binding CloneCommand}"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="Delete Profile"
                                                    Style="{StaticResource DangerButton}"
                                                    Command="{Binding DeleteCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <TextBlock HorizontalAlignment="Center" Foreground="#AAAAAA"
                           FontSize="13" Margin="0,32,0,24"
                           Text="No profiles yet — click Add New Profile to get started">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoProfiles}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Add New Profile -->
                <Button Command="{Binding AddProfileCommand}"
                        Style="{StaticResource ActionButton}"
                        Height="Auto" Padding="16,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="＋" FontSize="18" Foreground="#0078D4"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Add New Profile" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Create a playback, recording, or linked device profile"
                                       Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

            </StackPanel>
        </ScrollViewer>

        <!-- ── General Settings card ── -->
        <Border x:Name="SettingsCard" Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                Padding="0" ClipToBounds="True">
            <StackPanel>
                <!-- Collapsible header -->
                <ToggleButton x:Name="SettingsExpander"
                              IsChecked="{Binding SettingsCardExpanded, Mode=TwoWay}"
                              HorizontalContentAlignment="Stretch"
                              OverridesDefaultStyle="True"
                              Focusable="False" Cursor="Hand">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="7,7,0,0"
                                    Padding="16,14,16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚙" FontSize="16"
                                               Foreground="#555555" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="VibeSwitcher Settings"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#1A1A1A"/>
                                        <TextBlock Text="Startup, notifications, devices, and shortcuts"
                                                   Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="Arrow" Grid.Column="2"
                                               Text="▲" FontSize="10" Foreground="#888888"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="Arrow" Property="Text" Value="▼"/>
                                    <Setter TargetName="Bg" Property="CornerRadius" Value="7"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#F0F6FF"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#0078D4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- Collapsible body with inner cards (F42) -->
                <StackPanel Margin="16,0,16,14">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=SettingsExpander}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Inner card: Startup -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Startup" FontWeight="SemiBold" FontSize="12"
                                       Foreground="#444444" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding StartWithWindows}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="#E8F0FF" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <TextBlock Text="When your PC boots up, VibeSwitcher will start automatically, like a startup app." TextWrapping="Wrap" MaxWidth="220" FontSize="11"/>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding StartMinimized}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Start minimized to tray" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="#E8F0FF" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <TextBlock Text="When VibeSwitcher starts with Windows, it opens quietly in the tray." TextWrapping="Wrap" MaxWidth="220" FontSize="11"/>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding CloseToTray}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Close to tray" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="#E8F0FF" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <TextBlock Text="Clicking the Close button hides this window instead of exiting. VibeSwitcher keeps running in the tray. To reopen Settings, right-click the tray icon and click the VibeSwitcher header." TextWrapping="Wrap" MaxWidth="220" FontSize="11"/>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Inner card: Notifications -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="12"
                                       Foreground="#444444" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding ShowNotifications}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Show device switch alerts" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="#E8F0FF" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <TextBlock Text="Shows a Windows notification banner when you switch profiles, confirming which profile was selected." TextWrapping="Wrap" MaxWidth="220" FontSize="11"/>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <Button x:Name="LogsButton"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Click="LogsButton_Click">
                                <TextBlock x:Name="LogsButtonText" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Inner card: Tray -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Tray" FontWeight="SemiBold" FontSize="12"
                                       Foreground="#444444" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding LeftClickCyclesProfiles}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Left-click tray icon to cycle profiles" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="#E8F0FF" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <TextBlock Text="Left-clicking the tray icon switches to the next profile in order. Disable this if you want left-click to do nothing (right-click still works normally)." TextWrapping="Wrap" MaxWidth="220" FontSize="11"/>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Inner card: Devices -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Devices" FontWeight="SemiBold" FontSize="12"
                                       Foreground="#444444" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding UseLegacySoundPanel}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Use legacy sound panel" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="#E8F0FF" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <TextBlock Text="The 'Open Sound Settings' button will open the classic Windows Sound Control Panel instead of the modern Windows Settings app." TextWrapping="Wrap" MaxWidth="220" FontSize="11"/>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding ShowDisabledDevices}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Show disabled devices in dropdowns" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="#E8F0FF" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <TextBlock Text="Includes devices marked as 'Disabled' in Windows Sound settings. Useful if you manually enable and disable devices between uses." TextWrapping="Wrap" MaxWidth="220" FontSize="11"/>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding ShowDisconnectedDevices}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Show disconnected devices in dropdowns" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="#E8F0FF" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <TextBlock Text="Includes physically unplugged devices in profile dropdowns. Lets you assign a device that is not currently connected to the machine." TextWrapping="Wrap" MaxWidth="220" FontSize="11"/>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Inner card: Backup & Restore (F1) -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Backup &amp; Restore" FontWeight="SemiBold" FontSize="12"
                                       Foreground="#444444" Margin="0,0,0,6"/>
                            <TextBlock Text="Save your profiles to a file, or restore from a previous backup."
                                       FontSize="11" Foreground="#777777" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Export Config"
                                        Style="{StaticResource ActionButton}"
                                        Margin="0,0,8,0"
                                        Click="ExportButton_Click"/>
                                <Button Content="Import Config"
                                        Style="{StaticResource ActionButton}"
                                        Click="ImportButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Inner card: Shortcuts — F43 fades body when disabled -->
                    <Border Style="{StaticResource InnerCardBorder}" Margin="0">
                        <StackPanel>
                            <!-- Header row: always full opacity -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Shortcuts" FontWeight="SemiBold" FontSize="12"
                                           Foreground="#444444" VerticalAlignment="Center"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Enabled" FontSize="11" Foreground="#777777"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding SettingsHotkeyEnabled}"
                                              IsEnabled="{Binding SettingsHotkeyIsSet}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <!-- Body: fades when disabled (F43) -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SettingsHotkeyEnabled}" Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Open / Close VibeSwitcher" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#1A1A1A" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="#E8F0FF" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <TextBlock Text="A global keyboard shortcut that opens or closes the VibeSwitcher Settings window from anywhere, even when another app is in focus." TextWrapping="Wrap" MaxWidth="220" FontSize="11"/>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#F5F5F5" BorderBrush="#D0D0D0" BorderThickness="1"
                                            CornerRadius="5" Padding="10,5" Margin="0,0,8,0"
                                            MinWidth="74" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SettingsHotkeyDisplay}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1A1A1A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SettingsHotkeyDisplay}" Value="None">
                                                            <Setter Property="Foreground" Value="#AAAAAA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Button Style="{StaticResource ActionButton}"
                                            Content="Set hotkey"
                                            Click="SettingsHotkeyButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Footer ── -->
        <Grid x:Name="FooterGrid" Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="About"
                        Style="{StaticResource ActionButton}"
                        Width="72"
                        Click="AboutButton_Click"/>
                <Button Width="28" Height="28" Padding="0" Margin="8,0,0,0"
                        Style="{StaticResource ActionButton}"
                        Click="HelpButton_Click"
                        ToolTip="Getting started &amp; help">
                    <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"/>
                </Button>
            </StackPanel>
            <Button Content="Open Sound Settings"
                    Style="{StaticResource ActionButton}"
                    HorizontalAlignment="Center"
                    Click="OpenSoundSettings_Click"/>
            <Button Content="Close"
                    Style="{StaticResource ActionButton}"
                    Width="90"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click"/>
        </Grid>

    </Grid>
</Window>
