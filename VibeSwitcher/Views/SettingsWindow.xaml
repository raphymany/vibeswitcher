                                           FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Manage…"
                                    Style="{StaticResource ActionButton}"
                                    VerticalAlignment="Center"
                                    Click="ManageAliasesButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- BACKUP & RESTORE -->
                    <TextBlock Text="BACKUP &amp; RESTORE" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedText}"
                               Margin="2,0,0,7"/>
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Save your profiles to a file, or restore from a previous backup."
                                       FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Export Config"
                                        Style="{StaticResource ActionButton}"
                                        Margin="0,0,8,0"
                                        Click="ExportButton_Click"/>
                                <Button Content="Import Config"
                                        Style="{StaticResource ActionButton}"
                                        Click="ImportButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── C. About Panel ── -->
            <ScrollViewer x:Name="AboutPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource AppBg}">
                <StackPanel Margin="28,26" MaxWidth="640" HorizontalAlignment="Left">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                        <Button Style="{StaticResource ActionButton}"
                                Width="34" Height="34" Padding="0"
                                Click="ShowProfiles_Click"
                                ToolTip="Back to profiles">
                            <TextBlock Text="←" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <TextBlock Text="About"
                                   FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>

                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Canvas Width="32" Height="32" Margin="0,0,12,0">
                                    <Rectangle Width="32" Height="32" RadiusX="8" RadiusY="8" Fill="#13131E"/>
                                    <Path Data="M 6,9 L 16,22 L 26,9"
                                          Stroke="#F5820A" StrokeThickness="2.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent"/>
                                </Canvas>
                                <StackPanel>
                                    <TextBlock Text="VibeSwitcher"
                                               FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryText}"/>
                                    <TextBlock Text="Audio Profile Switcher for Windows"
                                               FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Quickly switch between audio device profiles using hotkeys, tray menu, schedules, and auto-triggers."
                                       FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── D. Profile Detail Modal Overlay ── -->
            <Grid x:Name="ProfileDetailOverlay"
                  Visibility="Collapsed"
                  Panel.ZIndex="10">

                <!-- Semi-transparent backdrop -->
                <Border Background="#D00D0D12"
                        MouseLeftButtonDown="ProfileDetail_BackdropClick"/>

                <!-- Modal card -->
                <Border x:Name="ProfileDetailCard"
                        Background="{DynamicResource VSModalBg}"
                        BorderBrush="{DynamicResource VSModalBorder}"
                        BorderThickness="1"
                        CornerRadius="18"
                        MaxWidth="500"
                        MaxHeight="640"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="80"
                                          ShadowDepth="0" Opacity="0.75"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ModalScale" ScaleX="1" ScaleY="1"
                                            CenterX="250" CenterY="320"/>
                            <TranslateTransform x:Name="ModalTranslate" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Modal header: icon + name + mode label + close -->
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource SeparatorBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="22,20,22,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <!-- Profile icon preview -->
                                <Border Grid.Column="0"
                                        Width="54" Height="54" CornerRadius="13"
                                        Background="{DynamicResource IconPreviewBg}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <Image Source="{Binding IconPreview}"
                                           Width="36" Height="36"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Name + mode badge -->
                                <StackPanel Grid.Column="2">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="20"
                                             Background="Transparent"
                                             BorderThickness="0,0,0,1"
                                             BorderBrush="{DynamicResource InputBorder}"
                                             FontFamily="Segoe UI"
                                             FontSize="16" FontWeight="Bold"
                                             Foreground="{DynamicResource PrimaryText}"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,0,6"/>
                                    <Border Background="{DynamicResource ChipBg}"
                                            BorderBrush="{DynamicResource ChipBorder}"
                                            BorderThickness="1" CornerRadius="6"
                                            Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ModeLabel}"
                                                   FontSize="11" Foreground="{DynamicResource ChipText}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Close button -->
                                <Button Grid.Column="4"
                                        Style="{StaticResource NavIconBtn}"
                                        Width="30" Height="30"
                                        Click="ProfileDetail_Close"
                                        ToolTip="Close">
                                    <TextBlock Text="✕" FontSize="11"
                                               Foreground="{DynamicResource MutedText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Modal body: all profile editing fields -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="440">
                            <StackPanel Margin="22,16,22,16">

                                <!-- Name suggestions -->
                                <WrapPanel HorizontalAlignment="Left"
                                           Orientation="Horizontal" Margin="0,0,0,12">
                                    <WrapPanel.Style>
                                        <Style TargetType="WrapPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowNameSuggestions}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>
                                    <Button Content="Gaming"    Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Gaming"/>
                                    <Button Content="Work"      Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Work"/>
                                    <Button Content="Music"     Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Music"/>
                                    <Button Content="Headset"   Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Headset"/>
                                    <Button Content="Streaming" Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Streaming"/>
                                    <Button Content="Calls"     Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Calls"/>
                                    <Button Content="Mic"       Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Mic"/>
                                    <Button Content="Home"      Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Home"/>
                                    <Button Content="Speakers"  Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Speakers"/>
                                </WrapPanel>

                                <!-- Notes -->
                                <TextBlock Text="Notes" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,14">
                                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="61"/>
                                    <TextBlock Text="Add a note about this profile…"
                                               IsHitTestVisible="False"
                                               Foreground="{DynamicResource TertiaryText}"
                                               FontStyle="Italic"
                                               VerticalAlignment="Center"
                                               Margin="9,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Notes}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Playback device -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4"
                                            Visibility="{Binding PlaybackVisible}">
                                    <TextBlock Text="Playback device" Style="{StaticResource LabelText}" Margin="0,0,6,0"/>
                                    <Border Width="15" Height="15" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            VerticalAlignment="Center" Cursor="Help"
                                            ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="12000">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <TextBlock TextWrapping="Wrap" MaxWidth="240" Foreground="{DynamicResource PrimaryText}">
                                                    The output audio device (speakers or headphones) that will become the default when this profile is activated.
                                                </TextBlock>
                                            </ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                                <DockPanel Margin="0,0,0,14"
                                           Visibility="{Binding PlaybackVisible}">
                                    <Button DockPanel.Dock="Right"
                                            Content="Test"
                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                            Style="{StaticResource ActionButton}"
                                            Command="{Binding TestSoundCommand}"
                                            IsEnabled="{Binding IsPlaybackDeviceSet}"/>
                                    <ComboBox ItemsSource="{Binding PlaybackDevices}"
                                              SelectedItem="{Binding SelectedPlaybackDevice}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                             Visibility="{Binding ShowDot, Converter={StaticResource BoolToVis}}">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessDot}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                        <Setter Property="Fill" Value="{DynamicResource ErrorDot}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DockPanel>

                                <!-- Recording device -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4"
                                            Visibility="{Binding RecordingVisible}">
                                    <TextBlock Text="Recording device" Style="{StaticResource LabelText}" Margin="0,0,6,0"/>
                                    <Border Width="15" Height="15" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            VerticalAlignment="Center" Cursor="Help"
                                            ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="12000">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <TextBlock TextWrapping="Wrap" MaxWidth="240" Foreground="{DynamicResource PrimaryText}">
                                                    The microphone or audio input that will become the default when this profile is activated.
                                                </TextBlock>
                                            </ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                                <DockPanel Margin="0,0,0,14"
                                           Visibility="{Binding RecordingVisible}">
                                    <Button DockPanel.Dock="Right"
                                            Content="Test"
                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                            Style="{StaticResource ActionButton}"
                                            Command="{Binding TestMicCommand}"
                                            IsEnabled="{Binding IsRecordingDeviceSet}"/>
                                    <ComboBox ItemsSource="{Binding RecordingDevices}"
                                              SelectedItem="{Binding SelectedRecordingDevice}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                             Visibility="{Binding ShowDot, Converter={StaticResource BoolToVis}}">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessDot}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                        <Setter Property="Fill" Value="{DynamicResource ErrorDot}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DockPanel>

                                <!-- Hotkey -->
                                <TextBlock Text="Hotkey" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right"
                                            Content="Set Hotkey"
                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                            Style="{StaticResource ActionButton}"
                                            Command="{Binding CaptureHotkeyCommand}"/>
                                    <TextBox Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                             IsReadOnly="True" IsTabStop="False"/>
                                </DockPanel>

                                <!-- Icon -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Icon" Style="{StaticResource LabelText}" Margin="0,0,6,0"/>
                                    <ToggleButton x:Name="IconInfoToggle"
                                                  Width="15" Height="15"
                                                  VerticalAlignment="Center"
                                                  Cursor="Hand" Focusable="False"
                                                  OverridesDefaultStyle="True"
                                                  ToolTip="Click for custom icon creation guide"
                                                  ToolTipService.InitialShowDelay="400">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{DynamicResource InfoBadgeBg}" CornerRadius="8">
                                                    <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                               Foreground="{DynamicResource InfoBadgeText}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=IconInfoToggle}"
                                           PlacementTarget="{Binding ElementName=IconInfoToggle}"
                                           Placement="Bottom" VerticalOffset="4"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Background="{DynamicResource TooltipBg}"
                                                BorderBrush="{DynamicResource TooltipBorder}" BorderThickness="1"
                                                CornerRadius="8" Padding="14,12" MaxWidth="280">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                                                  Direction="270" Opacity="0.13" Color="#000000"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                                           Foreground="{DynamicResource PrimaryText}">
                                                    Custom tray icon displayed when this profile is active.
                                                    Must be <Run FontWeight="SemiBold">.ico format</Run> only.
                                                </TextBlock>
                                                <TextBlock Text="💡 How to create a custom icon:"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}"
                                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"
                                                           Foreground="{DynamicResource PrimaryText}">
                                                    1. Remove the background from your image:
                                                </TextBlock>
                                                <TextBlock FontSize="12" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryText}">
                                                    <Hyperlink NavigateUri="https://www.pixelcut.ai/t/background-remover"
                                                               RequestNavigate="Hyperlink_RequestNavigate">
                                                        pixelcut.ai/t/background-remover
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"
                                                           Foreground="{DynamicResource PrimaryText}">
                                                    2. Convert the image to .ico:
                                                </TextBlock>
                                                <TextBlock FontSize="12" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryText}">
                                                    <Hyperlink NavigateUri="https://image.online-convert.com/convert-to-ico"
                                                               RequestNavigate="Hyperlink_RequestNavigate">
                                                        image.online-convert.com/convert-to-ico
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                                    Tip: export with multiple sizes (16, 32, 48, 256 px) for a sharper icon at all DPI settings.
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Button Content="Pick Icon"
                                                Style="{StaticResource ActionButton}"
                                                Command="{Binding PickIconCommand}"/>
                                        <Border Background="Transparent"
                                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                                                CornerRadius="4" Padding="3"
                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconPreview}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image Source="{Binding IconPreview}" Width="18" Height="18"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBox Text="{Binding IconPath, Mode=OneWay, FallbackValue='(default)'}"
                                             IsReadOnly="True" IsTabStop="False"/>
                                </DockPanel>

                                <!-- Validation warning -->
                                <Border Margin="0,0,0,12" Padding="10,7" CornerRadius="6"
                                        Background="{DynamicResource WarningBg}"
                                        BorderBrush="{DynamicResource WarningBorder}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValidationWarning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠" FontSize="12" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource WarningText}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ValidationWarning}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningText}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Height="1" Background="{DynamicResource CardSeparator}" Margin="0,0,0,14"/>

                                <!-- Action buttons -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <!-- Silent toggle -->
                                    <Border Margin="0,0,6,6" Height="32"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SoundOverride}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ToggleButton IsChecked="{Binding Silent}"
                                                      Cursor="Hand" Focusable="False"
                                                      OverridesDefaultStyle="True"
                                                      ToolTip="No Notification Banner + Sound — suppresses the tray banner and notification sound when activating this profile">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="8,4">
                                                        <TextBlock x:Name="bell" Text="🔔" FontSize="16"
                                                                   Foreground="{DynamicResource PrimaryText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bell" Property="Text" Value="🔕"/>
                                                            <Setter TargetName="bell" Property="Foreground" Value="#E57373"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Border>
                                    <!-- App trigger -->
                                    <Border Margin="0,0,6,6" Height="32"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="2">
                                        <Button Command="{Binding OpenAppTriggersCommand}"
                                                Cursor="Hand" Focusable="False"
                                                OverridesDefaultStyle="True"
                                                ToolTip="App Launch Triggers — switch to this profile automatically when a linked app opens">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="8,4">
                                                        <TextBlock x:Name="icon" Text="▶" FontSize="16"
                                                                   Foreground="{DynamicResource PrimaryText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasAppTriggers}" Value="True">
                                                            <Setter TargetName="icon" Property="Foreground" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Border>
                                    <!-- Auto-switch on connect -->
                                    <Border Margin="0,0,6,6" Height="32"
                                            Visibility="{Binding TriggerOnConnectVisible}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="2">
                                        <ToggleButton IsChecked="{Binding TriggerOnConnect}"
                                                      Cursor="Hand" Focusable="False"
                                                      OverridesDefaultStyle="True"
                                                      ToolTip="Auto-switch activates when your playback device connects">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="8,4">
                                                        <TextBlock x:Name="plug" Text="🔌" FontSize="18"
                                                                   Foreground="{DynamicResource PrimaryText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="plug" Property="Foreground" Value="#4CAF50"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Border>
                                    <!-- Pin toggle -->
                                    <Border Margin="0,0,6,6" Height="32"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="2">
                                        <ToggleButton IsChecked="{Binding IsPinned}"
                                                      Cursor="Hand" Focusable="False"
                                                      OverridesDefaultStyle="True"
                                                      ToolTip="Pin to top of list and tray menu">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="8,4">
                                                        <TextBlock x:Name="star" Text="☆" FontSize="20"
                                                                   Foreground="{DynamicResource PrimaryText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="star" Property="Text" Value="★"/>
                                                            <Setter TargetName="star" Property="Foreground" Value="#FFB300"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Border>
                                    <!-- Activate -->
                                    <Border Margin="0,0,6,6" Height="32"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="2">
                                        <Button Command="{Binding ActivateCommand}"
                                                Cursor="Hand" Focusable="False"
                                                OverridesDefaultStyle="True"
                                                ToolTip="Activate this profile — switches your audio devices immediately">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="8,4">
                                                        <TextBlock x:Name="icon" Text="◎" FontSize="20"
                                                                   Foreground="{DynamicResource PrimaryText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter TargetName="icon" Property="Text" Value="◉"/>
                                                            <Setter TargetName="icon" Property="Foreground" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Border>
                                    <!-- Clone -->
                                    <Border Margin="0,0,6,6" Height="32"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="2">
                                        <Button Command="{Binding CloneCommand}"
                                                Cursor="Hand" Focusable="False"
                                                OverridesDefaultStyle="True"
                                                ToolTip="Creates an exact copy of this profile with a new name">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="8,4">
                                                        <TextBlock x:Name="icon" Text="⧉" FontSize="18"
                                                                   Foreground="{DynamicResource PrimaryText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Border>
                                    <!-- Schedule -->
                                    <Border Margin="0,0,6,6" Height="32"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="2">
                                        <Button Command="{Binding AddScheduleCommand}"
                                                Cursor="Hand" Focusable="False"
                                                OverridesDefaultStyle="True"
                                                ToolTip="Automatically switch to this profile at a set time on selected days">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="8,4">
                                                        <TextBlock x:Name="icon" Text="⏰" FontSize="16"
                                                                   Foreground="{DynamicResource PrimaryText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasSchedules}" Value="True">
                                                            <Setter TargetName="icon" Property="Foreground" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Border>
                                    <!-- Switch sound -->
                                    <Border Margin="0,0,6,6" Height="32"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="2">
                                        <Button Command="{Binding ConfigureSoundCommand}"
                                                Cursor="Hand" Focusable="False"
                                                OverridesDefaultStyle="True"
                                                ToolTip="Play a sound when this profile is activated">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="8,4">
                                                        <TextBlock x:Name="icon" Text="🎵" FontSize="16"
                                                                   Foreground="{DynamicResource PrimaryText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding SoundOverride}" Value="True">
                                                            <Setter TargetName="icon" Property="Foreground" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Border>
                                    <!-- Delete -->
                                    <Border Margin="0,0,0,6" Height="32"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="2">
                                        <Button Command="{Binding DeleteCommand}"
                                                Cursor="Hand" Focusable="False"
                                                OverridesDefaultStyle="True"
                                                ToolTip="Permanently delete this profile">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="8,4">
                                                        <TextBlock x:Name="icon" Text="🗑" FontSize="16"
                                                                   Foreground="{DynamicResource ErrorText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Border>
                                </WrapPanel>

                                <!-- Schedules section -->
                                <Border Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSchedules}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Schedules"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SectionLabelText}"
                                                   Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding Schedules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ScheduleEntryViewModel}">
                                                    <Border Background="{DynamicResource InnerCardBg}"
                                                            BorderBrush="{DynamicResource InnerCardBorderBrush}"
                                                            BorderThickness="1" CornerRadius="6"
                                                            Padding="10,8" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <CheckBox IsChecked="{Binding Enabled}"
                                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                                          DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                                <Button DockPanel.Dock="Right" Content="Remove"
                                                                        Style="{StaticResource DangerButton}"
                                                                        Command="{Binding DeleteCommand}"
                                                                        FontSize="10" Padding="10,2" Height="26"
                                                                        VerticalAlignment="Center"/>
                                                                <Button DockPanel.Dock="Right" Content="Edit"
                                                                        Style="{StaticResource ActionButton}"
                                                                        Command="{Binding EditCommand}"
                                                                        FontSize="10" Padding="12,2" Height="26"
                                                                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Summary}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource SecondaryText}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="8,0,0,0"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding ConflictMessage}"
                                                                       FontSize="11" Foreground="#CC6600"
                                                                       TextWrapping="Wrap" Margin="42,4,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Sound override section -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SoundOverride}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Switch Sound"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SectionLabelText}"
                                                   Margin="0,0,0,6"/>
                                        <Border Background="{DynamicResource InnerCardBg}"
                                                BorderBrush="{DynamicResource InnerCardBorderBrush}"
                                                BorderThickness="1" CornerRadius="6"
                                                Padding="10,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Remove Sound"
                                                        Style="{StaticResource DangerButton}"
                                                        Command="{Binding RemoveSwitchSoundCommand}"
                                                        FontSize="10" Padding="10,2" Height="26"
                                                        VerticalAlignment="Center"/>
                                                <Button DockPanel.Dock="Right" Content="Edit Sound"
                                                        Style="{StaticResource ActionButton}"
                                                        Command="{Binding ConfigureSoundCommand}"
                                                        FontSize="10" Padding="12,2" Height="26"
                                                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SoundSummary}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryText}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Modal footer -->
                        <Border Grid.Row="2"
                                BorderBrush="{DynamicResource SeparatorBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="22,14,22,20">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="Close"
                                        Style="{StaticResource ActionButton}"
                                        Height="34" Margin="0,0,8,0"
                                        Click="ProfileDetail_Close"/>
                                <Button Content="Save Changes"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="34"
                                        Click="ProfileDetail_Save"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </Grid><!-- Row 3 content -->

    </Grid><!-- root grid -->
</Window>
