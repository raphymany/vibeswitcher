<Window x:Class="VibeSwitcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VibeSwitcher.ViewModels"
        Title="VibeSwitcher - Settings"
        Width="540" Height="680"
        MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F3F3F3"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <!-- ── Shared rounded button template ── -->
        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Template"   Value="{StaticResource RoundedButtonTemplate}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Padding"    Value="12,0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#F0F6FF"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DDEEFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Template"   Value="{StaticResource RoundedButtonTemplate}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Padding"    Value="12,0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#C00000"/>
            <Setter Property="Background" Value="#FFF0F0"/>
            <Setter Property="BorderBrush"     Value="#FFBBBB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#FFE0E0"/>
                    <Setter Property="BorderBrush" Value="#C00000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Card ── -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="Padding"         Value="16,14"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="#555555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,10,0"/>
        </Style>

        <!-- ── TextBox: rounded, blue focus ring ── -->
        <Style TargetType="TextBox">
            <Setter Property="Height"                  Value="30"/>
            <Setter Property="FontSize"                Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                 Value="8,0"/>
            <Setter Property="Background"              Value="White"/>
            <Setter Property="Foreground"              Value="#1A1A1A"/>
            <Setter Property="BorderBrush"             Value="#DDDDDD"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F7F7F7"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox: rounded, same hover feel ── -->
        <Style TargetType="ComboBox">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#1A1A1A"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,0,28,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="root">
                            <!-- Visual border with ContentPresenter inside — mirrors TextBox
                                 structure (border → padding → text) so offsets are identical. -->
                            <Border x:Name="bg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,0,28,0">
                                <ContentPresenter x:Name="contentPresenter"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False"/>
                            </Border>
                            <!-- Chevron overlaid at right (sits in the right-padding area) -->
                            <Path x:Name="arrow"
                                  Data="M0,0 L3.5,4 L7,0"
                                  Stroke="#777777" StrokeThickness="1.5"
                                  Fill="Transparent"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  IsHitTestVisible="False"/>
                            <!-- Transparent toggle — click target only, no visuals -->
                            <ToggleButton x:Name="toggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- Dropdown popup -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   VerticalOffset="2">
                                <Border Background="White"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, ElementName=root}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.10"
                                                          BlurRadius="10" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <ScrollViewer Padding="4,4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="toggleButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F0F6FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="#0078D4"/>
                            </Trigger>
                            <Trigger SourceName="toggleButton" Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F0F6FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox dropdown items ── -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"   Value="10,6"/>
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="Cursor"    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bg"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F0F6FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E3F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Styled tooltip ── -->
        <Style TargetType="ToolTip">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                                  Opacity="0.13" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="VibeSwitcher"
                       FontSize="20" FontWeight="Bold" Foreground="#1A1A1A"/>
            <TextBlock Text="Manage your device profiles and hotkeys"
                       FontSize="12" Foreground="#777777" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ── Profile cards ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>

                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileCardViewModel}">
                            <Border Style="{StaticResource CardBorder}">
                                <!-- Single grid — one column definition shared by every row,
                                     guaranteeing all labels and inputs are pixel-aligned. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Name -->
                                    <StackPanel Grid.Row="0" Grid.Column="0"
                                                Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Name" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                        <Border Width="15" Height="15" Background="#BDD0EE" CornerRadius="8"
                                                VerticalAlignment="Center" Cursor="Help"
                                                ToolTipService.InitialShowDelay="400"
                                                ToolTipService.ShowDuration="12000">
                                            <TextBlock Text="i" FontSize="8" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="240">
                                                        A short display name for this profile. It appears in the tray menu and at the top of the settings card.
                                                    </TextBlock>
                                                </ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                    </StackPanel>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="20"
                                             Margin="0,0,0,10"/>
                                    <Border Grid.Row="0" Grid.Column="2"
                                            Margin="8,0,0,10" VerticalAlignment="Center"
                                            Background="#EEF4FF" BorderBrush="#AACCFF"
                                            BorderThickness="1" CornerRadius="5"
                                            Padding="10,4">
                                        <TextBlock Text="{Binding ModeLabel}"
                                                   FontSize="11" Foreground="#3366CC"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Playback (row collapses when both items are Collapsed) -->
                                    <StackPanel Grid.Row="1" Grid.Column="0"
                                                Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding PlaybackVisible}">
                                        <TextBlock Text="Playback" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                        <Border Width="15" Height="15" Background="#BDD0EE" CornerRadius="8"
                                                VerticalAlignment="Center" Cursor="Help"
                                                ToolTipService.InitialShowDelay="400"
                                                ToolTipService.ShowDuration="12000">
                                            <TextBlock Text="i" FontSize="8" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="240">
                                                        The output audio device (speakers or headphones) that will become the default when this profile is activated.
                                                    </TextBlock>
                                                </ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding PlaybackDevices}"
                                              SelectedItem="{Binding SelectedPlaybackDevice}"
                                              Visibility="{Binding PlaybackVisible}"
                                              Margin="0,0,0,8"/>

                                    <!-- Recording -->
                                    <StackPanel Grid.Row="2" Grid.Column="0"
                                                Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding RecordingVisible}">
                                        <TextBlock Text="Recording" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                        <Border Width="15" Height="15" Background="#BDD0EE" CornerRadius="8"
                                                VerticalAlignment="Center" Cursor="Help"
                                                ToolTipService.InitialShowDelay="400"
                                                ToolTipService.ShowDuration="12000">
                                            <TextBlock Text="i" FontSize="8" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="240">
                                                        The microphone or audio input that will become the default when this profile is activated.
                                                    </TextBlock>
                                                </ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox Grid.Row="2" Grid.Column="1"
                                              ItemsSource="{Binding RecordingDevices}"
                                              SelectedItem="{Binding SelectedRecordingDevice}"
                                              Visibility="{Binding RecordingVisible}"
                                              Margin="0,0,0,8"/>

                                    <!-- Hotkey -->
                                    <StackPanel Grid.Row="3" Grid.Column="0"
                                                Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Hotkey" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                        <Border Width="15" Height="15" Background="#BDD0EE" CornerRadius="8"
                                                VerticalAlignment="Center" Cursor="Help"
                                                ToolTipService.InitialShowDelay="400"
                                                ToolTipService.ShowDuration="12000">
                                            <TextBlock Text="i" FontSize="8" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="240">
                                                        A global keyboard shortcut that switches to this profile instantly from anywhere, even when the app is minimized. Supports combinations like Ctrl+Shift+F1.
                                                    </TextBlock>
                                                </ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                    </StackPanel>
                                    <TextBox Grid.Row="3" Grid.Column="1"
                                             Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Margin="0,0,0,8"/>
                                    <Button Grid.Row="3" Grid.Column="2"
                                            Content="Set Hotkey"
                                            Margin="8,0,0,8" VerticalAlignment="Center"
                                            Style="{StaticResource ActionButton}"
                                            Command="{Binding CaptureHotkeyCommand}"/>

                                    <!-- Icon -->
                                    <StackPanel Grid.Row="4" Grid.Column="0"
                                                Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Icon" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                        <!-- ToggleButton + Popup so the links are actually clickable -->
                                        <ToggleButton x:Name="IconInfoToggle"
                                                      Width="15" Height="15"
                                                      VerticalAlignment="Center"
                                                      Cursor="Hand" Focusable="False"
                                                      OverridesDefaultStyle="True">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="#BDD0EE" CornerRadius="8">
                                                        <TextBlock Text="i" FontSize="8" FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=IconInfoToggle}"
                                               PlacementTarget="{Binding ElementName=IconInfoToggle}"
                                               Placement="Bottom" VerticalOffset="4"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Background="White"
                                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                                    CornerRadius="8" Padding="14,12" MaxWidth="280">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                                                      Direction="270" Opacity="0.13" Color="#000000"/>
                                                </Border.Effect>
                                                <StackPanel>
                                                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10">
                                                        Custom tray icon shown when this profile is active.
                                                        Must be <Run FontWeight="SemiBold">.ico format</Run> only.
                                                    </TextBlock>
                                                    <TextBlock Text="💡 How to create a custom icon:"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="#444444"
                                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2">
                                                        1. Remove the background from your image:
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Margin="0,0,0,10">
                                                        <Hyperlink NavigateUri="https://www.pixelcut.ai/t/background-remover"
                                                                   RequestNavigate="Hyperlink_RequestNavigate">
                                                            pixelcut.ai/t/background-remover
                                                        </Hyperlink>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2">
                                                        2. Convert the image to .ico:
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Margin="0,0,0,10">
                                                        <Hyperlink NavigateUri="https://image.online-convert.com/convert-to-ico"
                                                                   RequestNavigate="Hyperlink_RequestNavigate">
                                                            image.online-convert.com/convert-to-ico
                                                        </Hyperlink>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#888888" TextWrapping="Wrap">
                                                        Tip: export with multiple sizes (16, 32, 48, 256 px) for a sharper icon at all screen DPI settings.
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding IconPath, Mode=OneWay, FallbackValue='(default)'}"
                                             IsReadOnly="True"
                                             Margin="0,0,0,12"/>
                                    <StackPanel Grid.Row="4" Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,12">
                                        <Button Content="Browse"
                                                Style="{StaticResource ActionButton}"
                                                Command="{Binding BrowseIconCommand}"/>
                                        <Image Source="{Binding IconPreview}"
                                               Width="20" Height="20"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconPreview}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </StackPanel>

                                    <!-- Separator -->
                                    <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                            Height="1" Background="#F0F0F0" Margin="0,0,0,12"/>

                                    <!-- Delete -->
                                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                                Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Delete Profile"
                                                Style="{StaticResource DangerButton}"
                                                Command="{Binding DeleteCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state — shown when there are no profiles -->
                <TextBlock HorizontalAlignment="Center" Foreground="#AAAAAA"
                           FontSize="13" Margin="0,32,0,24"
                           Text="No profiles yet — click Add New Profile to get started">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoProfiles}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Add New Profile -->
                <Button Command="{Binding AddProfileCommand}"
                        Style="{StaticResource ActionButton}"
                        Height="Auto" Padding="16,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="＋" FontSize="18" Foreground="#0078D4"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Add New Profile" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Create a playback, recording, or linked device profile"
                                       Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

            </StackPanel>
        </ScrollViewer>

        <!-- ── General Settings card ── -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Startup" FontWeight="SemiBold" FontSize="12"
                               Foreground="#444444" Margin="0,0,0,6"/>
                    <CheckBox Content="Start with Windows"
                              IsChecked="{Binding StartWithWindows}" Margin="0,3"/>
                    <CheckBox Content="Start minimized to tray"
                              IsChecked="{Binding StartMinimized}" Margin="0,3"/>
                    <CheckBox Content="Close to tray"
                              IsChecked="{Binding CloseToTray}" Margin="0,3"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="12"
                               Foreground="#444444" Margin="0,0,0,6"/>
                    <CheckBox Content="Show device switch alerts"
                              IsChecked="{Binding ShowNotifications}" Margin="0,3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Footer: About (left) + Close (right) ── -->
        <Grid Grid.Row="3">
            <Button Content="About"
                    Style="{StaticResource ActionButton}"
                    Width="80" HorizontalAlignment="Left"
                    Click="AboutButton_Click"/>
            <Button Content="Close"
                    Style="{StaticResource ActionButton}"
                    Width="90" HorizontalAlignment="Right"
                    Click="CloseButton_Click"/>
        </Grid>

    </Grid>
</Window>
