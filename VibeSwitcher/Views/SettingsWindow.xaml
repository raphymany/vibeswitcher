                                        <TextBlock Text="↗" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="License (MIT)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource LinkChipStyle}"
                                        Tag="https://github.com/raphymany/vibeswitcher/issues/new/choose"
