                                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                                <Border CornerRadius="6" Background="#1FF5820A" BorderBrush="#40F5820A"
                                        BorderThickness="1" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                        ToolTip="Pair-programmed with Anthropic's Claude Code">
                                    <TextBlock Text="with Claude Code" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}"/>
                                </Border>
