<Window x:Class="VibeSwitcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VibeSwitcher.ViewModels"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        xmlns:controls="clr-namespace:VibeSwitcher.Controls"
        Title="VibeSwitcher"
        Icon="pack://application:,,,/Resources/Icons/vs-icon.ico"
        UseLayoutRounding="True"
        Width="920" Height="720"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBg}"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" GlassFrameThickness="0"
                      ResizeBorderThickness="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Filter chip icons (16-unit geometry) ─────────────── -->
        <Geometry x:Key="IcoPlayback">M2,6.5 H4.5 L8,3.5 V12.5 L4.5,9.5 H2 Z M11,6 Q12.8,8 11,10</Geometry>
        <Geometry x:Key="IcoRecording">M8,2.5 A1.8,1.8 0 0 1 9.8,4.3 V7 A1.8,1.8 0 0 1 6.2,7 V4.3 A1.8,1.8 0 0 1 8,2.5 Z M5,7.2 A3,3 0 0 0 11,7.2 M8,10.2 V12.5 M6,12.5 H10</Geometry>
        <Geometry x:Key="IcoBoth">M3.5,9 V7.5 A4.5,4.5 0 0 1 12.5,7.5 V9 M3,9.2 H5 V12.5 H3 Z M11,9.2 H13 V12.5 H11 Z</Geometry>
        <Geometry x:Key="IcoPin">M8,1.8 L9.9,5.7 L14.2,6.3 L11.1,9.3 L11.9,13.6 L8,11.5 L4.1,13.6 L4.9,9.3 L1.8,6.3 L6.1,5.7 Z</Geometry>
        <Geometry x:Key="IcoActive">M14,8 A6,6 0 1 1 2,8 A6,6 0 1 1 14,8 M5,8 L7,10 L11,5.5</Geometry>
        <Geometry x:Key="IcoSilent">M8,2.5 A4.5,4.5 0 0 0 3.5,7 V10 L2.5,11.5 H13.5 L12.5,10 V7 A4.5,4.5 0 0 0 8,2.5 Z M3,3 L13,13</Geometry>
        <Geometry x:Key="IcoHotkey">M2,4.5 H14 V11.5 H2 Z M4.5,7 H4.6 M7,7 H7.1 M9.5,7 H9.6 M12,7 H12.1 M5,9.5 H11</Geometry>
        <Geometry x:Key="IcoNotes">M4,2.5 H12 V13.5 H4 Z M6,5.5 H10 M6,8 H10 M6,10.5 H8.5</Geometry>
        <Geometry x:Key="IcoImage">M2.5,3.5 H13.5 V12.5 H2.5 Z M2.5,10.5 L6,7.5 L8.5,9.5 L11,7 L13.5,9.5 M5,6 A0.9,0.9 0 1 1 4.99,6 Z</Geometry>
        <Geometry x:Key="IcoSchedule">M12.5,9 A4.5,4.5 0 1 1 3.5,9 A4.5,4.5 0 1 1 12.5,9 M8,6 V9 L10.2,10.2 M4,5 A2.2,2.2 0 0 1 6.4,2.8 M12,5 A2.2,2.2 0 0 1 9.6,2.8 M5,13.2 L3.8,14.7 M11,13.2 L12.2,14.7</Geometry>
        <Geometry x:Key="IcoReminder">M8,2.5 A4.5,4.5 0 0 0 3.5,7 V10 L2.5,11.5 H13.5 L12.5,10 V7 A4.5,4.5 0 0 0 8,2.5 Z M6.5,12 A1.5,1.5 0 0 0 9.5,12</Geometry>
        <Geometry x:Key="IcoSound">M2.4,12.5 A1.6,1.6 0 1 0 5.6,12.5 A1.6,1.6 0 1 0 2.4,12.5 M5.6,12.5 V4 M8.4,11 A1.6,1.6 0 1 0 11.6,11 A1.6,1.6 0 1 0 8.4,11 M11.6,11 V2.7 M5.6,4 L11.6,2.7</Geometry>
        <Geometry x:Key="IcoWarning">M8,2.5 L14.5,13.5 H1.5 Z M8,6.5 V9.5 M8,11.2 V11.4</Geometry>

        <!-- ── Filter chip ──────────────────────────────────────── -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Padding"    Value="11,0"/>
            <Setter Property="Margin"     Value="0,0,7,7"/>
            <Setter Property="FontSize"   Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="15" BorderThickness="1"
                                BorderBrush="{DynamicResource VSBorder}"
                                Background="{DynamicResource VSSurface}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"   Value="#1FF5820A"/>
                                <Setter TargetName="Bg" Property="BorderBrush"  Value="#55F5820A"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background"  Value="{DynamicResource VSSurfaceHover}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource VSBorderStrong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter chip icon (stroke follows chip Foreground) -->
        <Style x:Key="FilterChipIcon" TargetType="Path">
            <Setter Property="Width"  Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- ── Clear-all link ───────────────────────────────────── -->
        <Style x:Key="ClearFilterButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FontSize"   Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Settings section card ────────────────────────────── -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="Padding"         Value="16,14"/>
        </Style>


        <!-- ── Day pill ─────────────────────────────────────────── -->
        <Style x:Key="DayPillStyle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="{DynamicResource ChipBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{DynamicResource ChipText}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource Accent}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Chip button ──────────────────────────────────────── -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource ChipBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{DynamicResource ChipText}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource ChipHoverBg}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Title bar button (min/max/close) ─────────────────── -->
        <!-- Mini-mode grid layout: square icon button, name on hover -->
        <Style x:Key="MiniGridBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource VSSurface}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource VSSurfaceHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#14F5820A"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Mini-mode profile row: the whole row is the activate button -->
        <Style x:Key="MiniRowBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource VSSurface}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource VSSurfaceHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#14F5820A"/>
                    <Setter Property="BorderBrush" Value="#66F5820A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"      Value="44"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource VSLabel}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable"  Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource VSGlassFill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C42B1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Nav icon button (FAQ / About / Settings) ─────────── -->
        <Style x:Key="NavIconBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"      Value="34"/>
            <Setter Property="Height"     Value="34"/>
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"   Value="#12F5820A"/>
                                <Setter TargetName="bg" Property="BorderBrush"  Value="#40F5820A"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Card action button (44×44) ─── -->
        <Style x:Key="CardActionBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"      Value="44"/>
            <Setter Property="Height"     Value="44"/>
            <Setter Property="Foreground" Value="{DynamicResource VSLabel}"/>
            <!-- Background/BorderBrush flow through TemplateBinding so per-button styles can show an
                 "enabled" state (orange/green/red tint when the feature is on) like the toggles do. -->
            <Setter Property="Background"  Value="{DynamicResource VSGlassFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VSGlassBorder}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Focusable"  Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource VSSurfaceHover}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource VSBorderStrong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardActionToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"      Value="44"/>
            <Setter Property="Height"     Value="44"/>
            <Setter Property="Foreground" Value="{DynamicResource VSLabel}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Focusable"  Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" CornerRadius="8"
                                Background="{DynamicResource VSGlassFill}" BorderBrush="{DynamicResource VSGlassBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="#1FF5820A"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#40F5820A"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource VSSurfaceHover}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource VSBorderStrong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Trigger>
                            <!-- Checked + hovered: keep the accent (checked) icon color while still showing the
                                 hover background. Declared last so it wins over the plain hover trigger — otherwise
                                 toggling the button on while the cursor is still on it shows no color change. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked"   Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource VSSurfaceHover}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#40F5820A"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact bell (silent) toggle for the Shortcuts mute rows — same icon/behavior as the
             profile card's silent toggle. Checked (accent) = no notification banner for that shortcut. -->
        <Style x:Key="MuteBannerToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"  Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource VSLabel}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" CornerRadius="7"
                                Background="{DynamicResource VSGlassFill}" BorderBrush="{DynamicResource VSGlassBorder}" BorderThickness="1">
                            <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M8,2 A5,5 0 0 0 3,7 V10 L2,12 H14 L13,10 V7 A5,5 0 0 0 8,2 Z" Fill="Transparent" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <Path Data="M6.5,13.5 A1.5,1.5 0 0 0 9.5,13.5" Fill="Transparent" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M2,2 L14,14" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="#1FF5820A"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#40F5820A"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource VSSurfaceHover}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource VSBorderStrong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked"   Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource VSSurfaceHover}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#40F5820A"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented radio button (Logo animation picker; mirrors the inline Theme picker style).
             GroupName is set per-instance so different pickers don't share a selection group. -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource VSLabel}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VSBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource VSBorderStrong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background"  Value="#1DF5820A"/>
                    <Setter Property="BorderBrush" Value="#38F5820A"/>
                    <Setter Property="Foreground"  Value="{DynamicResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Tooltip ──────────────────────────────────────────── -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource TooltipBg}"
                                BorderBrush="{DynamicResource TooltipBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                                  Opacity="0.18" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Back/nav button ──────────────────────────────────── -->
        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"   Value="32"/>
            <Setter Property="Height"  Value="32"/>
            <Setter Property="Cursor"  Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8"
                                Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Panel header title text ──────────────────────────── -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"     Value="12,0,0,0"/>
        </Style>

        <!-- ── Nav logo clickable button ────────────────────────── -->
        <Style x:Key="NavLogoBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- 5% orange was invisible over the light title bar — 10% reads in both themes -->
                                <Setter TargetName="bg" Property="Background" Value="#1AF5820A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── About / external link chip ──────────────────────── -->
        <Style x:Key="LinkChipStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource VSInsetBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VSBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource VSLabel}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#12F5820A"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#55F5820A"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Settings sidebar nav styles ───────────────────────── -->
        <Style x:Key="SettingsNavLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="9"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="Foreground"       Value="{DynamicResource SectionLabelText}"/>
            <Setter Property="Margin"           Value="10,8,10,5"/>
        </Style>

        <Style x:Key="SettingsNavItemStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{DynamicResource VSLabel}"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="10,8"/>
            <Setter Property="FontSize"                   Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Width"                      Value="152"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="FocusVisualStyle"           Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource VSSurface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ── Outer 4-row layout ─────────────────────────────────────── -->
    <Grid Background="{DynamicResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>   <!-- TitleBar -->
            <RowDefinition x:Name="NavRowDef" Height="54"/>   <!-- TopNav (0 in mini mode) -->
            <RowDefinition Height="Auto"/> <!-- FilterBar -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             ROW 0 — Title Bar
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource VSTitleBarBg}"
                BorderBrush="{DynamicResource VSSurface}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: title (draggable via WindowChrome caption area) -->
                <StackPanel x:Name="FullTitleGroup" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Resources/Icons/vs-icon-32.png"
                           Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="VibeSwitcher"
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Left (mini mode): animated logo + title + mini-mode keybind -->
                <StackPanel x:Name="MiniTitleGroup" Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed">
                    <controls:NavLogoIcon Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="VibeSwitcher"
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource VSInsetBg}" BorderBrush="{DynamicResource InputBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                            VerticalAlignment="Center" ToolTip="Mini Mode shortcut">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CompactHotkeyDisplay}" Value="None">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CompactHotkeyDisplay}" FontFamily="Courier New"
                                   FontSize="9.5" Foreground="{DynamicResource VSLabel}"/>
                    </Border>
                </StackPanel>

                <!-- Right: shrink-to-mini / pin / expand / min / max / close -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="TitleShrinkBtn" Style="{StaticResource TitleBarBtn}"
                            Click="TitleShrink_Click" ToolTip="Switch to Mini Mode">
                        <Path Data="{StaticResource IcoCompact}" Stretch="Uniform" Width="11" Height="11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"/>
                    </Button>
                    <Button x:Name="TitlePinBtn" Click="TitlePin_Click" Visibility="Collapsed"
                            ToolTip="Keep mini window on top">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CompactAlwaysOnTop}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M5.5,2 H10.5 M6.5,2 V6 L4,8.5 H12 L9.5,6 V2 M8,8.5 V13.5"
                              Stretch="Uniform" Width="11" Height="11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"/>
                    </Button>
                    <Button x:Name="TitleExpandBtn" Style="{StaticResource TitleBarBtn}"
                            Click="TitleExpand_Click" Visibility="Collapsed" ToolTip="Back to full window">
                        <Path Data="{StaticResource IcoExpand}" Stretch="Uniform" Width="11" Height="11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarBtn}"
                            Content="─" FontSize="11"
                            Click="TitleMinimize_Click"/>
                    <Button x:Name="TitleMaxBtn" Style="{StaticResource TitleBarBtn}"
                            Content="□"
                            Click="TitleMaximize_Click"/>
                    <Button Style="{StaticResource TitleBarCloseBtn}"
                            Content="✕"
                            Click="TitleClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             ROW 1 — Top Navigation Bar
             ══════════════════════════════════════════════════════════ -->
        <Border x:Name="NavBar" Grid.Row="1"
                Background="{DynamicResource VSNavBg}"
                BorderBrush="{DynamicResource VSNavBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- logo -->
                    <ColumnDefinition Width="*"/>     <!-- search area -->
                    <ColumnDefinition Width="Auto"/>  <!-- right buttons -->
                </Grid.ColumnDefinitions>

                <!-- Logo: animated icon + VibeSwitcher — click to go home -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavLogoBtn}" Click="NavLogo_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:NavLogoIcon Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Accent}">VibeSwitcher</TextBlock>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="22" Background="{DynamicResource InputBorder}" Margin="12,0,12,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search + Filters (profile view) -->
                <Grid x:Name="SearchFiltersPanel" Grid.Column="1"
                      VerticalAlignment="Center" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="280"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Search box with placeholder -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <TextBox x:Name="NavSearchBox"
                                 MinWidth="110" Height="32"
                                 HorizontalAlignment="Stretch"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" VerticalContentAlignment="Center"
                                 Padding="10,0"/>
                        <TextBlock Text="Search profiles..." FontSize="12.5" FontStyle="Italic"
                                   Foreground="{DynamicResource DisabledText}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFocused, ElementName=NavSearchBox}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <!-- Filters toggle button -->
                    <Button x:Name="FiltersToggleBtn" Grid.Column="1"
                            Height="32" Padding="10,0" Cursor="Hand"
                            Style="{StaticResource ActionButton}"
                            Click="FiltersBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M2.5,3.5 H13.5 L9,8.5 V12.5 L7,11 V8.5 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Filters" FontSize="12" VerticalAlignment="Center"/>
                            <Border x:Name="FilterCountBadge"
                                    Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource Accent}"
                                    Margin="6,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAnyFilterActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ActiveFilterCount}"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppBg}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Right: nav icon buttons + add profile + logs -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavAboutBtn"
                            Style="{StaticResource NavIconBtn}"
                            Margin="0,0,4,0"
                            ToolTip="About VibeSwitcher"
                            Click="NavAbout_Click">
                        <Path Data="{StaticResource IcoInfo}" Width="17" Height="17" Stretch="Uniform"
                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="NavFaqBtn"
                            Style="{StaticResource NavIconBtn}"
                            Margin="0,0,4,0"
                            ToolTip="Help &amp; FAQ"
                            Click="NavFaq_Click">
                        <Path Data="{StaticResource IcoHelp}" Width="17" Height="17" Stretch="Uniform"
                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="NavSettingsBtn"
                            Style="{StaticResource NavIconBtn}"
                            Margin="0,0,12,0"
                            ToolTip="Settings"
                            Click="NavSettings_Click">
                        <Path Data="{StaticResource IcoSettings}" Width="17" Height="17" Stretch="Uniform"
                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Border Width="1" Height="22" Background="{DynamicResource InputBorder}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddProfileCommand}"
                            Padding="10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="+" FontSize="16" FontWeight="Light"
                                       Margin="0,-3,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="New Profile" FontSize="11.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LogsButton"
                            Visibility="Collapsed" Margin="8,0,0,0"
                            Style="{StaticResource ActionButton}"
                            Click="LogsButton_Click">
                        <TextBlock x:Name="LogsButtonText" FontSize="11" Foreground="{DynamicResource WarningText}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             ROW 2 — Filter Bar (animated MaxHeight 0 ↔ 115)
             ══════════════════════════════════════════════════════════ -->
        <Border x:Name="FilterBarBorder" Grid.Row="2"
                MaxHeight="0" ClipToBounds="True"
                IsEnabled="False"
                Background="{DynamicResource AppBg}"
                BorderBrush="{DynamicResource VSSurface}" BorderThickness="0,0,0,1">
            <StackPanel Margin="18,9,18,9">
                <views:CenteredWrapPanel>
                    <ToggleButton IsChecked="{Binding ModePlayback}" Style="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoPlayback}" Style="{StaticResource FilterChipIcon}"/>
                            <TextBlock Text="Playback only" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ModeRecording}" Style="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoRecording}" Style="{StaticResource FilterChipIcon}"/>
                            <TextBlock Text="Recording only" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ModeBoth}" Style="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoBoth}" Style="{StaticResource FilterChipIcon}"/>
                            <TextBlock Text="Both devices" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding PinnedFilter}" Style="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoPin}" Style="{StaticResource FilterChipIcon}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Stroke="{x:Null}"/>
                            <TextBlock Text="Pinned" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ActiveFilter}" Style="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoActive}" Style="{StaticResource FilterChipIcon}"/>
                            <TextBlock Text="Active" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding SilentFilter}" Style="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoSilent}" Style="{StaticResource FilterChipIcon}"/>
                            <TextBlock Text="Silent" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding HotkeyFilter}" Style="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoHotkey}" Style="{StaticResource FilterChipIcon}"/>
                            <TextBlock Text="Has hotkey" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding NotesFilter}" Style="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoNotes}" Style="{StaticResource FilterChipIcon}"/>
                            <TextBlock Text="Has notes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IconFilter}" Style="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoImage}" Style="{StaticResource FilterChipIcon}"/>
                            <TextBlock Text="Has icon" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ScheduledFilter}" Style="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoSchedule}" Style="{StaticResource FilterChipIcon}"/>
                            <TextBlock Text="Scheduled" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ReminderFilter}" Style="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoReminder}" Style="{StaticResource FilterChipIcon}"/>
                            <TextBlock Text="Has reminder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding SoundFilter}" Style="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoSound}" Style="{StaticResource FilterChipIcon}"/>
                            <TextBlock Text="Has sound" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding WarningFilter}" Style="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoWarning}" Style="{StaticResource FilterChipIcon}"/>
                            <TextBlock Text="Has warning" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Content="✕ Clear"
                            Command="{Binding ClearFiltersCommand}"
                            Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ClearFilterButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnyFilterActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </views:CenteredWrapPanel>
                <!-- Day chips -->
                <ItemsControl ItemsSource="{Binding DayChips}" Margin="0,6,0,0">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ScheduledFilter}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <views:CenteredWrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DayChip}">
                            <ToggleButton Content="{Binding Label}"
                                          IsChecked="{Binding IsSelected}"
                                          Style="{StaticResource FilterChip}"
                                          Margin="0,0,4,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             ROW 3 — Main Content (4 panels share this Grid)
             ══════════════════════════════════════════════════════════ -->
        <Grid x:Name="MainGrid" Grid.Row="3">

            <!-- ── PANEL A: Profiles ─────────────────────────────── -->
            <ScrollViewer x:Name="ProfilesPanel"
                          Focusable="True"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,18,18,18">

                    <!-- Grid header -->
                    <Grid Margin="0,0,0,13">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PROFILES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource VSSurface}" CornerRadius="10" Margin="8,0,0,0"
                                    Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Profiles.Count}" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                            </Border>
                        </StackPanel>
                        <Button Content="Sound Settings"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ActionButton}"
                                FontSize="11"
                                Click="OpenSoundSettings_Click"/>
                    </Grid>

                    <!-- Compact card grid -->
                    <ItemsControl ItemsSource="{Binding Profiles}"
                                  KeyboardNavigation.DirectionalNavigation="Contained">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:CenteredWrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProfileCardViewModel}">

                                <Grid Width="310" Margin="0,0,14,14"
                                      VerticalAlignment="Top"
                                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">

                                    <Border x:Name="CardBg"
                                            CornerRadius="14" ClipToBounds="True"
                                            BorderThickness="1" Cursor="Hand"
                                            AllowDrop="True"
                                            DragEnter="Card_DragEnter"
                                            DragLeave="Card_DragLeave"
                                            DragOver="Card_DragOver"
                                            Drop="Card_Drop">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"   Value="{DynamicResource CardBg}"/>
                                                <Setter Property="BorderBrush"  Value="{DynamicResource CardBorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#4DF5820A"/>
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                    <GradientStop Color="{DynamicResource VSActiveGradTop}" Offset="0"/>
                                                                    <GradientStop Color="{DynamicResource VSActiveGradBot}" Offset="0.4"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource InnerCardBorderBrush}"/>
                                                        <Setter Property="Background"  Value="{DynamicResource InnerCardBg}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>   <!-- main content -->
                                                <RowDefinition Height="Auto"/><!-- action strip -->
                                            </Grid.RowDefinitions>

                                            <!-- Active bar (top accent line) -->
                                            <Border Grid.RowSpan="2" Height="2"
                                                    VerticalAlignment="Top" Margin="12,0"
                                                    Panel.ZIndex="5"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="Transparent" Offset="0"/>
                                                        <GradientStop Color="{DynamicResource AccentColor}"     Offset="0.5"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <!-- Main content — transparent click button -->
                                            <Button Grid.Row="0"
                                                    OverridesDefaultStyle="True"
                                                    Background="Transparent" BorderThickness="0"
                                                    Focusable="True"
                                                    FocusVisualStyle="{StaticResource AccentFocusVisual}"
                                                    ToolTip="Open profile settings"
                                                    Tag="{Binding}"
                                                    Click="ProfileCard_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>

                                                <StackPanel Margin="0,20,0,10" HorizontalAlignment="Center">
                                                    <!-- Icon area -->
                                                    <Border Width="90" Height="90" CornerRadius="20"
                                                            HorizontalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background"   Value="{DynamicResource VSSurface}"/>
                                                                <Setter Property="BorderBrush"  Value="{DynamicResource VSBorder}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#47F5820A"/>
                                                                        <Setter Property="Effect">
                                                                            <Setter.Value>
                                                                                <DropShadowEffect Color="{DynamicResource AccentColor}" Opacity="0.1" BlurRadius="18" ShadowDepth="0"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <controls:AboutLogoIcon Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <controls:AboutLogoIcon.Style>
                                                                    <Style TargetType="controls:AboutLogoIcon">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasCustomIcon}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </controls:AboutLogoIcon.Style>
                                                            </controls:AboutLogoIcon>
                                                            <Image Source="{Binding IconPreview}" Width="72" Height="72" Stretch="Uniform"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasCustomIcon}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Name -->
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryText}"
                                                               HorizontalAlignment="Center"
                                                               MaxWidth="220"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,10,0,0"/>

                                                    <!-- Mode chip — same geometry as every other card chip; brand orange for all modes -->
                                                    <Border Margin="0,8,0,0" CornerRadius="6" Padding="8,3"
                                                            HorizontalAlignment="Center"
                                                            Background="#1FF5820A" BorderBrush="#40F5820A" BorderThickness="1">
                                                        <TextBlock Text="{Binding ModeLabel}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Accent}"/>
                                                    </Border>

                                                    <!-- Separator (mode → sections) -->
                                                    <Border Height="1" Background="{DynamicResource VSHairline}" Margin="0,10,0,0" Width="220"/>

                                                    <!-- Schedule & sound section — its own separator-delimited block between the
                                                         mode chip and the devices; chips share the mode chip's orange palette -->
                                                    <StackPanel Visibility="{Binding HasVisibilityChips, Converter={StaticResource BoolToVis}}">
                                                        <!-- Schedule chip — one schedule edits directly; several open the manage dialog -->
                                                        <Button Command="{Binding ManageSchedulesCommand}"
                                                                Click="ChipButton_Click"
                                                                Cursor="Hand" FocusVisualStyle="{StaticResource AccentFocusVisual}"
                                                                HorizontalAlignment="Center" Margin="0,8,0,0"
                                                                ToolTip="Click to view or edit schedules"
                                                                Visibility="{Binding HasSchedules, Converter={StaticResource BoolToVis}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd"
                                                                                        Background="#1FF5820A"
                                                                                        BorderBrush="#40F5820A"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="6"
                                                                                        Padding="8,3">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#33F5820A"/>
                                                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#66F5820A"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Viewbox Width="9" Height="9" Margin="0,0,5,0">
                                                                    <Canvas Width="16" Height="16">
                                                                        <Path Data="M12.5,9 A4.5,4.5 0 1 1 3.5,9 A4.5,4.5 0 1 1 12.5,9 M8,6 V9 L10.2,10.2 M4,5 A2.2,2.2 0 0 1 6.4,2.8 M12,5 A2.2,2.2 0 0 1 9.6,2.8 M5,13.2 L3.8,14.7 M11,13.2 L12.2,14.7"
                                                                              Fill="Transparent" Stroke="{DynamicResource Accent}"
                                                                              StrokeThickness="1.4" StrokeStartLineCap="Round"
                                                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                                <TextBlock Text="{Binding ScheduleSummaryText}"
                                                                           FontFamily="Consolas" FontSize="10"
                                                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Sound chip — clickable, opens sound configuration -->
                                                        <Button Command="{Binding ConfigureSoundCommand}"
                                                                Click="ChipButton_Click"
                                                                Cursor="Hand" FocusVisualStyle="{StaticResource AccentFocusVisual}"
                                                                HorizontalAlignment="Center" Margin="0,6,0,0"
                                                                ToolTip="Click to configure switch sound"
                                                                Visibility="{Binding SoundOverride, Converter={StaticResource BoolToVis}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd"
                                                                                        Background="#1FF5820A"
                                                                                        BorderBrush="#40F5820A"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="6"
                                                                                        Padding="8,3">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#33F5820A"/>
                                                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#66F5820A"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Viewbox Width="9" Height="9" Margin="0,0,5,0">
                                                                    <Canvas Width="16" Height="16">
                                                                        <Path Data="M2.4,12.5 A1.6,1.6 0 1 0 5.6,12.5 A1.6,1.6 0 1 0 2.4,12.5 M5.6,12.5 V4 M8.4,11 A1.6,1.6 0 1 0 11.6,11 A1.6,1.6 0 1 0 8.4,11 M11.6,11 V2.7 M5.6,4 L11.6,2.7"
                                                                              Fill="Transparent" Stroke="{DynamicResource Accent}"
                                                                              StrokeThickness="1.7" StrokeStartLineCap="Round"
                                                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                                <TextBlock Text="{Binding SoundSummary}"
                                                                           FontFamily="Consolas" FontSize="10"
                                                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Separator (schedule/sound → devices) -->
                                                        <Border Height="1" Background="{DynamicResource VSHairline}" Margin="0,10,0,0" Width="220"/>
                                                    </StackPanel>

                                                    <!-- Device chips — same geometry as the rest, neutral palette -->
                                                    <Border CornerRadius="6" Background="{DynamicResource HotkeyBg}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            Padding="8,3" HorizontalAlignment="Center" Margin="0,8,0,0"
                                                            Visibility="{Binding PlaybackVisible}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Viewbox Width="10" Height="10" Margin="0,0,5,0">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M2.5,6 H5.5 L9.5,2.5 V13.5 L5.5,10 H2.5 Z M11.5,5.5 A3.6,3.6 0 0 1 11.5,10.5"
                                                                          Fill="Transparent" Stroke="{DynamicResource VSLabel}"
                                                                          StrokeThickness="1.4" StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                            <TextBlock Text="{Binding SelectedPlaybackDevice.FriendlyName}"
                                                                       FontSize="10" Foreground="{DynamicResource VSLabel}"
                                                                       VerticalAlignment="Center"
                                                                       MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border CornerRadius="6" Background="{DynamicResource HotkeyBg}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            Padding="8,3" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                            Visibility="{Binding RecordingVisible}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Viewbox Width="10" Height="10" Margin="0,0,5,0">
                                                                <Canvas Width="16" Height="16">
                                                                    <Rectangle Canvas.Left="6" Canvas.Top="1.5" Width="4" Height="7.5"
                                                                               RadiusX="2" RadiusY="2"
                                                                               Fill="Transparent" Stroke="{DynamicResource VSLabel}"
                                                                               StrokeThickness="1.4"/>
                                                                    <Path Data="M4,7.5 A4,4 0 0 0 12,7.5 M8,11.5 V14 M5.5,14 H10.5"
                                                                          Fill="Transparent" Stroke="{DynamicResource VSLabel}"
                                                                          StrokeThickness="1.4" StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                            <TextBlock Text="{Binding SelectedRecordingDevice.FriendlyName}"
                                                                       FontSize="10" Foreground="{DynamicResource VSLabel}"
                                                                       VerticalAlignment="Center"
                                                                       MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Hotkey chip -->
                                                    <Border CornerRadius="6" Background="{DynamicResource HotkeyBg}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            Padding="8,3"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,6,0,0"
                                                            Visibility="{Binding IsHotkeySet, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#x2328;" FontSize="9" Foreground="{DynamicResource VSLabel}"
                                                                       VerticalAlignment="Center" Margin="0,-4,5,0"/>
                                                            <TextBlock Text="{Binding HotkeyDisplay}"
                                                                       FontFamily="Consolas" FontSize="10"
                                                                       Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Button>

                                            <!-- Always-visible action strip. The bottom corner radius (card radius 14 minus the 1px
                                                 border) keeps the strip's fill from painting square corners over the card's rounded
                                                 border stroke — without it the orange active border looks cut at the bottom corners. -->
                                            <Border Grid.Row="1" BorderBrush="{DynamicResource VSHairline}" BorderThickness="0,1,0,0"
                                                    CornerRadius="0,0,13,13"
                                                    Padding="10,7,10,9" Background="{DynamicResource VSStripOverlay}">
                                                <StackPanel>
                                                    <!-- Row 1: 5 buttons, space-between -->
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- 1. Silent — bell with slash -->
                                                        <ToggleButton Grid.Column="0" HorizontalAlignment="Center"
                                                                      IsChecked="{Binding Silent}"
                                                                      ToolTip="Toggle silent mode">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource CardActionToggle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SoundOverride}" Value="True">
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                            <Setter Property="Opacity" Value="0.35"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M8,2 A5,5 0 0 0 3,7 V10 L2,12 H14 L13,10 V7 A5,5 0 0 0 8,2 Z"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                    <Path Data="M6.5,13.5 A1.5,1.5 0 0 0 9.5,13.5"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                    <Path Data="M2,2 L14,14"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </ToggleButton>
                                                        <!-- 2. App triggers — lightning bolt -->
                                                        <Button Grid.Column="1" HorizontalAlignment="Center"
                                                                Command="{Binding OpenAppTriggersCommand}"
                                                                ToolTip="App launch triggers">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasAppTriggers}" Value="True">
                                                                            <Setter Property="Foreground"  Value="{DynamicResource Accent}"/>
                                                                            <Setter Property="Background"  Value="#1FF5820A"/>
                                                                            <Setter Property="BorderBrush" Value="#40F5820A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M10,1.5 L3.5,9.5 H7.5 L6,14.5 L13.5,6.5 H9.5 Z"
                                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                        <!-- 3. Auto-switch — power plug (dim when Recording-only, not supported) -->
                                                        <ToggleButton Grid.Column="2" HorizontalAlignment="Center"
                                                                      IsChecked="{Binding TriggerOnConnect}"
                                                                      ToolTip="Auto-switch on device connect">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource CardActionToggle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TriggerOnConnectVisible}" Value="Collapsed">
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                            <Setter Property="Opacity" Value="0.28"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M6,1.5 L6,5 M10,1.5 L10,5 M3.5,5 H12.5 V7.5 A4.5,4.5 0 0 1 8,12 A4.5,4.5 0 0 1 3.5,7.5 Z M8,12 L8,14.5 M6,14.5 L10,14.5"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </ToggleButton>
                                                        <!-- 4. Favorite/Pin — filled star -->
                                                        <ToggleButton Grid.Column="3" HorizontalAlignment="Center"
                                                                      IsChecked="{Binding IsPinned}"
                                                                      Style="{StaticResource CardActionToggle}"
                                                                      ToolTip="Pin to top of list">
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M8,1.5 L10.2,5.8 L15,6.4 L11.5,9.8 L12.4,14.5 L8,12.1 L3.6,14.5 L4.5,9.8 L1,6.4 L5.8,5.8 Z"
                                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </ToggleButton>
                                                        <!-- 5. Activate — circle + checkmark -->
                                                        <Button Grid.Column="4" HorizontalAlignment="Center"
                                                                Command="{Binding ActivateCommand}"
                                                                ToolTip="Activate this profile">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Foreground"  Value="{DynamicResource VSGreen}"/>
                                                                            <Setter Property="Background"  Value="#1F30D278"/>
                                                                            <Setter Property="BorderBrush" Value="#4030D278"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <!-- Power symbol: broken ring + vertical stroke -->
                                                                    <Path Data="M11.2,4.1 A5.4,5.4 0 1 1 4.8,4.1 M8,1.2 L8,7.6"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                    <!-- Row 2: 3 buttons (clone lives in the profile detail), centered with even gaps -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <!-- 6. Schedule — clock with hands -->
                                                        <Button Margin="10,0"
                                                                Command="{Binding AddScheduleCommand}" ToolTip="Schedule this profile">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasSchedules}" Value="True">
                                                                            <Setter Property="Foreground"  Value="{DynamicResource Accent}"/>
                                                                            <Setter Property="Background"  Value="#1FF5820A"/>
                                                                            <Setter Property="BorderBrush" Value="#40F5820A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M12.5,9 A4.5,4.5 0 1 1 3.5,9 A4.5,4.5 0 1 1 12.5,9 M8,6 V9 L10.2,10.2 M4,5 A2.2,2.2 0 0 1 6.4,2.8 M12,5 A2.2,2.2 0 0 1 9.6,2.8 M5,13.2 L3.8,14.7 M11,13.2 L12.2,14.7"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                        <!-- 7. Sound — music notes -->
                                                        <Button Margin="10,0"
                                                                Command="{Binding ConfigureSoundCommand}" ToolTip="Configure switch sound">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SoundOverride}" Value="True">
                                                                            <Setter Property="Foreground"  Value="{DynamicResource Accent}"/>
                                                                            <Setter Property="Background"  Value="#1FF5820A"/>
                                                                            <Setter Property="BorderBrush" Value="#40F5820A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M2.4,12.5 A1.6,1.6 0 1 0 5.6,12.5 A1.6,1.6 0 1 0 2.4,12.5 M5.6,12.5 V4 M8.4,11 A1.6,1.6 0 1 0 11.6,11 A1.6,1.6 0 1 0 8.4,11 M11.6,11 V2.7 M5.6,4 L11.6,2.7"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                        <!-- 8. Delete — trash can, always red so the danger action is unmistakable -->
                                                        <Button Margin="10,0"
                                                                Command="{Binding DeleteCommand}" ToolTip="Delete this profile">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
                                                                    <Setter Property="Foreground"  Value="{DynamicResource ErrorText}"/>
                                                                    <Setter Property="Background"  Value="#1FE13737"/>
                                                                    <Setter Property="BorderBrush" Value="#40E13737"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M2,4 H14 M5.5,4 V2.5 H10.5 V4 M3.5,4 L4.3,13.5 H11.7 L12.5,4"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Save flash overlay -->
                                    <Border x:Name="FlashOverlay"
                                            CornerRadius="14"
                                            Background="{DynamicResource SaveFlashBg}"
                                            Opacity="0" IsHitTestVisible="False"/>

                                </Grid>

                                <DataTemplate.Triggers>
                                    <!-- Save flash -->
                                    <DataTrigger Binding="{Binding SaveFlash}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="FlashOverlay"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0.7" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="FlashOverlay"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.28"
                                                                     FillBehavior="Stop"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- No filter results -->
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource DisabledText}"
                               FontSize="13" Margin="0,32,0,8"
                               Text="No profiles match your filters.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoFilterResults}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Empty state -->
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource DisabledText}"
                               FontSize="13" Margin="0,32,0,24"
                               Text="No profiles yet — click + New Profile to get started.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoProfiles}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>

            <!-- ── PANEL B: Settings ──────────────────────────────── -->
            <Grid x:Name="SettingsBodyScrollViewer" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR -->
                <Border Grid.Column="0" Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="8,12,8,0">
                            <TextBlock Text="GENERAL" Style="{StaticResource SettingsNavLabelStyle}"/>

                            <!-- Startup -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="startup">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsNavItemStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStartupSelected}" Value="True">
                                                <Setter Property="Background" Value="#0FF5820A"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M 8,1.5 c 0,0 4,2.5 4,7.5 a 4,4 0 0 1 -8,0 c 0,-5 4,-7.5 4,-7.5 Z M 8,14 L 8,12 M 5.5,13 L 5.5,11.2 M 10.5,13 L 10.5,11.2"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Startup" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Appearance -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="appear">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsNavItemStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAppearSelected}" Value="True">
                                                <Setter Property="Background" Value="#0FF5820A"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Ellipse Canvas.Left="5" Canvas.Top="5" Width="6" Height="6"
                                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                     StrokeThickness="1.6" Fill="Transparent"/>
                                            <Path Data="M 8,1.5 L 8,2.5 M 8,13.5 L 8,14.5 M 1.5,8 L 2.5,8 M 13.5,8 L 14.5,8 M 3.3,3.3 L 4,4 M 12,12 L 12.7,12.7 M 12,3.3 L 11.3,4 M 4,12 L 3.3,12.7"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Appearance" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Notifications -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="notif">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsNavItemStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNotifSelected}" Value="True">
                                                <Setter Property="Background" Value="#0FF5820A"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M 8,2 a 5,5 0 0 0 -5,5 v 3 l -1,2 h 12 l -1,-2 V 7 a 5,5 0 0 0 -5,-5 Z M 6.5,13.5 a 1.5,1.5 0 0 0 3,0"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Notifications" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Devices -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="devices">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsNavItemStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDevicesSelected}" Value="True">
                                                <Setter Property="Background" Value="#0FF5820A"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M 5,6 H 3 a 1,1 0 0 0 -1,1 v 2 a 1,1 0 0 0 1,1 h 2 l 3.5,2.5 V 3.5 Z M 10.5,6 a 2.5,2.5 0 0 1 0,4"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Devices" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Tray -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="tray">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsNavItemStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTraySelected}" Value="True">
                                                <Setter Property="Background" Value="#0FF5820A"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M 4.5,1.5 H 11.5 A 3,3 0 0 1 14.5,4.5 V 11.5 A 3,3 0 0 1 11.5,14.5 H 4.5 A 3,3 0 0 1 1.5,11.5 V 4.5 A 3,3 0 0 1 4.5,1.5 Z M 1.5,10.5 H 14.5"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Fill="Transparent"/>
                                            <Ellipse Canvas.Left="4.2" Canvas.Top="11.7" Width="1.6" Height="1.6"
                                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Tray" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Shortcuts -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="shortcuts">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsNavItemStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShortcutsSelected}" Value="True">
                                                <Setter Property="Background" Value="#0FF5820A"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M 3,3.5 H 13 A 2,2 0 0 1 15,5.5 V 11.5 A 2,2 0 0 1 13,13.5 H 3 A 2,2 0 0 1 1,11.5 V 5.5 A 2,2 0 0 1 3,3.5 Z M 4,11 L 12,11"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Fill="Transparent"/>
                                            <Path Data="M 4,8 L 4.01,8 M 7.5,8 L 7.51,8 M 11,8 L 11.01,8"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Shortcuts" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Mini Window -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="compact">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsNavItemStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactSelected}" Value="True">
                                                <Setter Property="Background" Value="#0FF5820A"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="{StaticResource IcoCompact}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Mini Window" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Logs -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="logs">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsNavItemStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLogsSelected}" Value="True">
                                                <Setter Property="Background" Value="#0FF5820A"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M 2,3 H 14 M 2,7 H 10 M 2,11 H 12"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Logs" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Uninstall (installed copies only — hidden for portable) -->
                            <Button x:Name="UninstallNavBtn" Command="{Binding SelectCategoryCommand}" CommandParameter="uninstall">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsNavItemStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUninstallSelected}" Value="True">
                                                <Setter Property="Background" Value="#0FF5820A"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="{StaticResource IcoTrash}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Install &amp; Updates" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Back button at bottom of sidebar -->
                        <Button Grid.Row="1" Style="{StaticResource SettingsNavItemStyle}"
                                Margin="8,4,8,14" Click="NavProfiles_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13">
                                    <Canvas Width="14" Height="14">
                                        <Path Data="M 9,2 L 4,7 L 9,12"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Back" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- RIGHT CONTENT -->
                <ScrollViewer Grid.Column="1" Focusable="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,20,22,20">

                        <!-- ── Startup ──────────────────────── -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStartupSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Startup" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,16"/>
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <Grid Margin="14,10">
                                        <TextBlock Text="Start with Windows" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartWithWindows}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <Grid Margin="14,10">
                                        <TextBlock Text="Start minimized to tray" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartMinimized}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <Grid Margin="14,10">
                                        <TextBlock Text="Close to tray" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CloseToTray}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Appearance ───────────────────── -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAppearSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Appearance" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,16"/>
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <!-- Theme picker row -->
                                    <Grid Margin="14,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Theme" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <StackPanel.Resources>
                                                <Style TargetType="RadioButton">
                                                    <Setter Property="GroupName" Value="ThemeGroup2"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="FontSize" Value="11.5"/>
                                                    <Setter Property="Padding" Value="10,4"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource VSLabel}"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource VSBorder}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                                    <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="RadioButton">
                                                                <Border x:Name="Bg"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                      Margin="{TemplateBinding Padding}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource VSBorderStrong}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Background"  Value="#1DF5820A"/>
                                                            <Setter Property="BorderBrush" Value="#38F5820A"/>
                                                            <Setter Property="Foreground"  Value="{DynamicResource Accent}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Resources>
                                            <RadioButton Content="Follow Windows" Tag="Auto" Checked="ThemeRadio_Checked">
                                                <RadioButton.Style>
                                                    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Theme}" Value="Follow Windows">
                                                                <Setter Property="IsChecked" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </RadioButton.Style>
                                            </RadioButton>
                                            <RadioButton Content="Light" Tag="Light" Checked="ThemeRadio_Checked">
                                                <RadioButton.Style>
                                                    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Theme}" Value="Light">
                                                                <Setter Property="IsChecked" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </RadioButton.Style>
                                            </RadioButton>
                                            <RadioButton Content="Dark" Tag="Dark" Margin="0" Checked="ThemeRadio_Checked">
                                                <RadioButton.Style>
                                                    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Theme}" Value="Dark">
                                                                <Setter Property="IsChecked" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </RadioButton.Style>
                                            </RadioButton>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <!-- Logo animation row -->
                                    <Grid Margin="14,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Logo animation" FontSize="12.5" Foreground="{DynamicResource VSLabel}"/>
                                            <TextBlock Text="Lower it or turn it off to reduce CPU while the window is open" FontSize="10.5" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton Content="Full" Tag="Full" GroupName="LogoAnimGroup" Checked="LogoAnimRadio_Checked">
                                                <RadioButton.Style>
                                                    <Style TargetType="RadioButton" BasedOn="{StaticResource SegmentRadio}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LogoAnimation}" Value="Full">
                                                                <Setter Property="IsChecked" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </RadioButton.Style>
                                            </RadioButton>
                                            <RadioButton Content="Reduced" Tag="Reduced" GroupName="LogoAnimGroup" Checked="LogoAnimRadio_Checked">
                                                <RadioButton.Style>
                                                    <Style TargetType="RadioButton" BasedOn="{StaticResource SegmentRadio}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LogoAnimation}" Value="Reduced">
                                                                <Setter Property="IsChecked" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </RadioButton.Style>
                                            </RadioButton>
                                            <RadioButton Content="Static" Tag="Static" Margin="0" GroupName="LogoAnimGroup" Checked="LogoAnimRadio_Checked">
                                                <RadioButton.Style>
                                                    <Style TargetType="RadioButton" BasedOn="{StaticResource SegmentRadio}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LogoAnimation}" Value="Static">
                                                                <Setter Property="IsChecked" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </RadioButton.Style>
                                            </RadioButton>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <Grid Margin="14,10">
                                        <TextBlock Text="Use 24-hour clock" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Use24HourClock}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Notifications ────────────────── -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNotifSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Notifications" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,16"/>
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" CornerRadius="10">
                                <Grid Margin="14,10">
                                    <TextBlock Text="Show device switch alerts" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShowNotifications}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ── Devices ───────────────────────── -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDevicesSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Devices" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,16"/>
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <Grid Margin="14,10">
                                        <TextBlock Text="Use legacy sound panel" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding UseLegacySoundPanel}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <Grid Margin="14,10">
                                        <TextBlock Text="Show disabled devices in dropdowns" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShowDisabledDevices}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <Grid Margin="14,10">
                                        <TextBlock Text="Show disconnected devices in dropdowns" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShowDisconnectedDevices}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <StackPanel Margin="14,10">
                                        <Button Content="Open Sound Settings" Style="{StaticResource ActionButton}"
                                                HorizontalAlignment="Left" Click="OpenSoundSettings_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Device Aliases -->
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0">
                                <StackPanel Margin="14,12">
                                    <TextBlock Text="DEVICE ALIASES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SectionLabelText}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Give your audio devices custom display names to make profiles easier to read."
                                               FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="Manage Aliases…" Style="{StaticResource ActionButton}"
                                            HorizontalAlignment="Left" Click="ManageAliasesButton_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Backup & Restore -->
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0">
                                <StackPanel Margin="14,12">
                                    <TextBlock Text="BACKUP &amp; RESTORE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SectionLabelText}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Save your profiles to a file, or restore from a previous backup."
                                               FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Export Config" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="ExportButton_Click"/>
                                        <Button Content="Import Config" Style="{StaticResource ActionButton}" Click="ImportButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Tray ──────────────────────────── -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTraySelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Tray" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,16"/>
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" CornerRadius="10">
                                <Grid Margin="14,10">
                                    <TextBlock Text="Left-click tray icon cycles profiles" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LeftClickCyclesProfiles}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ── Shortcuts ─────────────────────── -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShortcutsSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Shortcuts" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,16"/>
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <!-- Open / Close VibeSwitcher -->
                                    <Grid Margin="14,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Open / Close VibeSwitcher" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{DynamicResource VSInsetBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SettingsHotkeyDisplay}" FontFamily="Courier New" FontSize="11" Foreground="{DynamicResource VSLabel}" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SettingsHotkeyDisplay}" Value="None">
                                                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button Grid.Column="2" Content="Set" Style="{StaticResource ActionButton}" Margin="6,0,0,0" Click="SettingsHotkeyButton_Click"/>
                                        <Button Grid.Column="3" Content="✕" Margin="4,0,0,0" Click="SettingsHotkeyClear_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SettingsHotkeyIsSet}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <!-- Mute Microphone -->
                                    <Grid Margin="14,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Mute Microphone" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource MuteBannerToggle}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                      IsChecked="{Binding MuteMicSilent}" ToolTip="Don't show a notification banner for this shortcut"/>
                                        <Border Grid.Column="2" Background="{DynamicResource VSInsetBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MuteMicHotkeyDisplay}" FontFamily="Courier New" FontSize="11" Foreground="{DynamicResource VSLabel}" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MuteMicHotkeyDisplay}" Value="None">
                                                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button Grid.Column="3" Content="Set" Style="{StaticResource ActionButton}" Tag="Mic" Margin="6,0,0,0" Click="MuteHotkeyButton_Click"/>
                                        <Button Grid.Column="4" Content="✕" Tag="Mic" Margin="4,0,0,0" Click="MuteHotkeyClear_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MuteMicHotkeyIsSet}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <!-- Mute Speakers -->
                                    <Grid Margin="14,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Mute Speakers" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource MuteBannerToggle}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                      IsChecked="{Binding MuteSpeakersSilent}" ToolTip="Don't show a notification banner for this shortcut"/>
                                        <Border Grid.Column="2" Background="{DynamicResource VSInsetBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MuteSpeakersHotkeyDisplay}" FontFamily="Courier New" FontSize="11" Foreground="{DynamicResource VSLabel}" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MuteSpeakersHotkeyDisplay}" Value="None">
                                                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button Grid.Column="3" Content="Set" Style="{StaticResource ActionButton}" Tag="Speakers" Margin="6,0,0,0" Click="MuteHotkeyButton_Click"/>
                                        <Button Grid.Column="4" Content="✕" Tag="Speakers" Margin="4,0,0,0" Click="MuteHotkeyClear_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MuteSpeakersHotkeyIsSet}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <!-- Mute All -->
                                    <Grid Margin="14,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Mute Mic + Speakers" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource MuteBannerToggle}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                      IsChecked="{Binding MuteBothSilent}" ToolTip="Don't show a notification banner for this shortcut"/>
                                        <Border Grid.Column="2" Background="{DynamicResource VSInsetBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MuteBothHotkeyDisplay}" FontFamily="Courier New" FontSize="11" Foreground="{DynamicResource VSLabel}" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MuteBothHotkeyDisplay}" Value="None">
                                                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button Grid.Column="3" Content="Set" Style="{StaticResource ActionButton}" Tag="Both" Margin="6,0,0,0" Click="MuteHotkeyButton_Click"/>
                                        <Button Grid.Column="4" Content="✕" Tag="Both" Margin="4,0,0,0" Click="MuteHotkeyClear_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MuteBothHotkeyIsSet}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Mini Window ──────────────────── -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Mini Window" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,6"/>
                            <TextBlock Text="Mini Mode shrinks VibeSwitcher into a small profile switcher you can keep in a corner of your screen. Enter it with the title bar button, the tray menu, or the shortcut below."
                                       FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <!-- Profiles & layout wizard -->
                                    <Grid Margin="14,10">
                                        <StackPanel>
                                            <TextBlock Text="Profiles &amp; layout" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Pick which profiles appear in Mini Mode and switch between the row list and a compact icon grid."
                                                       FontSize="10.5" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,110,0"/>
                                        </StackPanel>
                                        <Button Content="Customize…" Style="{StaticResource ActionButton}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="CompactCustomize_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <!-- Toggle Mini Mode shortcut -->
                                    <Grid Margin="14,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Toggle Mini Mode" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{DynamicResource VSInsetBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CompactHotkeyDisplay}" FontFamily="Courier New" FontSize="11" Foreground="{DynamicResource VSLabel}" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CompactHotkeyDisplay}" Value="None">
                                                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button Grid.Column="2" Content="Set" Style="{StaticResource ActionButton}" Margin="6,0,0,0" Click="CompactHotkeyButton_Click"/>
                                        <Button Grid.Column="3" Content="✕" Margin="4,0,0,0" Click="CompactHotkeyClear_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CompactHotkeyIsSet}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <!-- Always on top -->
                                    <Grid Margin="14,10">
                                        <StackPanel>
                                            <TextBlock Text="Always on top" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Keeps the mini window above games and other apps. Also toggled by the pin in the mini title bar."
                                                       FontSize="10.5" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,46,0"/>
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CompactAlwaysOnTop}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <!-- Translucent when inactive -->
                                    <Grid Margin="14,10">
                                        <StackPanel>
                                            <TextBlock Text="Translucent when inactive" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                                            <TextBlock Text="The mini window fades slightly when another app has focus, so it stays out of the way."
                                                       FontSize="10.5" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,46,0"/>
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CompactTranslucent}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource VSSurface}"/>
                                    <!-- Try it -->
                                    <StackPanel Margin="14,12">
                                        <Button Content="Switch to Mini Mode now" Style="{StaticResource ActionButton}"
                                                HorizontalAlignment="Left" Click="TitleShrink_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Logs ─────────────────────────── -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLogsSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Logs" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,16"/>
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" CornerRadius="10">
                                <StackPanel Margin="14,12">
                                    <TextBlock Text="SESSION LOG" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SectionLabelText}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="View a log of audio device switches and events from this session."
                                               FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="View session log" Style="{StaticResource ActionButton}"
                                            HorizontalAlignment="Left" Click="LogsButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Uninstall ────────────────────── -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUninstallSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Install / Update / Uninstall" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,16"/>

                            <!-- App location -->
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" CornerRadius="10">
                                <StackPanel Margin="14,12">
                                    <TextBlock Text="THIS INSTALLATION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SectionLabelText}"
                                               Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Version" FontSize="12.5" Foreground="{DynamicResource VSLabel}"/>
                                        <TextBlock x:Name="InstallVersionText" FontSize="12.5" Foreground="{DynamicResource SecondaryText}"
                                                   Margin="8,0,0,0"/>
                                        <TextBlock Text="•" FontSize="12.5" Foreground="{DynamicResource VSLabel}" Margin="10,0"/>
                                        <TextBlock Text="Size" FontSize="12.5" Foreground="{DynamicResource VSLabel}"/>
                                        <TextBlock x:Name="InstallSizeText" FontSize="12.5" Foreground="{DynamicResource SecondaryText}"
                                                   Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Location" FontSize="12.5" Foreground="{DynamicResource VSLabel}" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="InstallLocationText" FontSize="11" FontFamily="Consolas"
                                               Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,10"/>
                                    <Button Content="Browse install location" Style="{StaticResource ActionButton}"
                                            HorizontalAlignment="Left" Click="BrowseInstallFolder_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- App data -->
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0">
                                <StackPanel Margin="14,12">
                                    <TextBlock Text="APP DATA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SectionLabelText}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Your profiles, settings, custom icons, and the error log live in the app's data folder. This is also what Backup &amp; Restore exports."
                                               FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Size" FontSize="12.5" Foreground="{DynamicResource VSLabel}"/>
                                        <TextBlock x:Name="DataSizeText" FontSize="12.5" Foreground="{DynamicResource SecondaryText}"
                                                   Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Location" FontSize="12.5" Foreground="{DynamicResource VSLabel}" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="DataLocationText" FontSize="11" FontFamily="Consolas"
                                               Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,10"/>
                                    <Button Content="Open data folder" Style="{StaticResource ActionButton}"
                                            HorizontalAlignment="Left" Click="OpenDataFolder_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Uninstall (button disabled for portable copies) -->
                            <Border x:Name="UninstallCard" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0">
                                <StackPanel Margin="14,12">
                                    <TextBlock Text="UNINSTALL VIBESWITCHER" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SectionLabelText}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Removes VibeSwitcher from this PC — no admin prompt needed. Your profiles and settings are kept unless you choose to delete them too."
                                               FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="PortableUninstallNote" Visibility="Collapsed"
                                               Text="You're running the portable version — there's nothing to uninstall. To remove it, just delete the folder containing VibeSwitcher.exe."
                                               FontSize="10.5" Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button x:Name="UninstallBtn" Content="Uninstall VibeSwitcher…" Style="{StaticResource DeleteButton}"
                                            HorizontalAlignment="Left" Click="UninstallButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

            </Grid><!--end settings panel-->

            <!-- ── PANEL M: Mini Mode profile list ────────────────── -->
            <ScrollViewer x:Name="MiniPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          Focusable="True"
                          Padding="10,8,10,4">
                <Grid>
                <ItemsControl x:Name="MiniList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource MiniRowBtn}"
                                    Command="{Binding ActivateCommand}"
                                    ToolTip="{Binding HotkeyDisplay}"
                                    ToolTipService.IsEnabled="{Binding IsHotkeySet}"
                                    ToolTipService.ShowOnDisabled="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,10,0">
                                        <Image Source="{Binding IconPreview}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}"/>
                                        <controls:AboutLogoIcon Width="22" Height="22">
                                            <controls:AboutLogoIcon.Style>
                                                <Style TargetType="controls:AboutLogoIcon">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCustomIcon}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:AboutLogoIcon.Style>
                                        </controls:AboutLogoIcon>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{DynamicResource Accent}"
                                             VerticalAlignment="Center" Margin="8,0,2,0"
                                             Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Grid layout: icon buttons, name on hover -->
                <ItemsControl x:Name="MiniGrid" Visibility="Collapsed" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource MiniGridBtn}"
                                    Command="{Binding ActivateCommand}"
                                    ToolTip="{Binding Name}"
                                    ToolTipService.ShowOnDisabled="True">
                                <Grid Width="30" Height="30">
                                    <Image Source="{Binding IconPreview}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}"/>
                                    <controls:AboutLogoIcon Width="26" Height="26">
                                        <controls:AboutLogoIcon.Style>
                                            <Style TargetType="controls:AboutLogoIcon">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCustomIcon}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:AboutLogoIcon.Style>
                                    </controls:AboutLogoIcon>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- ── PANEL C: About ─────────────────────────────────── -->
            <ScrollViewer x:Name="AboutPanel"
                          Visibility="Collapsed"
                          Focusable="True"
