<Window x:Class="VibeSwitcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VibeSwitcher.ViewModels"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="540" Height="680"
        MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBg}"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="4" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Filter chip — ghost when off, accent-filled when on -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Padding"    Value="10,0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="15" BorderThickness="1"
                                BorderBrush="{DynamicResource InputBorder}"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"   Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bg" Property="BorderBrush"  Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background"  Value="{DynamicResource AccentHover}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clear-all link button -->
        <Style x:Key="ClearFilterButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TertiaryText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"
                                   VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="Padding"         Value="16,14"/>
        </Style>

        <Style x:Key="InnerCardBorder" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource InnerCardBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource InnerCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="{DynamicResource SecondaryText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,10,0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background"      Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,0,28,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="root">
                            <Border x:Name="bg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,0,28,0">
                                <ContentPresenter x:Name="contentPresenter"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False"/>
                            </Border>
                            <Path x:Name="arrow"
                                  Data="M0,0 L3.5,4 L7,0"
                                  Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5"
                                  Fill="Transparent"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  IsHitTestVisible="False"/>
                            <ToggleButton x:Name="toggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   VerticalOffset="2">
                                <Border Background="{DynamicResource CardBg}"
                                        BorderBrush="{DynamicResource InputBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, ElementName=root}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.12"
                                                          BlurRadius="10" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <ScrollViewer Padding="4,4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="toggleButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger SourceName="toggleButton" Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"    Value="10,6"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bg"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DayPillStyle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="{DynamicResource ChipBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{DynamicResource ChipText}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource Accent}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource ChipBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{DynamicResource ChipText}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource ChipHoverBg}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource TooltipBg}"
                                BorderBrush="{DynamicResource TooltipBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                                  Opacity="0.13" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:TitleBar x:Name="AppTitleBar" Grid.Row="0" ShowMinimize="True" ShowMaximize="True"/>

        <Grid x:Name="MainGrid" Grid.Row="1" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <StackPanel x:Name="HeaderPanel" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Image x:Name="AppHeaderIcon" Width="36" Height="36"
                   Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="VibeSwitcher"
                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock Text="Manage your device profiles and hotkeys"
                           FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Filter bar ── -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">

            <!-- Name text box -->
            <Grid Margin="0,0,0,6">
                <TextBox x:Name="FilterNameBox"
                         Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="FilterNameBox_KeyDown"
                         Padding="10,8,10,8" FontSize="13"/>
                <TextBlock Text="Filter by name…"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Margin="12,0,0,0" FontSize="13" IsHitTestVisible="False"
                           Foreground="{DynamicResource SubtleText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NameFilter}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Filter chips row -->
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding ModeOptions}"
                          SelectedItem="{Binding ModeFilter}"
                          Height="30" Width="130" FontSize="12"
                          VerticalContentAlignment="Center"
                          Margin="0,0,6,0"/>
                <ToggleButton Content="★  Pinned"
                              IsChecked="{Binding PinnedFilter}"
                              Style="{StaticResource FilterChip}"
                              Margin="0,0,6,0"/>
                <ToggleButton Content="⏰  Scheduled"
                              IsChecked="{Binding ScheduledFilter}"
                              Style="{StaticResource FilterChip}"
                              Margin="0,0,6,0"/>
                <!-- Clear link — visible only when any filter is active -->
                <Button Content="Clear all"
                        Command="{Binding ClearFiltersCommand}"
                        Margin="2,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ClearFilterButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAnyFilterActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>

            <!-- Day chips — visible only when Scheduled chip is on -->
            <ItemsControl ItemsSource="{Binding DayChips}" Margin="0,6,0,0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ScheduledFilter}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DayChip}">
                        <ToggleButton Content="{Binding Label}"
                                      IsChecked="{Binding IsSelected}"
                                      Style="{StaticResource FilterChip}"
                                      Margin="0,0,4,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>

        <!-- ── Profile cards ── -->
        <ScrollViewer x:Name="ProfilesScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>

                <ItemsControl ItemsSource="{Binding Profiles}"
                              KeyboardNavigation.DirectionalNavigation="Contained">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileCardViewModel}">

                            <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                <!-- Profile card -->
                                <Border AllowDrop="True"
                                        DragEnter="Card_DragEnter"
                                        DragLeave="Card_DragLeave"
                                        DragOver="Card_DragOver"
                                        Drop="Card_Drop"
                                        Style="{StaticResource CardBorder}">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Drag grip -->
                                        <TextBlock Grid.Column="0" Grid.Row="4"
                                                   Text="⠿" FontSize="20" Foreground="{DynamicResource DisabledText}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Cursor="Hand" Margin="-4,0,4,0"
                                                   ToolTipService.InitialShowDelay="400"
                                                   ToolTipService.ShowDuration="10000"
                                                   PreviewMouseLeftButtonDown="DragGrip_MouseDown"
                                                   PreviewMouseLeftButtonUp="DragGrip_MouseUp"
                                                   MouseMove="DragGrip_MouseMove">
                                            <TextBlock.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="Drag to reorder"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,4"/>
                                                        <TextBlock Text="Hold and drag up or down to change the order profiles appear in the tray menu."
                                                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                                                   TextWrapping="Wrap" MaxWidth="220"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>

                                        <!-- Name -->
                                        <StackPanel Grid.Row="0" Grid.Column="1"
                                                    Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Name" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                            <Border Width="15" Height="15" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                                    VerticalAlignment="Center" Cursor="Help"
                                                    ToolTipService.InitialShowDelay="400"
                                                    ToolTipService.ShowDuration="12000">
                                                <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                           Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock TextWrapping="Wrap" MaxWidth="240" Foreground="{DynamicResource PrimaryText}">
                                                            A short display name for this profile. It appears in the tray menu and at the top of the settings card.
                                                        </TextBlock>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                            </Border>
                                        </StackPanel>
                                        <TextBox Grid.Row="0" Grid.Column="2"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="20"
                                                 Margin="0,0,0,10"/>
                                        <Border Grid.Row="0" Grid.Column="3"
                                                Margin="8,0,0,10" VerticalAlignment="Center"
                                                Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource ChipBorder}"
                                                BorderThickness="1" CornerRadius="5" Padding="10,4">
                                            <TextBlock Text="{Binding ModeLabel}"
                                                       FontSize="11" Foreground="{DynamicResource ChipText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Name suggestions -->
                                        <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                                   HorizontalAlignment="Center"
                                                   Orientation="Horizontal" Margin="0,0,0,8">
                                            <WrapPanel.Style>
                                                <Style TargetType="WrapPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowNameSuggestions}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Style>
                                            <Button Content="Gaming"    Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Gaming"/>
                                            <Button Content="Work"      Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Work"/>
                                            <Button Content="Music"     Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Music"/>
                                            <Button Content="Headset"   Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Headset"/>
                                            <Button Content="Streaming" Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Streaming"/>
                                            <Button Content="Calls"     Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Calls"/>
                                            <Button Content="Mic"       Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Mic"/>
                                            <Button Content="Home"      Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Home"/>
                                            <Button Content="Speakers"  Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Speakers"/>
                                        </WrapPanel>

                                        <!-- Playback -->
                                        <StackPanel Grid.Row="3" Grid.Column="1"
                                                    Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding PlaybackVisible}">
                                            <TextBlock Text="Playback" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                            <Border Width="15" Height="15" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                                    VerticalAlignment="Center" Cursor="Help"
                                                    ToolTipService.InitialShowDelay="400"
                                                    ToolTipService.ShowDuration="12000">
                                                <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                           Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock TextWrapping="Wrap" MaxWidth="240" Foreground="{DynamicResource PrimaryText}">
                                                            The output audio device (speakers or headphones) that will become the default when this profile is activated.
                                                        </TextBlock>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                            </Border>
                                        </StackPanel>
                                        <ComboBox Grid.Row="3" Grid.Column="2"
                                                  ItemsSource="{Binding PlaybackDevices}"
                                                  SelectedItem="{Binding SelectedPlaybackDevice}"
                                                  Visibility="{Binding PlaybackVisible}"
                                                  Margin="0,0,0,8">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Visibility="{Binding ShowDot, Converter={StaticResource BoolToVis}}">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource SuccessDot}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                            <Setter Property="Fill" Value="{DynamicResource ErrorDot}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Row="3" Grid.Column="3"
                                                Content="Test"
                                                Margin="8,0,0,8" VerticalAlignment="Center"
                                                Style="{StaticResource ActionButton}"
                                                Command="{Binding TestSoundCommand}"
                                                IsEnabled="{Binding IsPlaybackDeviceSet}"
                                                Visibility="{Binding PlaybackVisible}"/>

                                        <!-- Recording -->
                                        <StackPanel Grid.Row="4" Grid.Column="1"
                                                    Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding RecordingVisible}">
                                            <TextBlock Text="Recording" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                            <Border Width="15" Height="15" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                                    VerticalAlignment="Center" Cursor="Help"
                                                    ToolTipService.InitialShowDelay="400"
                                                    ToolTipService.ShowDuration="12000">
                                                <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                           Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock TextWrapping="Wrap" MaxWidth="240" Foreground="{DynamicResource PrimaryText}">
                                                            The microphone or audio input that will become the default when this profile is activated.
                                                        </TextBlock>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                            </Border>
                                        </StackPanel>
                                        <ComboBox Grid.Row="4" Grid.Column="2"
                                                  ItemsSource="{Binding RecordingDevices}"
                                                  SelectedItem="{Binding SelectedRecordingDevice}"
                                                  Visibility="{Binding RecordingVisible}"
                                                  Margin="0,0,0,8">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Visibility="{Binding ShowDot, Converter={StaticResource BoolToVis}}">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource SuccessDot}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                            <Setter Property="Fill" Value="{DynamicResource ErrorDot}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Row="4" Grid.Column="3"
                                                Content="Test"
                                                Margin="8,0,0,8" VerticalAlignment="Center"
                                                Style="{StaticResource ActionButton}"
                                                Command="{Binding TestMicCommand}"
                                                IsEnabled="{Binding IsRecordingDeviceSet}"
                                                Visibility="{Binding RecordingVisible}"/>

                                        <!-- Hotkey -->
                                        <StackPanel Grid.Row="5" Grid.Column="1"
                                                    Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Hotkey" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                            <Border Width="15" Height="15" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                                    VerticalAlignment="Center" Cursor="Help"
                                                    ToolTipService.InitialShowDelay="400"
                                                    ToolTipService.ShowDuration="12000">
                                                <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                           Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock TextWrapping="Wrap" MaxWidth="240" Foreground="{DynamicResource PrimaryText}">
                                                            A global keyboard shortcut that switches to this profile instantly from anywhere, even when the app is minimized. Supports combinations like Ctrl+Shift+F1.
                                                        </TextBlock>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                            </Border>
                                        </StackPanel>
                                        <TextBox Grid.Row="5" Grid.Column="2"
                                                 Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 IsTabStop="False"
                                                 Margin="0,0,0,8"/>
                                        <Button Grid.Row="5" Grid.Column="3"
                                                Content="Set Hotkey"
                                                Margin="8,0,0,8" VerticalAlignment="Center"
                                                Style="{StaticResource ActionButton}"
                                                Command="{Binding CaptureHotkeyCommand}"/>

                                        <!-- Icon -->
                                        <StackPanel Grid.Row="6" Grid.Column="1"
                                                    Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Icon" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                            <ToggleButton x:Name="IconInfoToggle"
                                                          Width="15" Height="15"
                                                          VerticalAlignment="Center"
                                                          Cursor="Hand" Focusable="False"
                                                          OverridesDefaultStyle="True"
                                                          ToolTip="Click for custom icon creation guide"
                                                          ToolTipService.InitialShowDelay="400">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{DynamicResource InfoBadgeBg}" CornerRadius="8">
                                                            <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                                       Foreground="{DynamicResource InfoBadgeText}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <Popup IsOpen="{Binding IsChecked, ElementName=IconInfoToggle}"
                                                   PlacementTarget="{Binding ElementName=IconInfoToggle}"
                                                   Placement="Bottom" VerticalOffset="4"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Fade">
                                                <Border Background="{DynamicResource TooltipBg}"
                                                        BorderBrush="{DynamicResource TooltipBorder}" BorderThickness="1"
                                                        CornerRadius="8" Padding="14,12" MaxWidth="280">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                                                          Direction="270" Opacity="0.13" Color="#000000"/>
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                                                   Foreground="{DynamicResource PrimaryText}">
                                                            Custom tray icon displayed when this profile is active.
                                                            Must be <Run FontWeight="SemiBold">.ico format</Run> only.
                                                        </TextBlock>
                                                        <TextBlock Text="💡 How to create a custom icon:"
                                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}"
                                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"
                                                                   Foreground="{DynamicResource PrimaryText}">
                                                            1. Remove the background from your image:
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryText}">
                                                            <Hyperlink NavigateUri="https://www.pixelcut.ai/t/background-remover"
                                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                                pixelcut.ai/t/background-remover
                                                            </Hyperlink>
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"
                                                                   Foreground="{DynamicResource PrimaryText}">
                                                            2. Convert the image to .ico:
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryText}">
                                                            <Hyperlink NavigateUri="https://image.online-convert.com/convert-to-ico"
                                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                                image.online-convert.com/convert-to-ico
                                                            </Hyperlink>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                                            Tip: export with multiple sizes (16, 32, 48, 256 px) for a sharper icon at all screen DPI settings.
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </StackPanel>
                                        <TextBox Grid.Row="6" Grid.Column="2"
                                                 Text="{Binding IconPath, Mode=OneWay, FallbackValue='(default)'}"
                                                 IsReadOnly="True"
                                                 IsTabStop="False"
                                                 Margin="0,0,0,12"/>
                                        <StackPanel Grid.Row="6" Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,12">
                                            <Button Content="Pick Icon"
                                                    Style="{StaticResource ActionButton}"
                                                    Command="{Binding PickIconCommand}"/>
                                            <Border Background="Transparent"
                                                    BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                                                    CornerRadius="4" Padding="3"
                                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IconPreview}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Image Source="{Binding IconPreview}" Width="18" Height="18"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Notes -->
                                        <StackPanel Grid.Row="1" Grid.Column="1"
                                                    Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Notes" Style="{StaticResource LabelText}" Margin="0,0,4,0"/>
                                            <Border Width="15" Height="15" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                                    VerticalAlignment="Center" Cursor="Help"
                                                    ToolTipService.InitialShowDelay="400"
                                                    ToolTipService.ShowDuration="12000">
                                                <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                           Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock TextWrapping="Wrap" MaxWidth="240" Foreground="{DynamicResource PrimaryText}">
                                                            A short note for this profile. Use it to remember what it's for — e.g. "Gaming headset + Blue Yeti mic" or "Work calls only".
                                                        </TextBlock>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                            </Border>
                                        </StackPanel>
                                        <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="61"/>
                                            <TextBlock Text="Add a note about this profile..."
                                                       IsHitTestVisible="False"
                                                       Foreground="{DynamicResource TertiaryText}"
                                                       FontStyle="Italic"
                                                       VerticalAlignment="Center"
                                                       Margin="9,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Notes}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Validation warning -->
                                        <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4"
                                                Margin="0,0,0,8" Padding="10,7" CornerRadius="5"
                                                Background="{DynamicResource WarningBg}"
                                                BorderBrush="{DynamicResource WarningBorder}"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasValidationWarning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠" FontSize="12" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource WarningText}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ValidationWarning}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource WarningText}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Separator -->
                                        <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4"
                                                Height="1" Background="{DynamicResource CardSeparator}" Margin="0,0,0,12"/>

                                        <!-- Bottom row: Silent toggle + Clone + Delete -->
                                        <Grid Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4">
                                            <CheckBox IsChecked="{Binding Silent}"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Silent}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.4"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Silent switch" FontSize="12" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                                    <Border Width="15" Height="15" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                                            VerticalAlignment="Center" Cursor="Help" Margin="6,0,0,0"
                                                            ToolTipService.InitialShowDelay="400"
                                                            ToolTipService.ShowDuration="12000">
                                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Border.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock TextWrapping="Wrap" MaxWidth="240" Foreground="{DynamicResource PrimaryText}">
                                                                    Hides the notification banner when you switch to this profile manually — using a hotkey, the tray menu, or the Settings window. It does not affect scheduled switches; each schedule has its own silent option.
                                                                </TextBlock>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                    </Border>
                                                </StackPanel>
                                            </CheckBox>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Border Margin="0,0,8,0" VerticalAlignment="Center"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        CornerRadius="6" Padding="2">
                                                    <ToggleButton IsChecked="{Binding IsPinned}"
                                                                  Cursor="Hand" Focusable="False"
                                                                  OverridesDefaultStyle="True"
                                                                  ToolTip="Pin to top of list and tray menu">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="8,4">
                                                                    <TextBlock x:Name="star" Text="☆" FontSize="14"
                                                                               Foreground="{DynamicResource DisabledText}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="star" Property="Text" Value="★"/>
                                                                        <Setter TargetName="star" Property="Foreground" Value="#FFB300"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                </Border>
                                                <Button Command="{Binding ActivateCommand}"
                                                        Margin="0,0,8,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                            <Setter Property="Content" Value="Activate"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Content" Value="✓ Active"/>
                                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="Clone"
                                                        Style="{StaticResource ActionButton}"
                                                        Command="{Binding CloneCommand}"
                                                        Margin="0,0,8,0"
                                                        ToolTip="Creates an exact copy of this profile with a new name, so you can customise it independently."/>
                                                <Button Content="Add Schedule"
                                                        Style="{StaticResource ActionButton}"
                                                        Command="{Binding AddScheduleCommand}"
                                                        Margin="0,0,8,0"/>
                                                <Button Content="Delete Profile"
                                                        Style="{StaticResource DangerButton}"
                                                        Command="{Binding DeleteCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Schedule section -->
                                        <Border Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="4"
                                                Margin="0,8,0,0">
                                            <StackPanel>

                                                <!-- Section header -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="Schedules"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SectionLabelText}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Width="16" Height="16" CornerRadius="8"
                                                            Background="{DynamicResource InfoBadgeBg}"
                                                            Margin="5,0,0,0" VerticalAlignment="Center"
                                                            Cursor="Help"
                                                            ToolTipService.ShowDuration="12000">
                                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                                   Foreground="{DynamicResource InfoBadgeText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Border.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock TextWrapping="Wrap" MaxWidth="240" Foreground="{DynamicResource PrimaryText}">
                                                                    Schedules automatically switch this profile at a set time on selected days. You can add multiple schedules per profile.
                                                                </TextBlock>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Schedule entries -->
                                                <ItemsControl ItemsSource="{Binding Schedules}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ScheduleEntryViewModel}">
                                                            <Border Background="{DynamicResource InnerCardBg}"
                                                                    BorderBrush="{DynamicResource InnerCardBorderBrush}"
                                                                    BorderThickness="1" CornerRadius="6"
                                                                    Padding="10,8" Margin="0,0,0,6">
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <CheckBox IsChecked="{Binding Enabled}"
                                                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                                                  DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                                        <Button DockPanel.Dock="Right" Content="Remove Schedule"
                                                                                Style="{StaticResource DangerButton}"
                                                                                Command="{Binding DeleteCommand}"
                                                                                FontSize="10" Padding="10,2" Height="26"
                                                                                VerticalAlignment="Center"/>
                                                                        <Button DockPanel.Dock="Right" Content="Edit"
                                                                                Style="{StaticResource ActionButton}"
                                                                                Command="{Binding EditCommand}"
                                                                                FontSize="10" Padding="12,2" Height="26"
                                                                                Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Summary}"
                                                                                   FontSize="11"
                                                                                   Foreground="{DynamicResource SecondaryText}"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Margin="8,0,0,0"/>
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding ConflictMessage}"
                                                                               FontSize="11" Foreground="#CC6600"
                                                                               TextWrapping="Wrap" Margin="42,4,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                            </StackPanel>
                                        </Border>

                                    </Grid>
                                </Border>

                                <!-- Save flash overlay — theme-aware, sits on top, does not block input -->
                                <Border x:Name="FlashOverlay"
                                        Background="{DynamicResource SaveFlashBg}"
                                        CornerRadius="8"
                                        Opacity="0"
                                        IsHitTestVisible="False"
                                        Margin="0,0,0,10"/>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding SaveFlash}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="FlashOverlay"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.7" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="FlashOverlay"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0" Duration="0:0:0.28"
                                                    FillBehavior="Stop"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- No search results -->
                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource DisabledText}"
                           FontSize="13" Margin="0,32,0,24"
                           Text="No profiles match your search.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoFilterResults}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Empty state -->
                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource DisabledText}"
                           FontSize="13" Margin="0,32,0,24"
                           Text="No profiles yet — click Add New Profile to get started">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoProfiles}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Add New Profile -->
                <Button Command="{Binding AddProfileCommand}"
                        Style="{StaticResource ActionButton}"
                        Height="Auto" Padding="16,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="＋" FontSize="18" Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Add New Profile" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource PrimaryText}"/>
                            <TextBlock Text="Create a playback, recording, or linked device profile"
                                       Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

            </StackPanel>
        </ScrollViewer>

        <!-- ── General Settings card ── -->
        <Border x:Name="SettingsCard" Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                Padding="0" ClipToBounds="True">
            <StackPanel>
                <!-- Collapsible header -->
                <Grid>
                <ToggleButton x:Name="SettingsExpander"
                              IsChecked="{Binding SettingsCardExpanded, Mode=TwoWay}"
                              HorizontalContentAlignment="Stretch"
                              OverridesDefaultStyle="True"
                              Focusable="False" Cursor="Hand">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="7,7,0,0"
                                    Padding="16,14,16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚙" FontSize="16"
                                               Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="VibeSwitcher Settings"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource PrimaryText}"/>
                                        <TextBlock Text="Startup, notifications, devices, and shortcuts"
                                                   Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="Arrow" Grid.Column="2"
                                               Text="▲" FontSize="10" Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="Arrow" Property="Text" Value="▼"/>
                                    <Setter TargetName="Bg" Property="CornerRadius" Value="7"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="Bg" Property="CornerRadius" Value="7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Button x:Name="LogsButton"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,44,0"
                        Padding="10,4"
                        Visibility="Collapsed"
                        Style="{StaticResource ActionButton}"
                        Click="LogsButton_Click">
                    <TextBlock x:Name="LogsButtonText" FontSize="11" Foreground="{DynamicResource WarningText}"/>
                </Button>
                </Grid>

                <!-- Collapsible body -->
                <StackPanel Margin="16,0,16,14">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=SettingsExpander}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Appearance -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Theme" Style="{StaticResource LabelText}"/>
                                <!-- Segmented theme picker: Follow Windows / Light / Dark -->
                                <UniformGrid Grid.Column="1" Rows="1" Height="30">
                                    <UniformGrid.Resources>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="GroupName"              Value="ThemeGroup"/>
                                            <Setter Property="Cursor"                 Value="Hand"/>
                                            <Setter Property="FontSize"               Value="12"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment"   Value="Center"/>
                                            <Setter Property="Foreground"             Value="{DynamicResource SecondaryText}"/>
                                            <Setter Property="Background"             Value="Transparent"/>
                                            <Setter Property="BorderBrush"            Value="{DynamicResource InputBorder}"/>
                                            <Setter Property="BorderThickness"        Value="1"/>
                                            <Setter Property="FocusVisualStyle"       Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="Bg"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background"  Value="{DynamicResource Accent}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="Foreground"  Value="White"/>
                                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </UniformGrid.Resources>
                                    <RadioButton Content="Follow Windows" Tag="Auto"   Checked="ThemeRadio_Checked">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Theme}" Value="Auto">
                                                        <Setter Property="IsChecked" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                    <RadioButton Content="Light" Tag="Light" Checked="ThemeRadio_Checked">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Theme}" Value="Light">
                                                        <Setter Property="IsChecked" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                    <RadioButton Content="Dark" Tag="Dark" Checked="ThemeRadio_Checked">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Theme}" Value="Dark">
                                                        <Setter Property="IsChecked" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </UniformGrid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Startup -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Startup" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding StartWithWindows}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StartWithWindows}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Start with Windows" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="When your PC boots up, VibeSwitcher will start automatically, like a startup app." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding StartMinimized}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StartMinimized}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Start minimized to tray" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="When VibeSwitcher starts with Windows, it opens quietly in the tray." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding CloseToTray}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CloseToTray}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Close to tray" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="Clicking the Close button hides this window instead of exiting. VibeSwitcher keeps running in the tray. To reopen Settings, right-click the tray icon and click the VibeSwitcher header." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Notifications -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding ShowNotifications}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowNotifications}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Show device switch alerts" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="Shows a Windows notification banner when you switch profiles, confirming which profile was selected." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Schedules -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Schedules" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding Use24HourClock}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Use24HourClock}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Use 24-hour clock" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="Off = 12-hour format (2:00 PM). On = 24-hour format (14:00)." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Tray -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Tray" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding LeftClickCyclesProfiles}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LeftClickCyclesProfiles}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Left-click tray icon to cycle profiles" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="Left-clicking the tray icon switches to the next profile in order. When disabled, left-click opens VibeSwitcher instead. Right-click always works normally." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Search -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Search" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding RememberSearch}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RememberSearch}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Remember last search" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="When enabled, the search box remembers what you last typed and restores it each time you open Settings — even after a reboot. When disabled, the search box always starts empty." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Devices -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Devices" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding UseLegacySoundPanel}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseLegacySoundPanel}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Use legacy sound panel" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="The 'Open Sound Settings' button will open the classic Windows Sound Control Panel instead of the modern Windows Settings app." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding ShowDisabledDevices}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowDisabledDevices}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Show disabled devices in dropdowns" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="Includes devices marked as 'Disabled' in Windows Sound settings. Useful if you manually enable and disable devices between uses." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding ShowDisconnectedDevices}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowDisconnectedDevices}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Show disconnected devices in dropdowns" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="Includes physically unplugged devices in profile dropdowns. Lets you assign a device that is not currently connected to the machine." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Shortcuts -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Shortcuts" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding SettingsHotkeyEnabled}"
                                      IsEnabled="{Binding SettingsHotkeyIsSet}"
                                      Margin="0,3,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsHotkeyEnabled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Open / Close VibeSwitcher" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="A global keyboard shortcut that opens or closes the VibeSwitcher Settings window from anywhere, even when another app is in focus." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SettingsHotkeyEnabled}" Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Background="{DynamicResource HotkeyBg}" BorderBrush="{DynamicResource HotkeyBorder}" BorderThickness="1"
                                        CornerRadius="5" Padding="10,5" Margin="0,0,8,0"
                                        MinWidth="74" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SettingsHotkeyDisplay}"
                                               FontFamily="Consolas" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SettingsHotkeyDisplay}" Value="None">
                                                        <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Style="{StaticResource ActionButton}"
                                        Content="Set hotkey"
                                        Click="SettingsHotkeyButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Device Aliases -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Device Aliases" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource SectionLabelText}"/>
                                <TextBlock Text="Give your audio devices custom friendly names."
                                           FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Manage…"
                                    Style="{StaticResource ActionButton}"
                                    VerticalAlignment="Center"
                                    Click="ManageAliasesButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Backup & Restore -->
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Backup &amp; Restore" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
                            <TextBlock Text="Save your profiles to a file, or restore from a previous backup."
                                       FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Export Config"
                                        Style="{StaticResource ActionButton}"
                                        Margin="0,0,8,0"
                                        Click="ExportButton_Click"/>
                                <Button Content="Import Config"
                                        Style="{StaticResource ActionButton}"
                                        Click="ImportButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Footer ── -->
        <Grid x:Name="FooterGrid" Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="About"
                        Style="{StaticResource ActionButton}"
                        Width="72"
                        Click="AboutButton_Click"/>
                <Button Width="28" Height="28" Padding="0" Margin="8,0,0,0"
                        Style="{StaticResource ActionButton}"
                        Click="HelpButton_Click"
                        ToolTip="Getting started &amp; help">
                    <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"/>
                </Button>
            </StackPanel>
            <Button Content="Open Sound Settings"
                    Style="{StaticResource ActionButton}"
                    HorizontalAlignment="Center"
                    Click="OpenSoundSettings_Click"/>
            <Button Content="Close"
                    Style="{StaticResource ActionButton}"
                    Width="90"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click"/>
        </Grid>

        </Grid><!-- MainGrid -->
    </Grid><!-- root -->
</Window>
