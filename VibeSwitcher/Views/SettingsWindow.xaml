                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding StartWithWindows}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StartWithWindows}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Start with Windows" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="When your PC boots up, VibeSwitcher will start automatically." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding StartMinimized}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StartMinimized}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Start minimized to tray" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="When VibeSwitcher starts with Windows, it opens quietly in the tray." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding CloseToTray}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CloseToTray}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Close to tray" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="Clicking Close hides this window instead of exiting. To reopen, right-click the tray icon." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- NOTIFICATIONS -->
                    <TextBlock Text="NOTIFICATIONS" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedText}"
                               Margin="2,0,0,7"/>
                    <Border Style="{StaticResource InnerCardBorder}">
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding ShowNotifications}" Margin="0,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowNotifications}" Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Show device switch alerts" VerticalAlignment="Center"/>
                                <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                        Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                    <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                               Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border.ToolTip>
                                        <ToolTip><TextBlock Text="Shows a Windows notification banner when you switch profiles." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                    </Border.ToolTip>
                                </Border>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <!-- SCHEDULES -->
                    <TextBlock Text="SCHEDULES" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedText}"
                               Margin="2,0,0,7"/>
                    <Border Style="{StaticResource InnerCardBorder}">
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding Use24HourClock}" Margin="0,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Use24HourClock}" Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Use 24-hour clock" VerticalAlignment="Center"/>
                                <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                        Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                    <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                               Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border.ToolTip>
                                        <ToolTip><TextBlock Text="Off = 12-hour format (2:00 PM). On = 24-hour format (14:00)." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                    </Border.ToolTip>
                                </Border>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <!-- TRAY -->
                    <TextBlock Text="TRAY" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedText}"
                               Margin="2,0,0,7"/>
                    <Border Style="{StaticResource InnerCardBorder}">
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding LeftClickCyclesProfiles}" Margin="0,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LeftClickCyclesProfiles}" Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Left-click tray icon to cycle profiles" VerticalAlignment="Center"/>
                                <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                        Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                    <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                               Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border.ToolTip>
                                        <ToolTip><TextBlock Text="Left-clicking the tray icon switches to the next profile in order. When disabled, left-click opens VibeSwitcher instead." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                    </Border.ToolTip>
                                </Border>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <!-- DEVICES -->
                    <TextBlock Text="DEVICES" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedText}"
                               Margin="2,0,0,7"/>
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding UseLegacySoundPanel}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseLegacySoundPanel}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Use legacy sound panel" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="The 'Open Sound Settings' button will open the classic Windows Sound Control Panel instead of modern Settings." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding ShowDisabledDevices}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowDisabledDevices}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Show disabled devices in dropdowns" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="Includes devices marked as 'Disabled' in Windows Sound settings." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding ShowDisconnectedDevices}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowDisconnectedDevices}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Show disconnected devices in dropdowns" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="Includes physically unplugged devices in profile dropdowns." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Open Sound Settings"
                                        Style="{StaticResource ActionButton}"
                                        Margin="0,0,8,0"
                                        Click="OpenSoundSettings_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SHORTCUTS -->
                    <TextBlock Text="SHORTCUTS" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedText}"
                               Margin="2,0,0,7"/>
                    <Border Style="{StaticResource InnerCardBorder}">
                        <StackPanel>
                            <!-- Open/Close shortcut -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Open / Close VibeSwitcher" FontSize="12"
                                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                                <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8"
                                        Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                    <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                               Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border.ToolTip>
                                        <ToolTip><TextBlock Text="A global keyboard shortcut that opens or closes the VibeSwitcher Settings window from anywhere." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                    </Border.ToolTip>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="{DynamicResource HotkeyBg}" BorderBrush="{DynamicResource HotkeyBorder}" BorderThickness="1"
                                        CornerRadius="5" Padding="10,5" Margin="0,0,8,0"
                                        MinWidth="74" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SettingsHotkeyDisplay}"
                                               FontFamily="Consolas" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SettingsHotkeyDisplay}" Value="None">
                                                        <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Style="{StaticResource ActionButton}" Content="Set hotkey"
                                        Margin="0,0,6,0" Click="SettingsHotkeyButton_Click"/>
                                <Button Content="✕" Click="SettingsHotkeyClear_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsHotkeyIsSet}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <Separator Margin="0,2,0,10" Background="{DynamicResource SeparatorBrush}" Height="1" BorderThickness="0"/>

                            <!-- Mute Mic -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Mute Microphone" FontSize="12"
                                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                                <Border Width="16" Height="16" Background="#DC3232" CornerRadius="8"
                                        Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                    <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border.ToolTip>
                                        <ToolTip><TextBlock Text="Mutes your microphone. Tray icon flashes red while active." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                    </Border.ToolTip>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="{DynamicResource HotkeyBg}" BorderBrush="{DynamicResource HotkeyBorder}" BorderThickness="1"
                                        CornerRadius="5" Padding="10,5" Margin="0,0,8,0" MinWidth="74" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MuteMicHotkeyDisplay}" FontFamily="Consolas" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MuteMicHotkeyDisplay}" Value="None">
                                                        <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Style="{StaticResource ActionButton}" Content="Set hotkey" Tag="Mic"
                                        Margin="0,0,6,0" Click="MuteHotkeyButton_Click"/>
                                <Button Tag="Mic" Content="✕" Click="MuteHotkeyClear_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MuteMicHotkeyIsSet}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!-- Mute Speakers -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Mute Speakers" FontSize="12"
                                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                                <Border Width="16" Height="16" Background="#286EDC" CornerRadius="8"
                                        Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                    <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border.ToolTip>
                                        <ToolTip><TextBlock Text="Mutes your default playback device. Tray icon flashes blue while active." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                    </Border.ToolTip>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="{DynamicResource HotkeyBg}" BorderBrush="{DynamicResource HotkeyBorder}" BorderThickness="1"
                                        CornerRadius="5" Padding="10,5" Margin="0,0,8,0" MinWidth="74" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MuteSpeakersHotkeyDisplay}" FontFamily="Consolas" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MuteSpeakersHotkeyDisplay}" Value="None">
                                                        <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Style="{StaticResource ActionButton}" Content="Set hotkey" Tag="Speakers"
                                        Margin="0,0,6,0" Click="MuteHotkeyButton_Click"/>
                                <Button Tag="Speakers" Content="✕" Click="MuteHotkeyClear_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MuteSpeakersHotkeyIsSet}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!-- Mute Both -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Mute Mic + Speakers" FontSize="12"
                                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                                <Border Width="16" Height="16" Background="#8B3CDC" CornerRadius="8"
                                        Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                    <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border.ToolTip>
                                        <ToolTip><TextBlock Text="Mutes both microphone and speakers at once. Tray icon flashes purple while active." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip>
                                    </Border.ToolTip>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource HotkeyBg}" BorderBrush="{DynamicResource HotkeyBorder}" BorderThickness="1"
                                        CornerRadius="5" Padding="10,5" Margin="0,0,8,0" MinWidth="74" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MuteBothHotkeyDisplay}" FontFamily="Consolas" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MuteBothHotkeyDisplay}" Value="None">
                                                        <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Style="{StaticResource ActionButton}" Content="Set hotkey" Tag="Both"
                                        Margin="0,0,6,0" Click="MuteHotkeyButton_Click"/>
                                <Button Tag="Both" Content="✕" Click="MuteHotkeyClear_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MuteBothHotkeyIsSet}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DEVICE ALIASES -->
                    <TextBlock Text="DEVICE ALIASES" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedText}"
                               Margin="2,0,0,7"/>
                    <Border Style="{StaticResource InnerCardBorder}">
