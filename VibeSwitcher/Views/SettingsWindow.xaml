<Window x:Class="VibeSwitcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VibeSwitcher.ViewModels"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="920" Height="720"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBg}"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" GlassFrameThickness="0"
                      ResizeBorderThickness="4" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Filter chip ──────────────────────────────────────── -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Height"     Value="28"/>
            <Setter Property="Padding"    Value="10,0"/>
            <Setter Property="FontSize"   Value="11.5"/>
            <Setter Property="Foreground" Value="#38384E"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="20" BorderThickness="1"
                                BorderBrush="#1E1E30" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"   Value="#12F5820A"/>
                                <Setter TargetName="Bg" Property="BorderBrush"  Value="#40F5820A"/>
                                <Setter Property="Foreground" Value="#F5820A"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background"  Value="#16162A"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#303048"/>
                                <Setter Property="Foreground" Value="#7878A0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Clear-all link ───────────────────────────────────── -->
        <Style x:Key="ClearFilterButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FontSize"   Value="11.5"/>
            <Setter Property="Foreground" Value="#E05555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Settings section card ────────────────────────────── -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="Padding"         Value="16,14"/>
        </Style>

        <Style x:Key="InnerCardBorder" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource InnerCardBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource InnerCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="{DynamicResource SecondaryText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,10,0"/>
        </Style>

        <!-- ── Day pill ─────────────────────────────────────────── -->
        <Style x:Key="DayPillStyle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="{DynamicResource ChipBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{DynamicResource ChipText}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource Accent}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Chip button ──────────────────────────────────────── -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource ChipBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{DynamicResource ChipText}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource ChipHoverBg}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Title bar button (min/max/close) ─────────────────── -->
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"      Value="44"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Foreground" Value="#555570"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable"  Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C42B1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Nav icon button (FAQ / About / Settings) ─────────── -->
        <Style x:Key="NavIconBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"      Value="34"/>
            <Setter Property="Height"     Value="34"/>
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"   Value="#12F5820A"/>
                                <Setter TargetName="bg" Property="BorderBrush"  Value="#40F5820A"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIconBtnActive" TargetType="Button" BasedOn="{StaticResource NavIconBtn}">
            <Setter Property="Background" Value="#12F5820A"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#40F5820A" BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1FF5820A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Card action button (36×36, matches reference spec) ─── -->
        <Style x:Key="CardActionBtn" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"      Value="36"/>
            <Setter Property="Height"     Value="36"/>
            <Setter Property="Foreground" Value="#8888AA"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Focusable"  Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8"
                                Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="#222236"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#484860"/>
                                <Setter Property="Foreground" Value="#C8C8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardActionToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"      Value="36"/>
            <Setter Property="Height"     Value="36"/>
            <Setter Property="Foreground" Value="#8888AA"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Focusable"  Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" CornerRadius="8"
                                Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="#1FF5820A"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#40F5820A"/>
                                <Setter Property="Foreground" Value="#F5820A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="#222236"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#484860"/>
                                <Setter Property="Foreground" Value="#C8C8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tooltip ──────────────────────────────────────────── -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource TooltipBg}"
                                BorderBrush="{DynamicResource TooltipBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                                  Opacity="0.18" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Back/nav button ──────────────────────────────────── -->
        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"   Value="32"/>
            <Setter Property="Height"  Value="32"/>
            <Setter Property="Cursor"  Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8"
                                Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Panel header title text ──────────────────────────── -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"     Value="12,0,0,0"/>
        </Style>

    </Window.Resources>

    <!-- ── Outer 4-row layout ─────────────────────────────────────── -->
    <Grid Background="{DynamicResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>   <!-- TitleBar -->
            <RowDefinition Height="54"/>   <!-- TopNav -->
            <RowDefinition Height="Auto"/> <!-- FilterBar -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             ROW 0 — Title Bar
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource VSTitleBarBg}"
                BorderBrush="#16162A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: title (draggable via WindowChrome caption area) -->
                <TextBlock Grid.Column="0" Text="VibeSwitcher"
                           FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>

                <!-- Right: min / max / close -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarBtn}"
                            Content="─" FontSize="11"
                            Click="TitleMinimize_Click"/>
                    <Button Style="{StaticResource TitleBarBtn}"
                            Content="□"
                            Click="TitleMaximize_Click"/>
                    <Button Style="{StaticResource TitleBarCloseBtn}"
                            Content="✕"
                            Click="TitleClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             ROW 1 — Top Navigation Bar
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource VSNavBg}"
                BorderBrush="{DynamicResource VSNavBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- logo -->
                    <ColumnDefinition Width="*"/>     <!-- search area -->
                    <ColumnDefinition Width="Auto"/>  <!-- right buttons -->
                </Grid.ColumnDefinitions>

                <!-- Logo: animated icon + VibeSwitcher in orange -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- NavLogoIcon: V chevron + equalizer bars, looping animation via NavLogoStoryboard -->
                    <!-- Nav logo: 36×36 canvas, coordinates scaled from 80-unit SVG reference -->
                    <Canvas Width="36" Height="36" Margin="0,0,8,0" VerticalAlignment="Center">
                        <!-- Rounded dark background -->
                        <Rectangle Width="36" Height="36" RadiusX="9" RadiusY="9" Fill="#13131E"/>
                        <Rectangle Width="36" Height="36" RadiusX="9" RadiusY="9" Fill="Transparent"
                                   Stroke="#38F5820A" StrokeThickness="1.5"/>
                        <!-- V chevron — breathes up/down via NavVChevronTranslate -->
                        <Path x:Name="NavVChevron"
                              Data="M 8.6,9.9 L 18,24.3 L 27.4,9.9"
                              Stroke="#F5820A" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent">
                            <Path.RenderTransform>
                                <TranslateTransform x:Name="NavVChevronTranslate" Y="0"/>
                            </Path.RenderTransform>
                        </Path>
                        <!-- Equalizer bars — 5 bars at reference proportions, each animates ScaleY from bottom -->
                        <Rectangle x:Name="NLBar1" Canvas.Left="10"   Canvas.Top="32"   Width="2" Height="2.2" RadiusX="1" RadiusY="1"
                                   Fill="#F5820A" Opacity="0.38" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="NLBar1Scale" ScaleY="1"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="NLBar2" Canvas.Left="13.3" Canvas.Top="31"   Width="2" Height="3.2" RadiusX="1" RadiusY="1"
                                   Fill="#F5820A" Opacity="0.62" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="NLBar2Scale" ScaleY="1"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="NLBar3" Canvas.Left="17"   Canvas.Top="30.6" Width="2" Height="3.6" RadiusX="1" RadiusY="1"
                                   Fill="#F5820A" Opacity="1"    RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="NLBar3Scale" ScaleY="1"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="NLBar4" Canvas.Left="20.7" Canvas.Top="31"   Width="2" Height="3.2" RadiusX="1" RadiusY="1"
                                   Fill="#F5820A" Opacity="0.62" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="NLBar4Scale" ScaleY="1"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="NLBar5" Canvas.Left="24"   Canvas.Top="32"   Width="2" Height="2.2" RadiusX="1" RadiusY="1"
                                   Fill="#F5820A" Opacity="0.38" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="NLBar5Scale" ScaleY="1"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                    <TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}">VibeSwitcher</TextBlock>
                    <Border Width="1" Height="22" Background="#1E1E30" Margin="12,0,12,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search + Filters (profile view) -->
                <StackPanel x:Name="SearchFiltersPanel" Grid.Column="1"
                            Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- Search box with placeholder -->
                    <Grid Margin="0,0,8,0">
                        <TextBox x:Name="NavSearchBox"
                                 Width="220" Height="32"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" VerticalContentAlignment="Center"
                                 Padding="10,0"/>
                        <TextBlock Text="Search profiles..." FontSize="12.5" FontStyle="Italic"
                                   Foreground="{DynamicResource DisabledText}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <!-- Filters toggle button -->
                    <Button x:Name="FiltersToggleBtn"
                            Height="32" Padding="10,0" Cursor="Hand"
                            Style="{StaticResource ActionButton}"
                            Click="FiltersBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Filters" FontSize="12" VerticalAlignment="Center"/>
                            <Border x:Name="FilterCountBadge"
                                    Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource Accent}"
                                    Margin="6,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAnyFilterActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ActiveFilterCount}"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#0D0D12"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: nav icon buttons + add profile + logs -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavFaqBtn"
                            Style="{StaticResource NavIconBtn}"
                            Content="?" Margin="0,0,4,0"
                            ToolTip="Help &amp; FAQ"
                            Click="NavFaq_Click"/>
                    <Button x:Name="NavAboutBtn"
                            Style="{StaticResource NavIconBtn}"
                            Content="ℹ" Margin="0,0,4,0"
                            ToolTip="About VibeSwitcher"
                            Click="NavAbout_Click"/>
                    <Button x:Name="NavSettingsBtn"
                            Style="{StaticResource NavIconBtn}"
                            Content="⚙" Margin="0,0,12,0"
                            ToolTip="Settings"
                            Click="NavSettings_Click"/>
                    <Border Width="1" Height="22" Background="#1E1E30" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Button Content="+ New Profile"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddProfileCommand}"/>
                    <Button x:Name="LogsButton"
                            Visibility="Collapsed" Margin="8,0,0,0"
                            Style="{StaticResource ActionButton}"
                            Click="LogsButton_Click">
                        <TextBlock x:Name="LogsButtonText" FontSize="11" Foreground="{DynamicResource WarningText}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             ROW 2 — Filter Bar (animated MaxHeight 0 ↔ 115)
             ══════════════════════════════════════════════════════════ -->
        <Border x:Name="FilterBarBorder" Grid.Row="2"
                MaxHeight="0" ClipToBounds="True"
                Background="{DynamicResource AppBg}"
                BorderBrush="#181826" BorderThickness="0,0,0,1">
            <StackPanel Margin="18,9,18,9">
                <views:CenteredWrapPanel>
                    <ToggleButton Content="Playback only"  IsChecked="{Binding ModePlayback}"  Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                    <ToggleButton Content="Recording only" IsChecked="{Binding ModeRecording}" Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                    <ToggleButton Content="Both devices"   IsChecked="{Binding ModeBoth}"      Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                    <ToggleButton Content="★ Pinned"       IsChecked="{Binding PinnedFilter}"  Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                    <ToggleButton Content="✓ Active"       IsChecked="{Binding ActiveFilter}"  Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                    <ToggleButton Content="Silent"          IsChecked="{Binding SilentFilter}"  Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                    <ToggleButton Content="Has hotkey"      IsChecked="{Binding HotkeyFilter}"  Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                    <ToggleButton Content="Has notes"       IsChecked="{Binding NotesFilter}"   Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                    <ToggleButton Content="Has icon"        IsChecked="{Binding IconFilter}"    Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                    <ToggleButton Content="Scheduled"       IsChecked="{Binding ScheduledFilter}" Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                    <ToggleButton Content="Has reminder"    IsChecked="{Binding ReminderFilter}" Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                    <ToggleButton Content="Has sound"       IsChecked="{Binding SoundFilter}"   Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                    <ToggleButton Content="Has warning"     IsChecked="{Binding WarningFilter}" Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                    <Button Content="✕ Clear"
                            Command="{Binding ClearFiltersCommand}"
                            Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ClearFilterButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnyFilterActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </views:CenteredWrapPanel>
                <!-- Day chips -->
                <ItemsControl ItemsSource="{Binding DayChips}" Margin="0,6,0,0">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ScheduledFilter}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <views:CenteredWrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DayChip}">
                            <ToggleButton Content="{Binding Label}"
                                          IsChecked="{Binding IsSelected}"
                                          Style="{StaticResource FilterChip}"
                                          Margin="0,0,4,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             ROW 3 — Main Content (4 panels share this Grid)
             ══════════════════════════════════════════════════════════ -->
        <Grid x:Name="MainGrid" Grid.Row="3">

            <!-- ── PANEL A: Profiles ─────────────────────────────── -->
            <ScrollViewer x:Name="ProfilesPanel"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,18,18,18">

                    <!-- Grid header -->
                    <Grid Margin="0,0,0,13">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PROFILES" FontSize="11" FontWeight="SemiBold" Foreground="#38384E" VerticalAlignment="Center"/>
                            <Border Background="#1C1C2A" CornerRadius="10" Margin="8,0,0,0"
                                    Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Profiles.Count}" FontSize="11" Foreground="#7878A0"/>
                            </Border>
                        </StackPanel>
                        <Button Content="Sound Settings"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ActionButton}"
                                FontSize="11"
                                Click="OpenSoundSettings_Click"/>
                    </Grid>

                    <!-- Compact card grid -->
                    <ItemsControl ItemsSource="{Binding Profiles}"
                                  KeyboardNavigation.DirectionalNavigation="Contained">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:CenteredWrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProfileCardViewModel}">

                                <Grid Width="275" Margin="0,0,14,14"
                                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">

                                    <Border x:Name="CardBg"
                                            CornerRadius="14" ClipToBounds="True"
                                            BorderThickness="1" Cursor="Hand"
                                            AllowDrop="True"
                                            DragEnter="Card_DragEnter"
                                            DragLeave="Card_DragLeave"
                                            DragOver="Card_DragOver"
                                            Drop="Card_Drop">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"   Value="#16161E"/>
                                                <Setter Property="BorderBrush"  Value="#222234"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#4DF5820A"/>
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                    <GradientStop Color="#1C1610" Offset="0"/>
                                                                    <GradientStop Color="#16161E" Offset="0.4"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#363650"/>
                                                        <Setter Property="Background"  Value="#1E1E28"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>   <!-- main content -->
                                                <RowDefinition Height="Auto"/><!-- action strip -->
                                            </Grid.RowDefinitions>

                                            <!-- Active bar (top accent line) -->
                                            <Border Grid.RowSpan="2" Height="2"
                                                    VerticalAlignment="Top" Margin="12,0"
                                                    Panel.ZIndex="5"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="Transparent" Offset="0"/>
                                                        <GradientStop Color="#F5820A"     Offset="0.5"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <!-- Main content — transparent click button -->
                                            <Button Grid.Row="0"
                                                    OverridesDefaultStyle="True"
                                                    Background="Transparent" BorderThickness="0"
                                                    Focusable="False"
                                                    Tag="{Binding}"
                                                    Click="ProfileCard_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>

                                                <StackPanel Margin="0,20,0,10" HorizontalAlignment="Center">
                                                    <!-- Icon area -->
                                                    <Border Width="90" Height="90" CornerRadius="20"
                                                            HorizontalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background"   Value="#1C1C2A"/>
                                                                <Setter Property="BorderBrush"  Value="#282838"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#47F5820A"/>
                                                                        <Setter Property="Effect">
                                                                            <Setter.Value>
                                                                                <DropShadowEffect Color="#F5820A" Opacity="0.1" BlurRadius="18" ShadowDepth="0"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Image Source="{Binding IconPreview}" Width="46" Height="46" Stretch="Uniform"/>
                                                    </Border>

                                                    <!-- Name -->
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="#E4E4EF"
                                                               HorizontalAlignment="Center"
                                                               MaxWidth="220"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,12,0,7"/>

                                                    <!-- Mode badge -->
                                                    <Border Margin="0,8,0,0" CornerRadius="10" Padding="8,2.5"
                                                            HorizontalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background"   Value="#1FF5820A"/>
                                                                <Setter Property="BorderBrush"  Value="#40F5820A"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding PlaybackVisible}" Value="Visible"/>
                                                                            <Condition Binding="{Binding RecordingVisible}" Value="Collapsed"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Background"  Value="#1A4AA8FF"/>
                                                                        <Setter Property="BorderBrush" Value="#334AA8FF"/>
                                                                    </MultiDataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding PlaybackVisible}" Value="Collapsed"/>
                                                                            <Condition Binding="{Binding RecordingVisible}" Value="Visible"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Background"  Value="#1A30D278"/>
                                                                        <Setter Property="BorderBrush" Value="#3330D278"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ModeLabel}"
                                                                   FontSize="9.5" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#F5820A"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding PlaybackVisible}" Value="Visible"/>
                                                                                <Condition Binding="{Binding RecordingVisible}" Value="Collapsed"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Foreground" Value="#4AA8FF"/>
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding PlaybackVisible}" Value="Collapsed"/>
                                                                                <Condition Binding="{Binding RecordingVisible}" Value="Visible"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Foreground" Value="#30D278"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- Separator (badge → devices) -->
                                                    <Border Height="1" Background="#0EFFFFFF" Margin="0,10,0,10" Width="220"/>

                                                    <!-- Device rows -->
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding SelectedPlaybackDevice.FriendlyName}"
                                                                   FontSize="11" Foreground="#A0A0C0"
                                                                   HorizontalAlignment="Center"
                                                                   MaxWidth="220" TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,0,5"
                                                                   Visibility="{Binding PlaybackVisible}"/>
                                                        <TextBlock Text="{Binding SelectedRecordingDevice.FriendlyName}"
                                                                   FontSize="11" Foreground="#A0A0C0"
                                                                   HorizontalAlignment="Center"
                                                                   MaxWidth="220" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding RecordingVisible}"/>
                                                    </StackPanel>

                                                    <!-- Separator (devices → hotkey) -->
                                                    <Border Height="1" Background="#0EFFFFFF" Margin="0,10,0,10" Width="220"/>

                                                    <!-- Hotkey chip -->
                                                    <Border CornerRadius="4" Background="#131320"
                                                            BorderBrush="#222234" BorderThickness="1"
                                                            Padding="8,3"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,6,0,0"
                                                            Visibility="{Binding IsHotkeySet, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#x2328;" FontSize="9" Foreground="#484868"
                                                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock Text="{Binding HotkeyDisplay}"
                                                                       FontFamily="Consolas" FontSize="11"
                                                                       Foreground="#6060A0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Button>

                                            <!-- Always-visible action strip -->
                                            <Border Grid.Row="1" BorderBrush="#0BFFFFFF" BorderThickness="0,1,0,0"
                                                    Padding="10,7,10,9" Background="#47000000">
                                                <StackPanel>
                                                    <!-- Row 1: 5 buttons, space-between -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- 1. Silent — bell with slash -->
                                                        <ToggleButton Grid.Column="0" HorizontalAlignment="Center"
                                                                      IsChecked="{Binding Silent}"
                                                                      ToolTip="Toggle silent mode">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource CardActionToggle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SoundOverride}" Value="True">
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                            <Setter Property="Opacity" Value="0.35"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                            <Viewbox Width="14" Height="14">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M8,2 A5,5 0 0 0 3,7 V10 L2,12 H14 L13,10 V7 A5,5 0 0 0 8,2 Z"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                    <Path Data="M6.5,13.5 A1.5,1.5 0 0 0 9.5,13.5"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                    <Path Data="M2,2 L14,14"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </ToggleButton>
                                                        <!-- 2. App triggers — lightning bolt -->
                                                        <Button Grid.Column="1" HorizontalAlignment="Center"
                                                                Command="{Binding OpenAppTriggersCommand}"
                                                                ToolTip="App launch triggers">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasAppTriggers}" Value="True">
                                                                            <Setter Property="Foreground" Value="#F5820A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Viewbox Width="15" Height="15">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M9.2,1.5 L3.5,9 H8.7 L6.8,14.5 L13.5,7 H8.3 Z"
                                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                        <!-- 3. Auto-switch — power plug (dim when Recording-only, not supported) -->
                                                        <ToggleButton Grid.Column="2" HorizontalAlignment="Center"
                                                                      IsChecked="{Binding TriggerOnConnect}"
                                                                      ToolTip="Auto-switch on device connect">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource CardActionToggle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TriggerOnConnectVisible}" Value="Collapsed">
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                            <Setter Property="Opacity" Value="0.28"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                            <Viewbox Width="14" Height="14">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M6,1.5 L6,5 M10,1.5 L10,5 M3.5,5 H12.5 V7.5 A4.5,4.5 0 0 1 8,12 A4.5,4.5 0 0 1 3.5,7.5 Z M8,12 L8,14.5 M6,14.5 L10,14.5"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </ToggleButton>
                                                        <!-- 4. Favorite/Pin — filled star -->
                                                        <ToggleButton Grid.Column="3" HorizontalAlignment="Center"
                                                                      IsChecked="{Binding IsPinned}"
                                                                      Style="{StaticResource CardActionToggle}"
                                                                      ToolTip="Pin to top of list">
                                                            <Viewbox Width="14" Height="14">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M8,1.5 L10.2,5.8 L15,6.4 L11.5,9.8 L12.4,14.5 L8,12.1 L3.6,14.5 L4.5,9.8 L1,6.4 L5.8,5.8 Z"
                                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </ToggleButton>
                                                        <!-- 5. Activate — circle + checkmark -->
                                                        <Button Grid.Column="4" HorizontalAlignment="Center"
                                                                Command="{Binding ActivateCommand}"
                                                                ToolTip="Activate this profile">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Foreground" Value="#2DCA72"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Viewbox Width="14" Height="14">
                                                                <Canvas Width="16" Height="16">
                                                                    <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="11" Height="11"
                                                                             Fill="Transparent"
                                                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                             StrokeThickness="1.7"/>
                                                                    <Path Data="M5.5,8 L7.5,10.2 L11,6"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                    <!-- Row 2: 4 buttons, centered with 10px gap -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <!-- 6. Clone — two overlapping rectangles -->
                                                        <Button Style="{StaticResource CardActionBtn}" Margin="5,0"
                                                                Command="{Binding CloneCommand}" ToolTip="Clone this profile">
                                                            <Viewbox Width="14" Height="14">
                                                                <Canvas Width="16" Height="16">
                                                                    <Rectangle Canvas.Left="5.5" Canvas.Top="5.5" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5"
                                                                               Fill="Transparent"
                                                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                               StrokeThickness="1.7"/>
                                                                    <Path Data="M3.5,10.5 V3.5 A1,1 0 0 1 4.5,2.5 H11.5"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                        <!-- 7. Schedule — clock with hands -->
                                                        <Button Margin="5,0"
                                                                Command="{Binding AddScheduleCommand}" ToolTip="Schedule this profile">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasSchedules}" Value="True">
                                                                            <Setter Property="Foreground" Value="#4AA8FF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Viewbox Width="14" Height="14">
                                                                <Canvas Width="16" Height="16">
                                                                    <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="11" Height="11"
                                                                             Fill="Transparent"
                                                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                             StrokeThickness="1.7"/>
                                                                    <Path Data="M8,5 L8,8.5 L10.5,10.2"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                        <!-- 8. Sound — sine wave + remove badge when active -->
                                                        <Grid Margin="5,0">
                                                            <Button Command="{Binding ConfigureSoundCommand}" ToolTip="Configure switch sound">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SoundOverride}" Value="True">
                                                                                <Setter Property="Foreground" Value="#2DCA72"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <Viewbox Width="14" Height="14">
                                                                    <Canvas Width="16" Height="16">
                                                                        <Path Data="M1,8 Q2.5,3.5 4,8 Q5.5,12.5 7,8 Q8.5,3.5 10,8 Q11.5,12.5 13,8 Q14,5.5 15,8"
                                                                              Fill="Transparent"
                                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                            </Button>
                                                            <!-- × remove badge: only visible when a sound is configured -->
                                                            <Button Command="{Binding RemoveSwitchSoundCommand}"
                                                                    Width="14" Height="14"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Margin="0,-5,-5,0"
                                                                    Padding="0"
                                                                    ToolTip="Remove switch sound"
                                                                    Background="#CC2B2B" Foreground="White"
                                                                    BorderThickness="0">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="bg" Background="#CC2B2B" CornerRadius="7">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="bg" Property="Background" Value="#E06060"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SoundOverride}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock Text="×" FontSize="10" FontWeight="Bold" Foreground="White"
                                                                           Margin="0,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </Grid>
                                                        <!-- 9. Delete — trash can -->
                                                        <Button Margin="5,0"
                                                                Command="{Binding DeleteCommand}" ToolTip="Delete this profile">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Foreground" Value="#E06060"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Viewbox Width="14" Height="14">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Data="M2,4 H14 M5.5,4 V2.5 H10.5 V4 M3.5,4 L4.3,13.5 H11.7 L12.5,4"
                                                                          Fill="Transparent"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Save flash overlay -->
                                    <Border x:Name="FlashOverlay"
                                            CornerRadius="14"
                                            Background="{DynamicResource SaveFlashBg}"
                                            Opacity="0" IsHitTestVisible="False"/>

                                </Grid>

                                <DataTemplate.Triggers>
                                    <!-- Save flash -->
                                    <DataTrigger Binding="{Binding SaveFlash}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="FlashOverlay"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0.7" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="FlashOverlay"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.28"
                                                                     FillBehavior="Stop"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- No filter results -->
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource DisabledText}"
                               FontSize="13" Margin="0,32,0,8"
                               Text="No profiles match your filters.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoFilterResults}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Empty state -->
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource DisabledText}"
                               FontSize="13" Margin="0,32,0,24"
                               Text="No profiles yet — click + New Profile to get started.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoProfiles}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>

            <!-- ── PANEL B: Settings ──────────────────────────────── -->
            <ScrollViewer x:Name="SettingsBodyScrollViewer"
                          Visibility="Collapsed"
                          VerticalAlignment="Stretch"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18,22,18">

                    <!-- Panel header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Style="{StaticResource BackButton}"
                                Content="←" FontSize="14"
                                Click="NavProfiles_Click"/>
                        <TextBlock Text="Settings" Style="{StaticResource PanelTitle}"/>
                    </StackPanel>

                    <!-- Appearance -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Theme" Style="{StaticResource LabelText}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Height="30">
                                    <StackPanel.Resources>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="GroupName" Value="ThemeGroup"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Padding" Value="14,0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="Bg"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                              Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background"  Value="{DynamicResource Accent}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="Foreground"  Value="White"/>
                                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Resources>
                                    <RadioButton Content="Follow Windows" Tag="Auto" Margin="0,0,8,0" Checked="ThemeRadio_Checked">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Theme}" Value="Auto">
                                                        <Setter Property="IsChecked" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                    <RadioButton Content="Light" Tag="Light" Margin="0,0,8,0" Checked="ThemeRadio_Checked">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Theme}" Value="Light">
                                                        <Setter Property="IsChecked" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                    <RadioButton Content="Dark" Tag="Dark" Checked="ThemeRadio_Checked">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Theme}" Value="Dark">
                                                        <Setter Property="IsChecked" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Startup -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="STARTUP" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}"
                                       Margin="0,0,0,10"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartWithWindows}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic" Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip><ToolTip><TextBlock Text="When your PC boots up, VibeSwitcher will start automatically." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip></Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartMinimized}" Margin="0,3">
                                <TextBlock Text="Start minimized to tray" VerticalAlignment="Center"/>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CloseToTray}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Close to tray" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic" Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip><ToolTip><TextBlock Text="Clicking Close hides this window instead of exiting. Right-click the tray icon to reopen." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip></Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Notifications -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="NOTIFICATIONS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}"
                                       Margin="0,0,0,10"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShowNotifications}" Margin="0,3">
                                <TextBlock Text="Show device switch alerts" VerticalAlignment="Center"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Schedules -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="SCHEDULES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}"
                                       Margin="0,0,0,10"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Use24HourClock}" Margin="0,3">
                                <TextBlock Text="Use 24-hour clock" VerticalAlignment="Center"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Tray -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="TRAY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}"
                                       Margin="0,0,0,10"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LeftClickCyclesProfiles}" Margin="0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Left-click tray icon to cycle profiles" VerticalAlignment="Center"/>
                                    <Border Width="16" Height="16" Background="{DynamicResource InfoBadgeBg}" CornerRadius="8" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help">
                                        <TextBlock Text="i" FontSize="9" FontWeight="Bold" FontStyle="Italic" Foreground="{DynamicResource InfoBadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.ToolTip><ToolTip><TextBlock Text="Left-clicking the tray icon cycles profiles. When disabled, left-click opens VibeSwitcher instead." TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource PrimaryText}"/></ToolTip></Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Devices -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="DEVICES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}"
                                       Margin="0,0,0,10"/>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding UseLegacySoundPanel}" Margin="0,3">
                                <TextBlock Text="Use legacy sound panel" VerticalAlignment="Center"/>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShowDisabledDevices}" Margin="0,3">
                                <TextBlock Text="Show disabled devices in dropdowns" VerticalAlignment="Center"/>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShowDisconnectedDevices}" Margin="0,3">
                                <TextBlock Text="Show disconnected devices in dropdowns" VerticalAlignment="Center"/>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Open Sound Settings"
                                        Style="{StaticResource ActionButton}"
                                        Click="OpenSoundSettings_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Shortcuts -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="SHORTCUTS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="Open / Close VibeSwitcher" FontSize="12" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="{DynamicResource HotkeyBg}" BorderBrush="{DynamicResource HotkeyBorder}" BorderThickness="1" CornerRadius="5" Padding="10,5" Margin="0,0,8,0" MinWidth="74" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SettingsHotkeyDisplay}" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SettingsHotkeyDisplay}" Value="None">
                                                        <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Style="{StaticResource ActionButton}" Content="Set hotkey" Margin="0,0,6,0" Click="SettingsHotkeyButton_Click"/>
                                <Button Content="✕" Click="SettingsHotkeyClear_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsHotkeyIsSet}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <Separator Margin="0,0,0,12" Background="{DynamicResource SeparatorBrush}" Height="1" BorderThickness="0"/>
                            <TextBlock Text="Mute Microphone" FontSize="12" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="{DynamicResource HotkeyBg}" BorderBrush="{DynamicResource HotkeyBorder}" BorderThickness="1" CornerRadius="5" Padding="10,5" Margin="0,0,8,0" MinWidth="74" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MuteMicHotkeyDisplay}" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MuteMicHotkeyDisplay}" Value="None">
                                                        <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Style="{StaticResource ActionButton}" Content="Set hotkey" Tag="Mic" Margin="0,0,6,0" Click="MuteHotkeyButton_Click"/>
                                <Button Tag="Mic" Content="✕" Click="MuteHotkeyClear_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MuteMicHotkeyIsSet}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Mute Speakers" FontSize="12" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="{DynamicResource HotkeyBg}" BorderBrush="{DynamicResource HotkeyBorder}" BorderThickness="1" CornerRadius="5" Padding="10,5" Margin="0,0,8,0" MinWidth="74" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MuteSpeakersHotkeyDisplay}" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MuteSpeakersHotkeyDisplay}" Value="None">
                                                        <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Style="{StaticResource ActionButton}" Content="Set hotkey" Tag="Speakers" Margin="0,0,6,0" Click="MuteHotkeyButton_Click"/>
                                <Button Tag="Speakers" Content="✕" Click="MuteHotkeyClear_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MuteSpeakersHotkeyIsSet}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Mute Mic + Speakers" FontSize="12" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource HotkeyBg}" BorderBrush="{DynamicResource HotkeyBorder}" BorderThickness="1" CornerRadius="5" Padding="10,5" Margin="0,0,8,0" MinWidth="74" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MuteBothHotkeyDisplay}" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MuteBothHotkeyDisplay}" Value="None">
                                                        <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Style="{StaticResource ActionButton}" Content="Set hotkey" Tag="Both" Margin="0,0,6,0" Click="MuteHotkeyButton_Click"/>
                                <Button Tag="Both" Content="✕" Click="MuteHotkeyClear_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MuteBothHotkeyIsSet}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Device Aliases -->
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="DEVICE ALIASES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}"/>
                                <TextBlock Text="Give your audio devices custom friendly names."
                                           FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Manage…"
                                    Style="{StaticResource ActionButton}"
                                    VerticalAlignment="Center"
                                    Click="ManageAliasesButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Backup & Restore -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="BACKUP &amp; RESTORE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Save your profiles to a file, or restore from a previous backup."
                                       FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Export Config" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="ExportButton_Click"/>
                                <Button Content="Import Config" Style="{StaticResource ActionButton}" Click="ImportButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Session Log -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="DIAGNOSTICS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
                            <TextBlock Text="View errors and warnings logged during this session."
                                       FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Content="View session log" Style="{StaticResource ActionButton}"
                                    HorizontalAlignment="Left" Click="LogsButton_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── PANEL C: About ─────────────────────────────────── -->
            <ScrollViewer x:Name="AboutPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18,22,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Style="{StaticResource BackButton}" Content="&#x2190;" FontSize="14" Click="NavProfiles_Click"/>
                        <TextBlock Text="About" Style="{StaticResource PanelTitle}"/>
                    </StackPanel>

                    <!-- App identity card -->
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="13"
                                    Background="#1C1C2A" BorderBrush="#282838" BorderThickness="1"
                                    Margin="0,0,14,0">
                                <Image x:Name="AboutPanelIcon" Width="34" Height="34" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}">
                                    <Run Text="Vibe"/><Run Text="Switcher" Foreground="{DynamicResource Accent}"/>
                                </TextBlock>
                                <TextBlock x:Name="AboutVersionText"
                                           FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                                <TextBlock Text="Manage audio device profiles with global hotkeys, schedules, app triggers, and headset auto-detection."
                                           FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Links -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="LINKS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center">
                                    <Hyperlink NavigateUri="https://github.com/raphymany/vibeswitcher"
                                               RequestNavigate="Hyperlink_RequestNavigate">GitHub</Hyperlink>
                                </TextBlock>
                                <TextBlock Text=" — " Foreground="{DynamicResource DisabledText}" FontSize="12"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center">
                                    <Hyperlink NavigateUri="https://github.com/raphymany/vibeswitcher/blob/main/CHANGELOG.md"
                                               RequestNavigate="Hyperlink_RequestNavigate">Changelog</Hyperlink>
                                </TextBlock>
                                <TextBlock Text=" — " Foreground="{DynamicResource DisabledText}" FontSize="12"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center">
                                    <Hyperlink NavigateUri="https://github.com/raphymany/vibeswitcher/blob/main/LICENSE"
                                               RequestNavigate="Hyperlink_RequestNavigate">License (MIT)</Hyperlink>
                                </TextBlock>
                                <TextBlock Text=" — " Foreground="{DynamicResource DisabledText}" FontSize="12"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center">
                                    <Hyperlink NavigateUri="https://github.com/raphymany/vibeswitcher/issues/new/choose"
                                               RequestNavigate="Hyperlink_RequestNavigate">Report a bug</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Built with -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="BUILT WITH" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="WPF / .NET 8" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock Grid.Column="1" Text="Windows Presentation Foundation" FontSize="12"
                                           Foreground="{DynamicResource SecondaryText}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="NAudio" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock Grid.Column="1" Text="Audio playback and device management" FontSize="12"
                                           Foreground="{DynamicResource SecondaryText}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CoreAudio" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock Grid.Column="1" Text="Windows audio COM APIs" FontSize="12"
                                           Foreground="{DynamicResource SecondaryText}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="HID API" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock Grid.Column="1" Text="Wireless headset detection" FontSize="12"
                                           Foreground="{DynamicResource SecondaryText}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Credits + actions -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="DEVELOPMENT" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,10"/>
                            <TextBlock Text="Designed and built by" FontSize="11"
                                       Foreground="{DynamicResource SecondaryText}"/>
                            <TextBlock Text="Raphael Mansour" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}" Margin="0,2,0,10"/>
                            <TextBlock Text="&#xA9; 2026 Raphael Mansour. All rights reserved."
                                       FontSize="11" Foreground="{DynamicResource DisabledText}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── PANEL D: FAQ ───────────────────────────────────── -->
            <ScrollViewer x:Name="FaqPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18,22,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Button Style="{StaticResource BackButton}" Content="←" FontSize="14" Click="NavProfiles_Click"/>
                        <TextBlock Text="Help &amp; FAQ" Style="{StaticResource PanelTitle}"/>
                    </StackPanel>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="WHAT IS VIBESWITCHER?" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                VibeSwitcher is a Windows system tray app that lets you save audio device configurations as profiles and switch between them instantly — using hotkeys, schedules, or a single click.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="SETTING UP PROFILES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Click "+ New Profile" to create a profile. Choose a mode (Playback, Recording, or Both), pick your devices, then give it a name. You can assign a global hotkey to activate it from anywhere.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="FILTERING PROFILES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Use the search box and filter chips to narrow down your profile list. Filters stack (AND logic). Clear all filters with the ✕ Clear button.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="USING HOTKEYS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Click a card to open profile details, then click "Set Hotkey". Press your desired key combination. Hotkeys work globally — even when VibeSwitcher is minimized to the tray.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="SCHEDULED SWITCHING" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Click the schedule button (&#x231A;) on a card to add a schedule. Choose a time and days of the week. Multiple schedules per profile are supported. The blue dot on a card means at least one schedule is active.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="AUTO-SWITCH ON CONNECT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Click the auto-switch button (&#x26A1;) on a card to enable auto-switch. VibeSwitcher will activate this profile whenever its playback device connects. Best for wireless headsets and USB audio interfaces.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="BACKUP &amp; RESTORE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap">
                                Go to Settings → Backup &amp; Restore to export your config to a JSON file. Import that file on a new machine to restore all your profiles. Config is stored at %APPDATA%\VibeSwitcher\config.json.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════════════════
                 PROFILE DETAIL OVERLAY  (Panel.ZIndex = 10)
                 ══════════════════════════════════════════════════════ -->
            <Grid x:Name="ProfileDetailOverlay"
                  Visibility="Collapsed"
                  Panel.ZIndex="10">

                <!-- Backdrop -->
                <Border Background="#D405050A"
                        MouseLeftButtonDown="OverlayBackdrop_MouseDown"/>

                <!-- Modal card -->
                <Border MaxWidth="500" MinWidth="400"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="20"
                        Background="{DynamicResource VSModalBg}"
                        CornerRadius="18"
                        BorderBrush="#29F5820A" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.78" BlurRadius="80" ShadowDepth="0"/>
                    </Border.Effect>

                    <Grid x:Name="ProfileDetailContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- header -->
                            <RowDefinition Height="*"/>     <!-- body -->
                            <RowDefinition Height="Auto"/>  <!-- footer -->
                        </Grid.RowDefinitions>

                        <!-- ── Modal Header ── -->
                        <Border Grid.Row="0"
                                BorderBrush="#1E1E2C" BorderThickness="0,0,0,1"
                                Padding="22,18,22,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon preview -->
                                <Border Grid.Column="0" Width="54" Height="54" CornerRadius="13"
                                        Background="#1C1C2A" BorderBrush="#282838" BorderThickness="1"
                                        Margin="0,0,14,0">
                                    <Image Source="{Binding IconPreview}" Width="36" Height="36" Stretch="Uniform"/>
                                </Border>

                                <!-- Name + mode badge -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="20"
                                             FontSize="16" FontWeight="Bold"
                                             Foreground="{DynamicResource PrimaryText}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Margin="0,0,0,6"/>
                                    <Border CornerRadius="10" Padding="8,2.5"
                                            HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"   Value="#1FF5820A"/>
                                                <Setter Property="BorderBrush"  Value="#40F5820A"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding PlaybackVisible}" Value="Visible"/>
                                                            <Condition Binding="{Binding RecordingVisible}" Value="Collapsed"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background"  Value="#1A4AA8FF"/>
                                                        <Setter Property="BorderBrush" Value="#334AA8FF"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding PlaybackVisible}" Value="Collapsed"/>
                                                            <Condition Binding="{Binding RecordingVisible}" Value="Visible"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background"  Value="#1A30D278"/>
                                                        <Setter Property="BorderBrush" Value="#3330D278"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ModeLabel}"
                                                   FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Close button -->
                                <Button Grid.Column="2" Width="30" Height="30"
                                        Content="✕" FontSize="13"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource BackButton}"
                                        Click="OverlayClose_Click"/>
                            </Grid>
                        </Border>

                        <!-- ── Modal Body (scrollable) ── -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="440">
                            <StackPanel Margin="22,14,22,14">

                                <!-- Name suggestions -->
                                <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,10">
                                    <WrapPanel.Style>
                                        <Style TargetType="WrapPanel">
                                            <!-- Hidden (not Collapsed) so the row keeps its height when suggestions disappear,
                                                 preventing the dialog from shrinking as the user types a name. -->
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowNameSuggestions}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>
                                    <Button Content="Gaming"    Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Gaming"/>
                                    <Button Content="Work"      Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Work"/>
                                    <Button Content="Music"     Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Music"/>
                                    <Button Content="Headset"   Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Headset"/>
                                    <Button Content="Streaming" Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Streaming"/>
                                    <Button Content="Calls"     Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Calls"/>
                                    <Button Content="Mic"       Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Mic"/>
                                    <Button Content="Home"      Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Home"/>
                                    <Button Content="Speakers"  Style="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Speakers"/>
                                </WrapPanel>

                                <!-- Notes -->
                                <TextBlock Text="NOTES" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,14">
                                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="61"/>
                                    <TextBlock Text="Add a note about this profile..."
                                               IsHitTestVisible="False"
                                               Foreground="{DynamicResource TertiaryText}" FontStyle="Italic"
                                               VerticalAlignment="Center" Margin="9,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Notes}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Playback device -->
                                <StackPanel Visibility="{Binding PlaybackVisible}" Margin="0,0,0,14">
                                    <TextBlock Text="PLAYBACK DEVICE" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding PlaybackDevices}"
                                                  SelectedItem="{Binding SelectedPlaybackDevice}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Visibility="{Binding ShowDot, Converter={StaticResource BoolToVis}}">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource SuccessDot}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                            <Setter Property="Fill" Value="{DynamicResource ErrorDot}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1" Content="Test" Margin="8,0,0,0"
                                                Style="{StaticResource ActionButton}"
                                                Command="{Binding TestSoundCommand}"
                                                IsEnabled="{Binding IsPlaybackDeviceSet}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Recording device -->
                                <StackPanel Visibility="{Binding RecordingVisible}" Margin="0,0,0,14">
                                    <TextBlock Text="RECORDING DEVICE" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding RecordingDevices}"
                                                  SelectedItem="{Binding SelectedRecordingDevice}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Visibility="{Binding ShowDot, Converter={StaticResource BoolToVis}}">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource SuccessDot}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                            <Setter Property="Fill" Value="{DynamicResource ErrorDot}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1" Content="Test" Margin="8,0,0,0"
                                                Style="{StaticResource ActionButton}"
                                                Command="{Binding TestMicCommand}"
                                                IsEnabled="{Binding IsRecordingDeviceSet}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Hotkey -->
                                <TextBlock Text="HOTKEY" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBox Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                             IsReadOnly="True" IsTabStop="False" Width="120" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource ActionButton}" Content="Set Hotkey"
                                            Command="{Binding CaptureHotkeyCommand}"/>
                                </StackPanel>

                                <!-- Icon -->
                                <TextBlock Text="ICON" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBox Text="{Binding IconPath, Mode=OneWay, FallbackValue='(default)'}"
                                             IsReadOnly="True" IsTabStop="False" Width="160" Margin="0,0,8,0"/>
                                    <Button Content="Pick Icon" Style="{StaticResource ActionButton}"
                                            Command="{Binding PickIconCommand}" Margin="0,0,6,0"/>
                                    <Border Background="Transparent"
                                            BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                                            CornerRadius="4" Padding="3" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconPreview}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding IconPreview}" Width="18" Height="18"/>
                                    </Border>
                                </StackPanel>

                                <!-- Validation warning -->
                                <Border Padding="10,7" CornerRadius="5"
                                        Background="{DynamicResource WarningBg}"
                                        BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
                                        Margin="0,0,0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValidationWarning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠" FontSize="12" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource WarningText}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ValidationWarning}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Schedules section -->
                                <Border Margin="0,4,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSchedules}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="SCHEDULES" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Schedules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ScheduleEntryViewModel}">
                                                    <Border Background="{DynamicResource InnerCardBg}"
                                                            BorderBrush="{DynamicResource InnerCardBorderBrush}"
                                                            BorderThickness="1" CornerRadius="6"
                                                            Padding="10,8" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <CheckBox IsChecked="{Binding Enabled}" Style="{StaticResource ToggleSwitchStyle}"
                                                                          DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                                <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource DangerButton}"
                                                                        Command="{Binding DeleteCommand}" FontSize="10" Padding="10,2" Height="26" VerticalAlignment="Center"/>
                                                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource ActionButton}"
                                                                        Command="{Binding EditCommand}" FontSize="10" Padding="12,2" Height="26"
                                                                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding ConflictMessage}" FontSize="11" Foreground="#CC6600"
                                                                       TextWrapping="Wrap" Margin="42,4,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Switch sound section -->
                                <Border Margin="0,8,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SoundOverride}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="SWITCH SOUND" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
                                        <Border Background="{DynamicResource InnerCardBg}"
                                                BorderBrush="{DynamicResource InnerCardBorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource DangerButton}"
                                                        Command="{Binding RemoveSwitchSoundCommand}" FontSize="10" Padding="10,2" Height="26" VerticalAlignment="Center"/>
                                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource ActionButton}"
                                                        Command="{Binding ConfigureSoundCommand}" FontSize="10" Padding="12,2" Height="26"
                                                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SoundSummary}" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ── Modal Footer ── -->
                        <Border Grid.Row="2"
                                BorderBrush="#1E1E2C" BorderThickness="0,1,0,0"
                                Padding="22,14,22,18">
                            <Grid>
                                <!-- Quick action buttons (left) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionButton}" Content="Activate"
                                            Command="{Binding ActivateCommand}" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource ActionButton}" Content="Add Schedule"
                                            Command="{Binding AddScheduleCommand}" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource ActionButton}" Content="Clone"
                                            Command="{Binding CloneCommand}" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource DangerButton}" Content="Delete"
                                            Command="{Binding DeleteCommand}"/>
                                </StackPanel>
                                <!-- Done button (right) -->
                                <Button Content="Done"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        Click="OverlayClose_Click"/>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

        </Grid><!-- /MainGrid -->
    </Grid><!-- /outer Grid -->
</Window>

