<Window x:Class="VibeSwitcher.Views.ConflictRetryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="{DynamicResource WarningBg}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IcoWarning}" Width="18" Height="18" Stretch="Uniform"
                          Fill="Transparent" Stroke="{DynamicResource WarningText}" StrokeThickness="1.5"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="280"/>
            </StackPanel>

            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource PrimaryText}" LineHeight="18"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Try Again"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Margin="0,0,8,0"
                        Click="TryAgain_Click"/>
                <Button Content="Close"
                        Style="{StaticResource ActionButton}"
                        IsCancel="True"
                        Click="Close_Click"/>
            </StackPanel>

        </StackPanel>
    
        <!-- Shared accent window frame (Views/AccentFrame.xaml). -->
        <views:AccentFrame Grid.RowSpan="99" Grid.ColumnSpan="99" Panel.ZIndex="9999"/>
    </Grid>
</Window>
