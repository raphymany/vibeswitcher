<Window x:Class="VibeSwitcher.Views.SupportedHeadsetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ControlTemplate x:Key="RoundedBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Template"        Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Template"        Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background"      Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource HoverBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="#E3F2FD" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="📡" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Supported Wireless Headsets"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="Auto-switch via USB dongle power detection"
                               FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Explanation -->
            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource PrimaryText}" LineHeight="18"
                       Margin="0,0,0,12">
                Wireless headsets with a permanent USB dongle appear connected in Windows even when off.
                VibeSwitcher reads HID packets from the dongle to detect when the headset powers on,
                and triggers an auto-switch at that exact moment — without any polling delay.
            </TextBlock>

            <!-- Detected banner (populated and shown in code-behind) -->
            <Border x:Name="DetectedBanner"
                    Background="#E8F5E9" CornerRadius="6" Padding="10,8"
                    Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🟢 " FontSize="11"/>
                    <TextBlock x:Name="DetectedText" TextWrapping="Wrap" FontSize="12"
                               Foreground="#2E7D32" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Brand list (populated in code-behind) -->
            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BrandsPanel"/>
                </ScrollViewer>
            </Border>

            <!-- Action buttons -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="My headset is listed — I'm good"
                        Style="{StaticResource PrimaryBtn}"
                        IsDefault="True" IsCancel="True"
                        Click="Good_Click"/>

                <Button Grid.Column="2"
                        Content="Not listed — Request support"
                        Style="{StaticResource SecondaryBtn}"
                        Click="Request_Click"/>
            </Grid>

        </StackPanel>
    </Grid>
</Window>
