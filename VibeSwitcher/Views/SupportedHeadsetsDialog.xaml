<Window x:Class="VibeSwitcher.Views.SupportedHeadsetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="{DynamicResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IcoPlug}" Width="18" Height="18" Stretch="Uniform"
                          Fill="Transparent" Stroke="White" StrokeThickness="1.5"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Enable Auto-Switch"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="Works for all devices — including wireless headsets"
                               FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Explanation -->
            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource PrimaryText}" LineHeight="18"
                       Margin="0,0,0,12">
                Auto-switch works for any device — USB, Bluetooth, and more. When your playback device connects, Windows notifies VibeSwitcher and the switch happens automatically.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource PrimaryText}" LineHeight="18"
                       Margin="0,0,0,12">
                The list below covers wireless headsets whose USB dongle stays plugged in permanently. Windows can't detect when these headsets power on or off, so VibeSwitcher reads the dongle's HID packets directly to catch the exact moment the headset turns on.
            </TextBlock>

            <!-- Brand list (populated in code-behind) -->
            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BrandsPanel"/>
                </ScrollViewer>
            </Border>

            <!-- Action buttons -->
            <StackPanel Margin="0,16,0,0">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Enable Auto-Switch"
                            Style="{StaticResource PrimaryButton}"
                            IsDefault="True"
                            Click="Good_Click"/>
                    <Button Grid.Column="2"
                            Content="Request wireless headset support"
                            Style="{StaticResource ActionButton}"
                            Click="Request_Click"/>
                </Grid>
                <Button Content="Close"
                        Style="{StaticResource ActionButton}"
                        IsCancel="True"
                        HorizontalAlignment="Center"
                        Width="80"
                        Click="Close_Click"/>
            </StackPanel>

        </StackPanel>
    
        <!-- Shared accent window frame (Views/AccentFrame.xaml). -->
        <views:AccentFrame Grid.RowSpan="99" Grid.ColumnSpan="99" Panel.ZIndex="9999"/>
    </Grid>
</Window>
