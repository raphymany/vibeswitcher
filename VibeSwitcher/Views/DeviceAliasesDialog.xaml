<Window x:Class="VibeSwitcher.Views.DeviceAliasesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="440" SizeToContent="Height" MaxHeight="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <TextBlock Text="Device Aliases"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Custom names are shown everywhere a device appears — dropdowns, cards, and tooltips. Leave a field blank to use the Windows device name."
                       FontSize="12" Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

            <!-- Empty state -->
            <TextBlock Text="No audio devices detected. Devices appear here once enumeration completes."
                       FontSize="12" Foreground="{DynamicResource DisabledText}"
                       TextWrapping="Wrap" HorizontalAlignment="Center"
                       Margin="0,8,0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasKnownDevices}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Column headers -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Windows name"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource SectionLabelText}"/>
                <TextBlock Grid.Column="2" Text="Your alias"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource SectionLabelText}"/>
            </Grid>

            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DeviceAliases}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding RawName}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RawName}"/>
                                <Grid Grid.Column="2">
                                    <TextBox Text="{Binding Alias, UpdateSourceTrigger=LostFocus}"
                                             FontSize="12" Padding="6,4"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Custom alias…"
                                               IsHitTestVisible="False"
                                               FontSize="12" Padding="8,4"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource DisabledText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Alias}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Content="Done"
                    Style="{StaticResource PrimaryButton}"
                    IsCancel="True"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    Width="80"
                    Click="Done_Click"/>

        </StackPanel>
    </Grid>
</Window>
