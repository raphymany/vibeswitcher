<Window x:Class="VibeSwitcher.Views.MiniModeSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        xmlns:controls="clr-namespace:VibeSwitcher.Controls"
        Title="VibeSwitcher"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="LayoutChoiceBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#14F5820A"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="20,14,20,20">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Accent}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IcoCompact}" Width="15" Height="15" Stretch="Uniform"
                          Fill="Transparent" Stroke="White" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Customize Mini Mode"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="Choose the layout and which profiles appear."
                               FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap" MaxWidth="280" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Layout choice -->
            <TextBlock Text="LAYOUT" FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="LayoutRows" Grid.Column="0" Style="{StaticResource LayoutChoiceBtn}" Click="LayoutRows_Click">
                    <StackPanel>
                        <Canvas Width="26" Height="20" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <Rectangle Canvas.Left="0" Canvas.Top="0"  Width="26" Height="5" RadiusX="2" RadiusY="2" Fill="{DynamicResource SecondaryText}"/>
                            <Rectangle Canvas.Left="0" Canvas.Top="7.5" Width="26" Height="5" RadiusX="2" RadiusY="2" Fill="{DynamicResource SecondaryText}"/>
                            <Rectangle Canvas.Left="0" Canvas.Top="15" Width="26" Height="5" RadiusX="2" RadiusY="2" Fill="{DynamicResource SecondaryText}"/>
                        </Canvas>
                        <TextBlock Text="Rows" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Names always visible" FontSize="10"
                                   Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="LayoutGrid" Grid.Column="2" Style="{StaticResource LayoutChoiceBtn}" Click="LayoutGrid_Click">
                    <StackPanel>
                        <Canvas Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <Rectangle Canvas.Left="0"  Canvas.Top="0"  Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{DynamicResource SecondaryText}"/>
                            <Rectangle Canvas.Left="11" Canvas.Top="0"  Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{DynamicResource SecondaryText}"/>
                            <Rectangle Canvas.Left="0"  Canvas.Top="11" Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{DynamicResource SecondaryText}"/>
                            <Rectangle Canvas.Left="11" Canvas.Top="11" Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{DynamicResource SecondaryText}"/>
                        </Canvas>
                        <TextBlock Text="Icon grid" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Fits many more profiles" FontSize="10"
                                   Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <!-- Profile selection -->
            <TextBlock Text="PROFILES" FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="Show all profiles" FontSize="12.5" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"/>
                <CheckBox x:Name="AllToggle" Style="{StaticResource ToggleSwitchStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Checked="AllToggle_Changed" Unchecked="AllToggle_Changed"/>
            </Grid>
            <Border x:Name="ChecklistHost" Background="{DynamicResource VSInsetBg}"
                    BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Padding="10,6">
                    <ItemsControl x:Name="ProfileChecklist">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,5"
                                          Style="{StaticResource ThemedCheckBox}"
                                          VerticalContentAlignment="Center"
                                          Checked="ProfileCheck_Changed" Unchecked="ProfileCheck_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="20" Height="20" Margin="6,0,8,0">
                                            <Image Source="{Binding Icon}" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                            <controls:AboutLogoIcon Width="18" Height="18">
                                                <controls:AboutLogoIcon.Style>
                                                    <Style TargetType="controls:AboutLogoIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:AboutLogoIcon.Style>
                                            </controls:AboutLogoIcon>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   Foreground="{DynamicResource PrimaryText}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <TextBlock Text="Nothing checked means every profile is shown."
                       FontSize="10" Foreground="{DynamicResource SecondaryText}" Margin="2,5,0,0"/>

            <!-- Footer -->
            <Grid Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource ActionButton}" IsCancel="True"
                        HorizontalAlignment="Left" MinWidth="90" Click="Cancel_Click"/>
                <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        HorizontalAlignment="Right" MinWidth="90" Click="Save_Click"/>
            </Grid>
        </StackPanel>
    
        <!-- Shared accent window frame (Views/AccentFrame.xaml). -->
        <views:AccentFrame Grid.RowSpan="99" Grid.ColumnSpan="99" Panel.ZIndex="9999"/>
    </Grid>
</Window>
