<Window x:Class="VibeSwitcher.Views.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="Delete Profile"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ControlTemplate x:Key="RoundedBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Template"       Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Height"         Value="32"/>
            <Setter Property="Padding"        Value="20,0"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Foreground"     Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background"     Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource HoverBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Template"       Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Height"         Value="32"/>
            <Setter Property="Padding"        Value="20,0"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="Background"     Value="{DynamicResource DangerBtnBg}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource DangerBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource DangerBtnHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBtnPressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="36" Height="36" Background="{DynamicResource ErrorBg}" CornerRadius="18"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="🗑" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Delete Profile"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="This action cannot be undone."
                               FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource PrimaryText}" LineHeight="18"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="CancelBtn"
                        Content="Cancel"
                        Style="{StaticResource ActionBtn}"
                        IsDefault="True"
                        IsCancel="True"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="Delete"
                        Style="{StaticResource DangerBtn}"
                        Click="Delete_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
