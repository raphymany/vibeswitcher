<Window x:Class="VibeSwitcher.Views.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Profile"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        ShowInTaskbar="False">

    <Window.Resources>
        <ControlTemplate x:Key="RoundedBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Template"       Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Height"         Value="32"/>
            <Setter Property="Padding"        Value="20,0"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Background"     Value="White"/>
            <Setter Property="BorderBrush"    Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#F0F6FF"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Template"       Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Height"         Value="32"/>
            <Setter Property="Padding"        Value="20,0"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="Background"     Value="#C00020"/>
            <Setter Property="BorderBrush"    Value="#A00018"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#A80018"/>
                    <Setter Property="BorderBrush" Value="#900015"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,24">

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="36" Height="36" Background="#FFF0F0" CornerRadius="18"
                    Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="🗑" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Delete Profile"
                           FontSize="15" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                <TextBlock Text="This action cannot be undone."
                           FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Message -->
        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="#444444" LineHeight="18"
                   Margin="0,0,0,20"/>

        <!-- Buttons — no IsDefault on Delete so Enter can't trigger it accidentally -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="CancelBtn"
                    Content="Cancel"
                    Style="{StaticResource ActionBtn}"
                    IsCancel="True"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Content="Delete"
                    Style="{StaticResource DangerBtn}"
                    Click="Delete_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
