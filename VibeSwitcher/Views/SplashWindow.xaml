<Window x:Class="VibeSwitcher.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeSwitcher"
        Width="360" Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>

        <Storyboard x:Key="PressStoryboard">

            <!-- 1. Fade whole panel in (0–300ms) -->
            <DoubleAnimation
                Storyboard.TargetName="RootPanel"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 2. V chevron press (starts at 420ms, 1600ms animation) -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="VTranslate"
                Storyboard.TargetProperty="Y"
                BeginTime="0:0:0.42">
                <LinearDoubleKeyFrame  Value="0"    KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame  Value="0"    KeyTime="0:0:0.416"/>
                <EasingDoubleKeyFrame  Value="-16"  KeyTime="0:0:0.624">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="11"   KeyTime="0:0:0.832">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="-5"   KeyTime="0:0:1.024">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="1.5"  KeyTime="0:0:1.216">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="-0.5" KeyTime="0:0:1.408"/>
                <EasingDoubleKeyFrame  Value="0"    KeyTime="0:0:1.6">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- 3. Bar 3 (center) press wave -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Bar3Scale"
                Storyboard.TargetProperty="ScaleY"
                BeginTime="0:0:0.42">
                <LinearDoubleKeyFrame  Value="1"    KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame  Value="1"    KeyTime="0:0:0.768"/>
                <EasingDoubleKeyFrame  Value="0.28" KeyTime="0:0:0.880">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="2.6"  KeyTime="0:0:1.040">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="0.62" KeyTime="0:0:1.184"/>
                <EasingDoubleKeyFrame  Value="1.6"  KeyTime="0:0:1.328"/>
                <EasingDoubleKeyFrame  Value="0.88" KeyTime="0:0:1.472"/>
                <EasingDoubleKeyFrame  Value="1"    KeyTime="0:0:1.6"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 4. Bars 2 & 4 (inner) press wave -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Bar2Scale"
                Storyboard.TargetProperty="ScaleY"
                BeginTime="0:0:0.42">
                <LinearDoubleKeyFrame  Value="1"    KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame  Value="1"    KeyTime="0:0:0.816"/>
                <EasingDoubleKeyFrame  Value="0.38" KeyTime="0:0:0.928">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="2.1"  KeyTime="0:0:1.088">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="0.7"  KeyTime="0:0:1.232"/>
                <EasingDoubleKeyFrame  Value="1.42" KeyTime="0:0:1.376"/>
                <EasingDoubleKeyFrame  Value="0.92" KeyTime="0:0:1.504"/>
                <EasingDoubleKeyFrame  Value="1"    KeyTime="0:0:1.6"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Bar4Scale"
                Storyboard.TargetProperty="ScaleY"
                BeginTime="0:0:0.42">
                <LinearDoubleKeyFrame  Value="1"    KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame  Value="1"    KeyTime="0:0:0.816"/>
                <EasingDoubleKeyFrame  Value="0.38" KeyTime="0:0:0.928">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="2.1"  KeyTime="0:0:1.088">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="0.7"  KeyTime="0:0:1.232"/>
                <EasingDoubleKeyFrame  Value="1.42" KeyTime="0:0:1.376"/>
                <EasingDoubleKeyFrame  Value="0.92" KeyTime="0:0:1.504"/>
                <EasingDoubleKeyFrame  Value="1"    KeyTime="0:0:1.6"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 5. Bars 1 & 5 (outer) press wave -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Bar1Scale"
                Storyboard.TargetProperty="ScaleY"
                BeginTime="0:0:0.42">
                <LinearDoubleKeyFrame  Value="1"    KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame  Value="1"    KeyTime="0:0:0.864"/>
                <EasingDoubleKeyFrame  Value="0.5"  KeyTime="0:0:0.976">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="1.7"  KeyTime="0:0:1.136">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="0.8"  KeyTime="0:0:1.280"/>
                <EasingDoubleKeyFrame  Value="1.25" KeyTime="0:0:1.424"/>
                <EasingDoubleKeyFrame  Value="0.96" KeyTime="0:0:1.536"/>
                <EasingDoubleKeyFrame  Value="1"    KeyTime="0:0:1.6"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Bar5Scale"
                Storyboard.TargetProperty="ScaleY"
                BeginTime="0:0:0.42">
                <LinearDoubleKeyFrame  Value="1"    KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame  Value="1"    KeyTime="0:0:0.864"/>
                <EasingDoubleKeyFrame  Value="0.5"  KeyTime="0:0:0.976">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="1.7"  KeyTime="0:0:1.136">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame  Value="0.8"  KeyTime="0:0:1.280"/>
                <EasingDoubleKeyFrame  Value="1.25" KeyTime="0:0:1.424"/>
                <EasingDoubleKeyFrame  Value="0.96" KeyTime="0:0:1.536"/>
                <EasingDoubleKeyFrame  Value="1"    KeyTime="0:0:1.6"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 6. Text fades in after V settles (1820–2070ms) -->
            <DoubleAnimation
                Storyboard.TargetName="TextGroup"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                BeginTime="0:0:1.82"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="TextTranslate"
                Storyboard.TargetProperty="Y"
                From="6" To="0"
                BeginTime="0:0:1.82"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 7. Fade out at 3400ms -->
            <DoubleAnimation
                Storyboard.TargetName="RootPanel"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0"
                BeginTime="0:0:3.4"
                Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

        </Storyboard>
    </Window.Resources>

    <!-- Drop shadow wrapper -->
    <Border Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>

        <Border Background="#0D0D12" CornerRadius="20">
            <StackPanel x:Name="RootPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Opacity="0"
                        Margin="0,32,0,32">

                <!-- VS Icon -->
                <Border HorizontalAlignment="Center" Margin="0,0,0,16"
                        Width="96" Height="96" CornerRadius="22"
                        Background="#13131E">
                    <Border.Effect>
                        <DropShadowEffect Color="#F5820A" BlurRadius="32"
                                          ShadowDepth="0" Opacity="0.08"/>
                    </Border.Effect>
                    <Border BorderBrush="#3D2908" BorderThickness="1" CornerRadius="22">

                        <Canvas Width="80" Height="80" Margin="8">

                            <!-- V chevron — animates independently -->
                            <Path x:Name="VChevron"
                                  Canvas.Left="0" Canvas.Top="0"
                                  Data="M 19,22 L 40,54 L 61,22"
                                  Stroke="#F5820A" StrokeThickness="4"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="VTranslate" Y="0"/>
                                </Path.RenderTransform>
                            </Path>

                            <!-- Bars clip border — ceiling at y=62 -->
                            <Border Canvas.Left="14" Canvas.Top="62"
                                    Width="54" Height="18"
                                    ClipToBounds="True"
                                    Background="Transparent">
                                <Canvas x:Name="BarsCanvas" Width="54" Height="18">

                                    <!-- Bar 1 — outer left -->
                                    <Rectangle x:Name="Bar1"
                                               Canvas.Left="8" Canvas.Top="9"
                                               Width="4.5" Height="5"
                                               RadiusX="2.25" RadiusY="2.25"
                                               Fill="#F5820A" Opacity="0.38"
                                               RenderTransformOrigin="0.5,1.0">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="Bar1Scale" ScaleY="1"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>

                                    <!-- Bar 2 — inner left -->
                                    <Rectangle x:Name="Bar2"
                                               Canvas.Left="15.5" Canvas.Top="7"
                                               Width="4.5" Height="7"
                                               RadiusX="2.25" RadiusY="2.25"
                                               Fill="#F5820A" Opacity="0.62"
                                               RenderTransformOrigin="0.5,1.0">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="Bar2Scale" ScaleY="1"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>

                                    <!-- Bar 3 — center -->
                                    <Rectangle x:Name="Bar3"
                                               Canvas.Left="23.75" Canvas.Top="6"
                                               Width="4.5" Height="8"
                                               RadiusX="2.25" RadiusY="2.25"
                                               Fill="#F5820A"
                                               RenderTransformOrigin="0.5,1.0">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="Bar3Scale" ScaleY="1"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>

                                    <!-- Bar 4 — inner right -->
                                    <Rectangle x:Name="Bar4"
                                               Canvas.Left="32" Canvas.Top="7"
                                               Width="4.5" Height="7"
                                               RadiusX="2.25" RadiusY="2.25"
                                               Fill="#F5820A" Opacity="0.62"
                                               RenderTransformOrigin="0.5,1.0">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="Bar4Scale" ScaleY="1"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>

                                    <!-- Bar 5 — outer right -->
                                    <Rectangle x:Name="Bar5"
                                               Canvas.Left="39.5" Canvas.Top="9"
                                               Width="4.5" Height="5"
                                               RadiusX="2.25" RadiusY="2.25"
                                               Fill="#F5820A" Opacity="0.38"
                                               RenderTransformOrigin="0.5,1.0">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="Bar5Scale" ScaleY="1"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>

                                </Canvas>
                            </Border>

                        </Canvas>
                    </Border>
                </Border>

                <!-- Text group (fades in after V settles) -->
                <StackPanel x:Name="TextGroup"
                            HorizontalAlignment="Center"
                            Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="TextTranslate" Y="6"/>
                    </StackPanel.RenderTransform>

                    <TextBlock Text="VibeSwitcher"
                               FontFamily="Segoe UI"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#E4E4EF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Manage your device profiles and hotkeys"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#38384E"
                               HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Border>

</Window>
