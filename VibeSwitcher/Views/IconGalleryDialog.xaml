<Window x:Class="VibeSwitcher.Views.IconGalleryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose an Icon"
        Width="484" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        ShowInTaskbar="False">

    <Window.Resources>

        <Style x:Key="GalleryItemButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F0F6FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E3F0FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#005FA3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="RoundedBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Template"        Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#F0F6FF"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Color-mode pill radio button -->
        <Style x:Key="ColorPill" TargetType="RadioButton">
            <Setter Property="Foreground"      Value="#333333"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg"
                                Background="White" BorderBrush="#DDDDDD"
                                BorderThickness="1" CornerRadius="14"
                                Padding="14,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="#F0F6FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground"                   Value="White"/>
                                <Setter TargetName="bg" Property="Background"  Value="#0078D4"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <StackPanel Margin="24,20,24,24">

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="36" Height="36" Background="#EEF4FF" CornerRadius="18"
                    Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="🖼️" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Choose an Icon"
                           FontSize="15" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                <TextBlock Text="Select a built-in icon or browse for a custom .ico file"
                           FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Icon color toggle -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
            <TextBlock Text="Icon color:" FontSize="12" Foreground="#666666"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton x:Name="ColorBlack" Content="Black" GroupName="IconColor" IsChecked="True" Style="{StaticResource ColorPill}"/>
            <RadioButton x:Name="ColorWhite" Content="White" GroupName="IconColor" Margin="0" Style="{StaticResource ColorPill}"/>
        </StackPanel>

        <!-- Gallery grid — background darkens when White is selected to preview on dark taskbar -->
        <Border CornerRadius="8" Padding="4" Margin="0,0,0,4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=ColorWhite}" Value="True">
                            <Setter Property="Background" Value="#252525"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding}"
                                Style="{StaticResource GalleryItemButton}"
                                Click="GalleryItem_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Emoji}"
                                           FontSize="34"
                                           FontFamily="Segoe UI Emoji"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Label}"
                                           FontSize="11"
                                           Foreground="#555555"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Hint shown when White mode is active -->
        <TextBlock Text="Gallery shows original colors — saved icon will be white (best for dark taskbars)"
                   FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=ColorWhite}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Separator Margin="0,16"/>

        <!-- Footer buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Browse from disk..."
                    Style="{StaticResource ActionBtn}"
                    Margin="0,0,8,0"
                    Click="BrowseFromDisk_Click"/>
            <Button Content="Cancel"
                    Style="{StaticResource ActionBtn}"
                    IsCancel="True"
                    Click="Cancel_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
