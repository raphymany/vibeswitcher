<Window x:Class="VibeSwitcher.Views.IconGalleryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="484" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="GalleryItemButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource GalleryItemBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GalleryItemBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectedBg}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorPill" TargetType="RadioButton">
            <Setter Property="Foreground"      Value="{DynamicResource ColorPillText}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg"
                                Background="{DynamicResource ColorPillBg}" BorderBrush="{DynamicResource ColorPillBorder}"
                                BorderThickness="1" CornerRadius="14"
                                Padding="14,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground"                   Value="White"/>
                                <Setter TargetName="bg" Property="Background"  Value="{DynamicResource Accent}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="36" Height="36" Background="{DynamicResource InfoBadgeBg}" CornerRadius="18"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="🖼️" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Choose an Icon"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="Select a built-in icon or browse for a custom .ico file"
                               FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                <TextBlock Text="Icon color:" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <RadioButton x:Name="ColorBlack" Content="Black" GroupName="IconColor" IsChecked="True" Style="{StaticResource ColorPill}"/>
                <RadioButton x:Name="ColorWhite" Content="White" GroupName="IconColor" Margin="0" Style="{StaticResource ColorPill}"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding}"
                                Style="{StaticResource GalleryItemButton}"
                                Click="GalleryItem_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Emoji}"
                                           FontSize="34"
                                           FontFamily="Segoe UI Emoji"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Label}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryText}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Black works best on light taskbars · White works best on dark taskbars"
                       FontSize="11" Foreground="{DynamicResource DisabledText}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,10,0,0"/>

            <Separator Margin="0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Browse from disk..."
                        Style="{StaticResource ActionButton}"
                        Margin="0,0,8,0"
                        Click="BrowseFromDisk_Click"/>
                <Button Content="Cancel"
                        Style="{StaticResource ActionButton}"
                        IsCancel="True"
                        Click="Cancel_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
