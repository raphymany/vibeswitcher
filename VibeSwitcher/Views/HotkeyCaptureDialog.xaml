<Window x:Class="VibeSwitcher.Views.HotkeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Hotkey"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F3F3F3"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">

    <Window.Resources>
        <ControlTemplate x:Key="RoundedBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Template"       Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Height"         Value="32"/>
            <Setter Property="Width"          Value="80"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Background"     Value="White"/>
            <Setter Property="BorderBrush"    Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#F0F6FF"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DDEEFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background"  Value="#0078D4"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#0060AA"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#0060AA"/>
                    <Setter Property="BorderBrush" Value="#004E8C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#004E8C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,24">

        <!-- Header -->
        <TextBlock Text="Set Hotkey"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="#1A1A1A" Margin="0,0,0,4"/>
        <TextBlock Text="Press any key combination to assign it to this profile."
                   FontSize="12" Foreground="#777777" TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <!-- Key preview -->
        <Border Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14"
                Margin="0,0,0,20">
            <TextBlock x:Name="HotkeyPreviewText"
                       Text="(none)"
                       FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="#0078D4"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Cancel" Style="{StaticResource DialogButton}"
                    IsCancel="True" Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button Content="Clear" Style="{StaticResource DialogButton}"
                    Margin="0,0,8,0"
                    Click="ClearButton_Click"/>
            <Button Content="OK" Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Click="OkButton_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
