<Window x:Class="VibeSwitcher.Views.HotkeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ControlTemplate x:Key="RoundedBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Template"       Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Height"         Value="32"/>
            <Setter Property="Width"          Value="80"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Foreground"     Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background"     Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource HoverBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PressedBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background"  Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource AccentHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <TextBlock Text="Set Hotkey"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,4"/>
            <TextBlock Text="Press any key combination to assign it to this profile."
                       FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <Border Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource InputBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,20">
                <TextBlock x:Name="HotkeyPreviewText"
                           Text="(none)"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Accent}"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Cancel" Style="{StaticResource DialogButton}"
                        IsCancel="True" Margin="0,0,8,0"
                        Click="CancelButton_Click"/>
                <Button Content="Clear" Style="{StaticResource DialogButton}"
                        Margin="0,0,8,0"
                        Click="ClearButton_Click"/>
                <Button Content="OK" Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="OkButton_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
