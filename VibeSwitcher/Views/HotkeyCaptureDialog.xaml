<Window x:Class="VibeSwitcher.Views.HotkeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <!-- Header -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="HotkeyAppIcon" Grid.Column="0"
                       Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Set Hotkey"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock x:Name="HotkeySubtitleText"
                               Text="Press any key combination to assign it to this profile"
                               FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource InputBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,20">
                <TextBlock x:Name="HotkeyPreviewText"
                           Text="(none)"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Accent}"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Cancel" Style="{StaticResource ActionButton}"
                        IsCancel="True" Margin="0,0,8,0"
                        Click="CancelButton_Click"/>
                <Button Content="Clear" Style="{StaticResource ActionButton}"
                        Margin="0,0,8,0"
                        Click="ClearButton_Click"/>
                <Button Content="OK" Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="OkButton_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
