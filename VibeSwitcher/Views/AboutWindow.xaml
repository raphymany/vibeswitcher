<Window x:Class="VibeSwitcher.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About VibeSwitcher"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Template"   Value="{StaticResource RoundedButtonTemplate}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Padding"    Value="14,0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#F0F6FF"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DDEEFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Template"   Value="{StaticResource RoundedButtonTemplate}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Padding"    Value="20,0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush"     Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#006CBF"/>
                    <Setter Property="BorderBrush" Value="#006CBF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#005AA3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

    </Window.Resources>

    <StackPanel Margin="24,20">

        <!-- App identity -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Image x:Name="AppIconImage" Width="48" Height="48"
                   VerticalAlignment="Top" Margin="0,2,16,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="VibeSwitcher"
                           FontSize="22" FontWeight="Bold" Foreground="#1A1A1A"/>
                <TextBlock x:Name="VersionText"
                           FontSize="12" Foreground="#777777" Margin="0,2,0,0"/>
                <TextBlock Text="Seamless audio device switching for Windows"
                           FontSize="11" Foreground="#999999" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Website -->
        <Border Background="White" BorderBrush="#E8E8E8" BorderThickness="1"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="WEBSITE" Style="{StaticResource SectionLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🌐" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontSize="12" VerticalAlignment="Center">
                        <Hyperlink NavigateUri="https://vibeswitcher.app"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            vibeswitcher.app
                        </Hyperlink>
                        <Run Text=" — coming soon" Foreground="#AAAAAA"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Development -->
        <Border Background="White" BorderBrush="#E8E8E8" BorderThickness="1"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="DEVELOPMENT" Style="{StaticResource SectionLabel}"/>
                <StackPanel>
                    <TextBlock Text="Designed &amp; built by" FontSize="11" Foreground="#888888"/>
                    <TextBlock Text="Raphael Mansour" FontSize="13" FontWeight="SemiBold"
                               Foreground="#1A1A1A" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Support -->
        <Border Background="White" BorderBrush="#E8E8E8" BorderThickness="1"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SUPPORT" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Found a bug or have a suggestion?" FontSize="12"
                           Foreground="#555555" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="View Issues"
                            Style="{StaticResource ActionButton}"
                            Click="ViewIssues_Click" Margin="0,0,8,0"/>
                    <Button Content="Submit an Issue"
                            Style="{StaticResource ActionButton}"
                            Click="SubmitIssue_Click"/>
                </StackPanel>
                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#555555">
                    GitHub:
                    <Hyperlink NavigateUri="https://github.com/raphymany/vibeswitcher"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        github.com/raphymany/vibeswitcher
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Copyright + actions -->
        <StackPanel Margin="0,6,0,0" HorizontalAlignment="Center">
            <TextBlock Text="© 2026 Raphael Mansour. All rights reserved."
                       FontSize="11" Foreground="#AAAAAA"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Copy Diagnostic Info"
                        Style="{StaticResource ActionButton}"
                        Margin="0,0,8,0"
                        Click="CopyDiagnostics_Click"/>
                <Button Content="Close"
                        Style="{StaticResource PrimaryButton}"
                        IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>

    </StackPanel>
</Window>
