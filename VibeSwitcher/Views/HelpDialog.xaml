<Window x:Class="VibeSwitcher.Views.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Getting Started"
        Width="420" Height="600"
        MinHeight="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SectionBody" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Foreground"    Value="#444444"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
            <Setter Property="LineHeight"    Value="18"/>
            <Setter Property="Margin"        Value="0,0,0,14"/>
        </Style>
        <Style x:Key="BulletItem" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="#444444"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight"   Value="18"/>
            <Setter Property="Margin"       Value="0,0,0,4"/>
        </Style>
        <ControlTemplate x:Key="RoundedBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
        <Style x:Key="OkBtn" TargetType="Button">
            <Setter Property="Template"        Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="28,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#0078D4"/>
            <Setter Property="BorderBrush"     Value="#0060AA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#0060AA"/>
                    <Setter Property="BorderBrush" Value="#004E8C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#004E8C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,20,24,4">
            <StackPanel>

                <!-- Heading -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Width="36" Height="36" Background="#E8F4FF" CornerRadius="18"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="?" FontSize="18" FontWeight="Bold"
                                   Foreground="#0078D4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Getting Started" FontSize="16" FontWeight="Bold" Foreground="#1A1A1A"/>
                        <TextBlock Text="VibeSwitcher quick-start guide" FontSize="11" Foreground="#777777" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Section 1 -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="What is VibeSwitcher?"/>
                <TextBlock Style="{StaticResource SectionBody}">
                    VibeSwitcher lives in the system tray and lets you switch your default Windows
                    audio devices instantly. Each <Run FontWeight="SemiBold">profile</Run> stores
                    a playback device (speakers or headphones) and a recording device (microphone),
                    so you can swap setups with a single click or hotkey.
                </TextBlock>

                <!-- Section 2 -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Setting up profiles"/>
                <TextBlock Style="{StaticResource SectionBody}">
                    Click <Run FontWeight="SemiBold">Add New Profile</Run> at the bottom of the
                    profile list. Choose a mode — Playback Only, Recording Only, or Both — then
                    select your devices from the dropdowns. Give the profile a name and optionally
                    assign a global hotkey and an icon.
                </TextBlock>

                <!-- Section 3 -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Switching profiles"/>
                <TextBlock Style="{StaticResource BulletItem}" Text="• Left-click the tray icon to cycle to the next profile in order"/>
                <TextBlock Style="{StaticResource BulletItem}" Text="• Right-click the tray icon to pick a specific profile from the menu"/>
                <TextBlock Style="{StaticResource BulletItem}" Margin="0,0,0,14">
                    • Press a profile's <Run FontWeight="SemiBold">global hotkey</Run> from anywhere — even when VibeSwitcher is minimized
                </TextBlock>

                <!-- Section 4 -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Tray icon tips"/>
                <TextBlock Style="{StaticResource BulletItem}" Text="• The tray icon reflects the active profile's icon"/>
                <TextBlock Style="{StaticResource BulletItem}" Text="• Hover over the tray icon to see all profiles and their hotkeys"/>
                <TextBlock Style="{StaticResource BulletItem}" Margin="0,0,0,14">
                    • Right-click the tray → click the VibeSwitcher header to re-open Settings
                </TextBlock>

                <!-- Section 5 -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Settings explained"/>
                <TextBlock Style="{StaticResource SectionBody}">
                    Every toggle in Settings has a small <Run FontWeight="SemiBold">ⓘ</Run> badge next to it.
                    Hover over it to see a plain-English description of exactly what that option does.
                    You can also hover over device names in profile dropdowns to see the full Windows device identifier.
                </TextBlock>

                <!-- Section 6 -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Backup &amp; Restore"/>
                <TextBlock Style="{StaticResource BulletItem}">
                    • <Run FontWeight="SemiBold">Export</Run> saves your profiles and settings to a
                    <Run FontFamily="Consolas" FontSize="11">.json</Run> file — great before
                    reinstalling Windows or switching computers
                </TextBlock>
                <TextBlock Style="{StaticResource BulletItem}" Margin="0,0,0,14">
                    • <Run FontWeight="SemiBold">Import</Run> restores from that file, replacing the
                    current configuration after a confirmation prompt
                </TextBlock>

                <!-- Section 7 -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Where data is stored"/>
                <TextBlock Style="{StaticResource SectionBody}">
                    Profiles and settings are saved automatically to:&#x0A;<Run FontFamily="Consolas" FontSize="11">%APPDATA%\VibeSwitcher\config.json</Run>&#x0A;&#x0A;A
                    backup copy is written alongside it on every save, so accidental changes can always
                    be recovered from the Backup &amp; Restore section in Settings.
                </TextBlock>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="#EBEBEB" BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0" Padding="24,14">
            <Button Content="Got it"
                    Style="{StaticResource OkBtn}"
                    IsDefault="True" IsCancel="True"
                    HorizontalAlignment="Center"
                    Click="GotIt_Click"/>
        </Border>
    </Grid>
</Window>
