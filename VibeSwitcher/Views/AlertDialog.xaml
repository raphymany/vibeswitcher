<Window x:Class="VibeSwitcher.Views.AlertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        ShowInTaskbar="False">

    <Window.Resources>
        <ControlTemplate x:Key="RoundedBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="OkBtn" TargetType="Button">
            <Setter Property="Template"        Value="{StaticResource RoundedBtn}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="28,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#0078D4"/>
            <Setter Property="BorderBrush"     Value="#0060AA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#0060AA"/>
                    <Setter Property="BorderBrush" Value="#004E8C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#004E8C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,24">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border x:Name="IconBorder" Width="36" Height="36" CornerRadius="18"
                    Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="IconText" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                       Foreground="#1A1A1A" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="#444444" LineHeight="18"
                   Margin="0,0,0,20"/>

        <Button Content="OK" Style="{StaticResource OkBtn}"
                IsDefault="True" IsCancel="True" HorizontalAlignment="Center"
                Click="OK_Click"/>

    </StackPanel>
</Window>
