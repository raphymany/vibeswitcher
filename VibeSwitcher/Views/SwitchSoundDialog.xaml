<Window x:Class="VibeSwitcher.Views.SwitchSoundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Tone chip toggle -->
        <Style x:Key="ToneChip" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Padding"    Value="10,0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="15" BorderThickness="1"
                                BorderBrush="{DynamicResource InputBorder}"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"  Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background"  Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background"  Value="{DynamicResource AccentHover}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="28,18,28,24">

            <!-- Header -->
            <TextBlock Text="Switch Sound"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Play a sound when this profile is activated."
                       FontSize="12" Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- Tone chips -->
            <TextBlock Text="Tone" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,16">
                <ToggleButton x:Name="ToneClick"  Content="Click"   Style="{StaticResource ToneChip}" Margin="0,0,6,6" Click="ToneChip_Click" Tag="Click"/>
                <ToggleButton x:Name="ToneChime"  Content="Chime"   Style="{StaticResource ToneChip}" Margin="0,0,6,6" Click="ToneChip_Click" Tag="Chime"/>
                <ToggleButton x:Name="ToneBlip"   Content="Blip"    Style="{StaticResource ToneChip}" Margin="0,0,6,6" Click="ToneChip_Click" Tag="Blip"/>
                <ToggleButton x:Name="ToneBell"   Content="Bell"    Style="{StaticResource ToneChip}" Margin="0,0,6,6" Click="ToneChip_Click" Tag="Bell"/>
                <ToggleButton x:Name="ToneAlert"  Content="Alert"   Style="{StaticResource ToneChip}" Margin="0,0,6,6" Click="ToneChip_Click" Tag="Alert"/>
                <ToggleButton x:Name="ToneSoft"   Content="Soft"    Style="{StaticResource ToneChip}" Margin="0,0,6,6" Click="ToneChip_Click" Tag="Soft"/>
                <ToggleButton x:Name="TonePing"   Content="Ping"    Style="{StaticResource ToneChip}" Margin="0,0,6,6" Click="ToneChip_Click" Tag="Ping"/>
                <ToggleButton x:Name="ToneCustom" Content="Custom…" Style="{StaticResource ToneChip}" Margin="0,0,0,6"  Click="ToneChip_Click" Tag="Custom"/>
            </WrapPanel>

            <!-- Custom file path — visible when Custom is selected -->
            <StackPanel x:Name="CustomPathPanel" Visibility="Collapsed" Margin="0,0,0,16">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CustomPathBox" Grid.Column="0"
                             Padding="8,5" Margin="0,0,6,0"
                             TextChanged="CustomPath_Changed"/>
                    <Button Grid.Column="1" Content="Browse…"
                            Style="{StaticResource ActionButton}"
                            Click="Browse_Click"/>
                </Grid>
                <TextBlock Text="Only 16-bit PCM .wav files are supported. MP3 and other formats are not compatible."
                           FontSize="11" Foreground="{DynamicResource SecondaryText}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Volume -->
            <TextBlock Text="Volume" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SectionLabelText}" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="VolumeSliderControl" Grid.Column="0"
                        Style="{StaticResource VolumeSlider}"
                        Minimum="0" Maximum="100"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"
                        ValueChanged="Volume_Changed"/>
                <TextBlock x:Name="VolumeLabel" Grid.Column="1"
                           FontSize="11" Foreground="{DynamicResource SecondaryText}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Show notification banner toggle -->
            <Border Background="{DynamicResource InnerCardBg}"
                    BorderBrush="{DynamicResource InnerCardBorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="16,12" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Show notification banner"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="Display a tray banner when this profile activates (no Windows ding)."
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="BannerToggle" Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              Checked="BannerToggle_Changed" Unchecked="BannerToggle_Changed"/>
                </Grid>
            </Border>

            <!-- Footer buttons -->
            <DockPanel Margin="0,16,0,0">
                <Button Content="Cancel" DockPanel.Dock="Left"
                        Style="{StaticResource ActionButton}"
                        Padding="16,0"
                        Click="Cancel_Click"/>
                <Button Content="Save" DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,0"
                        HorizontalAlignment="Right"
                        Click="Save_Click"/>
                <Button Content="Test Sound"
                        Style="{StaticResource ActionButton}"
                        HorizontalAlignment="Center"
                        Padding="14,0"
                        Click="TestSound_Click"/>
            </DockPanel>

        </StackPanel>
    </Grid>
</Window>
