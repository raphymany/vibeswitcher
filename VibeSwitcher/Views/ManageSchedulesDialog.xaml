<Window x:Class="VibeSwitcher.Views.ManageSchedulesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="{DynamicResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="16" Height="16">
                            <Path Data="M12.5,9 A4.5,4.5 0 1 1 3.5,9 A4.5,4.5 0 1 1 12.5,9 M8,6 V9 L10.2,10.2 M4,5 A2.2,2.2 0 0 1 6.4,2.8 M12,5 A2.2,2.2 0 0 1 9.6,2.8 M5,13.2 L3.8,14.7 M11,13.2 L12.2,14.7"
                                  Fill="Transparent" Stroke="Black"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Manage Schedules"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="{Binding Name}"
                               FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Every schedule on this profile. Edit one to change its time, days, or reminder — or remove the ones you no longer need."
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource SecondaryText}" LineHeight="18"
                       Margin="0,0,0,12"/>

            <!-- Schedule rows -->
            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="0,4" Margin="0,0,0,18">
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Schedules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Summary}"
                                               FontSize="12" Foreground="{DynamicResource PrimaryText}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Content="Edit" Style="{StaticResource ActionButton}"
                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditScheduleEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="2" Content="Remove" Style="{StaticResource DeleteButton}"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.DeleteScheduleEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Button Content="Done" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" IsCancel="True" HorizontalAlignment="Center"
                    Click="Done_Click"/>

        </StackPanel>

        <!-- Accent window frame: a rounded overlay (not a Window border) so it follows
             Windows 11's rounded window corners instead of being clipped at them. -->
        <Border Grid.RowSpan="99" Grid.ColumnSpan="99" CornerRadius="8"
                BorderBrush="#66F5820A" BorderThickness="1"
                IsHitTestVisible="False" Panel.ZIndex="9999"/>
    </Grid>
</Window>
