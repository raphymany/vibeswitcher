<Window x:Class="VibeSwitcher.Views.ScheduleConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ConflictBtn" TargetType="Button">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="#FFF3CD" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="⚠" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Schedule Conflict" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="This time slot is already used by another profile:"
                       FontSize="12" Foreground="{DynamicResource PrimaryText}"
                       Margin="0,0,0,10" TextWrapping="Wrap"/>

            <!-- Conflict list -->
            <ItemsControl x:Name="ConflictList" Margin="0,0,0,14">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource InnerCardBg}"
                                BorderBrush="{DynamicResource InnerCardBorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="12,8" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="{Binding ProfileName, StringFormat='&quot;{0}&quot;'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock Text="{Binding ConflictDesc}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="18">
                Two schedules cannot share the same time slot. Please choose a
                different time for this schedule.
            </TextBlock>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ChangeTimeBtn"
                        Content="Change Time"
                        Style="{StaticResource ConflictBtn}"
                        Background="{DynamicResource Accent}"
                        BorderBrush="{DynamicResource AccentHover}"
                        Foreground="White"
                        IsDefault="True"
                        IsCancel="True"
                        Click="ChangeTime_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
