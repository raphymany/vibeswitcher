<Window x:Class="VibeSwitcher.Views.CloneProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VibeSwitcher.Views"
        Title="VibeSwitcher"
        Width="470" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="28,18,28,24">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="{DynamicResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Canvas.Left="5" Canvas.Top="0" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                   Fill="Transparent" Stroke="White" StrokeThickness="1.5"/>
                        <Rectangle Canvas.Left="0" Canvas.Top="5" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource Accent}" Stroke="White" StrokeThickness="1.5"/>
                    </Canvas>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Clone Profile"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock x:Name="HeaderSubtitle"
                               FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap" MaxWidth="360" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Step progress dots -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Ellipse x:Name="Dot0" Width="9" Height="9" Margin="5,0"/>
                <Ellipse x:Name="Dot1" Width="9" Height="9" Margin="5,0"/>
                <Ellipse x:Name="Dot2" Width="9" Height="9" Margin="5,0"/>
                <Ellipse x:Name="Dot3" Width="9" Height="9" Margin="5,0"/>
            </StackPanel>

            <!-- Step title and subtitle -->
            <TextBlock x:Name="StepTitle"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="StepSubtitle"
                       FontSize="12" Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap" LineHeight="18"
                       Margin="0,0,0,20"/>

            <!-- ── Step 0: Name & hotkey ─────────────────────── -->
            <StackPanel x:Name="Step0Panel" MinHeight="120">
                <TextBlock Text="Profile name" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/>
                <TextBox x:Name="NameBox" FontSize="13" Padding="8,7"
                         Foreground="{DynamicResource PrimaryText}"
                         Background="{DynamicResource InputBg}"
                         BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"/>

                <TextBlock Text="Hotkey" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryText}" Margin="0,16,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource HotkeyBg}"
                            BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                            CornerRadius="6" Padding="10,6" MinWidth="150" VerticalAlignment="Center">
                        <TextBlock x:Name="HotkeyLabel" Text="None" FontSize="13"
                                   Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="SetHotkeyBtn" Content="Set hotkey…" Style="{StaticResource ActionButton}"
                            Padding="14,0" Height="34" Margin="8,0,0,0" Click="SetHotkey_Click"/>
                    <Button x:Name="ClearHotkeyBtn" Content="Clear" Style="{StaticResource ActionButton}"
                            Padding="12,0" Height="34" Margin="6,0,0,0" Click="ClearHotkey_Click"/>
                </StackPanel>
                <TextBlock Text="Two profiles can't share a hotkey — the clone starts with none."
                           FontSize="10.5" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- ── Step 1: Devices & mode ────────────────────── -->
            <StackPanel x:Name="Step1Panel" Visibility="Collapsed" MinHeight="120">
                <TextBlock Text="Mode" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="ModePlayback" GroupName="CloneMode" Content="Playback"
                                 Foreground="{DynamicResource PrimaryText}" Margin="0,0,16,0"
                                 VerticalContentAlignment="Center" Checked="Mode_Changed"/>
                    <RadioButton x:Name="ModeRecording" GroupName="CloneMode" Content="Recording"
                                 Foreground="{DynamicResource PrimaryText}" Margin="0,0,16,0"
                                 VerticalContentAlignment="Center" Checked="Mode_Changed"/>
                    <RadioButton x:Name="ModeBoth" GroupName="CloneMode" Content="Both"
                                 Foreground="{DynamicResource PrimaryText}"
                                 VerticalContentAlignment="Center" Checked="Mode_Changed"/>
                </StackPanel>

                <TextBlock x:Name="PlaybackLabel" Text="Playback device" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/>
                <ComboBox x:Name="PlaybackCombo" FontSize="12" Margin="0,0,0,12"/>

                <TextBlock x:Name="RecordingLabel" Text="Recording device" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/>
                <ComboBox x:Name="RecordingCombo" FontSize="12"/>
            </StackPanel>

            <!-- ── Step 2: What to copy ──────────────────────── -->
            <StackPanel x:Name="Step2Panel" Visibility="Collapsed" MinHeight="120">
                <StackPanel x:Name="CopyOptionsPanel">
                    <CheckBox x:Name="chkSound"       Content="Switch sound"                  Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10" Checked="Sound_Toggled" Unchecked="Sound_Toggled"/>
                    <CheckBox x:Name="chkAppTriggers" Content="App launch triggers"           Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkAutoSwitch"  Content="Auto-switch on device connect" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkFavorite"    Content="Favorite (pinned)"             Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkSilent"      Content="Silent — no notification banner" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkIcon"        Content="Custom icon"                   Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkNotes"       Content="Notes"                         Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
                </StackPanel>
                <TextBlock x:Name="NoCopyOptionsHint"
                           Text="This profile has no extra features to copy."
                           FontSize="12" Foreground="{DynamicResource SecondaryText}"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- ── Step 3: Schedules ─────────────────────────── -->
            <StackPanel x:Name="Step3Panel" Visibility="Collapsed" MinHeight="120">
                <StackPanel x:Name="SchedulesPanel"/>
                <TextBlock Text="Copied schedules keep the same time, so they'll overlap the original — adjust them afterward if needed."
                           FontSize="10.5" Foreground="{DynamicResource SecondaryText}"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- ── Footer ────────────────────────────────────── -->
            <DockPanel Margin="0,24,0,0">
                <Button Content="Cancel" DockPanel.Dock="Left"
                        Style="{StaticResource ActionButton}" Padding="16,0"
                        Click="Cancel_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <Button x:Name="BackBtn" Content="← Back"
                            Style="{StaticResource ActionButton}"
                            Padding="14,0" Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="Back_Click"/>
                    <Button x:Name="NextBtn" Content="Next →"
                            Style="{StaticResource PrimaryButton}"
                            Padding="18,0"
                            Click="Next_Click"/>
                </StackPanel>
            </DockPanel>

        </StackPanel>

        <!-- Shared accent window frame (Views/AccentFrame.xaml). -->
        <views:AccentFrame Grid.RowSpan="99" Grid.ColumnSpan="99" Panel.ZIndex="9999"/>
    </Grid>
</Window>
