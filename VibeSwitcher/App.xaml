<Application x:Class="VibeSwitcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- All windows default to Segoe UI -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- ── Shared rounded button template ── -->
        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Template"   Value="{StaticResource RoundedButtonTemplate}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Padding"    Value="12,0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#F0F6FF"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DDEEFF"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Template"   Value="{StaticResource RoundedButtonTemplate}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Padding"    Value="12,0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#C00000"/>
            <Setter Property="Background" Value="#FFF0F0"/>
            <Setter Property="BorderBrush"     Value="#FFBBBB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#FFE0E0"/>
                    <Setter Property="BorderBrush" Value="#C00000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFCCCC"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#C00000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Template"   Value="{StaticResource RoundedButtonTemplate}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Padding"    Value="20,0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush"     Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#006CBF"/>
                    <Setter Property="BorderBrush" Value="#006CBF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#005AA3"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="Background"  Value="#006CBF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle switch style for CheckBox — pill track + animated sliding thumb -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="FocusRing"
                                    CornerRadius="11"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <Border x:Name="Track"
                                        Width="34" Height="18"
                                        CornerRadius="9">
                                    <!-- Named brush so ColorAnimation can target it -->
                                    <Border.Background>
                                        <SolidColorBrush x:Name="TrackBrush" Color="#CCCCCC"/>
                                    </Border.Background>
                                    <!-- HorizontalAlignment stays Left always; Margin drives position -->
                                    <Border x:Name="Thumb"
                                            Width="12" Height="12"
                                            CornerRadius="6"
                                            Background="White"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="3,0,0,0"/>
                                </Border>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Slide thumb right: track(34) - thumb(12) - right-pad(3) = 19 -->
                                            <ThicknessAnimation
                                                Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="Margin"
                                                To="19,0,0,0"
                                                Duration="0:0:0.18">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                            <ColorAnimation
                                                Storyboard.TargetName="TrackBrush"
                                                Storyboard.TargetProperty="Color"
                                                To="#0078D4"
                                                Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation
                                                Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="Margin"
                                                To="3,0,0,0"
                                                Duration="0:0:0.18">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                            <ColorAnimation
                                                Storyboard.TargetName="TrackBrush"
                                                Storyboard.TargetProperty="Color"
                                                To="#CCCCCC"
                                                Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded popup with drop shadow -->
        <Style TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <!-- Outer transparent padding gives the shadow room to render -->
                        <Border Padding="10" Background="Transparent">
                            <Border Background="White"
                                    CornerRadius="10"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="0"
                                                     Opacity="0.20" Color="#000000"/>
                                </Border.Effect>
                                <ItemsPresenter Margin="0,5"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu item: hover highlight + blue left bar when active -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8,16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Rectangle x:Name="ActiveBar"
                                       Width="3" RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Left"
                                       Fill="#0078D4"
                                       Visibility="Collapsed"/>
                            <Border x:Name="Bg"
                                    Margin="5,1"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F0F6FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#E3F0FF"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin subtle separator -->
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#EFEFEF" Margin="10,5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
