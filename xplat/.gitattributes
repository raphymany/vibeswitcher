# The repo root forces CRLF for Windows; files under xplat/ that run on macOS/Linux need LF.
*.sh       text eol=lf
*.desktop  text eol=lf
*.rules    text eol=lf
*.plist    text eol=lf
AppRun     text eol=lf
forks.txt  text eol=lf
# Recorded tool output used as test fixtures: byte-for-byte what Linux prints.
tests/**/Fixtures/** text eol=lf
postinst   text eol=lf
postrm     text eol=lf
