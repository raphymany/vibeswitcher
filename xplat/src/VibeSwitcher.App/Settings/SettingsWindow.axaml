<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VibeSwitcher.ViewModels"
        xmlns:svc="using:VibeSwitcher.Services"
        xmlns:c="using:VibeSwitcher.App.Controls"
        xmlns:img="using:VibeSwitcher.App.Imaging"
        xmlns:s="using:VibeSwitcher.App.Settings"
        x:Class="VibeSwitcher.App.Settings.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="VibeSwitcher"
        Width="920" Height="720" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}">
    <!-- Port of Views/SettingsWindow.xaml: the window frame, the top bar, the filter bar, the
         Profiles page, the Settings / About / FAQ pages and the profile popup. Texts that name
         Windows things come from Wording (each system's words). Mini Mode reuses the window: the
         MiniPanel list, a smaller title bar and no top bar. -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://VibeSwitcher/Settings/SettingsStyles.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <!-- Path icons drawn in their button's text colour. -->
        <Style Selector="Button Path.fg, Button Rectangle.fg">
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="ToggleButton Path.fg">
            <Setter Property="Stroke" Value="{Binding $parent[ToggleButton].Foreground}" />
        </Style>
        <Style Selector="Button Path.fill">
            <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="ToggleButton Path.fill">
            <Setter Property="Fill" Value="{Binding $parent[ToggleButton].Foreground}" />
        </Style>
        <Style Selector="Path.fg">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <!-- Filter chip icon (stroke follows the chip's text colour). -->
        <Style Selector="Path.chipIcon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{Binding $parent[ToggleButton].Foreground}" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector="Path.chipIcon.solid">
            <Setter Property="Fill" Value="{Binding $parent[ToggleButton].Foreground}" />
            <Setter Property="Stroke" Value="{x:Null}" />
        </Style>

        <!-- ── Profile card ── -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        </Style>
        <Style Selector="Border.card.active">
            <Setter Property="BorderBrush" Value="#4DF5820A" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Color="{DynamicResource VSActiveGradTop}" Offset="0" />
                    <GradientStop Color="{DynamicResource VSActiveGradBot}" Offset="0.4" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource InnerCardBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource InnerCardBg}" />
        </Style>
        <Style Selector="Border.iconArea">
            <Setter Property="Background" Value="{DynamicResource VSSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VSBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.iconArea.active">
            <Setter Property="BorderBrush" Value="#47F5820A" />
            <Setter Property="BoxShadow" Value="0 0 18 0 #1AF5820A" />
        </Style>
        <!-- Card chips: the same pill everywhere (orange for mode/schedule/sound, neutral for devices
             and the hotkey). -->
        <Style Selector="Border.neutralChip">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource HotkeyBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="Border.hairline">
            <Setter Property="Height" Value="1" />
            <Setter Property="Width" Value="220" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Background" Value="{DynamicResource VSHairline}" />
        </Style>
        <!-- A card button that's off for this profile (auto-switch on a recording-only profile; silent
             while the profile has its own sound). -->
        <Style Selector="ToggleButton.dim28">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Opacity" Value="0.28" />
        </Style>
        <Style Selector="ToggleButton.dim35">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- The popup's name field: plain text on the popup, no box (WPF: transparent, no border). -->
        <Style Selector="TextBox.bare">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SectionLabelText}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Fill" Value="{DynamicResource SuccessDot}" />
        </Style>
        <Style Selector="Ellipse.dot.disconnected">
            <Setter Property="Fill" Value="{DynamicResource ErrorDot}" />
        </Style>

        <!-- ── Settings page (the Windows XAML repeats these values on every row) ── -->
        <Style Selector="Button Ellipse.fg">
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="Button Ellipse.fill">
            <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VSBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.rowLine">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource VSSurface}" />
        </Style>
        <Style Selector="TextBlock.rowLabel">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource VSLabel}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.rowHint">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.cardLabel">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SectionLabelText}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.cardHint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="CheckBox.switch">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A shortcut's keys, in a small box; dimmed while there's none. -->
        <Style Selector="Border.hkBox">
            <Setter Property="Background" Value="{DynamicResource VSInsetBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.hkBox > TextBlock">
            <Setter Property="FontFamily" Value="fonts:VibeSwitcher#Cousine" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource VSLabel}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.hkBox > TextBlock.unset">
            <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
        </Style>
        <Style Selector="TextBlock.storageValue">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style Selector="TextBlock.storagePath">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="fonts:VibeSwitcher#Cascadia Mono" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- ── About / FAQ ── -->
        <Style Selector="TextBlock.aboutLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SectionLabelText}" />
        </Style>
        <Style Selector="TextBlock.faqHead">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.faq">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Grid Name="Root" RowDefinitions="30,54,Auto,*" Background="{DynamicResource AppBg}">

        <!-- ══ ROW 0 — Title bar ══ -->
        <Border Grid.Row="0" Background="{DynamicResource VSTitleBarBg}"
                BorderBrush="{DynamicResource VSSurface}" BorderThickness="0,0,0,1">
            <Grid Name="TitleBarGrid" ColumnDefinitions="*,Auto" Background="Transparent">
                <StackPanel Name="FullTitleGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="avares://VibeSwitcher/Assets/Icons/vs-icon-32.png" Width="16" Height="16"
                           Stretch="Uniform" Margin="0,0,6,0" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Text="VibeSwitcher" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- (Mini Mode: the logo and the Mini Mode shortcut.) -->
                <StackPanel Name="MiniTitleGroup" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="10,0,0,0" IsVisible="False">
                    <c:LogoIcon Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource VSInsetBg}" BorderBrush="{DynamicResource InputBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                            ToolTip.Tip="Mini Mode shortcut"
                            IsVisible="{Binding CompactHotkeyDisplay, Converter={x:Static c:Converters.IsNotNotSet}}">
                        <TextBlock Text="{Binding CompactHotkeyDisplay}" FontFamily="fonts:VibeSwitcher#Cousine"
                                   FontSize="9.5" Foreground="{DynamicResource VSLabel}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="TitleShrinkBtn" Theme="{StaticResource TitleBarBtn}" Click="TitleShrink_Click"
                            ToolTip.Tip="Switch to Mini Mode" AutomationProperties.Name="Switch to Mini Mode">
                        <Path Classes="fg" Data="{DynamicResource IcoCompact}" Stretch="Uniform" Width="11" Height="11" StrokeThickness="1.6" />
                    </Button>
                    <Button Name="TitlePinBtn" Theme="{StaticResource TitleBarBtn}" Click="TitlePin_Click" IsVisible="False"
                            Classes.on="{Binding CompactAlwaysOnTop}"
                            ToolTip.Tip="Keep mini window on top" AutomationProperties.Name="Keep mini window on top">
                        <Path Classes="fg" Data="M5.5,2 H10.5 M6.5,2 V6 L4,8.5 H12 L9.5,6 V2 M8,8.5 V13.5"
                              Stretch="Uniform" Width="11" Height="11" StrokeThickness="1.6" />
                    </Button>
                    <Button Name="TitleExpandBtn" Theme="{StaticResource TitleBarBtn}" Click="TitleExpand_Click" IsVisible="False"
                            ToolTip.Tip="Back to full window" AutomationProperties.Name="Back to full window">
                        <Path Classes="fg" Data="{DynamicResource IcoExpand}" Stretch="Uniform" Width="11" Height="11" StrokeThickness="1.6" />
                    </Button>
                    <!-- The window buttons (macOS uses its own, on the left). -->
                    <StackPanel Name="WindowButtons" Orientation="Horizontal">
                        <Button Theme="{StaticResource TitleBarBtn}" Click="TitleMinimize_Click"
                                ToolTip.Tip="Minimize" AutomationProperties.Name="Minimize">
                            <Path Classes="fg" Data="M0,0.5 H10" Width="10" Height="1" StrokeThickness="1" />
                        </Button>
                        <Button Name="TitleMaxBtn" Theme="{StaticResource TitleBarBtn}" Click="TitleMaximize_Click"
                                ToolTip.Tip="Maximize" AutomationProperties.Name="Maximize">
                            <Path Name="MaxGlyph" Classes="fg" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Width="10" Height="10" StrokeThickness="1" />
                        </Button>
                        <Button Theme="{StaticResource TitleBarCloseBtn}" Click="TitleClose_Click"
                                ToolTip.Tip="Close" AutomationProperties.Name="Close">
                            <Path Classes="fg" Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" StrokeThickness="1" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ROW 1 — Top navigation bar ══ -->
        <Border Name="NavBar" Grid.Row="1" Background="{DynamicResource VSNavBg}"
                BorderBrush="{DynamicResource VSNavBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Theme="{StaticResource NavLogoBtn}" Click="NavLogo_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:LogoIcon Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="VibeSwitcher" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Accent}" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="22" Background="{DynamicResource InputBorder}" Margin="12,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Search + Filters -->
                <Grid Name="SearchFiltersPanel" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="280" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,8,0">
                        <TextBox Name="NavSearchBox" MinWidth="110" Height="32" HorizontalAlignment="Stretch"
                                 Text="{Binding SearchText}" FontSize="13" VerticalContentAlignment="Center" Padding="10,0" />
                        <TextBlock Text="Search profiles..." FontSize="12.5" FontStyle="Italic"
                                   Foreground="{DynamicResource DisabledText}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" IsHitTestVisible="False">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="SearchText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                    <Binding ElementName="NavSearchBox" Path="IsFocused" Converter="{x:Static BoolConverters.Not}" />
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>
                    </Grid>
                    <Button Name="FiltersToggleBtn" Grid.Column="1" Height="32" Padding="10,0"
                            Theme="{StaticResource ActionButton}" Click="FiltersBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Classes="fill" Data="M2.5,3.5 H13.5 L9,8.5 V12.5 L7,11 V8.5 Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Filters" FontSize="12" VerticalAlignment="Center" />
                            <Border Name="FilterCountBadge" Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource Accent}" Margin="6,0,0,0" VerticalAlignment="Center"
                                    IsVisible="{Binding IsAnyFilterActive}">
                                <TextBlock Text="{Binding ActiveFilterCount}" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppBg}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="NavAboutBtn" Theme="{StaticResource NavIconBtn}" Margin="0,0,4,0"
                            ToolTip.Tip="About VibeSwitcher" AutomationProperties.Name="About VibeSwitcher" Click="NavAbout_Click">
                        <Path Classes="fg" Data="{DynamicResource IcoInfo}" Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.5" />
                    </Button>
                    <Button Name="NavFaqBtn" Theme="{StaticResource NavIconBtn}" Margin="0,0,4,0"
                            ToolTip.Tip="Help &amp; FAQ" AutomationProperties.Name="Help and FAQ" Click="NavFaq_Click">
                        <Path Classes="fg" Data="{DynamicResource IcoHelp}" Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.5" />
                    </Button>
                    <Button Name="NavSettingsBtn" Theme="{StaticResource NavIconBtn}" Margin="0,0,12,0"
                            ToolTip.Tip="Settings" AutomationProperties.Name="Settings" Click="NavSettings_Click">
                        <Path Classes="fg" Data="{DynamicResource IcoSettings}" Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.5" />
                    </Button>
                    <Border Width="1" Height="22" Background="{DynamicResource InputBorder}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button Theme="{StaticResource PrimaryButton}" Command="{Binding AddProfileCommand}" Padding="10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="+" FontSize="16" FontWeight="Light" Margin="0,-3,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="New Profile" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Name="LogsButton" IsVisible="False" Margin="8,0,0,0" Theme="{StaticResource ActionButton}" Click="LogsButton_Click">
                        <TextBlock Name="LogsButtonText" FontSize="11" Foreground="{DynamicResource WarningText}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ROW 2 — Filter bar (slides open / closed) ══ -->
        <Border Name="FilterBarBorder" Grid.Row="2" MaxHeight="0" ClipToBounds="True" IsEnabled="False"
                Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource VSSurface}" BorderThickness="0,0,0,1">
            <StackPanel Margin="18,9">
                <c:CenteredWrapPanel>
                    <ToggleButton IsChecked="{Binding ModePlayback}" Theme="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="chipIcon" Data="{StaticResource IcoPlayback}" />
                            <TextBlock Text="Playback only" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ModeRecording}" Theme="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="chipIcon" Data="{StaticResource IcoRecording}" />
                            <TextBlock Text="Recording only" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ModeBoth}" Theme="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="chipIcon" Data="{StaticResource IcoBoth}" />
                            <TextBlock Text="Both devices" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding PinnedFilter}" Theme="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="chipIcon solid" Data="{StaticResource IcoPin}" />
                            <TextBlock Text="Pinned" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ActiveFilter}" Theme="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="chipIcon" Data="{StaticResource IcoActive}" />
                            <TextBlock Text="Active" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding SilentFilter}" Theme="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="chipIcon" Data="{StaticResource IcoSilent}" />
                            <TextBlock Text="Silent" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding HotkeyFilter}" Theme="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="chipIcon" Data="{StaticResource IcoHotkey}" />
                            <TextBlock Text="Has hotkey" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding NotesFilter}" Theme="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="chipIcon" Data="{StaticResource IcoNotes}" />
                            <TextBlock Text="Has notes" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IconFilter}" Theme="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="chipIcon" Data="{StaticResource IcoImage}" />
                            <TextBlock Text="Has icon" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ScheduledFilter}" Theme="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="chipIcon" Data="{StaticResource IcoSchedule}" />
                            <TextBlock Text="Scheduled" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ReminderFilter}" Theme="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="chipIcon" Data="{StaticResource IcoReminder}" />
                            <TextBlock Text="Has reminder" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding SoundFilter}" Theme="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="chipIcon" Data="{StaticResource IcoSound}" />
                            <TextBlock Text="Has sound" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding WarningFilter}" Theme="{StaticResource FilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="chipIcon" Data="{StaticResource IcoWarning}" />
                            <TextBlock Text="Has warning" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Content="✕ Clear" Command="{Binding ClearFiltersCommand}" Margin="4,0,0,0"
                            Theme="{StaticResource ClearFilterButton}" IsVisible="{Binding IsAnyFilterActive}" />
                </c:CenteredWrapPanel>
                <!-- Day chips (with "Scheduled") -->
                <ItemsControl ItemsSource="{Binding DayChips}" Margin="0,6,0,0" IsVisible="{Binding ScheduledFilter}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:CenteredWrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DayChip">
                            <ToggleButton Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                          Theme="{StaticResource FilterChip}" Margin="0,0,4,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ══ ROW 3 — Main content (the pages share this grid) ══ -->
        <Grid Name="MainGrid" Grid.Row="3">

            <!-- ── Profiles ── -->
            <ScrollViewer Name="ProfilesPanel" Focusable="True" IsTabStop="False" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <Grid Margin="0,0,0,13">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PROFILES" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SectionLabelText}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource VSSurface}" CornerRadius="10" Margin="8,0,0,0"
                                    Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Profiles.Count}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                            </Border>
                        </StackPanel>
                        <Button Content="Sound Settings" HorizontalAlignment="Right" Theme="{StaticResource ActionButton}"
                                FontSize="11" Click="OpenSoundSettings_Click" />
                    </Grid>

                    <ItemsControl Name="ProfileCards" ItemsSource="{Binding Profiles}"
                                 >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:CenteredWrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileCardViewModel">
                                <Grid Width="310" Margin="0,0,14,14" VerticalAlignment="Top" IsVisible="{Binding IsVisible}">
                                    <Border Classes="card" Classes.active="{Binding IsActive}"
                                            CornerRadius="14" ClipToBounds="True" BorderThickness="1" Cursor="Hand">
                                        <Grid RowDefinitions="*,Auto">
                                            <!-- Active bar (top accent line) -->
                                            <Border Grid.RowSpan="2" Height="2" VerticalAlignment="Top" Margin="12,0"
                                                    ZIndex="5" IsVisible="{Binding IsActive}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                        <GradientStop Color="Transparent" Offset="0" />
                                                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0.5" />
                                                        <GradientStop Color="Transparent" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <!-- Main content — opens the profile popup -->
                                            <Button Grid.Row="0" Theme="{StaticResource CardMainButton}"
                                                    ToolTip.Tip="Open profile settings" Click="ProfileCard_Click">
                                                <StackPanel Margin="0,20,0,10" HorizontalAlignment="Center">
                                                    <Border Classes="iconArea" Classes.active="{Binding IsActive}"
                                                            Width="90" Height="90" CornerRadius="20" HorizontalAlignment="Center">
                                                        <Grid>
                                                            <c:LogoIcon IsAbout="True" Width="80" Height="80"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                        IsVisible="{Binding !HasCustomIcon}" />
                                                            <Image Source="{Binding IconPreview, Converter={x:Static img:AppImages.ToBitmap}}"
                                                                   Width="72" Height="72" Stretch="Uniform"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding HasCustomIcon}" />
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"
                                                               MaxWidth="220" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" />

                                                    <Border Margin="0,8,0,0" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center"
                                                            Background="#1FF5820A" BorderBrush="#40F5820A" BorderThickness="1">
                                                        <TextBlock Text="{Binding ModeLabel}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Accent}" />
                                                    </Border>

                                                    <!-- Every chip and separator has the same 8 px top margin, so gaps stay
                                                         even whichever chips are hidden. -->
                                                    <Border Classes="hairline" />

                                                    <StackPanel IsVisible="{Binding HasVisibilityChips}">
                                                        <Button Theme="{StaticResource CardChipButton}" Command="{Binding ManageSchedulesCommand}"
                                                                HorizontalAlignment="Center" Margin="0,8,0,0"
                                                                ToolTip.Tip="Click to view or edit schedules" IsVisible="{Binding HasSchedules}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Viewbox Width="9" Height="9" Margin="0,0,5,0">
                                                                    <Canvas Width="16" Height="16">
                                                                        <Path Classes="fg" Stroke="{DynamicResource Accent}" StrokeThickness="1.4"
                                                                              Data="M12.5,9 A4.5,4.5 0 1 1 3.5,9 A4.5,4.5 0 1 1 12.5,9 M8,6 V9 L10.2,10.2 M4,5 A2.2,2.2 0 0 1 6.4,2.8 M12,5 A2.2,2.2 0 0 1 9.6,2.8 M5,13.2 L3.8,14.7 M11,13.2 L12.2,14.7" />
                                                                    </Canvas>
                                                                </Viewbox>
                                                                <TextBlock Text="{Binding ScheduleSummaryText}" FontFamily="fonts:VibeSwitcher#Cascadia Mono"
                                                                           FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Theme="{StaticResource CardChipButton}" Command="{Binding ConfigureSoundCommand}"
                                                                HorizontalAlignment="Center" Margin="0,8,0,0"
                                                                ToolTip.Tip="Click to configure switch sound" IsVisible="{Binding SoundOverride}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Viewbox Width="9" Height="9" Margin="0,0,5,0">
                                                                    <Canvas Width="16" Height="16">
                                                                        <Path Classes="fg" Stroke="{DynamicResource Accent}" StrokeThickness="1.7"
                                                                              Data="M2.4,12.5 A1.6,1.6 0 1 0 5.6,12.5 A1.6,1.6 0 1 0 2.4,12.5 M5.6,12.5 V4 M8.4,11 A1.6,1.6 0 1 0 11.6,11 A1.6,1.6 0 1 0 8.4,11 M11.6,11 V2.7 M5.6,4 L11.6,2.7" />
                                                                    </Canvas>
                                                                </Viewbox>
                                                                <TextBlock Text="{Binding SoundSummary}" FontFamily="fonts:VibeSwitcher#Cascadia Mono"
                                                                           FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Border Classes="hairline" />
                                                    </StackPanel>

                                                    <Border Classes="neutralChip" c:Wpf.Visibility="{Binding PlaybackVisible}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Viewbox Width="10" Height="10" Margin="0,0,5,0">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Classes="fg" Stroke="{DynamicResource VSLabel}" StrokeThickness="1.4"
                                                                          Data="M2.5,6 H5.5 L9.5,2.5 V13.5 L5.5,10 H2.5 Z M11.5,5.5 A3.6,3.6 0 0 1 11.5,10.5" />
                                                                </Canvas>
                                                            </Viewbox>
                                                            <TextBlock Text="{Binding SelectedPlaybackDevice.FriendlyName}" FontSize="10"
                                                                       Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"
                                                                       MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Classes="neutralChip" c:Wpf.Visibility="{Binding RecordingVisible}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Viewbox Width="10" Height="10" Margin="0,0,5,0">
                                                                <Canvas Width="16" Height="16">
                                                                    <Rectangle Canvas.Left="6" Canvas.Top="1.5" Width="4" Height="7.5" RadiusX="2" RadiusY="2"
                                                                               Fill="Transparent" Stroke="{DynamicResource VSLabel}" StrokeThickness="1.4" />
                                                                    <Path Classes="fg" Stroke="{DynamicResource VSLabel}" StrokeThickness="1.4"
                                                                          Data="M4,7.5 A4,4 0 0 0 12,7.5 M8,11.5 V14 M5.5,14 H10.5" />
                                                                </Canvas>
                                                            </Viewbox>
                                                            <TextBlock Text="{Binding SelectedRecordingDevice.FriendlyName}" FontSize="10"
                                                                       Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center"
                                                                       MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="neutralChip" IsVisible="{Binding IsHotkeySet}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#x2328;" FontSize="9" Foreground="{DynamicResource VSLabel}"
                                                                       VerticalAlignment="Center" Margin="0,-4,5,0" />
                                                            <TextBlock Text="{Binding HotkeyDisplay}" FontFamily="fonts:VibeSwitcher#Cascadia Mono"
                                                                       FontSize="10" Foreground="{DynamicResource VSLabel}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Button>

                                            <!-- Action strip. Its bottom corners follow the card's (14 minus the 1 px
                                                 border) so its fill doesn't cut the card's rounded border. -->
                                            <Border Grid.Row="1" BorderBrush="{DynamicResource VSHairline}" BorderThickness="0,1,0,0"
                                                    CornerRadius="0,0,13,13" Padding="10,7,10,9" Background="{DynamicResource VSStripOverlay}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,14" ColumnDefinitions="*,*,*,*">
                                                        <ToggleButton HorizontalAlignment="Center" IsChecked="{Binding IsPinned}"
                                                                      Theme="{StaticResource CardActionToggle}" c:Wpf.RereadIsChecked="True"
                                                                      ToolTip.Tip="Pin to top of list" AutomationProperties.Name="Pin to top of list">
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Classes="fill" Data="M8,1.5 L10.2,5.8 L15,6.4 L11.5,9.8 L12.4,14.5 L8,12.1 L3.6,14.5 L4.5,9.8 L1,6.4 L5.8,5.8 Z" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </ToggleButton>
                                                        <Button Grid.Column="1" HorizontalAlignment="Center" Command="{Binding OpenAppTriggersCommand}"
                                                                Theme="{StaticResource CardActionBtn}" Classes.on="{Binding HasAppTriggers}"
                                                                ToolTip.Tip="App launch triggers" AutomationProperties.Name="App launch triggers">
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Classes="fill" Data="M10,1.5 L3.5,9.5 H7.5 L6,14.5 L13.5,6.5 H9.5 Z" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                        <ToggleButton Grid.Column="2" HorizontalAlignment="Center" IsChecked="{Binding TriggerOnConnect}"
                                                                      Theme="{StaticResource CardActionToggle}" c:Wpf.RereadIsChecked="True"
                                                                      Classes.dim28="{Binding TriggerOnConnectVisible, Converter={x:Static c:Converters.IsCollapsed}}"
                                                                      ToolTip.Tip="Auto-switch on device connect" AutomationProperties.Name="Auto-switch on device connect">
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Classes="fg" StrokeThickness="1.6"
                                                                          Data="M6,1.5 L6,5 M10,1.5 L10,5 M3.5,5 H12.5 V7.5 A4.5,4.5 0 0 1 8,12 A4.5,4.5 0 0 1 3.5,7.5 Z M8,12 L8,14.5 M6,14.5 L10,14.5" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </ToggleButton>
                                                        <Button Grid.Column="3" HorizontalAlignment="Center" Command="{Binding ActivateCommand}"
                                                                Theme="{StaticResource CardActionBtn}" Classes.active="{Binding IsActive}"
                                                                ToolTip.Tip="Activate this profile" AutomationProperties.Name="Activate this profile">
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Classes="fg" StrokeThickness="1.7" Data="M11.2,4.1 A5.4,5.4 0 1 1 4.8,4.1 M8,1.2 L8,7.6" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,*,*,*">
                                                        <ToggleButton HorizontalAlignment="Center" IsChecked="{Binding Silent}"
                                                                      Theme="{StaticResource CardActionToggle}" c:Wpf.RereadIsChecked="True" Classes.dim35="{Binding SoundOverride}"
                                                                      ToolTip.Tip="Toggle silent mode" AutomationProperties.Name="Toggle silent mode">
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Classes="fg" StrokeThickness="1.6" Data="M8,2 A5,5 0 0 0 3,7 V10 L2,12 H14 L13,10 V7 A5,5 0 0 0 8,2 Z" />
                                                                    <Path Classes="fg" StrokeThickness="1.6" Data="M6.5,13.5 A1.5,1.5 0 0 0 9.5,13.5" />
                                                                    <Path Classes="fg" StrokeThickness="1.8" Data="M2,2 L14,14" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </ToggleButton>
                                                        <Button Grid.Column="1" HorizontalAlignment="Center" Command="{Binding AddScheduleCommand}"
                                                                Theme="{StaticResource CardActionBtn}" Classes.on="{Binding HasSchedules}"
                                                                ToolTip.Tip="Schedule this profile" AutomationProperties.Name="Schedule this profile">
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Classes="fg" StrokeThickness="1.4"
                                                                          Data="M12.5,9 A4.5,4.5 0 1 1 3.5,9 A4.5,4.5 0 1 1 12.5,9 M8,6 V9 L10.2,10.2 M4,5 A2.2,2.2 0 0 1 6.4,2.8 M12,5 A2.2,2.2 0 0 1 9.6,2.8 M5,13.2 L3.8,14.7 M11,13.2 L12.2,14.7" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Grid.Column="2" HorizontalAlignment="Center" Command="{Binding ConfigureSoundCommand}"
                                                                Theme="{StaticResource CardActionBtn}" Classes.on="{Binding SoundOverride}"
                                                                ToolTip.Tip="Configure switch sound" AutomationProperties.Name="Configure switch sound">
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Classes="fg" StrokeThickness="1.7"
                                                                          Data="M2.4,12.5 A1.6,1.6 0 1 0 5.6,12.5 A1.6,1.6 0 1 0 2.4,12.5 M5.6,12.5 V4 M8.4,11 A1.6,1.6 0 1 0 11.6,11 A1.6,1.6 0 1 0 8.4,11 M11.6,11 V2.7 M5.6,4 L11.6,2.7" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Grid.Column="3" HorizontalAlignment="Center" Command="{Binding DeleteCommand}"
                                                                Theme="{StaticResource CardActionBtn}" Classes="delete"
                                                                ToolTip.Tip="Delete this profile" AutomationProperties.Name="Delete this profile">
                                                            <Viewbox Width="18" Height="18">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Classes="fg" StrokeThickness="1.7" Data="M2,4 H14 M5.5,4 V2.5 H10.5 V4 M3.5,4 L4.3,13.5 H11.7 L12.5,4" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Save flash -->
                                    <Border c:SaveFlash.IsOn="{Binding SaveFlash}" Opacity="0" CornerRadius="14"
                                            Background="{DynamicResource SaveFlashBg}" IsHitTestVisible="False" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource DisabledText}" FontSize="13"
                               Margin="0,32,0,8" Text="No profiles match your filters." IsVisible="{Binding HasNoFilterResults}" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource DisabledText}" FontSize="13"
                               Margin="0,32,0,24" Text="No profiles yet — click + New Profile to get started."
                               IsVisible="{Binding HasNoProfiles}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ══ PANEL B: Settings ══ -->
            <Grid Name="SettingsBodyScrollViewer" IsVisible="False" ColumnDefinitions="168,*">

                <!-- LEFT SIDEBAR -->
                <Border Grid.Column="0" Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="*,Auto">
                        <StackPanel Grid.Row="0" Margin="8,12,8,0">
                            <TextBlock Text="GENERAL" Theme="{StaticResource SettingsNavLabelStyle}" />

                            <Button Name="NavStartup" Theme="{StaticResource SettingsNavItemStyle}" Classes.selected="{Binding IsStartupSelected}"
                                    Command="{Binding SelectCategoryCommand}" CommandParameter="startup">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Classes="fg" StrokeThickness="1.6"
                                                  Data="M 8,1.5 c 0,0 4,2.5 4,7.5 a 4,4 0 0 1 -8,0 c 0,-5 4,-7.5 4,-7.5 Z M 8,14 L 8,12 M 5.5,13 L 5.5,11.2 M 10.5,13 L 10.5,11.2" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Startup" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Name="NavAppear" Theme="{StaticResource SettingsNavItemStyle}" Classes.selected="{Binding IsAppearSelected}"
                                    Command="{Binding SelectCategoryCommand}" CommandParameter="appear">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Ellipse Classes="fg" Canvas.Left="5" Canvas.Top="5" Width="6" Height="6"
                                                     StrokeThickness="1.6" Fill="Transparent" />
                                            <Path Classes="fg" StrokeThickness="1.6"
                                                  Data="M 8,1.5 L 8,2.5 M 8,13.5 L 8,14.5 M 1.5,8 L 2.5,8 M 13.5,8 L 14.5,8 M 3.3,3.3 L 4,4 M 12,12 L 12.7,12.7 M 12,3.3 L 11.3,4 M 4,12 L 3.3,12.7" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Appearance" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Name="NavNotif" Theme="{StaticResource SettingsNavItemStyle}" Classes.selected="{Binding IsNotifSelected}"
                                    Command="{Binding SelectCategoryCommand}" CommandParameter="notif">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Classes="fg" StrokeThickness="1.6"
                                                  Data="M 8,2 a 5,5 0 0 0 -5,5 v 3 l -1,2 h 12 l -1,-2 V 7 a 5,5 0 0 0 -5,-5 Z M 6.5,13.5 a 1.5,1.5 0 0 0 3,0" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Notifications" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Name="NavDevices" Theme="{StaticResource SettingsNavItemStyle}" Classes.selected="{Binding IsDevicesSelected}"
                                    Command="{Binding SelectCategoryCommand}" CommandParameter="devices">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Classes="fg" StrokeThickness="1.6"
                                                  Data="M 5,6 H 3 a 1,1 0 0 0 -1,1 v 2 a 1,1 0 0 0 1,1 h 2 l 3.5,2.5 V 3.5 Z M 10.5,6 a 2.5,2.5 0 0 1 0,4" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Devices" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Name="NavTray" Theme="{StaticResource SettingsNavItemStyle}" Classes.selected="{Binding IsTraySelected}"
                                    Command="{Binding SelectCategoryCommand}" CommandParameter="tray">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Classes="fg" StrokeThickness="1.6"
                                                  Data="M 4.5,1.5 H 11.5 A 3,3 0 0 1 14.5,4.5 V 11.5 A 3,3 0 0 1 11.5,14.5 H 4.5 A 3,3 0 0 1 1.5,11.5 V 4.5 A 3,3 0 0 1 4.5,1.5 Z M 1.5,10.5 H 14.5" />
                                            <Ellipse Classes="fill" Canvas.Left="4.2" Canvas.Top="11.7" Width="1.6" Height="1.6" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{x:Static s:Wording.TrayNav}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Name="NavShortcuts" Theme="{StaticResource SettingsNavItemStyle}" Classes.selected="{Binding IsShortcutsSelected}"
                                    Command="{Binding SelectCategoryCommand}" CommandParameter="shortcuts">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Classes="fg" StrokeThickness="1.5"
                                                  Data="M 3,3.5 H 13 A 2,2 0 0 1 15,5.5 V 11.5 A 2,2 0 0 1 13,13.5 H 3 A 2,2 0 0 1 1,11.5 V 5.5 A 2,2 0 0 1 3,3.5 Z M 4,11 L 12,11" />
                                            <Path Classes="fg" StrokeThickness="2" Data="M 4,8 L 4.01,8 M 7.5,8 L 7.51,8 M 11,8 L 11.01,8" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Shortcuts" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Name="NavCompact" Theme="{StaticResource SettingsNavItemStyle}" Classes.selected="{Binding IsCompactSelected}"
                                    Command="{Binding SelectCategoryCommand}" CommandParameter="compact">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Classes="fg" StrokeThickness="1.6" Data="{DynamicResource IcoCompact}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Mini Window" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Name="NavLogs" Theme="{StaticResource SettingsNavItemStyle}" Classes.selected="{Binding IsLogsSelected}"
                                    Command="{Binding SelectCategoryCommand}" CommandParameter="logs">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Classes="fg" StrokeThickness="1.6" Data="M 2,3 H 14 M 2,7 H 10 M 2,11 H 12" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Logs" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Name="UninstallNavBtn" Theme="{StaticResource SettingsNavItemStyle}" Classes.selected="{Binding IsUninstallSelected}"
                                    Command="{Binding SelectCategoryCommand}" CommandParameter="uninstall">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Classes="fg" StrokeThickness="1.6" Data="{DynamicResource IcoTrash}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Install &amp; Updates" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Back button at bottom of sidebar -->
                        <Button Name="SettingsBackBtn" Grid.Row="1" Theme="{StaticResource SettingsNavItemStyle}" Margin="8,4,8,14"
                                Click="NavProfiles_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13">
                                    <Canvas Width="14" Height="14">
                                        <Path Classes="fg" StrokeThickness="2" Data="M 9,2 L 4,7 L 9,12" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Back" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- RIGHT CONTENT -->
                <ScrollViewer Name="SettingsScroll" Grid.Column="1" Focusable="True" IsTabStop="False"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,20,22,20">

                        <!-- ── Startup ── -->
                        <StackPanel Name="StartupSection" IsVisible="{Binding IsStartupSelected}">
                            <TextBlock Classes="pageTitle" Text="Startup" />
                            <Border Classes="section">
                                <StackPanel>
                                    <Grid Margin="14,10">
                                        <TextBlock Classes="rowLabel" Text="{x:Static s:Wording.StartAtLogin}" />
                                        <CheckBox Name="StartAtLoginToggle" Classes="switch" Theme="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding StartWithWindows}" c:Wpf.RereadIsChecked="True" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <Grid Margin="14,10">
                                        <TextBlock Classes="rowLabel" Text="{x:Static s:Wording.StartMinimized}" />
                                        <CheckBox Classes="switch" Theme="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartMinimized}" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <Grid Margin="14,10">
                                        <TextBlock Classes="rowLabel" Text="{x:Static s:Wording.CloseToTray}" />
                                        <CheckBox Classes="switch" Theme="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CloseToTray}" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <Grid Margin="14,10" ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Classes="rowLabel" Text="Catch up missed schedules" />
                                            <TextBlock Classes="rowHint" Text="{x:Static s:Wording.CatchUpDetail}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Classes="switch" Theme="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding SchedulerCatchUp}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Appearance ── -->
                        <StackPanel Name="AppearSection" IsVisible="{Binding IsAppearSelected}">
                            <TextBlock Classes="pageTitle" Text="Appearance" />
                            <Border Classes="section">
                                <StackPanel>
                                    <Grid Margin="14,10" ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="rowLabel" Text="Theme" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <RadioButton Name="ThemeAuto" Theme="{StaticResource SegmentRadio}" GroupName="ThemeGroup2"
                                                         Content="{x:Static s:Wording.FollowSystem}"
                                                         IsChecked="{Binding Theme, Converter={x:Static c:Converters.IsValue}, ConverterParameter='Follow Windows'}" />
                                            <RadioButton Name="ThemeLight" Theme="{StaticResource SegmentRadio}" GroupName="ThemeGroup2" Content="Light"
                                                         IsChecked="{Binding Theme, Converter={x:Static c:Converters.IsValue}, ConverterParameter=Light}" />
                                            <RadioButton Name="ThemeDark" Theme="{StaticResource SegmentRadio}" GroupName="ThemeGroup2" Content="Dark" Margin="0"
                                                         IsChecked="{Binding Theme, Converter={x:Static c:Converters.IsValue}, ConverterParameter=Dark}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <Grid Margin="14,10" ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Classes="rowLabel" Text="Logo animation" />
                                            <TextBlock Classes="rowHint" Margin="0,2,0,0"
                                                       Text="Lower it or turn it off to reduce CPU while the window is open" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton Name="LogoFull" Theme="{StaticResource SegmentRadio}" GroupName="LogoAnimGroup" Content="Full"
                                                         IsChecked="{Binding LogoAnimation, Converter={x:Static c:Converters.IsValue}, ConverterParameter=Full}" />
                                            <RadioButton Name="LogoReduced" Theme="{StaticResource SegmentRadio}" GroupName="LogoAnimGroup" Content="Reduced"
                                                         IsChecked="{Binding LogoAnimation, Converter={x:Static c:Converters.IsValue}, ConverterParameter=Reduced}" />
                                            <RadioButton Name="LogoStatic" Theme="{StaticResource SegmentRadio}" GroupName="LogoAnimGroup" Content="Static" Margin="0"
                                                         IsChecked="{Binding LogoAnimation, Converter={x:Static c:Converters.IsValue}, ConverterParameter=Static}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <Grid Margin="14,10">
                                        <TextBlock Classes="rowLabel" Text="Use 24-hour clock" />
                                        <CheckBox Classes="switch" Theme="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Use24HourClock}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Notifications ── -->
                        <StackPanel Name="NotifSection" IsVisible="{Binding IsNotifSelected}">
                            <TextBlock Classes="pageTitle" Text="Notifications" />
                            <Border Classes="section">
                                <Grid Margin="14,10" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Classes="rowLabel" Text="Show switch &amp; warning alerts" />
                                        <TextBlock Classes="rowHint" FontSize="11" Margin="0,3,0,0" Text="{x:Static s:Wording.NotificationsDetail}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Classes="switch" Theme="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShowNotifications}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ── Devices ── -->
                        <!-- (Windows' "Use legacy sound panel" and "Show disabled devices" rows are left out:
                             macOS and Linux have neither — see docs/PARITY.md.) -->
                        <StackPanel Name="DevicesSection" IsVisible="{Binding IsDevicesSelected}">
                            <TextBlock Classes="pageTitle" Text="Devices" />
                            <Border Classes="section">
                                <StackPanel>
                                    <Grid Margin="14,10">
                                        <TextBlock Classes="rowLabel" Text="Show disconnected devices in dropdowns" />
                                        <CheckBox Classes="switch" Theme="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShowDisconnectedDevices}" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <StackPanel Margin="14,10">
                                        <Button Content="Open Sound Settings" Theme="{StaticResource ActionButton}"
                                                HorizontalAlignment="Left" Click="OpenSoundSettings_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Device Aliases -->
                            <Border Classes="section" Margin="0,12,0,0">
                                <StackPanel Margin="14,12">
                                    <TextBlock Classes="cardLabel" Text="DEVICE ALIASES" />
                                    <TextBlock Classes="cardHint" Text="Give your audio devices custom display names to make profiles easier to read." />
                                    <Button Content="Manage Aliases…" Theme="{StaticResource ActionButton}"
                                            HorizontalAlignment="Left" Click="ManageAliasesButton_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Backup & Restore -->
                            <Border Classes="section" Margin="0,12,0,0">
                                <StackPanel Margin="14,12">
                                    <TextBlock Classes="cardLabel" Text="BACKUP &amp; RESTORE" />
                                    <TextBlock Classes="cardHint" Text="Save your profiles to a file, or restore from a previous backup." />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Name="ExportBtn" Content="Export Config" Theme="{StaticResource ActionButton}" Margin="0,0,8,0" Click="ExportButton_Click" />
                                        <Button Name="ImportBtn" Content="Import Config" Theme="{StaticResource ActionButton}" Click="ImportButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Tray (macOS: Menu Bar) ── -->
                        <StackPanel Name="TraySection" IsVisible="{Binding IsTraySelected}">
                            <TextBlock Classes="pageTitle" Text="{x:Static s:Wording.TrayNav}" />
                            <Border Classes="section" IsVisible="{x:Static s:Wording.LeftClickOption}">
                                <Grid Margin="14,10">
                                    <TextBlock Classes="rowLabel" Text="{x:Static s:Wording.LeftClickCycles}" />
                                    <CheckBox Classes="switch" Theme="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LeftClickCyclesProfiles}" />
                                </Grid>
                            </Border>

                            <!-- Menu items: which optional actions appear in the icon's menu. -->
                            <Border Classes="section" Margin="0,12,0,0">
                                <StackPanel Margin="14,12">
                                    <TextBlock Classes="cardLabel" Text="{x:Static s:Wording.TrayMenuHeader}" Margin="0,0,0,4" />
                                    <TextBlock Classes="cardHint" Text="{x:Static s:Wording.TrayMenuDetail}" Margin="0,0,0,8" />
                                    <Grid Margin="0,6">
                                        <TextBlock Classes="rowLabel" Text="About" />
                                        <CheckBox Classes="switch" Theme="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding TrayShowAbout}" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <Grid Margin="0,6">
                                        <TextBlock Classes="rowLabel" Text="Help &amp; FAQ" />
                                        <CheckBox Classes="switch" Theme="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding TrayShowFaq}" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <Grid Margin="0,6">
                                        <TextBlock Classes="rowLabel" Text="Mini Mode" />
                                        <CheckBox Classes="switch" Theme="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding TrayShowMiniMode}" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <Grid Margin="0,6">
                                        <TextBlock Classes="rowLabel" Text="Open Sound Settings" />
                                        <CheckBox Classes="switch" Theme="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding TrayShowSoundSettings}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Shortcuts ── -->
                        <StackPanel Name="ShortcutsSection" IsVisible="{Binding IsShortcutsSelected}">
                            <TextBlock Classes="pageTitle" Text="Shortcuts" />
                            <Border Classes="section">
                                <StackPanel>
                                    <!-- Open / Close VibeSwitcher -->
                                    <Grid Margin="14,9" ColumnDefinitions="*,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Classes="rowLabel" Text="Open / Close VibeSwitcher" />
                                        <Border Grid.Column="1" Classes="hkBox">
                                            <TextBlock Name="SettingsHotkeyText" Text="{Binding SettingsHotkeyDisplay}" Classes.unset="{Binding !SettingsHotkeyIsSet}" />
                                        </Border>
                                        <Button Grid.Column="2" Name="SettingsHotkeySetBtn" Content="Set" Theme="{StaticResource ActionButton}" Margin="6,0,0,0"
                                                Click="SettingsHotkeyButton_Click" />
                                        <Button Grid.Column="3" Name="SettingsHotkeyClearBtn" Content="✕" Theme="{StaticResource ActionButton}" Margin="4,0,0,0"
                                                IsVisible="{Binding SettingsHotkeyIsSet}" Click="SettingsHotkeyClear_Click" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <!-- Mute Microphone -->
                                    <Grid Margin="14,9" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Classes="rowLabel" Text="Mute Microphone" />
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource MuteBannerToggle}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                      IsChecked="{Binding MuteMicSilent}" ToolTip.Tip="Don't show a notification banner for this shortcut"
                                                      AutomationProperties.Name="Silence the Mute Microphone banner" />
                                        <Border Grid.Column="2" Classes="hkBox">
                                            <TextBlock Text="{Binding MuteMicHotkeyDisplay}" Classes.unset="{Binding !MuteMicHotkeyIsSet}" />
                                        </Border>
                                        <Button Grid.Column="3" Name="MuteMicSetBtn" Content="Set" Theme="{StaticResource ActionButton}" Tag="Mic" Margin="6,0,0,0"
                                                Click="MuteHotkeyButton_Click" />
                                        <Button Grid.Column="4" Content="✕" Theme="{StaticResource ActionButton}" Tag="Mic" Margin="4,0,0,0"
                                                IsVisible="{Binding MuteMicHotkeyIsSet}" Click="MuteHotkeyClear_Click" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <!-- Mute Speakers -->
                                    <Grid Margin="14,9" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Classes="rowLabel" Text="Mute Speakers" />
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource MuteBannerToggle}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                      IsChecked="{Binding MuteSpeakersSilent}" ToolTip.Tip="Don't show a notification banner for this shortcut"
                                                      AutomationProperties.Name="Silence the Mute Speakers banner" />
                                        <Border Grid.Column="2" Classes="hkBox">
                                            <TextBlock Text="{Binding MuteSpeakersHotkeyDisplay}" Classes.unset="{Binding !MuteSpeakersHotkeyIsSet}" />
                                        </Border>
                                        <Button Grid.Column="3" Name="MuteSpeakersSetBtn" Content="Set" Theme="{StaticResource ActionButton}" Tag="Speakers" Margin="6,0,0,0"
                                                Click="MuteHotkeyButton_Click" />
                                        <Button Grid.Column="4" Content="✕" Theme="{StaticResource ActionButton}" Tag="Speakers" Margin="4,0,0,0"
                                                IsVisible="{Binding MuteSpeakersHotkeyIsSet}" Click="MuteHotkeyClear_Click" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <!-- Mute All -->
                                    <Grid Margin="14,9" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Classes="rowLabel" Text="Mute Mic + Speakers" />
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource MuteBannerToggle}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                      IsChecked="{Binding MuteBothSilent}" ToolTip.Tip="Don't show a notification banner for this shortcut"
                                                      AutomationProperties.Name="Silence the Mute Mic and Speakers banner" />
                                        <Border Grid.Column="2" Classes="hkBox">
                                            <TextBlock Text="{Binding MuteBothHotkeyDisplay}" Classes.unset="{Binding !MuteBothHotkeyIsSet}" />
                                        </Border>
                                        <Button Grid.Column="3" Name="MuteBothSetBtn" Content="Set" Theme="{StaticResource ActionButton}" Tag="Both" Margin="6,0,0,0"
                                                Click="MuteHotkeyButton_Click" />
                                        <Button Grid.Column="4" Content="✕" Theme="{StaticResource ActionButton}" Tag="Both" Margin="4,0,0,0"
                                                IsVisible="{Binding MuteBothHotkeyIsSet}" Click="MuteHotkeyClear_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Mini Window ── -->
                        <StackPanel Name="CompactSection" IsVisible="{Binding IsCompactSelected}">
                            <TextBlock Classes="pageTitle" Text="Mini Window" Margin="0,0,0,6" />
                            <TextBlock Classes="cardHint" Text="{x:Static s:Wording.MiniDetail}" Margin="0,0,0,14" />
                            <Border Classes="section">
                                <StackPanel>
                                    <!-- Profiles & layout wizard -->
                                    <Grid Margin="14,10">
                                        <StackPanel>
                                            <TextBlock Classes="rowLabel" Text="Profiles &amp; layout" />
                                            <TextBlock Classes="rowHint" Margin="0,3,110,0"
                                                       Text="Pick which profiles appear in Mini Mode and switch between the row list and a compact icon grid." />
                                        </StackPanel>
                                        <Button Content="Customize…" Theme="{StaticResource ActionButton}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="CompactCustomize_Click" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <!-- Toggle Mini Mode shortcut -->
                                    <Grid Margin="14,9" ColumnDefinitions="*,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Classes="rowLabel" Text="Toggle Mini Mode" />
                                        <Border Grid.Column="1" Classes="hkBox">
                                            <TextBlock Text="{Binding CompactHotkeyDisplay}" Classes.unset="{Binding !CompactHotkeyIsSet}" />
                                        </Border>
                                        <Button Grid.Column="2" Name="CompactHotkeySetBtn" Content="Set" Theme="{StaticResource ActionButton}" Margin="6,0,0,0"
                                                Click="CompactHotkeyButton_Click" />
                                        <Button Grid.Column="3" Content="✕" Theme="{StaticResource ActionButton}" Margin="4,0,0,0"
                                                IsVisible="{Binding CompactHotkeyIsSet}" Click="CompactHotkeyClear_Click" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <!-- Always on top -->
                                    <Grid Margin="14,10">
                                        <StackPanel>
                                            <TextBlock Classes="rowLabel" Text="Always on top" />
                                            <TextBlock Classes="rowHint" Margin="0,3,46,0"
                                                       Text="Keeps the mini window above games and other apps. Also toggled by the pin in the mini title bar." />
                                        </StackPanel>
                                        <CheckBox Classes="switch" Theme="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CompactAlwaysOnTop}" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <!-- Translucent when inactive -->
                                    <Grid Margin="14,10">
                                        <StackPanel>
                                            <TextBlock Classes="rowLabel" Text="Translucent when inactive" />
                                            <TextBlock Classes="rowHint" Margin="0,3,46,0"
                                                       Text="The mini window fades slightly when another app has focus, so it stays out of the way." />
                                        </StackPanel>
                                        <CheckBox Classes="switch" Theme="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CompactTranslucent}" />
                                    </Grid>
                                    <Border Classes="rowLine" />
                                    <!-- Try it -->
                                    <StackPanel Margin="14,12">
                                        <Button Content="Switch to Mini Mode now" Theme="{StaticResource ActionButton}"
                                                HorizontalAlignment="Left" Click="TitleShrink_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Logs ── -->
                        <StackPanel Name="LogsSection" IsVisible="{Binding IsLogsSelected}">
                            <TextBlock Classes="pageTitle" Text="Logs" />
                            <Border Classes="section">
                                <StackPanel Margin="14,12">
                                    <TextBlock Classes="cardLabel" Text="SESSION LOG" />
                                    <TextBlock Classes="cardHint" Text="View a log of audio device switches and events from this session." />
                                    <Button Content="View session log" Theme="{StaticResource ActionButton}"
                                            HorizontalAlignment="Left" Click="LogsButton_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Install & Updates ── -->
                        <StackPanel Name="UninstallSection" IsVisible="{Binding IsUninstallSelected}">
                            <TextBlock Classes="pageTitle" Text="Install / Update / Uninstall" />

                            <!-- App location -->
                            <Border Classes="section">
                                <StackPanel Margin="14,12">
                                    <TextBlock Classes="cardLabel" Text="THIS INSTALLATION" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Classes="rowLabel" Text="Version" />
                                        <TextBlock Name="InstallVersionText" Classes="storageValue" />
                                        <TextBlock Classes="rowLabel" Text="•" Margin="10,0" />
                                        <TextBlock Classes="rowLabel" Text="Size" />
                                        <TextBlock Name="InstallSizeText" Classes="storageValue" />
                                    </StackPanel>
                                    <TextBlock Classes="rowLabel" Text="Location" Margin="0,4,0,2" />
                                    <TextBlock Name="InstallLocationText" Classes="storagePath" ToolTip.Tip="{Binding $self.Text}" />
                                    <Button Name="BrowseInstallBtn" Content="{x:Static s:Wording.BrowseInstall}" Theme="{StaticResource ActionButton}"
                                            HorizontalAlignment="Left" Click="BrowseInstallFolder_Click" />
                                </StackPanel>
                            </Border>

                            <!-- App data -->
                            <Border Classes="section" Margin="0,12,0,0">
                                <StackPanel Margin="14,12">
                                    <TextBlock Classes="cardLabel" Text="APP DATA" />
                                    <TextBlock Classes="cardHint" Margin="0,0,0,8"
                                               Text="Your profiles, settings, custom icons, and the error log live in the app's data folder. This is also what Backup &amp; Restore exports." />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Classes="rowLabel" Text="Size" />
                                        <TextBlock Name="DataSizeText" Classes="storageValue" />
                                    </StackPanel>
                                    <TextBlock Classes="rowLabel" Text="Location" Margin="0,4,0,2" />
                                    <TextBlock Name="DataLocationText" Classes="storagePath" ToolTip.Tip="{Binding $self.Text}" />
                                    <Button Content="Open data folder" Theme="{StaticResource ActionButton}"
                                            HorizontalAlignment="Left" Click="OpenDataFolder_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Reset settings (keeps profiles and data) -->
                            <Border Classes="section" Margin="0,12,0,0">
                                <StackPanel Margin="14,12">
                                    <TextBlock Classes="cardLabel" Text="RESET SETTINGS" />
                                    <TextBlock Classes="cardHint"
                                               Text="Returns every app setting to its default — theme, notifications, shortcuts, Mini Mode, and the rest. Your profiles, schedules, app triggers, and device aliases are kept." />
                                    <Button Content="Reset settings to defaults…" Theme="{StaticResource DangerButton}"
                                            HorizontalAlignment="Left" Command="{Binding ResetSettingsCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Uninstall (button off for builds that can't uninstall themselves) -->
                            <Border Name="UninstallCard" Classes="section" Margin="0,12,0,0">
                                <StackPanel Margin="14,12">
                                    <TextBlock Classes="cardLabel" Text="UNINSTALL VIBESWITCHER" />
                                    <TextBlock Name="UninstallDetailText" Classes="cardHint" />
                                    <TextBlock Name="UninstallBlockedNote" IsVisible="False" FontSize="10.5" Foreground="{DynamicResource WarningText}"
                                               TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <Button Name="UninstallBtn" Content="Uninstall VibeSwitcher…" Theme="{StaticResource DeleteButton}"
                                            HorizontalAlignment="Left" Click="UninstallButton_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ══ PANEL C: About ══ -->
            <ScrollViewer Name="AboutPanel" IsVisible="False" Focusable="True" IsTabStop="False"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720" HorizontalAlignment="Center" Margin="22,18,22,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Theme="{StaticResource BackButton}" Content="&#x2190;" FontSize="14" Click="NavProfiles_Click" />
                        <TextBlock Text="About" Theme="{StaticResource PanelTitle}" />
                    </StackPanel>

                    <!-- App identity card -->
                    <Border Theme="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="Auto,*">
                            <c:LogoIcon Grid.Column="0" IsAbout="True" Width="84" Height="84" Margin="0,0,20,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="VibeSwitcher" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                                <TextBlock Name="AboutVersionText" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0" />
                                <TextBlock Text="Manage audio device profiles with global hotkeys, schedules, app triggers, and headset auto-detection."
                                           FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Links -->
                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="aboutLabel" Text="LINKS" Margin="0,0,0,12" />
                            <WrapPanel>
                                <!-- Placeholder until the site exists — set Tag to the URL and remove
                                     IsEnabled/Opacity to activate. -->
                                <Button Theme="{StaticResource LinkChipStyle}" IsEnabled="False" Opacity="0.45"
                                        ToolTip.Tip="Coming soon" ToolTip.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↗" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Website" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Theme="{StaticResource LinkChipStyle}" Tag="https://github.com/raphymany/vibeswitcher" Click="LinkChip_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↗" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="GitHub" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Theme="{StaticResource LinkChipStyle}" Tag="https://github.com/raphymany/vibeswitcher/issues/new/choose" Click="LinkChip_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↗" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Report a bug" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Theme="{StaticResource LinkChipStyle}" Tag="https://github.com/raphymany/vibeswitcher/blob/main/README.md" Click="LinkChip_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↗" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="ReadMe" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Theme="{StaticResource LinkChipStyle}" Tag="https://github.com/raphymany/vibeswitcher/blob/main/CHANGELOG.md" Click="LinkChip_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↗" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Changelog" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Theme="{StaticResource LinkChipStyle}" Tag="https://github.com/raphymany/vibeswitcher/blob/main/LICENSE" Click="LinkChip_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↗" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="License (MIT)" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Built with -->
                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="aboutLabel" Text="BUILT WITH" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{x:Static s:Wording.BuiltWith}" Margin="0,0,0,-6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="s:BuiltWithItem">
                                        <Grid ColumnDefinitions="130,*" Margin="0,0,0,6">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Credits -->
                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="aboutLabel" Text="DEVELOPMENT" Margin="0,0,0,10" />
                            <TextBlock Text="Designed and built by" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                <TextBlock Text="Raphael Mansour" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
                                <Border CornerRadius="6" Background="#1FF5820A" BorderBrush="#40F5820A" BorderThickness="1"
                                        Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                        ToolTip.Tip="Pair-programmed with Anthropic's Claude Code">
                                    <TextBlock Text="with Claude Code" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="&#xA9; 2026 Raphael Mansour. All rights reserved." FontSize="11" Foreground="{DynamicResource DisabledText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ PANEL D: FAQ ══ -->
            <!-- (WPF Hyperlinks → FaqLink buttons inside the text.) -->
            <ScrollViewer Name="FaqPanel" IsVisible="False" Focusable="True" IsTabStop="False"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720" HorizontalAlignment="Center" Margin="22,18,22,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Button Theme="{StaticResource BackButton}" Content="←" FontSize="14" Click="NavProfiles_Click" />
                        <TextBlock Text="Help &amp; FAQ" Theme="{StaticResource PanelTitle}" />
                    </StackPanel>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="WHAT IS VIBESWITCHER?" />
                            <TextBlock Classes="faq"><Run Text="VibeSwitcher is " /><Run Text="{x:Static s:Wording.AppKind}" /><Run Text=" that lets you save audio device configurations as profiles and switch between them instantly — using hotkeys, schedules, or a single click." /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="SETTING UP PROFILES" />
                            <TextBlock Classes="faq"><Run Text="Click " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="newProfile" Click="FaqAction_Click" Content="+ New Profile" /></InlineUIContainer><Run Text=" to create a profile. Choose a mode (Playback, Recording, or Both), pick your devices, then give it a name. You can assign a global hotkey to activate it from anywhere." /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="CUSTOM PROFILE ICONS" />
                            <TextBlock Classes="faq" Margin="0,0,0,6"><Run Text="Open " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="profiles" Click="FaqAction_Click" Content="a profile" /></InlineUIContainer><Run Text=", click its icon, and choose &quot;Browse from disk&quot; to use your own " /><Run FontFamily="fonts:VibeSwitcher#Cascadia Mono" Text=".ico" /><Run Text=" file. To make one from any picture:" /></TextBlock>
                            <TextBlock Classes="faq" LineHeight="21"><Run Text="1.&#160; Save the picture you want to use." /><LineBreak /><Run Text="2.&#160; (Optional) Remove its background with " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="https://www.pixelcut.ai/background-remover/png" Click="FaqUrl_Click" Content="Pixelcut Background Remover" /></InlineUIContainer><Run Text="." /><LineBreak /><Run Text="3.&#160; Convert the image to " /><Run FontFamily="fonts:VibeSwitcher#Cascadia Mono" Text=".ico" /><Run Text=" with " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="https://image.online-convert.com/convert-to-ico" Click="FaqUrl_Click" Content="Online&#8209;Convert" /></InlineUIContainer><Run Text=". If your file is a PNG, JPEG, or other format, just pick the matching conversion (e.g. PNG&#160;&#8594;&#160;ICO)." /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="FILTERING PROFILES" />
                            <TextBlock Classes="faq"><Run Text="Use the " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="filters" Click="FaqAction_Click" Content="search box and filter chips" /></InlineUIContainer><Run Text=" to narrow down your profile list. Filters stack (AND logic). Clear all filters with the ✕ Clear button." /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="USING HOTKEYS" />
                            <TextBlock Classes="faq"><Run Text="Click " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="profiles" Click="FaqAction_Click" Content="a profile card" /></InlineUIContainer><Run Text=" to open profile details, then click &quot;Set Hotkey&quot;. Press your desired key combination. " /><Run Text="{x:Static s:Wording.HotkeysWorkWhen}" /><Run Text="App-wide shortcuts (open/close the window, mute) live in " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="shortcuts" Click="FaqAction_Click" Content="Settings → Shortcuts" /></InlineUIContainer><Run Text="." /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="SCHEDULED SWITCHING" />
                            <TextBlock Classes="faq"><Run Text="Click the schedule button (&#x231A;) on " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="profiles" Click="FaqAction_Click" Content="a profile card" /></InlineUIContainer><Run Text=" to add a schedule. Choose a time and days of the week. Multiple schedules per profile are supported. The schedule button lights up orange when at least one schedule is set, and the card shows a schedule chip you can click to edit it." /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="AUTO-SWITCH ON CONNECT" />
                            <TextBlock Classes="faq"><Run Text="Click the auto-switch button (&#x26A1;) on " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="profiles" Click="FaqAction_Click" Content="a profile card" /></InlineUIContainer><Run Text=" to enable auto-switch. VibeSwitcher will activate this profile whenever its playback device connects. Best for wireless headsets and USB audio interfaces." /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="MINI MODE" />
                            <TextBlock Classes="faq"><Run Text="Shrink VibeSwitcher into a small profile switcher that sits in a corner of your screen — perfect over games. Enter it with the shrink button in the title bar, the " /><Run Text="{x:Static s:Wording.TrayMenu}" /><Run Text=", or a hotkey; the expand button brings the full window back. In " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="miniSettings" Click="FaqAction_Click" Content="Settings → Mini Window" /></InlineUIContainer><Run Text=" you can pick the layout (rows or icon grid), choose which profiles appear, set the toggle shortcut, keep it always on top, and make it fade when inactive. Or just " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="miniTry" Click="FaqAction_Click" Content="try Mini Mode now" /></InlineUIContainer><Run Text="." /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="PANIC / MUTE HOTKEYS" />
                            <TextBlock Classes="faq"><Run Text="Set global hotkeys to instantly mute your microphone, speakers, or both — from inside any app. Each toggle plays a distinct sound and shows a brief &quot;muted / unmuted&quot; notification (you can silence the banner per shortcut with its bell toggle). Press the hotkey again to unmute. Set them up in " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="shortcuts" Click="FaqAction_Click" Content="Settings → Shortcuts" /></InlineUIContainer><Run Text="." /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="APP LAUNCH TRIGGERS" />
                            <TextBlock Classes="faq"><Run Text="Link one or more programs to a profile with the trigger button (&#x25B6;) on " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="profiles" Click="FaqAction_Click" Content="a profile card" /></InlineUIContainer><Run Text=" — VibeSwitcher switches to that profile automatically within seconds of any linked app launching, and stays there until you switch yourself." /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="SWITCH SOUNDS &amp; SILENT PROFILES" />
                            <TextBlock Classes="faq"><Run Text="Each profile can play a tone when it activates — choose from 7 built-in tones or your own WAV via the sound button on " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="profiles" Click="FaqAction_Click" Content="a profile card" /></InlineUIContainer><Run Text=". Prefer quiet? The silent toggle on a card skips the notification banner for that profile, and app-wide notification options live in " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="notifications" Click="FaqAction_Click" Content="Settings → Notifications" /></InlineUIContainer><Run Text="." /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="BACKUP &amp; RESTORE" />
                            <TextBlock Classes="faq"><Run Text="Go to " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="backup" Click="FaqAction_Click" Content="Settings → Backup &amp; Restore" /></InlineUIContainer><Run Text=" to export your config to a JSON file. Import that file on a new machine to restore all your profiles. Config is stored at " /><Run Text="{x:Static s:Wording.ConfigPath}" /><Run Text="." /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="{x:Static s:Wording.TrayFaqHeader}" />
                            <TextBlock Classes="faq"><Run Text="{x:Static s:Wording.LivesIn}" /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="traySettings" Click="FaqAction_Click" Content="{x:Static s:Wording.TrayLink}" /></InlineUIContainer><Run Text="{x:Static s:Wording.LivesInRest}" /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="STARTING AT LOGIN" />
                            <TextBlock Classes="faq"><Run Text="In " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="startupSettings" Click="FaqAction_Click" Content="Settings → Startup" /></InlineUIContainer><Run Text="{x:Static s:Wording.StartupFaq}" /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="RENAMING DEVICES" />
                            <TextBlock Classes="faq"><Run Text="{x:Static s:Wording.DeviceNamesIntro}" /><Run Text="Give devices short friendly names like &quot;GoXLR&quot; or &quot;Desk Speakers&quot; in " /><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="deviceAliases" Click="FaqAction_Click" Content="Settings → Devices" /></InlineUIContainer><Run Text=" — aliases are shown everywhere in the app instead of the raw names." /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Classes="faqHead" Text="INSTALL, UPDATES &amp; UNINSTALL" />
                            <TextBlock Classes="faq"><InlineUIContainer><Button Theme="{StaticResource FaqLink}" Tag="installSettings" Click="FaqAction_Click" Content="Settings → Install &amp; Updates" /></InlineUIContainer><Run Text=" shows your version, where the app and its data live (with folder sizes), and lets you uninstall from inside the app. Uninstalling keeps your profiles and settings unless you explicitly choose to delete them — so a reinstall picks up right where you left off." /></TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ PANEL M: Mini Mode profile list ══ -->
            <!-- (The profiles in tray order — pinned first, then the user's order — filtered to Mini Mode's
                 own selection: SettingsWindow.RefreshMiniList.) -->
            <ScrollViewer Name="MiniPanel" IsVisible="False" VerticalScrollBarVisibility="Auto"
                          Focusable="True" IsTabStop="False">
                <!-- (WPF: Padding="10,8,10,4" on the ScrollViewer, which Avalonia leaves out of its height.) -->
                <Grid Margin="10,8,10,4">
                    <ItemsControl Name="MiniList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileCardViewModel">
                                <Button Theme="{StaticResource MiniRowBtn}" Classes.active="{Binding IsActive}"
                                        Command="{Binding ActivateCommand}"
                                        ToolTip.Tip="{Binding HotkeyDisplay}" ToolTip.ServiceEnabled="{Binding IsHotkeySet}"
                                        ToolTip.ShowOnDisabled="True">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,10,0">
                                            <Image Source="{Binding IconPreview, Converter={x:Static img:AppImages.ToBitmap}}" Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding HasCustomIcon}" />
                                            <c:LogoIcon IsAbout="True" Width="22" Height="22" IsVisible="{Binding !HasCustomIcon}" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <!-- This profile's activation hotkey -->
                                        <Border Grid.Column="2" Background="{DynamicResource VSInsetBg}" BorderBrush="{DynamicResource InputBorder}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,2,0"
                                                VerticalAlignment="Center" IsVisible="{Binding IsHotkeySet}">
                                            <TextBlock Text="{Binding HotkeyDisplay}" FontFamily="fonts:VibeSwitcher#Cousine"
                                                       FontSize="9.5" Foreground="{DynamicResource VSLabel}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Grid layout: icon buttons, name on hover -->
                    <ItemsControl Name="MiniGrid" IsVisible="False" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileCardViewModel">
                                <Button Theme="{StaticResource MiniGridBtn}" Classes.active="{Binding IsActive}"
                                        Command="{Binding ActivateCommand}" ToolTip.Tip="{Binding Name}" ToolTip.ShowOnDisabled="True">
                                    <StackPanel VerticalAlignment="Center">
                                        <Grid Width="26" Height="26" HorizontalAlignment="Center">
                                            <Image Source="{Binding IconPreview, Converter={x:Static img:AppImages.ToBitmap}}" Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding HasCustomIcon}" />
                                            <c:LogoIcon IsAbout="True" Width="24" Height="24" IsVisible="{Binding !HasCustomIcon}" />
                                        </Grid>
                                        <!-- This profile's activation hotkey -->
                                        <TextBlock Text="{Binding HotkeyDisplay}" FontFamily="fonts:VibeSwitcher#Cousine" FontSize="8"
                                                   Foreground="{DynamicResource VSLabel}" HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="52"
                                                   IsVisible="{Binding IsHotkeySet}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- ══ Profile popup ══ -->
            <Grid Name="ProfileDetailOverlay" IsVisible="False" ZIndex="10">
                <Border Name="OverlayBackdrop" Background="{DynamicResource VSScrim}" />
                <Border Name="ProfileDetailCard" MaxWidth="500" MinWidth="400" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Margin="20" Background="{DynamicResource VSModalBg}"
                        CornerRadius="18" BorderBrush="#66F5820A" BorderThickness="1">
                    <Grid Name="ProfileDetailContent" RowDefinitions="Auto,*,Auto" x:DataType="vm:ProfileCardViewModel">
                        <!-- Header -->
                        <Border Grid.Row="0" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1"
                                Padding="22,18,22,14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Width="54" Height="54" CornerRadius="13" Background="{DynamicResource VSInsetBg}"
                                        BorderBrush="{DynamicResource VSBorder}" BorderThickness="1" Margin="0,0,14,0">
                                    <Grid>
                                        <c:LogoIcon Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsVisible="{Binding !HasCustomIcon}" />
                                        <Image Source="{Binding IconPreview, Converter={x:Static img:AppImages.ToBitmap}}"
                                               Width="52" Height="52" Stretch="Uniform" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" IsVisible="{Binding HasCustomIcon}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox Name="ProfileNameBox" Text="{Binding Name}" MaxLength="20" FontSize="16" FontWeight="Bold"
                                             Foreground="{DynamicResource PrimaryText}" Classes="bare" Margin="0,0,0,6" />
                                    <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"
                                            Background="#1FF5820A" BorderBrush="#40F5820A" BorderThickness="1">
                                        <TextBlock Text="{Binding ModeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="2" Width="30" Height="30" Content="✕" FontSize="13" VerticalAlignment="Top"
                                        Theme="{StaticResource BackButton}" Click="OverlayClose_Click"
                                        ToolTip.Tip="Close" AutomationProperties.Name="Close" />
                            </Grid>
                        </Border>

                        <!-- Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="440">
                            <StackPanel Margin="22,14">
                                <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,10"
                                           c:Wpf.Visibility="{Binding SuggestionsVisibility}">
                                    <Button Content="Gaming" Theme="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Gaming" />
                                    <Button Content="Work" Theme="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Work" />
                                    <Button Content="Music" Theme="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Music" />
                                    <Button Content="Headset" Theme="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Headset" />
                                    <Button Content="Streaming" Theme="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Streaming" />
                                    <Button Content="Calls" Theme="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Calls" />
                                    <Button Content="Mic" Theme="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Mic" />
                                    <Button Content="Home" Theme="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Home" />
                                    <Button Content="Speakers" Theme="{StaticResource ChipButton}" Command="{Binding ApplyNameSuggestionCommand}" CommandParameter="Speakers" />
                                </WrapPanel>

                                <TextBlock Classes="sectionLabel" Text="NOTES" />
                                <Grid Margin="0,0,0,14">
                                    <TextBox Text="{Binding Notes}" MaxLength="61" />
                                    <TextBlock Text="Add a note about this profile..." IsHitTestVisible="False"
                                               Foreground="{DynamicResource TertiaryText}" FontStyle="Italic"
                                               VerticalAlignment="Center" Margin="9,0,0,0"
                                               IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                </Grid>

                                <StackPanel c:Wpf.Visibility="{Binding PlaybackVisible}" Margin="0,0,0,14">
                                    <TextBlock Classes="sectionLabel" Text="PLAYBACK DEVICE" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ComboBox ItemsSource="{Binding PlaybackDevices}" SelectedItem="{Binding SelectedPlaybackDevice}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="svc:AudioDeviceInfo">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Classes="dot" Classes.disconnected="{Binding !IsConnected}" Width="7" Height="7"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding ShowDot}" />
                                                        <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1" Content="Test" Margin="8,0,0,0" Theme="{StaticResource ActionButton}"
                                                Command="{Binding TestSoundCommand}" IsEnabled="{Binding IsPlaybackDeviceSet}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel c:Wpf.Visibility="{Binding RecordingVisible}" Margin="0,0,0,14">
                                    <TextBlock Classes="sectionLabel" Text="RECORDING DEVICE" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ComboBox ItemsSource="{Binding RecordingDevices}" SelectedItem="{Binding SelectedRecordingDevice}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="svc:AudioDeviceInfo">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Classes="dot" Classes.disconnected="{Binding !IsConnected}" Width="7" Height="7"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding ShowDot}" />
                                                        <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1" Content="Test" Margin="8,0,0,0" Theme="{StaticResource ActionButton}"
                                                Command="{Binding TestMicCommand}" IsEnabled="{Binding IsRecordingDeviceSet}" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Classes="sectionLabel" Text="HOTKEY" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBox Text="{Binding HotkeyDisplay, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Width="120" Margin="0,0,8,0" />
                                    <Button Theme="{StaticResource ActionButton}" Content="Set Hotkey" Command="{Binding CaptureHotkeyCommand}" />
                                    <Button Content="✕" Margin="6,0,0,0" Theme="{StaticResource ActionButton}" Command="{Binding ClearHotkeyCommand}"
                                            ToolTip.Tip="Clear hotkey" AutomationProperties.Name="Clear hotkey" IsVisible="{Binding IsHotkeySet}" />
                                </StackPanel>

                                <TextBlock Classes="sectionLabel" Text="ICON" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBox Text="{Binding IconPath, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Width="160" Margin="0,0,8,0" />
                                    <Button Content="Pick Icon" Theme="{StaticResource ActionButton}" Command="{Binding PickIconCommand}" />
                                    <Button Content="✕" Margin="6,0,0,0" Theme="{StaticResource ActionButton}" Command="{Binding ResetIconCommand}"
                                            ToolTip.Tip="Reset to default icon" AutomationProperties.Name="Reset to default icon"
                                            IsVisible="{Binding HasCustomIcon}" />
                                </StackPanel>

                                <Border Padding="10,7" CornerRadius="5" Background="{DynamicResource WarningBg}"
                                        BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1" Margin="0,0,0,10"
                                        IsVisible="{Binding HasValidationWarning}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource WarningText}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ValidationWarning}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <Border Grid.Row="2" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="22,14,22,18">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Theme="{StaticResource ActionButton}" Content="Clone" Command="{Binding CloneCommand}" Margin="0,0,6,0" />
                                    <Button Theme="{StaticResource DangerButton}" Content="Delete" Command="{Binding DeleteCommand}" />
                                </StackPanel>
                                <Button Content="Done" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="OverlayClose_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- The window's resize grip (bottom-right), as WPF's CanResizeWithGrip draws it. -->
        <c:ResizeGrip Name="Grip" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" ZIndex="20" />

        <c:AccentFrame Grid.RowSpan="4" />
    </Grid>
</Window>
