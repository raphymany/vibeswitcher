<c:VsDialog xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="using:VibeSwitcher.App.Controls"
            x:Class="VibeSwitcher.App.Dialogs.AlertDialog"
            Width="360">
    <!-- Port of Views/AlertDialog.xaml. -->
    <Grid RowDefinitions="Auto,Auto">
        <c:TitleBar />

        <StackPanel Grid.Row="1" Margin="24,14,24,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Name="IconBorder" Width="36" Height="36" CornerRadius="18"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Name="IconPath" Width="18" Height="18" Stretch="Uniform"
                          Fill="Transparent" StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Name="TitleText" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Name="MessageText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource PrimaryText}" LineHeight="18" Margin="0,0,0,20" />

            <Button Content="OK" Theme="{StaticResource PrimaryButton}"
                    IsDefault="True" IsCancel="True" HorizontalAlignment="Center" Click="OK_Click" />
        </StackPanel>

        <c:AccentFrame Grid.RowSpan="2" />
    </Grid>
</c:VsDialog>
