<c:VsDialog xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="using:VibeSwitcher.App.Controls"
            xmlns:d="using:VibeSwitcher.App.Dialogs"
            x:Class="VibeSwitcher.App.Dialogs.SessionLogWindow"
            Title="Session Errors"
            Width="520" Height="360" MinWidth="400" MinHeight="260">
    <!-- Port of Views/SessionLogWindow.xaml. (WPF's ListView/GridView columns → a header row and
         rows with the same column widths.) -->
    <c:VsDialog.Styles>
        <Style Selector="Border.header">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SessionSeparator}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.header TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="12,6" />
        </Style>
        <Style Selector="Border.col">
            <Setter Property="BorderBrush" Value="{DynamicResource SessionSeparator}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SessionSeparator}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <!-- (WPF: the cells start 7 px in, a little tighter than the ListViewItem padding suggests.) -->
            <Setter Property="Padding" Value="7,5" />
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{DynamicResource SessionItemHoverBg}" />
        </Style>
    </c:VsDialog.Styles>

    <Grid RowDefinitions="Auto,*">
        <c:TitleBar ShowMinimize="True" ShowMaximize="True" />

        <Grid Grid.Row="1" Margin="18" RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource WarningBg}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="{DynamicResource IcoWarning}" Width="18" Height="18" Stretch="Uniform"
                          Fill="Transparent" Stroke="{DynamicResource WarningText}" StrokeThickness="1.5"
                          StrokeJoin="Round" StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Session Errors" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                    <TextBlock Text="Errors that occurred since the app started. Previous sessions are not shown."
                               FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"
                               TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <!-- Error list -->
            <Border Grid.Row="1" Background="{DynamicResource SessionListBg}" BorderBrush="{DynamicResource SessionListBorder}"
                    BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="header">
                        <Grid ColumnDefinitions="70,70,320">
                            <!-- (WPF draws a divider at the end of each column header.) -->
                            <Border Classes="col"><TextBlock Text="Time" /></Border>
                            <Border Classes="col" Grid.Column="1"><TextBlock Text="Code" /></Border>
                            <Border Classes="col" Grid.Column="2"><TextBlock Text="Message" /></Border>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Name="ErrorList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="d:SessionErrorRow">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="70,70,320">
                                            <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{DynamicResource TertiaryText}"
                                                       FontFamily="fonts:VibeSwitcher#Cascadia Mono" />
                                            <TextBlock Grid.Column="1" Text="{Binding CodeDisplay}" FontSize="11"
                                                       Foreground="{DynamicResource ErrorCodeText}" FontFamily="fonts:VibeSwitcher#Cascadia Mono"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="11"
                                                       Foreground="{DynamicResource SessionMsgText}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Footer buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Open Log File" Theme="{StaticResource ActionButton}" Margin="0,0,8,0" Click="OpenLog_Click" />
                <Button Content="Close" Theme="{StaticResource ActionButton}" IsDefault="True" IsCancel="True" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <c:AccentFrame Grid.RowSpan="2" />
    </Grid>
</c:VsDialog>
