<c:VsDialog xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="using:VibeSwitcher.App.Controls"
            x:Class="VibeSwitcher.App.Dialogs.CloneProfileDialog"
            Width="470">
    <!-- Port of Views/CloneProfileDialog.xaml. -->
    <c:VsDialog.Resources>
        <!-- Segmented "pill" radio for the mode picker — accent fill when selected. -->
        <ControlTheme x:Key="ModePill" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource VSLabel}" />
            <Setter Property="FocusAdorner" Value="{DynamicResource AccentFocusVisual}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="bg" Background="{DynamicResource VSSurface}" BorderBrush="{DynamicResource VSBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <!-- (WPF order: checked, then hover — a hovered checked pill gets the accent border too.) -->
            <Style Selector="^:checked">
                <Setter Property="Foreground" Value="White" />
                <Style Selector="^ /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Style>
            </Style>
            <Style Selector="^:pointerover /template/ Border#bg">
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Style>
        </ControlTheme>
    </c:VsDialog.Resources>
    <c:VsDialog.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Fill" Value="{DynamicResource ChipBorder}" />
        </Style>
        <Style Selector="Ellipse.dot.on">
            <Setter Property="Fill" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="ComboBox.device">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </c:VsDialog.Styles>

    <Grid RowDefinitions="Auto,Auto">
        <c:TitleBar />

        <StackPanel Grid.Row="1" Margin="28,18,28,24">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Accent}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Canvas.Left="5" Canvas.Top="0" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                   Fill="Transparent" Stroke="White" StrokeThickness="1.5" />
                        <Rectangle Canvas.Left="0" Canvas.Top="5" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource Accent}" Stroke="White" StrokeThickness="1.5" />
                    </Canvas>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Clone Profile" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                    <TextBlock Name="HeaderSubtitle" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Step progress dots -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Ellipse Name="Dot0" Classes="dot" />
                <Ellipse Name="Dot1" Classes="dot" />
                <Ellipse Name="Dot2" Classes="dot" />
                <Ellipse Name="Dot3" Classes="dot" />
            </StackPanel>

            <!-- Step title and subtitle -->
            <TextBlock Name="StepTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,4" />
            <TextBlock Name="StepSubtitle" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,20" />

            <!-- ── Step 0: Name & hotkey ── -->
            <StackPanel Name="Step0Panel" MinHeight="120">
                <TextBlock Classes="fieldLabel" Text="Profile name" />
                <TextBox Name="NameBox" FontSize="13" Height="32" />

                <TextBlock Classes="fieldLabel" Text="Hotkey" Margin="0,16,0,6" />
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource HotkeyBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                            CornerRadius="6" Padding="10,6" MinWidth="150" VerticalAlignment="Center">
                        <TextBlock Name="HotkeyLabel" Text="Not set" FontSize="13" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
                    </Border>
                    <Button Name="SetHotkeyBtn" Content="Set hotkey…" Theme="{StaticResource ActionButton}"
                            Padding="14,0" Height="34" Margin="8,0,0,0" Click="SetHotkey_Click" />
                    <Button Name="ClearHotkeyBtn" Content="Clear" Theme="{StaticResource ActionButton}"
                            Padding="12,0" Height="34" Margin="6,0,0,0" Click="ClearHotkey_Click" />
                </StackPanel>
                <TextBlock Text="Two profiles can't share a hotkey — the clone starts with none."
                           FontSize="10.5" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0" />
            </StackPanel>

            <!-- ── Step 1: Devices & mode ── -->
            <StackPanel Name="Step1Panel" IsVisible="False" MinHeight="120">
                <TextBlock Classes="fieldLabel" Text="Mode" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton Name="ModePlayback" GroupName="CloneMode" Content="Playback" Theme="{StaticResource ModePill}" IsCheckedChanged="Mode_Changed" />
                    <RadioButton Name="ModeRecording" GroupName="CloneMode" Content="Recording" Theme="{StaticResource ModePill}" IsCheckedChanged="Mode_Changed" />
                    <RadioButton Name="ModeBoth" GroupName="CloneMode" Content="Both" Theme="{StaticResource ModePill}" IsCheckedChanged="Mode_Changed" />
                </StackPanel>

                <TextBlock Name="PlaybackLabel" Classes="fieldLabel" Text="Playback device" />
                <ComboBox Name="PlaybackCombo" Classes="device" FontSize="12" Margin="0,0,0,12" />

                <TextBlock Name="RecordingLabel" Classes="fieldLabel" Text="Recording device" />
                <ComboBox Name="RecordingCombo" Classes="device" FontSize="12" />
            </StackPanel>

            <!-- ── Step 2: What to copy ── -->
            <StackPanel Name="Step2Panel" IsVisible="False" MinHeight="120">
                <StackPanel Name="CopyOptionsPanel">
                    <CheckBox Name="chkSound" Theme="{StaticResource ThemedCheckBox}" Content="Switch sound" IsCheckedChanged="Sound_Toggled" />
                    <CheckBox Name="chkAppTriggers" Theme="{StaticResource ThemedCheckBox}" Content="App launch triggers" />
                    <CheckBox Name="chkAutoSwitch" Theme="{StaticResource ThemedCheckBox}" Content="Auto-switch on device connect" />
                    <CheckBox Name="chkFavorite" Theme="{StaticResource ThemedCheckBox}" Content="Favorite (pinned)" />
                    <CheckBox Name="chkSilent" Theme="{StaticResource ThemedCheckBox}" Content="Silent — no notification banner" />
                    <CheckBox Name="chkIcon" Theme="{StaticResource ThemedCheckBox}" Content="Custom icon" />
                    <CheckBox Name="chkNotes" Theme="{StaticResource ThemedCheckBox}" Content="Notes" />
                </StackPanel>
                <TextBlock Name="NoCopyOptionsHint" Text="This profile has no extra features to copy." FontSize="12"
                           Foreground="{DynamicResource SecondaryText}" IsVisible="False" />
            </StackPanel>

            <!-- ── Step 3: Schedules ── -->
            <StackPanel Name="Step3Panel" IsVisible="False" MinHeight="120">
                <StackPanel Name="SchedulesPanel" />
                <TextBlock Text="Copied schedules keep the same time, so they'll overlap the original — adjust them afterward if needed."
                           FontSize="10.5" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>

            <!-- ── Footer ── -->
            <DockPanel Margin="0,24,0,0">
                <Button Content="Cancel" DockPanel.Dock="Left" Theme="{StaticResource ActionButton}" Padding="16,0" Click="Cancel_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <Button Name="BackBtn" Content="← Back" Theme="{StaticResource ActionButton}" Padding="14,0" Margin="0,0,8,0"
                            IsVisible="False" Click="Back_Click" />
                    <Button Name="NextBtn" Content="Next →" Theme="{StaticResource PrimaryButton}" Padding="18,0"
                            IsDefault="True" Click="Next_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <c:AccentFrame Grid.RowSpan="2" />
    </Grid>
</c:VsDialog>
