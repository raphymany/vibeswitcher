<c:VsDialog xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="using:VibeSwitcher.App.Controls"
            x:Class="VibeSwitcher.App.Dialogs.ConfirmDialog"
            Width="380">
    <!-- Port of Views/ConfirmDialog.xaml. -->
    <Grid RowDefinitions="Auto,Auto">
        <c:TitleBar />

        <StackPanel Grid.Row="1" Margin="24,14,24,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Name="IconBadge" Width="36" Height="36" CornerRadius="18"
                        Background="{DynamicResource WarningBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <ContentControl Name="IconContent" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                    <TextBlock Name="SubtitleText" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"
                               TextWrapping="Wrap" MaxWidth="280" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <TextBlock Name="MessageText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource PrimaryText}" LineHeight="18" Margin="0,0,0,20" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="CancelBtn" Content="Cancel" Theme="{StaticResource ActionButton}"
                        IsDefault="True" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Name="ActionBtn" Theme="{StaticResource PrimaryButton}" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>

        <c:AccentFrame Grid.RowSpan="2" />
    </Grid>
</c:VsDialog>
