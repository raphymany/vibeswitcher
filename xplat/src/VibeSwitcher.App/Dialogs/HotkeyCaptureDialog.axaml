<c:VsDialog xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="using:VibeSwitcher.App.Controls"
            x:Class="VibeSwitcher.App.Dialogs.HotkeyCaptureDialog"
            Width="360">
    <!-- Port of Views/HotkeyCaptureDialog.xaml. -->
    <c:VsDialog.Resources>
        <!-- (This dialog's own buttons on Windows: 80 × 32, 6 px corners.) -->
        <ControlTheme x:Key="DialogButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="80" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusAdorner" Value="{DynamicResource AccentFocusVisual}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource HoverBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource PressedBg}" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource AccentHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
            </Style>
        </ControlTheme>
    </c:VsDialog.Resources>

    <Grid RowDefinitions="Auto,Auto">
        <c:TitleBar />

        <StackPanel Grid.Row="1" Margin="24,14,24,24">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Accent}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="{DynamicResource IcoKeyboard}" Width="19" Height="19" Stretch="Uniform"
                          Fill="Transparent" Stroke="White" StrokeThickness="1.4" StrokeJoin="Round" StrokeLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Set Hotkey" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                    <TextBlock Name="HotkeySubtitleText" Text="Press any key combination to assign it to this profile"
                               FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" MaxWidth="250"
                               HorizontalAlignment="Left" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="16,14" Margin="0,0,0,20">
                <TextBlock Name="HotkeyPreviewText" Text="(none)" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Cancel" Theme="{StaticResource DialogButton}" IsCancel="True" Margin="0,0,8,0"
                        Click="CancelButton_Click" />
                <Button Content="Clear" Theme="{StaticResource DialogButton}" Margin="0,0,8,0" Click="ClearButton_Click" />
                <Button Content="OK" Theme="{StaticResource DialogPrimaryButton}" IsDefault="True" Click="OkButton_Click" />
            </StackPanel>
        </StackPanel>

        <c:AccentFrame Grid.RowSpan="2" />
    </Grid>
</c:VsDialog>
