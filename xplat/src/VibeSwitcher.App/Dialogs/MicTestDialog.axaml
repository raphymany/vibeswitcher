<c:VsDialog xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="using:VibeSwitcher.App.Controls"
            x:Class="VibeSwitcher.App.Dialogs.MicTestDialog"
            Width="380">
    <!-- Port of Views/MicTestDialog.xaml. -->
    <c:VsDialog.Resources>
        <!-- The Windows app's level bar is WPF's standard progress bar (the same in both themes). -->
        <ControlTheme x:Key="MeterBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="#E6E6E6" BorderBrush="#BCBCBC" BorderThickness="1" ClipToBounds="True">
                        <Border Name="PART_Indicator" Background="#06B025" HorizontalAlignment="Left" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </c:VsDialog.Resources>

    <Grid RowDefinitions="Auto,Auto">
        <c:TitleBar />

        <StackPanel Grid.Row="1" Margin="24,14,24,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Accent}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="{DynamicResource IcoMic}" Width="18" Height="18" Stretch="Uniform"
                          Fill="Transparent" Stroke="White" StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Microphone Test" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                    <TextBlock Name="DeviceNameText" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap" MaxWidth="280" HorizontalAlignment="Left" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Name="SpeakPrompt" Text="Speak into your microphone" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,12" />

            <TextBlock Name="CaptureError" Text="Could not open the microphone. Check that it is not in use by another app."
                       FontSize="12" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Margin="0,0,0,12" IsVisible="False" />

            <ProgressBar Name="LevelBar" Theme="{StaticResource MeterBar}" Minimum="0" Maximum="1" Value="0"
                         Height="14" MinHeight="0" Margin="0,0,0,8" AutomationProperties.Name="Microphone input level" />

            <Grid Margin="0,0,0,16">
                <TextBlock Name="LevelText" Text="0%" FontSize="12" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Left" />
                <TextBlock Name="PeakText" Text="Peak: 0%" FontSize="12" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right" />
            </Grid>

            <Grid>
                <TextBlock Name="CountdownText" Text="Closing in 5 s" FontSize="11" Foreground="{DynamicResource DisabledText}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Button Content="Close" Theme="{StaticResource ActionButton}" Width="90" HorizontalAlignment="Right"
                        IsDefault="True" IsCancel="True" Click="Close_Click" />
            </Grid>
        </StackPanel>

        <c:AccentFrame Grid.RowSpan="2" />
    </Grid>
</c:VsDialog>
