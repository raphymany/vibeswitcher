<c:VsDialog xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="using:VibeSwitcher.App.Controls"
            x:Class="VibeSwitcher.App.Dialogs.UninstallDialog"
            Width="400">
    <!-- Port of Views/UninstallDialog.xaml; the wording says what happens on this system. -->
    <Grid RowDefinitions="Auto,Auto">
        <c:TitleBar />

        <StackPanel Grid.Row="1" Margin="20,14,20,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource ErrorDot}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IcoTrash}" Width="15" Height="15" Stretch="Uniform"
                          Fill="Transparent" Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Uninstall VibeSwitcher?" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                    <TextBlock Name="SubtitleText" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap" MaxWidth="280" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Name="BodyText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource PrimaryText}" LineHeight="18" Margin="0,0,0,14" />

            <Border Background="{DynamicResource VSInsetBg}" BorderBrush="{DynamicResource InputBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                    <StackPanel Margin="0,0,52,0">
                        <TextBlock Text="Also delete my profiles and settings" FontSize="12.5" Foreground="{DynamicResource PrimaryText}" />
                        <TextBlock Name="DataText" FontSize="10.5" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <CheckBox Name="DeleteDataToggle" Theme="{StaticResource ToggleSwitchStyle}"
                              HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Grid Margin="0,18,0,0">
                <Button Content="Cancel" Theme="{StaticResource ActionButton}" IsCancel="True"
                        HorizontalAlignment="Left" MinWidth="90" Click="Cancel_Click" />
                <Button Content="Uninstall" Theme="{StaticResource DeleteButton}"
                        HorizontalAlignment="Right" MinWidth="90" Click="Uninstall_Click" />
            </Grid>
        </StackPanel>

        <c:AccentFrame Grid.RowSpan="2" />
    </Grid>
</c:VsDialog>
