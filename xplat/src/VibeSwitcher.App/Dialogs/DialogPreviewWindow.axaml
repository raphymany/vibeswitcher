<c:VsDialog xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="using:VibeSwitcher.App.Controls"
            x:Class="VibeSwitcher.App.Dialogs.DialogPreviewWindow"
            Width="420" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
    <!-- A stand-in main window until the app wiring step: opens each dialog, switches light/dark, and
         shows the controls, so the look can be checked by hand on a Mac or Linux desktop. -->
    <Grid RowDefinitions="Auto,Auto">
        <c:TitleBar ShowMinimize="True" />

        <StackPanel Grid.Row="1" Margin="24,14,24,24" Spacing="10">
            <TextBlock Text="Dialog preview" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
            <TextBlock Text="The Mac/Linux app's first screens. The real app arrives with the Settings window."
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" />

            <WrapPanel>
                <WrapPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="Margin" Value="0,0,8,8" />
                    </Style>
                </WrapPanel.Styles>
                <Button Content="Alert" Theme="{StaticResource ActionButton}" Click="Alert_Click" />
                <Button Content="Confirm" Theme="{StaticResource ActionButton}" Click="Confirm_Click" />
                <Button Content="Delete profile" Theme="{StaticResource ActionButton}" Click="Delete_Click" />
                <Button Content="Try again" Theme="{StaticResource ActionButton}" Click="Retry_Click" />
                <Button Content="Error" Theme="{StaticResource ActionButton}" Click="Error_Click" />
                <Button Content="Uninstall" Theme="{StaticResource ActionButton}" Click="Uninstall_Click" />
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Light" Theme="{StaticResource ActionButton}" Click="Light_Click" />
                <Button Content="Dark" Theme="{StaticResource ActionButton}" Click="Dark_Click" />
                <Button Content="Follow system" Theme="{StaticResource ActionButton}" Click="Auto_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <CheckBox Theme="{StaticResource ToggleSwitchStyle}" IsChecked="True" />
                <CheckBox Theme="{StaticResource ThemedCheckBox}" Content="Check box" IsChecked="True" Margin="0" />
                <ToggleButton Theme="{StaticResource DayPillStyle}" Content="Mon" IsChecked="True" />
                <ToggleButton Theme="{StaticResource DayPillStyle}" Content="Tue" />
            </StackPanel>
            <Slider Theme="{StaticResource VolumeSlider}" Minimum="0" Maximum="100" Value="60" />
            <TextBox Text="Text box" />
            <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Speakers (Realtek)" />
                <ComboBoxItem Content="Headset (USB)" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Primary" Theme="{StaticResource PrimaryButton}" />
                <Button Content="Danger" Theme="{StaticResource DangerButton}" />
                <Button Content="Delete" Theme="{StaticResource DeleteButton}" />
            </StackPanel>
        </StackPanel>

        <c:AccentFrame Grid.RowSpan="2" />
    </Grid>
</c:VsDialog>
