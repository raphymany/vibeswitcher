# Normalize line endings to CRLF on Windows
* text=auto eol=crlf
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.md text eol=crlf

# Binary files - no line ending conversion
*.ico binary
*.png binary
*.jpg binary
*.exe binary
*.dll binary

# Linux system files the macOS/Linux packages install: must keep LF line endings everywhere
xplat/packaging/linux/*.rules text eol=lf
